: 1786114498:0;cat << 'EOF' > server.js\
import express from 'express';\
import { createServer } from 'http';\
import { Server } from 'socket.io';\
\
const app = express();\
const server = createServer(app);\
const io = new Server(server);\
\
app.use(express.static('public'));\
\
let playlist = [];\
let musicaAtual = null;\
let tempoInicioMusica = 0;\
\
setInterval(() => {\
  if (!musicaAtual && playlist.length > 0) {\
    musicaAtual = playlist.shift();\
    tempoInicioMusica = Date.now();\
    io.emit('novaMusica', { musica: musicaAtual, tempoDecorrido: 0 });\
    io.emit('atualizarFila', playlist);\
  }\
}, 1000);\
\
io.on('connection', (socket) => {\
  if (musicaAtual) {\
    const tempoDecorrido = (Date.now() - tempoInicioMusica) / 1000;\
    socket.emit('novaMusica', { musica: musicaAtual, tempoDecorrido });\
  }\
  socket.emit('atualizarFila', playlist);\
\
  socket.on('adicionarMusica', (url) => {\
    if (url) {\
      playlist.push(url);\
      io.emit('atualizarFila', playlist);\
    }\
  });\
\
  socket.on('proximaMusica', () => {\
    musicaAtual = null;\
    io.emit('novaMusica', null);\
  });\
});\
\
// O '0.0.0.0' libera para a rede Wi-Fi e para o Cloudflare\
server.listen(3000, '0.0.0.0', () => {\
  console.log('ÉøÉ∫Ä R√ÉÅdio rodando!');\
});\
EOF\

