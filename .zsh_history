\
        .sound-unit { display: flex; flex-direction: column; align-items: center; gap: 8px; }\
        .unit-label { font-size: 9px; font-weight: bold; color: #888; }\
\
        /* Subwoofer */\
        .subwoofer {\
            width: 65px; height: 65px;\
            background: radial-gradient(circle, #222 15%, #111 60%, #000 100%);\
            border: 3px solid #333; border-radius: 50%;\
            display: flex; justify-content: center; align-items: center;\
