}\

: 1786159475:0;const canvas = document.getElementById('gameCanvas');\
const ctx = canvas.getContext('2d');\
const scoreElement = document.getElementById('score');\
const restartBtn = document.getElementById('restartBtn');\
\
// Configura√ß√µes do Jogo\
const gridSize = 20; // Tamanho de cada quadrado (cobrinha/comida)\
const tileCount = canvas.width / gridSize; // Quantos quadrados cabem na tela\
let score = 0;\
let speed = 100; // Milissegundos entre cada "frame" (menor = mais r√ÉÅpido)\
let gameInterval;\
let isGameOver = false;\
\
// Estado da Cobrinha e Comida\
let snake = [];\
let food = { x: 0, y: 0 };\
\
// Dire√ß√£o do movimento\
let dX = 0;\
let dY = 0;\
\
// Inicializa o jogo\
function startGame() {\
    // Posi√ß√£o inicial da cobrinha (centro)\
    snake = [\
        { x: 10, y: 10 },\
        { x: 9, y: 10 },\
        { x: 8, y: 10 }\
    ];\
    score = 0;\
    dX = 1; // Come√ßa movendo para a direita\
    dY = 0;\
    isGameOver = false;\
    scoreElement.innerText = score;\
    restartBtn.style.display = 'none';\
    \
    placeFood();\
    document.addEventListener('keydown', changeDirection);\
    \
    // Limpa intervalo anterior se houver e come√ßa o loop\
    clearInterval(gameInterval);\
    gameInterval = setInterval(gameLoop, speed);\
}\
\
// Loop principal do jogo\
function gameLoop() {\
    if (isGameOver) return;\
    \
    update();\
    draw();\
}\
\
// Atualiza a l√≥gica (movimento, colis√£o)\
function update() {\
    // Calcula a nova posi√ß√£o da cabe√ßa\
    const head = { x: snake[0].x + dX, y: snake[0].y + dY };\
\
    // Detec√ß√£o de Colis√£o com as Paredes\
    if (head.x < 0 || head.x >= tileCount || head.y < 0 || head.y >= tileCount) {\
        gameOver();\
        return;\
    }\
\
    // Detec√ß√£o de Colis√£o com o pr√≥prio corpo\
    for (let i = 1; i < snake.length; i++) {\
        if (snake[i].x === head.x && snake[i].y === head.y) {\
            gameOver();\
            return;\
        }\
    }\
\
    // Adiciona a nova cabe√ßa ao in√≠cio do array\
    snake.unshift(head);\
\
    // Verifica se comeu a comida\
    if (head.x === food.x && head.y === food.y) {\
        score += 10;\
        scoreElement.innerText = score;\
        placeFood();\
        // Opcional: Aumentar a velocidade\
        // clearInterval(gameInterval);\
        // speed = Math.max(50, speed - 2); \
        // gameInterval = setInterval(gameLoop, speed);\
    } else {\
        // Se n√£o comeu, remove a cauda para manter o tamanho\
        snake.pop();\
    }\
}\
\
// Desenha tudo no Canvas\
function draw() {\
    // Limpa o canvas\
    ctx.fillStyle = '#34495e';\
    ctx.fillRect(0, 0, canvas.width, canvas.height);\
\
    // Desenha a Comida\
    ctx.fillStyle = '#e74c3c'; // Vermelho\
    ctx.fillRect(food.x * gridSize, food.y * gridSize, gridSize - 2, gridSize - 2);\
\
    // Desenha a Cobrinha\
    ctx.fillStyle = '#2ecc71'; // Verde\
    snake.forEach((part, index) => {\
        // Cabe√ßa √© de cor diferente\
        if (index === 0) ctx.fillStyle = '#27ae60';\
        else ctx.fillStyle = '#2ecc71';\
\
        // O "-2" cria um pequeno espa√ßamento entre os quadrados\
        ctx.fillRect(part.x * gridSize, part.y * gridSize, gridSize - 2, gridSize - 2);\
    });\
}\
\
// Coloca a comida em uma posi√ß√£o aleat√≥ria (fora da cobrinha)\
function placeFood() {\
    let validPosition = false;\
    while (!validPosition) {\
        food.x = Math.floor(Math.random() * tileCount);\
        food.y = Math.floor(Math.random() * tileCount);\
\
        validPosition = true;\
        // Verifica se a comida nasceu em cima da cobrinha\
        snake.forEach(part => {\
            if (part.x === food.x && part.y === food.y) {\
                validPosition = false;\
            }\
        });\
    }\
}\
\
// Controla a dire√ß√£o usando as setas\
function changeDirection(event) {\
    const LEFT_KEY = 37;\
    const RIGHT_KEY = 39;\
    const UP_KEY = 38;\
    const DOWN_KEY = 40;\
\
    const keyPressed = event.keyCode;\
    \
    const goingUp = dY === -1;\
    const goingDown = dY === 1;\
    const goingRight = dX === 1;\
    const goingLeft = dX === -1;\
\
    // Impede que a cobrinha volte para tr√ÉÅs (colida consigo mesma instantaneamente)\
    if (keyPressed === LEFT_KEY && !goingRight) {\
        dX = -1;\
        dY = 0;\
    }\
    if (keyPressed === UP_KEY && !goingDown) {\
        dX = 0;\
        dY = -1;\
    }\
    if (keyPressed === RIGHT_KEY && !goingLeft) {\
        dX = 1;\
        dY = 0;\
    }\
    if (keyPressed === DOWN_KEY && !goingUp) {\
        dX = 0;\
        dY = 1;\
    }\
}\
\
function gameOver() {\
    isGameOver = true;\
    clearInterval(gameInterval);\
    \
    ctx.fillStyle = 'rgba(0, 0, 0, 0.7)';\
    ctx.fillRect(0, 0, canvas.width, canvas.height);\
    \
    ctx.fillStyle = 'white';\
    ctx.font = '40px Arial';\
    ctx.textAlign = 'center';\
    ctx.fillText("Fim de Jogo!", canvas.width / 2, canvas.height / 2);\
    \
    restartBtn.style.display = 'inline-block';\
}\
\
restartBtn.addEventListener('click', startGame);\
\
// Inicia o jogo ao carregar a p√ÉÅgina\
startGame();\

: 1786159503:0;// Inicializa a Web Audio API\
const audioCtx = new (window.AudioContext || window.webkitAudioContext)();\
\
// Fun√ß√£o para reproduzir um tom sint√©tico r√ÉÅpido\
function playSound(frequency, type, duration) {\
    // Reativa o contexto de √ÉÅudio caso o navegador o tenha pausado por pol√≠ticas de autoplay\
    if (audioCtx.state === 'suspended') {\
        audioCtx.resume();\
    }\
\
    const osc = audioCtx.createOscillator();\
    const gain = audioCtx.createGain();\
\
    osc.type = type; // Tipos comuns: 'sine', 'square', 'sawtooth', 'triangle'\
    osc.frequency.value = frequency; // Frequ√™ncia em Hz\
\
    // Reduz o volume gradualmente para evitar um estalo no final do som\
    gain.gain.setValueAtTime(0.1, audioCtx.currentTime);\
    gain.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + duration);\
\
    osc.connect(gain);\
    gain.connect(audioCtx.destination);\
\
    osc.start();\
    osc.stop(audioCtx.currentTime + duration);\
}\
\
// Efeito sonoro ao comer a fruta (tom agudo e curto)\
function playEatSound() {\
    playSound(600, 'sine', 0.1);\
}\
\
// Efeito sonoro de Game Over (tom grave descritivo)\
function playGameOverSound() {\
    playSound(150, 'sawtooth', 0.4);\
}\

