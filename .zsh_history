  { id: 1, nome: "Produto F√≠sico - Performance Kit", preco: 150.00, tipo: "fisico" },\
  { id: 2, nome: "Produto Digital - E-book E-commerce Elite", preco: 49.90, tipo: "digital", downloadUrl: "https://seu-link-de-download.com/arquivo.pdf" }\
