: 1786133024:0;cat << 'EOF' > ~/minha-radio/public/index.html\
<!DOCTYPE html>\
<html lang="pt-BR">\
<head>\
    <meta charset="UTF-8">\
    <meta name="viewport" content="width=device-width, initial-scale=1.0">\
    <title>‚É∫ÉÅ SPEED R√ÅDIO - PIONEER EDITION PRO</title>\
    <script src="/socket.io/socket.io.js"></script>\
    <style>\
        :root { \
            --bg-color: #0a0b0e; \
            --bg-image: none;\
            --pioneer-frame-bg: linear-gradient(145deg, #1f232a, #0d0e12);\
            --pioneer-border: #2a2e38;\
            --pioneer-blue: #00d4ff; \
            --pioneer-glow: #00d4ff66;\
            --speaker-sub-color: #e67e22;\
            --speaker-horn-color: #e67e22;\
            --speaker-tweet-color: #e67e22;\
            --btn-bg: #00d4ff;\
            --btn-text: #000000;\
            --text-color: #00d4ff;\
        }\
\
        body { \
            background-color: var(--bg-color); \
            background-image: var(--bg-image);\
            background-size: cover;\
            background-position: center;\
            background-attachment: fixed;\
            color: #fff; \
            font-family: 'Courier New', Courier, monospace; \
            text-align: center; \
            padding: 15px; \
            margin: 0; \
            transition: background 0.3s ease;\
        }\
\
        /* Efeito Glitter */\
        body.glitter-bg {\
            background-image: radial-gradient(circle, #ffffff 1px, transparent 1px), radial-gradient(circle, #ff007f 1px, transparent 1px), radial-gradient(circle, #00d4ff 1px, transparent 1px);\
            background-size: 20px 20px, 30px 30px, 15px 15px;\
            background-position: 0 0, 10px 10px, 5px 5px;\
            animation: glitterAnim 2s infinite linear;\
        }\
        @keyframes glitterAnim {\
            0% { background-position: 0 0, 10px 10px, 5px 5px; }\
            50% { background-position: 10px 20px, 20px 0px, 15px 10px; }\
            100% { background-position: 0 0, 10px 10px, 5px 5px; }\
        }\
\
        .gear-container { position: absolute; top: 15px; right: 15px; z-index: 1000; }\
        .gear-btn { background: #1f232a; border: 2px solid var(--pioneer-blue); color: #fff; padding: 8px 12px; border-radius: 50%; cursor: pointer; font-size: 18px; box-shadow: 0 0 10px var(--pioneer-glow); }\
        .gear-menu { display: none; position: absolute; right: 0; top: 45px; background: #111318; border: 2px solid var(--pioneer-blue); padding: 10px; border-radius: 10px; width: 220px; box-shadow: 0 8px 20px rgba(0,0,0,0.8); text-align: left; }\
        .gear-menu button { width: 100%; margin: 4px 0; text-align: left; font-size: 11px; padding: 8px; }\
\
        .pioneer-frame { background: var(--pioneer-frame-bg); border: 4px solid var(--pioneer-border); border-radius: 18px; padding: 20px; max-width: 600px; margin: 40px auto 15px auto; box-shadow: 0 10px 30px rgba(0,0,0,0.9); position: relative; }\
        .lcd-display { background: #00121a; border: 3px solid #002b3d; border-radius: 8px; padding: 12px; box-shadow: inset 0 0 15px var(--pioneer-glow), 0 0 10px var(--pioneer-glow); color: var(--text-color); margin-bottom: 15px; }\
\
        /* WALLCONTAINER & ALTO-FALANTES */\
        .wall-container { display: flex; justify-content: space-around; align-items: center; background: #050608; border: 2px solid #1a1d24; border-radius: 12px; padding: 15px 5px; margin: 15px 0; }\
        .sound-unit { display: flex; flex-direction: column; align-items: center; gap: 8px; }\
        .unit-label { font-size: 9px; font-weight: bold; color: #888; }\
\
        .subwoofer { width: 65px; height: 65px; background: radial-gradient(circle, #222 15%, #111 60%, #000 100%); border: 3px solid #333; border-radius: 50%; display: flex; justify-content: center; align-items: center; }\
        .subwoofer::before { content: ''; width: 38px; height: 38px; background: radial-gradient(circle, var(--speaker-sub-color) 20%, #111 100%); border-radius: 50%; border: 1px solid #000; }\
        \
        .horn { width: 50px; height: 50px; background: #111; border: 3px solid #333; border-radius: 6px; display: flex; justify-content: center; align-items: center; }\
        .horn-inner { width: 28px; height: 28px; background: radial-gradient(circle, var(--speaker-horn-color) 10%, #000 80%); border-radius: 50%; border: 1px solid #444; }\
        \
        .tweeter { width: 35px; height: 35px; background: #1a1a1a; border: 2px solid #444; border-radius: 50%; display: flex; justify-content: center; align-items: center; }\
        .tweeter-core { width: 14px; height: 14px; background: var(--speaker-tweet-color); border-radius: 50%; box-shadow: 0 0 5px var(--speaker-tweet-color); }\
\
        .box-link { background: rgba(0, 212, 255, 0.05); border: 1px dashed var(--pioneer-blue); border-radius: 6px; padding: 8px; margin: 10px 0; }\
        .box-link input { width: 90%; text-align: center; font-size: 11px; background: #000; color: var(--text-color); border: 1px solid #005577; padding: 6px; }\
        \
        input[type="text"], input[type="email"], input[type="password"], select { width: 85%; padding: 8px; border-radius: 5px; border: 1px solid #005577; background: #00121a; color: #fff; margin-bottom: 8px; }\
        button { padding: 8px 12px; border-radius: 6px; border: none; background: var(--btn-bg); color: var(--btn-text); font-weight: bold; cursor: pointer; margin: 2px; }\
        .btn-danger { background: #e74c3c !important; color: #fff !important; }\
        .btn-extreme { background: #ff0055 !important; color: #fff !important; font-weight: bold; width: 100%; padding: 10px; }\
        .btn-extreme.active { background: #ff2a00 !important; box-shadow: 0 0 15px #ff2a00; }\
        .btn-small { padding: 4px 8px; font-size: 10px; margin: 0 2px; }\
\
        .vu-container { display: flex; justify-content: center; align-items: flex-end; gap: 4px; height: 30px; background: #00080d; padding: 6px; border-radius: 5px; margin: 10px 0; border: 1px solid #003344; }\
        .vu-bar { width: 8%; background: #003344; height: 10%; border-radius: 2px; }\
        .eq-panel { background: rgba(0,0,0,0.6); padding: 12px; border-radius: 8px; border: 1px solid #003344; margin: 10px 0; text-align: left; }\
        .eq-slider { display: flex; justify-content: space-between; align-items: center; margin: 10px 0; font-size: 12px; }\
        .eq-slider input { width: 55%; }\
\
        ol, ul { text-align: left; background: rgba(0, 212, 255, 0.05); padding: 10px 15px 10px 35px; border-radius: 5px; max-height: 220px; overflow-y: auto; border: 1px solid #003344; color: var(--text-color); font-size: 12px; }\
        li { margin-bottom: 6px; border-bottom: 1px solid #002b3d; padding-bottom: 4px; display: flex; justify-content: space-between; align-items: center; }\
        .song-title { flex-grow: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin-right: 8px; }\
        .color-group { display: flex; align-items: center; justify-content: space-between; margin: 8px 0; font-size: 12px; }\
        .color-group input[type="color"] { border: none; width: 40px; height: 30px; cursor: pointer; background: none; }\
    </style>\
</head>\
<body>\
\
    <!-- ENGRENAGEM -->\
    <div class="gear-container">\
        <button class="gear-btn" onclick="toggleGearMenu()">‚É∫ÉπÔ∏ÉØ</button>\
        <div id="gearMenu" class="gear-menu">\
            <button onclick="verAba('ouvinte'); toggleGearMenu();">ÉøÉ≥ª Display Pioneer (P√∫blico)</button>\
            <button onclick="solicitarAcesso('adm'); toggleGearMenu();">ÉøÉÆÉªÔ∏ÉØ Mesa de DJ / ADM</button>\
            <button onclick="solicitarAcesso('custom'); toggleGearMenu();">ÉøÉÆ® Edi√ß√£o de Display & Som</button>\
        </div>\
    </div>\
\
    <!-- LOGIN ADM -->\
    <div id="modalLogin" class="pioneer-frame" style="display:none; border-color: #ffcc00;">\
        <h3 style="color:#ffcc00;">ÉøÉ¥É≤ √Årea Restrita ADM</h3>\
        <input type="email" id="loginEmail" placeholder="E-mail ADM">\
        <input type="password" id="loginPass" placeholder="Senha ADM">\
        <br>\
        <button onclick="validarLogin()">Acessar Painel</button>\
        <button onclick="cancelarLogin()" class="btn-danger">Cancelar</button>\
    </div>\
\
    <!-- ABA 1: OUVINTE -->\
    <div id="abaOuvinte" class="pioneer-frame">\
        <div class="lcd-display">\
            <h1 style="margin: 5px 0; font-size: 18px;">‚É∫ÉÅ SPEED R√ÅDIO</h1>\
            <p id="status" style="margin: 5px 0; font-size: 11px;">[READY] SELECIONE OU ADICIONE M√É∫SICAS</p>\
            <div class="vu-container">\
                <div class="vu-bar"></div><div class="vu-bar"></div><div class="vu-bar"></div>\
                <div class="vu-bar"></div><div class="vu-bar"></div><div class="vu-bar"></div>\
            </div>\
        </div>\
        \
        <div class="box-link">\
            <input type="text" id="urlRadio" readonly>\
            <button onclick="copiarLink()">ÉøÉ≥É´ Copiar Link</button>\
        </div>\
\
        <audio id="audioElement" controls style="width:100%; margin: 10px 0;"></audio>\
\
        <div class="wall-container">\
            <div class="sound-unit"><div class="unit-label">SUBWOOFER</div><div class="subwoofer"></div></div>\
            <div class="sound-unit"><div class="unit-label">CORNETA</div><div class="horn"><div class="horn-inner"></div></div></div>\
            <div class="sound-unit"><div class="unit-label">TWEETER</div><div class="tweeter"><div class="tweeter-core"></div></div></div>\
        </div>\
\
        <h3>ÉøÉÆµ Pedir M√∫sica</h3>\
        <input type="text" id="linkMusicaOuvinte" placeholder="Cole o link MP3...">\
        <button onclick="enviarPedidoPublico()">‚ÉæÉµ Enviar para Aprova√ß√£o</button>\
\
        <h3>ÉøÉ≥Éº Fila Principal (Numerada)</h3>\
        <ol id="filaOuvinte"></ol>\
    </div>\
\
    <!-- ABA 2: MESA DE DJ / ADM -->\
    <div id="abaAdm" class="pioneer-frame" style="display: none;">\
        <h2>ÉøÉÆÉªÔ∏ÉØ Mesa de Som & Transmiss√£o DJ</h2>\
\
        <div style="margin: 15px 0;">\
            <button onclick="voltarMusica()">‚ÉØÆÔ∏ÉØ Voltar</button>\
            <button onclick="pausarEPlay()">‚ÉØØÔ∏ÉØ Play/Pause</button>\
            <button onclick="proximaMusica()">‚ÉØ≠Ô∏ÉØ Avan√ßar</button>\
        </div>\
\
        <div class="eq-panel">\
            <h4>ÉøÉ≥Å Adicionar √Åudios do Celular (Sem Limite)</h4>\
            <input type="file" id="fileInput" accept="audio/*" multiple style="font-size: 11px;">\
            <button onclick="carregarMp3Locais()">‚ÉæÉµ Inserir M√∫sicas</button>\
        </div>\
\
        <div class="eq-panel" style="border-color: #ffcc00;">\
            <h4 style="color: #ffcc00;">ÉøÉ≥• Pedidos do P√∫blico</h4>\
            <ul id="listaEspera"></ul>\
        </div>\
\
        <h4>ÉøÉ≥Éº Fila ADM (Organizar e Reordenar)</h4>\
        <ol id="filaAdm"></ol>\
\
        <button onclick="limparFila()" class="btn-danger">ÉøÉ∑É±Ô∏ÉØ Limpar Fila</button>\
        <br><br>\
        <button onclick="logout()" style="background: #444; color: #fff;">Sair do Painel</button>\
    </div>\
\
    <!-- ABA 3: EDI√Éß√É£O DE DISPLAY, SOM & APAR√É™NCIA -->\
    <div id="abaCustom" class="pioneer-frame" style="display: none;">\
        <h2>ÉøÉÆ® Edi√ß√£o de Display & Som</h2>\
\
        <!-- AJUSTES DE SOM -->\
        <div class="eq-panel">\
            <h4>ÉøÉÆÉ∫Ô∏ÉØ Ajuste de Som do Pared√£o (Frequ√™ncias)</h4>\
            <div class="eq-slider">\
                <span>ÉøÉ¥É™ Subwoofer / Grave:</span>\
                <input type="range" id="bassRange" min="-10" max="30" value="0" oninput="atualizarEqualizador()">\
            </div>\
            <div class="eq-slider">\
                <span>ÉøÉ≥ÉÇ Corneta / M√©dio:</span>\
                <input type="range" id="midRange" min="-10" max="20" value="0" oninput="atualizarEqualizador()">\
            </div>\
            <div class="eq-slider">\
                <span>‚É∫ÉÅ Tweeter / Agudo:</span>\
                <input type="range" id="trebleRange" min="-10" max="20" value="0" oninput="atualizarEqualizador()">\
            </div>\
            <div style="margin-top: 15px;">\
                <button id="btnGraveExtreme" class="btn-extreme" onclick="toggleGraveExtreme()">ÉøÉ¥É™ LIGAR GRAVE EXTREME</button>\
            </div>\
        </div>\
\
        <!-- CORES DOS ALTO-FALANTES -->\
        <div class="eq-panel">\
            <h4>ÉøÉ≥ÉÇ Cores dos Alto-Falantes / Pared√£o</h4>\
            <div class="color-group"><span>Cor do Subwoofer:</span><input type="color" value="#e67e22" onchange="mudarCor('--speaker-sub-color', this.value)"></div>\
            <div class="color-group"><span>Cor da Corneta:</span><input type="color" value="#e67e22" onchange="mudarCor('--speaker-horn-color', this.value)"></div>\
            <div class="color-group"><span>Cor do Tweeter:</span><input type="color" value="#e67e22" onchange="mudarCor('--speaker-tweet-color', this.value)"></div>\
        </div>\
\
        <!-- TIPO DE FUNDO (S√É≥LIDO / GLITTER / FOTO) -->\
        <div class="eq-panel">\
            <h4>ÉøÉ∂ºÔ∏ÉØ Personaliza√ß√£o do Fundo</h4>\
            <div class="eq-slider">\
                <span>Estilo do Fundo:</span>\
                <select id="tipoFundo" onchange="alterarTipoFundo(this.value)">\
                    <option value="solido">Cor S√≥lida</option>\
                    <option value="glitter">Glitter Animado</option>\
                    <option value="foto">Foto / URL de Imagem</option>\
                </select>\
            </div>\
            <div class="color-group" id="groupCorFundo">\
                <span>Cor do Fundo:</span>\
                <input type="color" value="#0a0b0e" onchange="mudarCor('--bg-color', this.value)">\
            </div>\
            <div id="groupFotoFundo" style="display: none; margin-top: 8px;">\
                <input type="text" id="urlFotoFundo" placeholder="Cole a URL da Foto de Fundo..." style="width:100%;">\
                <button onclick="aplicarFotoFundo()">Aplicar Foto</button>\
            </div>\
        </div>\
\
        <!-- CORES DO PIONEER -->\
        <div class="eq-panel">\
            <h4>ÉøÉÆ® Mudar Cores e Glow Pioneer</h4>\
            <div class="color-group"><span>Glow Pioneer (Brilho Neon):</span><input type="color" value="#00d4ff" onchange="mudarGlowDisplay(this.value)"></div>\
            <div class="color-group"><span>Cor dos Bot√µes:</span><input type="color" value="#00d4ff" onchange="mudarCor('--btn-bg', this.value)"></div>\
            <div class="color-group"><span>Cor do Texto / Display:</span><input type="color" value="#00d4ff" onchange="mudarCor('--text-color', this.value); mudarCor('--pioneer-blue', this.value)"></div>\
        </div>\
\
        <button onclick="logout()" style="background: #444; color: #fff;">Sair do Painel</button>\
    </div>\
\
    <script>\
        const socket = io();\
        let filaMusicas = [];\
        let listaEspera = [];\
        let indexAtual = 0;\
        let admAutenticado = false;\
        let abaPendente = '';\
\
        const audio = document.getElementById('audioElement');\
        document.getElementById('urlRadio').value = window.location.href;\
\
        // PROCESSAMENTO DE √ÅUDIO REALTIME\
        let audioCtx, source, bassNode, midNode, trebleNode, extremeBassNode;\
        let graveExtremeAtivo = false;\
\
        function initAudioContext() {\
            if (!audioCtx) {\
                audioCtx = new (window.AudioContext || window.webkitAudioContext)();\
                source = audioCtx.createMediaElementSource(audio);\
\
                bassNode = audioCtx.createBiquadFilter();\
                bassNode.type = 'lowshelf';\
                bassNode.frequency.value = 180;\
\
                midNode = audioCtx.createBiquadFilter();\
                midNode.type = 'peaking';\
                midNode.frequency.value = 1000;\
\
                trebleNode = audioCtx.createBiquadFilter();\
                trebleNode.type = 'highshelf';\
                trebleNode.frequency.value = 3500;\
\
                extremeBassNode = audioCtx.createBiquadFilter();\
                extremeBassNode.type = 'lowshelf';\
                extremeBassNode.frequency.value = 70;\
\
                source.connect(bassNode);\
                bassNode.connect(midNode);\
                midNode.connect(trebleNode);\
                trebleNode.connect(extremeBassNode);\
                extremeBassNode.connect(audioCtx.destination);\
            }\
            if (audioCtx.state === 'suspended') {\
                audioCtx.resume();\
            }\
        }\
\
        function atualizarEqualizador() {\
            initAudioContext();\
            bassNode.gain.value = parseFloat(document.getElementById('bassRange').value);\
            midNode.gain.value = parseFloat(document.getElementById('midRange').value);\
            trebleNode.gain.value = parseFloat(document.getElementById('trebleRange').value);\
        }\
\
        function toggleGraveExtreme() {\
            initAudioContext();\
            graveExtremeAtivo = !graveExtremeAtivo;\
            const btn = document.getElementById('btnGraveExtreme');\
            if (graveExtremeAtivo) {\
                extremeBassNode.gain.value = 35;\
                bassNode.gain.value = 25;\
                btn.innerText = "ÉøÉ≤• GRAVE EXTREME: LIGADO ÉøÉ¥•";\
                btn.classList.add('active');\
            } else {\
                extremeBassNode.gain.value = 0;\
                btn.innerText = "ÉøÉ¥É™ LIGAR GRAVE EXTREME";\
                btn.classList.remove('active');\
                atualizarEqualizador();\
            }\
        }\
\
        // NAVEGA√Éß√É£O E INTERFACE\
        function toggleGearMenu() {\
            const menu = document.getElementById('gearMenu');\
            menu.style.display = (menu.style.display === 'block') ? 'none' : 'block';\
        }\
\
        function verAba(aba) {\
            document.getElementById('abaOuvinte').style.display = (aba === 'ouvinte') ? 'block' : 'none';\
            document.getElementById('abaAdm').style.display = (aba === 'adm') ? 'block' : 'none';\
            document.getElementById('abaCustom').style.display = (aba === 'custom') ? 'block' : 'none';\
        }\
\
        function solicitarAcesso(aba) {\
            if (admAutenticado) { verAba(aba); } \
            else { abaPendente = aba; document.getElementById('modalLogin').style.display = 'block'; }\
        }\
\
        function validarLogin() {\
            const e = document.getElementById('loginEmail').value;\
            const p = document.getElementById('loginPass').value;\
            if (e && p) { admAutenticado = true; document.getElementById('modalLogin').style.display = 'none'; verAba(abaPendente); }\
            else { alert('Informe e-mail e senha!'); }\
        }\
\
        function cancelarLogin() { document.getElementById('modalLogin').style.display = 'none'; }\
        function logout() { admAutenticado = false; verAba('ouvinte'); }\
        function copiarLink() { navigator.clipboard.writeText(window.location.href); alert('Link Copiado!'); }\
\
        // GERENCIAMENTO DA FILA COM NUMERA√Éß√É£O VIS√É≠VEL\
        function carregarMp3Locais() {\
            const files = document.getElementById('fileInput').files;\
            for (let file of files) {\
                const url = URL.createObjectURL(file);\
                filaMusicas.push({ nome: file.name, url: url });\
            }\
            atualizarFilas();\
            if (audio.paused && filaMusicas.length > 0) tocarMusicaIndex(0);\
        }\
\
        function enviarPedidoPublico() {\
            const input = document.getElementById('linkMusicaOuvinte');\
            if (input.value.trim() !== '') {\
                listaEspera.push({ nome: "Pedido: " + input.value, url: input.value });\
                input.value = '';\
                atualizarFilas();\
                alert('Pedido enviado ao DJ!');\
            }\
        }\
\
        function aprovarPedido(i) {\
            filaMusicas.push(listaEspera[i]);\
            listaEspera.splice(i, 1);\
            atualizarFilas();\
        }\
\
        function moverMusica(index, direcao) {\
            let novoIndex = index + direcao;\
            if (novoIndex >= 0 && novoIndex < filaMusicas.length) {\
                let temp = filaMusicas[index];\
                filaMusicas[index] = filaMusicas[novoIndex];\
                filaMusicas[novoIndex] = temp;\
                if (indexAtual === index) indexAtual = novoIndex;\
                else if (indexAtual === novoIndex) indexAtual = index;\
                atualizarFilas();\
            }\
        }\
\
        function removerMusica(index) {\
            filaMusicas.splice(index, 1);\
            if (indexAtual >= filaMusicas.length) indexAtual = filaMusicas.length - 1;\
            atualizarFilas();\
        }\
\
        function atualizarFilas() {\
            const olOuvinte = document.getElementById('filaOuvinte');\
            const olAdm = document.getElementById('filaAdm');\
            const ulEspera = document.getElementById('listaEspera');\
\
            olOuvinte.innerHTML = '';\
            olAdm.innerHTML = '';\
            ulEspera.innerHTML = '';\
\
            filaMusicas.forEach((m, idx) => {\
                let numero = idx + 1;\
                let emExecucao = (idx === indexAtual) ? " ‚É∂∂Ô∏ÉØ (TOCANDO)" : "";\
                \
                // Numera√ß√£o expl√≠cita em n√∫meros\
                olOuvinte.innerHTML += `<li><span class="song-title"><b>${numero}.</b> ${m.nome}${emExecucao}</span></li>`;\
\
                olAdm.innerHTML += `\
                    <li>\
                        <span class="song-title"><b>${numero}.</b> ${m.nome}</span>\
                        <div>\
                            <button class="btn-small" onclick="moverMusica(${idx}, -1)">‚¨É¶Ô∏ÉØ</button>\
                            <button class="btn-small" onclick="moverMusica(${idx}, 1)">‚¨ÉßÔ∏ÉØ</button>\
                            <button class="btn-small btn-danger" onclick="removerMusica(${idx})">‚ÉΩÉ¨</button>\
                        </div>\
                    </li>`;\
            });\
\
            listaEspera.forEach((m, idx) => {\
                ulEspera.innerHTML += `\
                    <li>\
                        <span class="song-title">${m.nome}</span>\
                        <button class="btn-small" onclick="aprovarPedido(${idx})">‚ÉºÉ• Aceitar</button>\
                    </li>`;\
            });\
        }\
\
        function tocarMusicaIndex(idx) {\
            if (filaMusicas.length > 0 && idx >= 0 && idx < filaMusicas.length) {\
                initAudioContext();\
                indexAtual = idx;\
                audio.src = filaMusicas[idx].url;\
                audio.play();\
                document.getElementById('status').innerText = "TOCANDO: " + filaMusicas[idx].nome;\
                atualizarFilas();\
            }\
        }\
\
        function proximaMusica() { if (indexAtual + 1 < filaMusicas.length) tocarMusicaIndex(indexAtual + 1); }\
        function voltarMusica() { if (indexAtual - 1 >= 0) tocarMusicaIndex(indexAtual - 1); }\
        function pausarEPlay() {\
            initAudioContext();\
            if (audio.paused) { audio.play(); } else { audio.pause(); }\
        }\
        function limparFila() { filaMusicas = []; atualizarFilas(); }\
\
        // PERSONALIZA√Éß√É£O DE CORES E FUNDO\
        function mudarCor(varCss, val) { document.documentElement.style.setProperty(varCss, val); }\
        function mudarGlowDisplay(cor) { document.documentElement.style.setProperty('--pioneer-glow', cor + '66'); }\
\
        function alterarTipoFundo(tipo) {\
            document.body.classList.remove('glitter-bg');\
            document.getElementById('groupCorFundo').style.display = (tipo === 'solido') ? 'flex' : 'none';\
            document.getElementById('groupFotoFundo').style.display = (tipo === 'foto') ? 'block' : 'none';\
\
            if (tipo === 'glitter') {\
                document.body.classList.add('glitter-bg');\
            } else if (tipo === 'solido') {\
                mudarCor('--bg-image', 'none');\
            }\
        }\
\
        function aplicarFotoFundo() {\
            const url = document.getElementById('urlFotoFundo').value.trim();\
            if (url) {\
                mudarCor('--bg-image', `url('${url}')`);\
                alert('Foto de fundo aplicada!');\
            }\
        }\
\
        audio.onended = function() { proximaMusica(); };\
    </script>\
</body>\
</html>\
EOF\

