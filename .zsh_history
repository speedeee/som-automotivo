<!DOCTYPE html>\
<html lang="pt-BR">\
<head>\
    <meta charset="UTF-8">\
    <meta name="viewport" content="width=device-width, initial-scale=1.0">\
    <title>‚É∫ÉÅ SPEED R√ÅDIO DJ PRO</title>\
    <script src="/socket.io/socket.io.js"></script>\
    <script src="https://www.youtube.com/iframe_api"></script>\
    <style>\
        :root { --bg-color: #121212; --card-color: #1e1e1e; --primary-color: #ffcc00; --stage-light: #ffcc00; }\
        body { background: var(--bg-color); color: #fff; font-family: sans-serif; text-align: center; padding: 15px; margin: 0; }\
        .card { background: var(--card-color); padding: 20px; border-radius: 12px; max-width: 500px; margin: 0 auto 15px auto; border-top: 5px solid var(--stage-light); box-shadow: 0 0 20px rgba(0,0,0,0.8); }\
        .box-link { background: rgba(255,255,255,0.05); border: 2px dashed var(--primary-color); border-radius: 8px; padding: 10px; margin: 10px 0; }\
        .box-link input { width: 90%; text-align: center; font-size: 11px; background: #000; color: #fff; border: 1px solid #444; padding: 6px; border-radius: 5px; }\
        input[type="text"], input[type="email"], input[type="password"] { width: 85%; padding: 10px; border-radius: 5px; border: 1px solid #444; background: #222; color: #fff; margin-bottom: 10px; box-sizing: border-box; }\
        button { padding: 10px 14px; border-radius: 6px; border: none; background: var(--primary-color); color: #000; font-weight: bold; cursor: pointer; margin: 3px; }\
        .btn-danger { background: #e74c3c; color: #fff; }\
        .btn-warning { background: #f39c12; color: #fff; }\
        .btn-fx { background: #9b59b6; color: #fff; font-size: 11px; padding: 8px; }\
        .btn-control { background: #333; color: #fff; font-size: 16px; padding: 8px 15px; border: 1px solid #555; }\
        \
        .vu-container { display: flex; justify-content: center; align-items: flex-end; gap: 4px; height: 30px; background: #000; padding: 5px; border-radius: 5px; margin: 10px 0; }\
        .vu-bar { width: 8%; background: #333; height: 10%; border-radius: 2px; }\
        \
        .light-controls { display: flex; justify-content: center; gap: 5px; margin: 10px 0; }\
        .color-btn { width: 25px; height: 25px; border-radius: 50%; border: 2px solid #fff; cursor: pointer; }\
        \
        #ytPlayerContainer { position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; border-radius: 8px; background: #000; margin-top: 10px; }\
        #ytPlayerContainer iframe, #audioLocal { position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 0; }\
        ol { text-align: left; background: rgba(255,255,255,0.05); padding: 15px 30px; border-radius: 5px; max-height: 150px; overflow-y: auto; }\
        li { font-size: 13px; margin-bottom: 6px; border-bottom: 1px solid #333; padding-bottom: 4px; word-break: break-all; }\
        .controls-bar { margin: 12px 0; display: flex; justify-content: center; gap: 8px; }\
    </style>\
</head>\
<body>\
\
    <div>\
        <button id="btnTabOuvinte" onclick="verAba('ouvinte')">ÉøÉ≥ª Player Ouvinte</button>\
        <button id="btnTabAdm" onclick="verAba('adm')">ÉøÉÆÉªÔ∏ÉØ Mesa de DJ / ADM</button>\
    </div>\
\
    <!-- PLAYER OUVINTE -->\
    <div id="abaOuvinte" class="card">\
        <h1 style="margin: 5px 0; color: var(--stage-light);">‚É∫ÉÅ SPEED R√ÅDIO</h1>\
        \
        <div class="box-link">\
            <input type="text" id="urlRadio" readonly>\
            <br><br>\
            <button onclick="copiarLink()">ÉøÉ≥É´ Copiar Link</button>\
        </div>\
\
        <div class="vu-container" id="vuMeter">\
            <div class="vu-bar"></div><div class="vu-bar"></div><div class="vu-bar"></div>\
            <div class="vu-bar"></div><div class="vu-bar"></div><div class="vu-bar"></div>\
            <div class="vu-bar"></div><div class="vu-bar"></div><div class="vu-bar"></div>\
        </div>\
\
        <p id="status">Status: Pronto</p>\
\
        <div id="ytPlayerContainer">\
            <div id="player"></div>\
            <audio id="audioLocal" controls style="display:none;"></audio>\
        </div>\
\
        <!-- CONTROLES NATIVOS DO PLAYER -->\
        <div class="controls-bar">\
            <button class="btn-control" onclick="voltarMusica()">‚ÉØÆÔ∏ÉØ Voltar</button>\
            <button class="btn-control" onclick="pausarEPlay()">‚ÉØØÔ∏ÉØ Play/Pause</button>\
            <button class="btn-control" onclick="proximaMusica()">‚ÉØ≠Ô∏ÉØ Avan√ßar</button>\
        </div>\
\
        <h3>ÉøÉÆµ Pedir M√∫sica (YouTube / YMusic / Link)</h3>\
        <input type="text" id="linkMusicaOuvinte" placeholder="Cole o link aqui...">\
        <button onclick="adicionarMusicaWeb()">‚ÉæÉµ Enviar Fila</button>\
\
        <h3>ÉøÉ≥Éº Fila de Reprodu√ß√£o</h3>\
        <ol id="filaOuvinte"></ol>\
    </div>\
\
    <!-- MESA DE DJ / ADM -->\
    <div id="abaAdm" class="card" style="display: none;">\
        <h2>ÉøÉÆÉªÔ∏ÉØ Mesa de Som & Mixagem DJ</h2>\
\
        <div id="areaLogin">\
            <input type="email" id="loginEmail" placeholder="E-mail ADM">\
            <input type="password" id="loginPass" placeholder="Senha ADM">\
            <button onclick="fazerLogin()">Acessar Mesa</button>\
        </div>\
\
        <div id="areaDj" style="display: none;">\
            <h3>ÉøÉ≤ÉÅ Luzes de Palco</h3>\
            <div class="light-controls">\
                <div class="color-btn" style="background:#ffcc00" onclick="mudarCor('#ffcc00')"></div>\
                <div class="color-btn" style="background:#00e5ff" onclick="mudarCor('#00e5ff')"></div>\
                <div class="color-btn" style="background:#ff0055" onclick="mudarCor('#ff0055')"></div>\
                <div class="color-btn" style="background:#00ff66" onclick="mudarCor('#00ff66')"></div>\
            </div>\
\
            <!-- ADICIONAR M√É∫LTIPLOS MP3 DO CELULAR -->\
            <div style="background: rgba(255,255,255,0.05); padding: 12px; border-radius: 8px; margin: 10px 0;">\
                <h3>ÉøÉ≥Å Selecionar MP3 do Celular (V√ÉÅrias M√∫sicas)</h3>\
                <input type="file" id="fileInput" accept="audio/*" multiple style="font-size: 11px; margin-bottom: 8px;">\
                <br>\
                <button onclick="carregarMp3Locais()" style="background: #2ecc71; color: #fff;">‚ÉæÉµ Adicionar Todas na Fila</button>\
            </div>\
\
            <div style="background: rgba(255,255,255,0.05); padding: 10px; border-radius: 8px; margin: 10px 0;">\
                <h3>ÉøÉ¥É™ Efeitos DJ</h3>\
                <button class="btn-fx" onclick="tocarEfeito('airhorn')">ÉøÉ≥Ø Cornetada</button>\
                <button class="btn-fx" onclick="tocarEfeito('scratch')">ÉøÉÆß Scratch</button>\
                <button class="btn-fx" onclick="tocarEfeito('drop')">ÉøÉ≤• Bass Drop</button>\
            </div>\
\
            <button onclick="proximaMusica()" class="btn-warning">‚ÉØ≠Ô∏ÉØ Pular Atual</button>\
            <button onclick="limparFila()" class="btn-danger">ÉøÉ∑É±Ô∏ÉØ Limpar Fila</button>\
\
            <h3>ÉøÉ≥Éº Fila no Painel:</h3>\
            <ol id="filaAdm"></ol>\
            <br>\
            <button onclick="logout()" style="background: #444; color: #fff;">Sair</button>\
        </div>\
    </div>\
\
    <script>\
        const socket = io();\
        let ytPlayer;\
        let playlistLocal = [];\
        let historico = [];\
        let indexAtual = -1;\
        let corAtual = '#ffcc00';\
        const audioLocal = document.getElementById('audioLocal');\
\
        document.getElementById('urlRadio').value = window.location.href;\
\
        function extrairIdYoutube(url) {\
            if (!url) return null;\
            let regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|\&v=)([^#\&\?]*).*/;\
            let match = url.match(regExp);\
            return (match && match[2].length === 11) ? match[2] : url;\
        }\
\
        function onYouTubeIframeAPIReady() {\
            ytPlayer = new YT.Player('player', {\
                height: '100%', width: '100%',\
                playerVars: { 'autoplay': 1, 'controls': 1, 'origin': window.location.origin },\
                events: { 'onStateChange': (e) => { if (e.data === 0) proximaMusica(); } }\
            });\
        }\
\
        audioLocal.onended = () => { proximaMusica(); };\
\
        // ADICIONAR M√É∫LTIPLOS MP3 DO CELULAR\
        function carregarMp3Locais() {\
            const files = document.getElementById('fileInput').files;\
            if (files.length > 0) {\
                for (let i = 0; i < files.length; i++) {\
                    let file = files[i];\
                    playlistLocal.push({\
                        tipo: 'local',\
                        nome: file.name,\
                        url: URL.createObjectURL(file)\
                    });\
                }\
                atualizarExibicaoFila();\
                if (indexAtual === -1) proximaMusica();\
                alert(`${files.length} m√∫sica(s) adicionada(s) √ÉÄ fila!`);\
            }\
        }\
\
        function adicionarMusicaWeb() {\
            const input = document.getElementById('linkMusicaOuvinte');\
            if (input.value) {\
                playlistLocal.push({\
                    tipo: 'web',\
                    nome: input.value,\
                    url: input.value\
                });\
                input.value = '';\
                atualizarExibicaoFila();\
                if (indexAtual === -1) proximaMusica();\
            }\
        }\
\
        function tocarItem(item) {\
            if (!item) return;\
            document.getElementById('status').innerText = 'Tocando: ' + item.nome;\
\
            if (item.tipo === 'local') {\
                if (ytPlayer?.stopVideo) ytPlayer.stopVideo();\
                document.getElementById('ytPlayerContainer').querySelector('iframe').style.display = 'none';\
                audioLocal.style.display = 'block';\
                audioLocal.src = item.url;\
                audioLocal.play();\
            } else {\
                audioLocal.pause();\
                audioLocal.style.display = 'none';\
                document.getElementById('ytPlayerContainer').querySelector('iframe').style.display = 'block';\
                let id = extrairIdYoutube(item.url);\
                if (ytPlayer?.loadVideoById) ytPlayer.loadVideoById(id);\
            }\
        }\
\
        function proximaMusica() {\
            if (indexAtual < playlistLocal.length - 1) {\
                indexAtual++;\
                tocarItem(playlistLocal[indexAtual]);\
                atualizarExibicaoFila();\
            }\
        }\
\
        function voltarMusica() {\
            if (indexAtual > 0) {\
                indexAtual--;\
                tocarItem(playlistLocal[indexAtual]);\
                atualizarExibicaoFila();\
            }\
        }\
\
        function pausarEPlay() {\
            const item = playlistLocal[indexAtual];\
            if (!item) return;\
            if (item.tipo === 'local') {\
                audioLocal.paused ? audioLocal.play() : audioLocal.pause();\
            } else if (ytPlayer) {\
                let state = ytPlayer.getPlayerState();\
                state === 1 ? ytPlayer.pauseVideo() : ytPlayer.playVideo();\
            }\
        }\
\
        function atualizarExibicaoFila() {\
            const htmlFila = playlistLocal.map((m, i) => {\
                let estilo = i === indexAtual ? 'style="color: var(--stage-light); font-weight: bold;"' : '';\
                return `<li ${estilo}>${m.nome} ${i === indexAtual ? '‚É∂∂' : ''}</li>`;\
            }).join('');\
            \
            document.getElementById('filaOuvinte').innerHTML = htmlFila;\
            document.getElementById('filaAdm').innerHTML = htmlFila;\
        }\
\
        function limparFila() {\
            playlistLocal = [];\
            indexAtual = -1;\
            audioLocal.pause();\
            if (ytPlayer?.stopVideo) ytPlayer.stopVideo();\
            document.getElementById('status').innerText = 'Fila limpa';\
            atualizarExibicaoFila();\
        }\
\
        // VU METER ANIMADO\
        setInterval(() => {\
            const bars = document.querySelectorAll('.vu-bar');\
            const tocando = !audioLocal.paused || (ytPlayer && ytPlayer.getPlayerState && ytPlayer.getPlayerState() === 1);\
            bars.forEach((bar) => {\
                if (tocando) {\
                    let lvl = Math.floor(Math.random() * 85) + 15;\
                    bar.style.height = lvl + '%';\
                    bar.style.background = lvl > 75 ? '#ff0055' : corAtual;\
                } else {\
                    bar.style.height = '10%';\
                    bar.style.background = '#333';\
                }\
            });\
        }, 120);\
\
        function tocarEfeito(tipo) {\
            let ctx = new (window.AudioContext || window.webkitAudioContext)();\
            let osc = ctx.createOscillator();\
            let gain = ctx.createGain();\
            osc.connect(gain);\
            gain.connect(ctx.destination);\
            \
            if (tipo === 'airhorn') {\
                osc.frequency.setValueAtTime(400, ctx.currentTime);\
                osc.frequency.exponentialRampToValueAtTime(800, ctx.currentTime + 0.3);\
            } else if (tipo === 'scratch') {\
                osc.type = 'sawtooth';\
                osc.frequency.setValueAtTime(1200, ctx.currentTime);\
                osc.frequency.linearRampToValueAtTime(200, ctx.currentTime + 0.15);\
            } else {\
                osc.type = 'triangle';\
                osc.frequency.setValueAtTime(150, ctx.currentTime);\
                osc.frequency.exponentialRampToValueAtTime(30, ctx.currentTime + 0.5);\
            }\
            osc.start();\
            osc.stop(ctx.currentTime + 0.4);\
        }\
\
        function mudarCor(cor) {\
            corAtual = cor;\
            document.documentElement.style.setProperty('--stage-light', cor);\
            document.documentElement.style.setProperty('--primary-color', cor);\
        }\
\
        function verAba(aba) {\
            document.getElementById('abaOuvinte').style.display = aba === 'ouvinte' ? 'block' : 'none';\
            document.getElementById('abaAdm').style.display = aba === 'adm' ? 'block' : 'none';\
        }\
\
        function copiarLink() {\
            navigator.clipboard.writeText(document.getElementById('urlRadio').value);\
            alert('Link copiado!');\
        }\
\
        function fazerLogin() {\
            const email = document.getElementById('loginEmail').value;\
            const pass = document.getElementById('loginPass').value;\
            fetch('/api/login', {\
                method: 'POST',\
                headers: { 'Content-Type': 'application/json' },\
                body: JSON.stringify({ email, pass })\
            }).then(r => r.json()).then(d => {\
                if (d.success) {\
                    document.getElementById('areaLogin').style.display = 'none';\
                    document.getElementById('areaDj').style.display = 'block';\
                } else alert('E-mail ou senha incorretos!');\
            });\
        }\
\
        function logout() { location.reload(); }\
    </script>\
</body>\
</html>\
EOF\

