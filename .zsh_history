    \
    .woofer { width: 90px; height: 90px; border-radius: 50%; background: radial-gradient(circle, #222 30%, #111 70%, #444 100%); border: 5px solid #333; display: flex; justify-content: center; align-items: center; box-shadow: 0 0 10px rgba(0,0,0,0.8); transition: transform 0.05s ease; }\
    .woofer-inner { width: 35px; height: 35px; border-radius: 50%; background: #050505; border: 2px solid #555; }\
    .horn { width: 40px; height: 40px; background: #222; border: 2px solid #888; display: flex; justify-content: center; align-items: center; color: #aaa; font-size: 0.65rem; font-weight: bold; }\
    .horn.square { border-radius: 4px; }\
    .horn.round { border-radius: 50%; }\
\
    .vibrating { animation: beat 0.15s infinite alternate ease-in-out; }\
    @keyframes beat {\
      0% { transform: scale(1); }\
      100% { transform: scale(1.15); box-shadow: 0 0 18px rgba(255, 51, 102, 0.8); }\
    }\
\
    button { width: 100%; padding: 12px; background: linear-gradient(45deg, #ff3366, #ff6533); border: none; border-radius: 6px; color: #fff; font-weight: bold; cursor: pointer; margin-top: 8px; font-size: 0.9rem; }\
    .output-box { background: #0f121a; border: 1px solid #00d2ff; border-radius: 8px; padding: 15px; white-space: pre-wrap; font-family: monospace; font-size: 0.8rem; color: #00ffcc; margin-top: 10px; }\
    \
    .player-controls { background: #111520; padding: 12px; border-radius: 8px; border: 1px solid #00d2ff; margin-top: 10px; }\
    .vol-slider { width: 100%; margin-top: 5px; }\
  </style>\
</head>\
<body>\
  <div class="container">\
    <h1>ÉøÉ¥É™ SIMULADOR & CONFIGURADOR DE SOM PRO</h1>\
\
    <div class="section">\
      <h2>ÉøÉ≥ÉΩ Digite o que seu som tem (Montagem Autom√ÉÅtica)</h2>\
      <label>Escreva seus equipamentos:</label>\
      <textarea id="customPrompt" placeholder="Ex: Tenho 2 Target Bass de 15, 4 cornetas quadradas, bateria de 150A..."></textarea>\
      <button onclick="interpretarTexto()">‚Éº® MONTAR E CONFIGURAR AUTOMATICAMENTE</button>\
    </div>\
\
    <div class="section">\
      <h2>1. Componentes e Caixas</h2>\
      <div class="grid">\
        <div>\
          <label>Player Central:</label>\
          <select id="player">\
            <option>Pioneer MVH-X3000BR (Graves Xtreme)</option>\
            <option>Stetsom Player Bluetooth</option>\
            <option>Expert Electronics Central</option>\
            <option>Alpine / Kenwood High-End</option>\
          </select>\
        </div>\
        <div>\
          <label>Tamanho do Woofer:</label>\
          <select id="wooferSize" onchange="atualizarPalco()">\
            <option value="12">12" (Grave Seco)</option>\
            <option value="15" selected>15" (Grave Misto / Pared√£o)</option>\
            <option value="18">18" (Subgrave Profundo)</option>\
          </select>\
        </div>\
        <div>\
          <label>Qtd de Woofers:</label>\
          <input type="number" id="wooferQty" value="2" min="1" max="6" onchange="atualizarPalco()">\
        </div>\
        <div>\
          <label>Pot√™ncia RMS por Falante:</label>\
          <input type="number" id="wooferRms" value="1500">\
        </div>\
      </div>\
    </div>\
\
    <div class="section">\
      <h2>2. Drivers e Ilumina√ß√£o</h2>\
      <div class="grid">\
        <div>\
          <label>Formato Corneta:</label>\
          <select id="hornFormat" onchange="atualizarPalco()"><option value="round">Redonda</option><option value="square">Quadrada</option></select>\
        </div>\
        <div>\
          <label>Material Corneta:</label>\
          <select id="hornMaterial"><option>Alum√≠nio</option><option>Pl√ÉÅstico ABS</option></select>\
        </div>\
        <div>\
          <label>Cor Neon RGB:</label>\
          <input type="color" id="neonColor" value="#00d2ff" onchange="atualizarPalco()">\
        </div>\
      </div>\
    </div>\
\
    <div class="sound-stage" id="stage">\
      <p style="font-size:0.75rem; color:#aaa;">PALCO VIRTUAL DO SOM AUTOMOTIVO</p>\
      <div class="speakers-container" id="speakersBox"></div>\
      <p id="barStatus" style="margin-top:10px; font-weight:bold; color:#00ffcc;">Barramento: 12.6V [Est√ÉÅvel]</p>\
    </div>\
\
    <div class="section">\
      <h2>ÉøÉ≥ª Player de M√∫sica & Regulagem de Grave Xtreme</h2>\
      <div class="player-controls">\
        <label>ÉøÉ≥Å Carregar M√∫sicas do Seu Celular (.mp3/.wav):</label>\
        <input type="file" id="audioFile" accept="audio/*" onchange="carregarAudioLocal(event)">\
        \
        <label style="margin-top:10px;">ÉøÉ¥É∑ Ou Cole o Link de uma M√∫sica Online:</label>\
        <input type="text" id="audioUrl" placeholder="https://exemplo.com/musica.mp3">\
        <button onclick="carregarAudioUrl()" style="background:#00d2ff; color:#000;">Tocar Link</button>\
\
        <audio id="mainAudio" style="width:100%; margin-top:10px;" controls></audio>\
\
        <div style="margin-top:10px;">\
          <label>ÉøÉ¥• Regulagem de Grave Xtreme no Player (Bass Boost):</label>\
          <input type="range" class="vol-slider" id="bassBoost" min="0" max="20" value="5" oninput="ajustarBass(this.value)">\
          <span id="bassValue">N√≠vel Grave Xtreme: +5 dB</span>\
        </div>\
      </div>\
    </div>\
\
    <button onclick="gerarProjeto()">‚É∫ÉÅ CALCULAR TUDO & GERAR SCRIPT COMPLETO</button>\
\
    <div class="section" style="margin-top:15px;">\
      <h2>ÉøÉ≥É™ Script de Montagem, El√©trica e DSP</h2>\
      <div class="output-box" id="relatorioOutput">Clique no bot√£o acima para gerar a configura√ß√£o...</div>\
    </div>\
  </div>\
\
  <script>\
    let audioCtx, source, bassFilter;\
\
    function atualizarPalco() {\
      const qty = parseInt(document.getElementById('wooferQty').value) || 2;\
      const size = document.getElementById('wooferSize').value;\
      const format = document.getElementById('hornFormat').value;\
      const color = document.getElementById('neonColor').value;\
      \
      const stage = document.getElementById('stage');\
      const container = document.getElementById('speakersBox');\
      stage.style.borderColor = color;\
      stage.style.boxShadow = '0 0 15px ' + color + '88';\
\
      container.innerHTML = '';\
\
      for(let i=0; i<2; i++) {\
        const horn = document.createElement('div');\
        horn.className = 'horn ' + format;\
        horn.innerText = 'DRIVER';\
        container.appendChild(horn);\
      }\
\
      for(let i=0; i<qty; i++) {\
        const w = document.createElement('div');\
        w.className = 'woofer';\
        w.style.width = size == '18' ? '110px' : (size == '15' ? '90px' : '75px');\
        w.style.height = w.style.width;\
        w.innerHTML = '<div class="woofer-inner"></div>';\
        container.appendChild(w);\
      }\
    }\
\
    function carregarAudioLocal(e) {\
      const file = e.target.files[0];\
      if (file) {\
        const audio = document.getElementById('mainAudio');\
        audio.src = URL.createObjectURL(file);\
        conectarAudioContext(audio);\
        audio.play();\
        ativarBatida();\
      }\
    }\
\
    function carregarAudioUrl() {\
      const url = document.getElementById('audioUrl').value;\
      if (url) {\
        const audio = document.getElementById('mainAudio');\
        audio.src = url;\
        conectarAudioContext(audio);\
        audio.play();\
        ativarBatida();\
      }\
    }\
\
    function conectarAudioContext(audioElement) {\
      if (!audioCtx) {\
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();\
        source = audioCtx.createMediaElementSource(audioElement);\
        bassFilter = audioCtx.createBiquadFilter();\
        bassFilter.type = 'lowshelf';\
        bassFilter.frequency.value = 100;\
        bassFilter.gain.value = 5;\
\
        source.connect(bassFilter);\
        bassFilter.connect(audioCtx.destination);\
      }\
    }\
\
    function ajustarBass(val) {\
      document.getElementById('bassValue').innerText = 'N√≠vel Grave Xtreme: +' + val + ' dB';\
      if (bassFilter) bassFilter.gain.value = val;\
    }\
\
    function ativarBatida() {\
      const woofers = document.querySelectorAll('.woofer');\
      const audio = document.getElementById('mainAudio');\
      \
      audio.onplay = () => {\
        woofers.forEach(w => w.classList.add('vibrating'));\
        document.getElementById('barStatus').innerText = 'Barramento: 12.1V [Consumindo Graves]';\
      };\
      audio.onpause = () => {\
        woofers.forEach(w => w.classList.remove('vibrating'));\
        document.getElementById('barStatus').innerText = 'Barramento: 12.6V [Est√ÉÅvel]';\
      };\
    }\
\
    function interpretarTexto() {\
      const txt = document.getElementById('customPrompt').value.toLowerCase();\
      if (!txt) return;\
\
      if (txt.includes('18')) document.getElementById('wooferSize').value = '18';\
      else if (txt.includes('12')) document.getElementById('wooferSize').value = '12';\
      else document.getElementById('wooferSize').value = '15';\
\
      if (txt.includes('quadrada')) document.getElementById('hornFormat').value = 'square';\
      else document.getElementById('hornFormat').value = 'round';\
\
      atualizarPalco();\
      gerarProjeto();\
    }\
\
    function gerarProjeto() {\
      const p = document.getElementById('player').value;\
      const size = document.getElementById('wooferSize').value;\
      const qty = parseInt(document.getElementById('wooferQty').value) || 2;\
      const rms = parseInt(document.getElementById('wooferRms').value) || 1500;\
      const fmt = document.getElementById('hornFormat').value;\
      const mat = document.getElementById('hornMaterial').value;\
\
      const totalRms = (qty * rms) + 800;\
      const batAh = Math.round(totalRms / 20);\
      const cabo = totalRms <= 3000 ? "35mm¬≤" : "50mm¬≤";\
      const disj = totalRms <= 3000 ? "150A" : "200A";\
\
      document.getElementById('relatorioOutput').textContent = \
"=======================================================\n" +\
"ÉøÉªÉÄÔ∏ÉØ PROJETO DE SOM AUTOMOTIVO - RELAT√É≥RIO COMPLETO\n" +\
"=======================================================\n\n" +\
"ÉøÉ≥ª UNIDADE CENTRAL & EQUALIZA√Éß√É£O:\n" +\
"  ‚ÄÉÇ Player: " + p + "\n" +\
"  ‚ÄÉÇ Regulagem Grave Xtreme: Ativada (+5dB a +12dB em 60Hz)\n\n" +\
"ÉøÉ¥É™ CAIXA TRIO / PARED√É£O:\n" +\
"  ‚ÄÉÇ Woofers: " + qty + "x Falante(s) de " + size + '" (' + rms + "W RMS cada)\n" +\
"  ‚ÄÉÇ Cornetas: Drivers em Cornetas " + (fmt === 'square' ? 'Quadradas' : 'Redondas') + " de " + mat + "\n\n" +\
"ÉøÉÆÉªÔ∏ÉØ CORTE DE FREQU√É™NCIAS NO PROCESSADOR (DSP):\n" +\
"  ‚ÄÉÇ CANAL 1 (Woofers " + size + '"): HPF 40Hz (BT24) | LPF 200Hz (BT24)\n' +\
"  ‚ÄÉÇ CANAL 2 (M√©dio 8"/10"): HPF 200Hz (BT24) | LPF 1200Hz (BT24)\n' +\
"  ‚ÄÉÇ CANAL 3 (Cornetas " + mat + "): HPF 1200Hz (BT24) | LPF 5000Hz (BT24)\n" +\
"  ‚ÄÉÇ CANAL 4 (Super Tweeters): HPF 5000Hz (BT24) | LPF 20000Hz (BT24)\n\n" +\
"‚É∫ÉÅ SISTEMA EL√É©TRICO, BARRAMENTO E FIA√Éß√É£O (~" + totalRms + "W RMS Total):\n" +\
"  ‚ÄÉÇ Bateria Auxiliar M√≠nima: " + batAh + " Ah (AGM / Estacion√ÉÅria)\n" +\
"  ‚ÄÉÇ Fonte Automotiva      : " + Math.round(batAh * 0.8) + "A a " + batAh + "A\n" +\
"  ‚ÄÉÇ Barramento            : Barra de Cobre Maci√ßo (Positivo e Aterramento)\n" +\
"  ‚ÄÉÇ Bitola de Cabos       : " + cabo + " (100% Cobre)\n" +\
"  ‚ÄÉÇ Fus√≠vel/Disjuntor     : " + disj + " no cofre da bateria principal";\
    }\
\
    atualizarPalco();\
  </script>\
</body>\
</html>\
EOF\
