    .playlist-box { margin-top: 12px; background: #0a0c10; border: 1px solid #232838; border-radius: 6px; padding: 10px; max-height: 180px; overflow-y: auto; }\
    .playlist-box ol { padding-left: 20px; }\
    .playlist-box li { font-size: 0.85rem; color: #94a3b8; padding: 6px; border-radius: 4px; cursor: pointer; margin-bottom: 4px; background: #131722; list-style-position: inside; }\
    .playlist-box li:hover { background: #1a1f2c; color: #00d2ff; }\
