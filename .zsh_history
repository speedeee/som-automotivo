            menu.style.display = (menu.style.display === 'block') ? 'none' : 'block';\
        }\
\
        function solicitarAcesso(aba) {\
            if (admAutenticado) {\
                verAba(aba);\
            } else {\
                abaPendente = aba;\
                document.getElementById('modalLogin').style.display = 'block';\
                document.getElementById('gearMenu').style.display = 'none';\
            }\
        }\
\
        function validarLogin() {\
            const email = document.getElementById('loginEmail').value;\
            const pass = document.getElementById('loginPass').value;\
            if (email === "admin@speed.com" && pass === "1234") {\
                admAutenticado = true;\
                document.getElementById('modalLogin').style.display = 'none';\
                verAba(abaPendente);\
            } else {\
                alert("E-mail ou Senha incorretos!");\
            }\
        }\
\
        function cancelarLogin() {\
            document.getElementById('modalLogin').style.display = 'none';\
        }\
\
        function logout() {\
            admAutenticado = false;\
            verAba('abaOuvinte');\
        }\
\
        function verAba(abaId) {\
            document.getElementById('abaOuvinte').style.display = 'none';\
            document.getElementById('abaAdm').style.display = 'none';\
            document.getElementById('abaCustom').style.display = 'none';\
            document.getElementById(abaId).style.display = 'block';\
            document.getElementById('gearMenu').style.display = 'none';\
        }\
\
        function copiarLink() {\
            const input = document.getElementById('urlRadio');\
            input.select();\
            document.execCommand('copy');\
            alert('Link copiado!');\
        }\
\
        function desbloquearAudio() {\
            if (!audioCtx) {\
                initAudioContext();\
            } else if (audioCtx.state === 'suspended') {\
                audioCtx.resume();\
            }\
        }\
\
        function initAudioContext() {\
            audioCtx = new (window.AudioContext || window.webkitAudioContext)();\
            source = audioCtx.createMediaElementSource(audio);\
            analyser = audioCtx.createAnalyser();\
            analyser.fftSize = 256;\
\
            bassNode = audioCtx.createBiquadFilter();\
            bassNode.type = 'lowshelf';\
            bassNode.frequency.value = 180;\
\
            midNode = audioCtx.createBiquadFilter();\
            midNode.type = 'peaking';\
            midNode.frequency.value = 1000;\
\
            trebleNode = audioCtx.createBiquadFilter();\
            trebleNode.type = 'highshelf';\
            trebleNode.frequency.value = 3500;\
\
            extremeBassNode = audioCtx.createBiquadFilter();\
            extremeBassNode.type = 'lowshelf';\
            extremeBassNode.frequency.value = 70;\
\
            source.connect(bassNode);\
            bassNode.connect(midNode);\
            midNode.connect(trebleNode);\
            trebleNode.connect(extremeBassNode);\
            extremeBassNode.connect(analyser);\
            analyser.connect(audioCtx.destination);\
\
            renderFrame();\
        }\
\
        function renderFrame() {\
            requestAnimationFrame(renderFrame);\
            if (!analyser) return;\
\
            const bufferLength = analyser.frequencyBinCount;\
            const dataArray = new Uint8Array(bufferLength);\
            analyser.getByteFrequencyData(dataArray);\
\
            let bassSum = 0;\
            for (let i = 0; i < 10; i++) bassSum += dataArray[i];\
            let bassAvg = bassSum / 10;\
\
            const subScale = 1 + (bassAvg / 255) * 0.25;\
            document.querySelectorAll('.subElem').forEach(el => {\
                el.style.transform = `scale(${subScale})`;\
            });\
\
            const paredao = document.getElementById('paredaoContainer');\
            if (bassAvg > 180) {\
                paredao.classList.add('shake-effect');\
            } else {\
                paredao.classList.remove('shake-effect');\
            }\
\
            ctx.clearRect(0, 0, canvas.width, canvas.height);\
            const barWidth = (canvas.width / bufferLength) * 2.5;\
            let x = 0;\
            for (let i = 0; i < bufferLength; i++) {\
                const barHeight = dataArray[i] / 5;\
                ctx.fillStyle = '#00d4ff';\
                ctx.fillRect(x, canvas.height - barHeight, barWidth, barHeight);\
                x += barWidth + 1;\
            }\
        }\
\
        function atualizarEqualizador() {\
            if (!audioCtx) return;\
            bassNode.gain.value = parseFloat(document.getElementById('bassRange').value);\
            midNode.gain.value = parseFloat(document.getElementById('midRange').value);\
            trebleNode.gain.value = parseFloat(document.getElementById('trebleRange').value);\
        }\
\
        function toggleGraveExtreme() {\
            if (!audioCtx) return;\
            graveExtremeAtivo = !graveExtremeAtivo;\
            const btn = document.getElementById('btnGraveExtreme');\
            if (graveExtremeAtivo) {\
                extremeBassNode.gain.value = 25;\
                btn.classList.add('active');\
                btn.innerText = "ÉøÉ≤• GRAVE EXTREME ATIVADO";\
            } else {\
                extremeBassNode.gain.value = 0;\
                btn.classList.remove('active');\
                btn.innerText = "ÉøÉ¥É™ LIGAR GRAVE EXTREME";\
            }\
        }\
\
        function mudarCor(variable, value) {\
            document.documentElement.style.setProperty(variable, value);\
        }\
\
        function enviarPedidoPublico() {\
            const input = document.getElementById('linkMusicaOuvinte');\
            if (input.value.trim() !== '') {\
                socket.emit('novoPedido', input.value.trim());\
                alert('Pedido enviado!');\
                input.value = '';\
            }\
        }\
\
        function carregarMp3Locais() {\
            const fileInput = document.getElementById('fileInput');\
            if (fileInput.files.length > 0) {\
                const file = fileInput.files[0];\
                const url = URL.createObjectURL(file);\
                audio.src = url;\
                audio.play();\
                alert('M√∫sica carregada e tocando!');\
            }\
        }\
    </script>\
</body>\
</html>\
EOF\

: 1786141897:0;pkg install tur-repo -y && pkg install qrencode -y\
cat << 'EOF' > $PREFIX/bin/radio\
#!/bin/bash\
clear\
pkill -9 -f node > /dev/null 2>&1\
pkill -9 -f cloudflared > /dev/null 2>&1\
sleep 1\
\
cd ~/minha-radio\
node server.js > /dev/null 2>&1 &\
sleep 2\
\
cloudflared tunnel --url http://127.0.0.1:3000 2>&1 | tee ~/.tunnel.log | grep --line-buffered -o 'https://[a-zA-Z0-9-]*\.trycloudflare\.com' | while read -r LINK; do\
    clear\
    echo "=================================================="\
    echo "         ‚É∫ÉÅ SPEED R√ÅDIO - ONLINE ‚É∫ÉÅ               "\
    echo "=================================================="\
    echo "ÉøÉ±É© LINK DIRETO:"\
    echo "   $LINK"\
    echo ""\
    echo "ÉøÉ±É© QR CODE PARA ESCANEAR:"\
    echo ""\
    qrencode -t UTF8 "$LINK" 2>/dev/null\
    echo "=================================================="\
    echo "Pressione CTRL + C para desligar."\
done\
EOF\
chmod +x $PREFIX/bin/radio\

: 1786141913:0;radio
: 1786142625:0;cat << 'EOF' > ~/minha-radio/public/index.html\
<!DOCTYPE html>\
<html lang="pt-BR">\
<head>\
    <meta charset="UTF-8">\
    <meta name="viewport" content="width=device-width, initial-scale=1.0">\
    <title>‚É∫ÉÅ SPEED R√ÅDIO - SAVEIRO PARED√É£O EDITION</title>\
    <script src="/socket.io/socket.io.js"></script>\
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>\
    <style>\
        :root { \
            --bg-color: #0a0b0e; \
            --bg-image: none;\
            --pioneer-frame-bg: linear-gradient(145deg, #1f232a, #0d0e12);\
            --pioneer-border: #2a2e38;\
            --pioneer-blue: #00d4ff; \
            --pioneer-glow: #00d4ff66;\
            --speaker-sub-color: #00d4ff;\
            --speaker-horn-color: #00d4ff;\
            --speaker-tweet-color: #00d4ff;\
            --btn-bg: #00d4ff;\
            --btn-text: #000000;\
            --text-color: #00d4ff;\
        }\
\
        body { \
            background-color: var(--bg-color); \
            background-image: var(--bg-image);\
            background-size: cover;\
            background-position: center;\
            background-attachment: fixed;\
            color: #fff; \
            font-family: 'Courier New', Courier, monospace; \
            text-align: center; \
            padding: 15px; \
            margin: 0; \
            transition: background 0.3s ease;\
        }\
\
        body.glitter-bg {\
            background-image: radial-gradient(circle, #ffffff 1px, transparent 1px), radial-gradient(circle, #ff007f 1px, transparent 1px), radial-gradient(circle, #00d4ff 1px, transparent 1px);\
            background-size: 20px 20px, 30px 30px, 15px 15px;\
            animation: glitterAnim 2s infinite linear;\
        }\
        @keyframes glitterAnim {\
            0% { background-position: 0 0, 10px 10px, 5px 5px; }\
            50% { background-position: 10px 20px, 20px 0px, 15px 10px; }\
            100% { background-position: 0 0, 10px 10px, 5px 5px; }\
        }\
\
        .gear-container { position: absolute; top: 15px; right: 15px; z-index: 1000; }\
        .gear-btn { background: #1f232a; border: 2px solid var(--pioneer-blue); color: #fff; padding: 8px 12px; border-radius: 50%; cursor: pointer; font-size: 18px; box-shadow: 0 0 10px var(--pioneer-glow); }\
        .gear-menu { display: none; position: absolute; right: 0; top: 45px; background: #111318; border: 2px solid var(--pioneer-blue); padding: 10px; border-radius: 10px; width: 220px; box-shadow: 0 8px 20px rgba(0,0,0,0.8); text-align: left; }\
        .gear-menu button { width: 100%; margin: 4px 0; text-align: left; font-size: 11px; padding: 8px; background: var(--btn-bg); color: var(--btn-text); border: none; border-radius: 5px; font-weight: bold; cursor: pointer; }\
\
        .pioneer-frame { background: var(--pioneer-frame-bg); border: 4px solid var(--pioneer-border); border-radius: 18px; padding: 20px; max-width: 650px; margin: 40px auto 15px auto; box-shadow: 0 10px 30px rgba(0,0,0,0.9); position: relative; }\
        .lcd-display { background: #00121a; border: 3px solid #002b3d; border-radius: 8px; padding: 12px; box-shadow: inset 0 0 15px var(--pioneer-glow), 0 0 10px var(--pioneer-glow); color: var(--text-color); margin-bottom: 15px; }\
\
        .wall-container-saveiro { \
            background: #08090c; border: 3px solid #1f232a; border-radius: 12px; padding: 12px 8px; margin: 15px 0; display: flex; flex-direction: column; gap: 12px; box-shadow: inset 0 0 20px #000;\
        }\
\
        .rack-top { display: flex; justify-content: space-around; align-items: center; background: #111318; padding: 8px; border-radius: 8px; border: 1px solid #222; }\
        .rack-bottom { display: flex; justify-content: space-around; align-items: center; background: #0d0e12; padding: 12px 5px; border-radius: 8px; border: 1px solid #222; }\
\
        .shake-effect { animation: tremor 0.05s infinite alternate; }\
        @keyframes tremor {\
            0% { transform: translate(1px, 1px) rotate(0deg); }\
            100% { transform: translate(-1px, -1px) rotate(-0.5deg); }\
        }\
\
        .subwoofer-saveiro { \
            width: 85px; height: 85px; background: radial-gradient(circle, #222 10%, #111 50%, #000 100%); border: 4px solid #333; border-radius: 50%; display: flex; justify-content: center; align-items: center; transition: transform 0.03s ease; box-shadow: 0 0 10px rgba(0,0,0,0.8);\
        }\
        .subwoofer-saveiro::before { \
            content: 'SDS'; font-size: 10px; font-weight: bold; color: #aaa; width: 50px; height: 50px; background: radial-gradient(circle, var(--speaker-sub-color) 15%, #111 90%); border-radius: 50%; border: 2px solid #000; box-shadow: inset 0 0 8px #000, 0 0 10px var(--speaker-sub-color); display: flex; align-items: center; justify-content: center;\
        }\
\
        .horn-saveiro { width: 50px; height: 50px; background: #15171c; border: 2px solid #333; border-radius: 50%; display: flex; justify-content: center; align-items: center; }\
        .horn-saveiro-inner { width: 34px; height: 34px; background: radial-gradient(circle, var(--speaker-horn-color) 10%, #000 80%); border-radius: 50%; border: 1px solid #444; box-shadow: 0 0 8px var(--speaker-horn-color); }\
\
        .tweeter-saveiro { width: 32px; height: 32px; background: #1a1a1a; border: 2px solid #444; border-radius: 6px; display: flex; justify-content: center; align-items: center; }\
        .tweeter-saveiro-core { width: 12px; height: 12px; background: var(--speaker-tweet-color); border-radius: 50%; box-shadow: 0 0 6px var(--speaker-tweet-color); }\
\
        .box-link { background: rgba(0, 212, 255, 0.05); border: 1px dashed var(--pioneer-blue); border-radius: 6px; padding: 10px; margin: 10px 0; display: flex; flex-direction: column; align-items: center; gap: 8px; }\
        .box-link input { width: 90%; text-align: center; font-size: 11px; background: #000; color: var(--text-color); border: 1px solid #005577; padding: 6px; }\
        \
        #qrcodeCanvas { background: #fff; padding: 8px; border-radius: 6px; margin-top: 5px; }\
\
        input[type="text"], input[type="email"], input[type="password"], select { width: 85%; padding: 8px; border-radius: 5px; border: 1px solid #005577; background: #00121a; color: #fff; margin-bottom: 8px; }\
        button { padding: 8px 12px; border-radius: 6px; border: none; background: var(--btn-bg); color: var(--btn-text); font-weight: bold; cursor: pointer; margin: 2px; }\
        .btn-power { background: #2ecc71; color: #fff; font-size: 14px; padding: 10px 20px; border-radius: 8px; font-weight: bold; width: 100%; margin-bottom: 10px; box-shadow: 0 0 10px #2ecc71; }\
        .btn-power.off { background: #e74c3c !important; box-shadow: 0 0 10px #e74c3c !important; }\
        .btn-danger { background: #e74c3c !important; color: #fff !important; }\
        .btn-success { background: #2ecc71 !important; color: #fff !important; }\
        .btn-extreme { background: #ff0055 !important; color: #fff !important; font-weight: bold; width: 100%; padding: 10px; }\
        .btn-extreme.active { background: #ff2a00 !important; box-shadow: 0 0 15px #ff2a00; }\
        .btn-small { padding: 4px 8px; font-size: 10px; margin: 0 2px; }\
\
        .visualizer-box { background: #00080d; border-radius: 5px; margin: 10px 0; border: 1px solid #003344; padding: 5px; }\
        canvas { width: 100%; height: 60px; display: block; }\
\
        .eq-panel { background: rgba(0,0,0,0.6); padding: 12px; border-radius: 8px; border: 1px solid #003344; margin: 10px 0; text-align: left; }\
        .eq-slider { display: flex; justify-content: space-between; align-items: center; margin: 10px 0; font-size: 12px; }\
        .eq-slider input { width: 55%; }\
\
        ol, ul { text-align: left; background: rgba(0, 212, 255, 0.05); padding: 10px; border-radius: 5px; max-height: 220px; overflow-y: auto; border: 1px solid #003344; color: var(--text-color); font-size: 12px; list-style: none; }\
        li { margin-bottom: 6px; border-bottom: 1px solid #002b3d; padding-bottom: 4px; display: flex; justify-content: space-between; align-items: center; gap: 8px; }\
        .song-title { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\
        .color-group { display: flex; align-items: center; justify-content: space-between; margin: 8px 0; font-size: 12px; }\
        .color-group input[type="color"] { border: none; width: 40px; height: 30px; cursor: pointer; background: none; }\
    </style>\
</head>\
<body onclick="desbloquearAudio()">\
\
    <!-- ENGRENAGEM -->\
    <div class="gear-container">\
        <button class="gear-btn" onclick="toggleGearMenu(event)">‚É∫ÉπÔ∏ÉØ</button>\
        <div id="gearMenu" class="gear-menu">\
            <button onclick="verAba('abaOuvinte')">ÉøÉ≥ª Display Pioneer (P√∫blico)</button>\
            <button onclick="solicitarAcesso('abaAdm')">ÉøÉÆÉªÔ∏ÉØ Mesa de DJ / ADM</button>\
            <button onclick="solicitarAcesso('abaCustom')">ÉøÉÆ® Edi√ß√£o de Display & Som</button>\
        </div>\
    </div>\
\
    <!-- LOGIN ADM -->\
    <div id="modalLogin" class="pioneer-frame" style="display:none; border-color: #ffcc00;">\
        <h3 style="color:#ffcc00;">ÉøÉ¥É≤ √Årea Restrita ADM</h3>\
        <input type="email" id="loginEmail" placeholder="E-mail ADM (admin@speed.com)">\
        <input type="password" id="loginPass" placeholder="Senha ADM (1234)">\
        <br>\
        <button onclick="validarLogin()">Acessar Painel</button>\
        <button onclick="cancelarLogin()" class="btn-danger">Cancelar</button>\
    </div>\
\
    <!-- ABA 1: OUVINTE -->\
    <div id="abaOuvinte" class="pioneer-frame">\
        <button id="btnPowerRadio" class="btn-power" onclick="toggleLigarRadio()">‚É∫ÉÅ LIGAR R√ÅDIO PARED√É£O</button>\
\
        <div class="lcd-display">\
            <h1 style="margin: 5px 0; font-size: 18px;">‚É∫ÉÅ SPEED R√ÅDIO</h1>\
            <p id="status" style="margin: 5px 0; font-size: 11px;">[DESLIGADO] CLIQUE EM LIGAR</p>\
            <div class="visualizer-box">\
                <canvas id="visualizerCanvas"></canvas>\
            </div>\
        </div>\
        \
        <div class="box-link">\
            <input type="text" id="urlRadio" readonly>\
            <button onclick="copiarLink()">ÉøÉ≥É´ Copiar Link da R√ÉÅdio</button>\
            <div id="qrcodeCanvas"></div>\
        </div>\
\
        <audio id="audioElement" controls crossorigin="anonymous" style="width:100%; margin: 10px 0;" onended="proximaMusica()"></audio>\
\
        <div class="wall-container-saveiro" id="paredaoContainer">\
            <div class="rack-top">\
                <div class="tweeter-saveiro"><div class="tweeter-saveiro-core"></div></div>\
                <div class="horn-saveiro"><div class="horn-saveiro-inner"></div></div>\
                <div class="horn-saveiro"><div class="horn-saveiro-inner"></div></div>\
                <div class="horn-saveiro"><div class="horn-saveiro-inner"></div></div>\
                <div class="horn-saveiro"><div class="horn-saveiro-inner"></div></div>\
                <div class="tweeter-saveiro"><div class="tweeter-saveiro-core"></div></div>\
            </div>\
            <div class="rack-bottom">\
                <div class="subwoofer-saveiro subElem"></div>\
                <div class="subwoofer-saveiro subElem"></div>\
                <div class="subwoofer-saveiro subElem"></div>\
            </div>\
        </div>\
\
        <h3>ÉøÉÆµ Pedir M√∫sica</h3>\
        <input type="text" id="linkMusicaOuvinte" placeholder="Cole o link MP3...">\
        <button onclick="enviarPedidoPublico()">‚ÉæÉµ Enviar para Aprova√ß√£o</button>\
\
        <h3>ÉøÉ≥Éº Fila Principal (Numerada)</h3>\
        <ol id="filaOuvinte"></ol>\
    </div>\
\
    <!-- ABA 2: MESA DE DJ / ADM -->\
    <div id="abaAdm" class="pioneer-frame" style="display: none;">\
        <h2>ÉøÉÆÉªÔ∏ÉØ Mesa de Som & Transmiss√£o DJ</h2>\
\
        <div style="margin: 15px 0;">\
            <button onclick="voltarMusica()">‚ÉØÆÔ∏ÉØ Voltar</button>\
            <button onclick="pausarEPlay()">‚ÉØØÔ∏ÉØ Play/Pause</button>\
            <button onclick="proximaMusica()">‚ÉØ≠Ô∏ÉØ Avan√ßar</button>\
        </div>\
\
        <div class="eq-panel">\
            <h4>ÉøÉ≥Å Adicionar √Åudios do Celular</h4>\
            <input type="file" id="fileInput" accept="audio/*" multiple style="font-size: 11px;">\
            <button onclick="carregarMp3Locais()">‚ÉæÉµ Inserir M√∫sicas</button>\
        </div>\
\
        <div class="eq-panel" style="border-color: #ffcc00;">\
            <h4 style="color: #ffcc00;">ÉøÉ≥• Pedidos do P√∫blico</h4>\
            <ul id="listaEspera"></ul>\
        </div>\
\
        <h4>ÉøÉ≥Éº Fila ADM (Organizar e Reordenar)</h4>\
        <ol id="filaAdm"></ol>\
\
        <button onclick="limparFila()" class="btn-danger">ÉøÉ∑É±Ô∏ÉØ Limpar Fila</button>\
        <br><br>\
        <button onclick="logout()" style="background: #444; color: #fff;">Sair do Painel</button>\
    </div>\
\
    <!-- ABA 3: EDI√Éß√É£O DE DISPLAY & SOM -->\
    <div id="abaCustom" class="pioneer-frame" style="display: none;">\
        <h2>ÉøÉÆ® Edi√ß√£o de Display & Som</h2>\
\
        <div class="eq-panel">\
            <h4>ÉøÉ≥É™ Estilo do Visualizador de √Åudio</h4>\
            <div class="eq-slider">\
                <span>Modo de Display:</span>\
                <select id="selectVisualizer" onchange="mudarEstiloVisualizer(this.value)">\
                    <option value="bars">Barras LED (Pioneer Cl√ÉÅssico)</option>\
                    <option value="wave">Onda Oscilosc√≥pio</option>\
                    <option value="radial">Espectro Radial Neon</option>\
                </select>\
            </div>\
        </div>\
\
        <div class="eq-panel">\
            <h4>ÉøÉÆÉ∫Ô∏ÉØ Ajuste de Som do Pared√£o</h4>\
            <div class="eq-slider"><span>ÉøÉ¥É™ Subwoofer / Grave:</span><input type="range" id="bassRange" min="-10" max="30" value="0" oninput="atualizarEqualizador()"></div>\
            <div class="eq-slider"><span>ÉøÉ≥ÉÇ Corneta / M√©dio:</span><input type="range" id="midRange" min="-10" max="20" value="0" oninput="atualizarEqualizador()"></div>\
            <div class="eq-slider"><span>‚É∫ÉÅ Tweeter / Agudo:</span><input type="range" id="trebleRange" min="-10" max="20" value="0" oninput="atualizarEqualizador()"></div>\
            <button id="btnGraveExtreme" class="btn-extreme" onclick="toggleGraveExtreme()">ÉøÉ¥É™ LIGAR GRAVE EXTREME</button>\
        </div>\
\
        <div class="eq-panel">\
            <h4>ÉøÉ≥ÉÇ Cores do Pared√£o</h4>\
            <div class="color-group"><span>Cor do Subwoofer:</span><input type="color" value="#00d4ff" onchange="mudarCor('--speaker-sub-color', this.value)"></div>\
            <div class="color-group"><span>Cor da Corneta:</span><input type="color" value="#00d4ff" onchange="mudarCor('--speaker-horn-color', this.value)"></div>\
            <div class="color-group"><span>Cor do Tweeter:</span><input type="color" value="#00d4ff" onchange="mudarCor('--speaker-tweet-color', this.value)"></div>\
        </div>\
\
        <div class="eq-panel">\
            <h4>ÉøÉ∂ºÔ∏ÉØ Personaliza√ß√£o do Fundo</h4>\
            <div class="eq-slider">\
                <span>Estilo do Fundo:</span>\
                <select id="tipoFundo" onchange="alterarTipoFundo(this.value)">\
                    <option value="solido">Cor S√≥lida</option>\
                    <option value="glitter">Glitter Animado</option>\
                    <option value="foto">Foto / URL de Imagem</option>\
                </select>\
            </div>\
            <div class="color-group" id="groupCorFundo">\
                <span>Cor do Fundo:</span>\
                <input type="color" value="#0a0b0e" onchange="mudarCor('--bg-color', this.value)">\
            </div>\
            <div id="groupFotoFundo" style="display: none; margin-top: 8px;">\
                <input type="text" id="urlFotoFundo" placeholder="Cole a URL da Imagem..." style="width:100%;">\
                <button onclick="aplicarFotoFundo()">Aplicar Foto</button>\
            </div>\
        </div>\
\
        <button onclick="logout()" style="background: #444; color: #fff;">Sair do Painel</button>\
    </div>\
\
    <script>\
        const socket = io();\
        let filaMusicas = [];\
        let listaEspera = [];\
        let indexAtual = 0;\
        let admAutenticado = false;\
        let abaPendente = '';\
        let visualizerMode = 'bars';\
        let radioLigada = false;\
\
        const audio = document.getElementById('audioElement');\
        const canvas = document.getElementById('visualizerCanvas');\
        const ctx = canvas.getContext('2d');\
\
        // GERA√Éß√É£O AUTOM√ÅTICA DO QR CODE DA R√ÅDIO NO NAVEGADOR\
        window.onload = () => {\
            const currentUrl = window.location.href;\
            document.getElementById('urlRadio').value = currentUrl;\
            new QRCode(document.getElementById("qrcodeCanvas"), {\
                text: currentUrl,\
                width: 120,\
                height: 120,\
                colorDark: "#000000",\
                colorLight: "#ffffff"\
            });\
        };\
\
        let audioCtx, source, analyser, bassNode, midNode, trebleNode, extremeBassNode;\
        let graveExtremeAtivo = false;\
\
        function toggleLigarRadio() {\
            radioLigada = !radioLigada;\
            const btn = document.getElementById('btnPowerRadio');\
            const status = document.getElementById('status');\
\
            if (radioLigada) {\
                btn.innerText = "ÉøÉªÉ± DESLIGAR R√ÅDIO PARED√É£O";\
                btn.classList.add('off');\
                status.innerText = "[ONLINE] PARED√É£O PRONTO PARA TOCAR";\
                desbloquearAudio();\
                if (filaMusicas.length > 0) audio.play();\
            } else {\
                btn.innerText = "‚É∫ÉÅ LIGAR R√ÅDIO PARED√É£O";\
                btn.classList.remove('off');\
                status.innerText = "[DESLIGADO] R√ÅDIO EM STANDBY";\
                audio.pause();\
            }\
        }\
\
        function toggleGearMenu(e) {\
            e.stopPropagation();\
            const menu = document.getElementById('gearMenu');\
            menu.style.display = (menu.style.display === 'block') ? 'none' : 'block';\
        }\
\
        function solicitarAcesso(aba) {\
            if (admAutenticado) {\
                verAba(aba);\
            } else {\
                abaPendente = aba;\
                document.getElementById('modalLogin').style.display = 'block';\
                document.getElementById('gearMenu').style.display = 'none';\
            }\
        }\
\
        function validarLogin() {\
            const email = document.getElementById('loginEmail').value;\
            const pass = document.getElementById('loginPass').value;\
            if (email === "admin@speed.com" && pass === "1234") {\
                admAutenticado = true;\
                document.getElementById('modalLogin').style.display = 'none';\
                verAba(abaPendente);\
            } else {\
                alert("E-mail ou Senha incorretos!");\
            }\
        }\
\
        function cancelarLogin() {\
            document.getElementById('modalLogin').style.display = 'none';\
        }\
\
        function logout() {\
            admAutenticado = false;\
            verAba('abaOuvinte');\
        }\
\
        function verAba(abaId) {\
            document.getElementById('abaOuvinte').style.display = 'none';\
            document.getElementById('abaAdm').style.display = 'none';\
            document.getElementById('abaCustom').style.display = 'none';\
            document.getElementById(abaId).style.display = 'block';\
            document.getElementById('gearMenu').style.display = 'none';\
        }\
\
        function copiarLink() {\
            const input = document.getElementById('urlRadio');\
            input.select();\
            document.execCommand('copy');\
            alert('Link da r√ÉÅdio copiado!');\
        }\
\
        function desbloquearAudio() {\
            if (!audioCtx) {\
                initAudioContext();\
            } else if (audioCtx.state === 'suspended') {\
                audioCtx.resume();\
            }\
        }\
\
        function initAudioContext() {\
            audioCtx = new (window.AudioContext || window.webkitAudioContext)();\
            source = audioCtx.createMediaElementSource(audio);\
            analyser = audioCtx.createAnalyser();\
            analyser.fftSize = 256;\
\
            bassNode = audioCtx.createBiquadFilter();\
            bassNode.type = 'lowshelf';\
            bassNode.frequency.value = 180;\
\
            midNode = audioCtx.createBiquadFilter();\
            midNode.type = 'peaking';\
            midNode.frequency.value = 1000;\
\
            trebleNode = audioCtx.createBiquadFilter();\
            trebleNode.type = 'highshelf';\
            trebleNode.frequency.value = 3500;\
\
            extremeBassNode = audioCtx.createBiquadFilter();\
            extremeBassNode.type = 'lowshelf';\
            extremeBassNode.frequency.value = 70;\
\
            source.connect(bassNode);\
            bassNode.connect(midNode);\
            midNode.connect(trebleNode);\
            trebleNode.connect(extremeBassNode);\
            extremeBassNode.connect(analyser);\
            analyser.connect(audioCtx.destination);\
\
            renderFrame();\
        }\
\
        function renderFrame() {\
            requestAnimationFrame(renderFrame);\
            if (!analyser || !radioLigada) return;\
\
            const bufferLength = analyser.frequencyBinCount;\
            const dataArray = new Uint8Array(bufferLength);\
            analyser.getByteFrequencyData(dataArray);\
\
            let bassSum = 0;\
            for (let i = 0; i < 10; i++) bassSum += dataArray[i];\
            let bassAvg = bassSum / 10;\
\
            const subScale = 1 + (bassAvg / 255) * 0.25;\
            document.querySelectorAll('.subElem').forEach(el => {\
                el.style.transform = `scale(${subScale})`;\
            });\
\
            const paredao = document.getElementById('paredaoContainer');\
            if (bassAvg > 180) {\
                paredao.classList.add('shake-effect');\
            } else {\
                paredao.classList.remove('shake-effect');\
            }\
\
            ctx.clearRect(0, 0, canvas.width, canvas.height);\
\
            if (visualizerMode === 'bars') {\
                const barWidth = (canvas.width / bufferLength) * 2.5;\
                let x = 0;\
                for (let i = 0; i < bufferLength; i++) {\
                    const barHeight = dataArray[i] / 4;\
                    ctx.fillStyle = '#00d4ff';\
                    ctx.fillRect(x, canvas.height - barHeight, barWidth, barHeight);\
                    x += barWidth + 1;\
                }\
            } else if (visualizerMode === 'wave') {\
                ctx.beginPath();\
                ctx.lineWidth = 2;\
                ctx.strokeStyle = '#00d4ff';\
                const sliceWidth = canvas.width / bufferLength;\
                let x = 0;\
                for (let i = 0; i < bufferLength; i++) {\
                    const v = dataArray[i] / 128.0;\
                    const y = (v * canvas.height) / 2;\
                    if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);\
                    x += sliceWidth;\
                }\
                ctx.stroke();\
            } else if (visualizerMode === 'radial') {\
                const centerX = canvas.width / 2;\
                const centerY = canvas.height / 2;\
                const radius = 15;\
                for (let i = 0; i < bufferLength; i += 2) {\
                    const rad = (i * Math.PI) / (bufferLength / 2);\
                    const barLen = dataArray[i] / 8;\
                    const x1 = centerX + Math.cos(rad) * radius;\
                    const y1 = centerY + Math.sin(rad) * radius;\
                    const x2 = centerX + Math.cos(rad) * (radius + barLen);\
                    const y2 = centerY + Math.sin(rad) * (radius + barLen);\
                    ctx.strokeStyle = '#00d4ff';\
                    ctx.beginPath();\
                    ctx.moveTo(x1, y1);\
                    ctx.lineTo(x2, y2);\
                    ctx.stroke();\
                }\
            }\
        }\
\
        function carregarMp3Locais() {\
            const fileInput = document.getElementById('fileInput');\
            if (fileInput.files.length > 0) {\
                for (let i = 0; i < fileInput.files.length; i++) {\
                    const file = fileInput.files[i];\
                    const url = URL.createObjectURL(file);\
                    filaMusicas.push({ nome: file.name, url: url });\
                }\
                atualizarFila();\
                if (audio.paused && filaMusicas.length > 0 && radioLigada) {\
                    tocarMusica(indexAtual);\
                }\
                alert('M√∫sicas adicionadas!');\
            }\
        }\
\
        function tocarMusica(index) {\
            if (index >= 0 && index < filaMusicas.length) {\
                indexAtual = index;\
                audio.src = filaMusicas[indexAtual].url;\
                if (radioLigada) audio.play();\
                document.getElementById('status').innerText = "TOCANDO: " + filaMusicas[indexAtual].nome;\
                atualizarFila();\
            }\
        }\
\
        function pausarEPlay() {\
            if (audio.paused && radioLigada) audio.play(); else audio.pause();\
        }\
\
        function proximaMusica() {\
            if (indexAtual + 1 < filaMusicas.length) {\
                tocarMusica(indexAtual + 1);\
            }\
        }\
\
        function voltarMusica() {\
            if (indexAtual - 1 >= 0) {\
                tocarMusica(indexAtual - 1);\
            }\
        }\
\
        function moverParaCima(i) {\
            if (i > 0) {\
                const temp = filaMusicas[i];\
                filaMusicas[i] = filaMusicas[i - 1];\
                filaMusicas[i - 1] = temp;\
                atualizarFila();\
            }\
        }\
\
        function moverParaBaixo(i) {\
            if (i < filaMusicas.length - 1) {\
                const temp = filaMusicas[i];\
                filaMusicas[i] = filaMusicas[i + 1];\
                filaMusicas[i + 1] = temp;\
                atualizarFila();\
            }\
        }\
\
        function removerMusica(i) {\
            filaMusicas.splice(i, 1);\
            atualizarFila();\
        }\
\
        function limparFila() {\
            filaMusicas = [];\
            audio.pause();\
            audio.src = "";\
            document.getElementById('status').innerText = "[PRONTO] ADICIONE M√É∫SICAS";\
            atualizarFila();\
        }\
\
        function atualizarFila() {\
            const listaOuvinte = document.getElementById('filaOuvinte');\
            const listaAdm = document.getElementById('filaAdm');\
            listaOuvinte.innerHTML = '';\
            listaAdm.innerHTML = '';\
\
            filaMusicas.forEach((m, i) => {\
                const ativo = (i === indexAtual) ? 'style="color:#00ff88; font-weight:bold;"' : '';\
                listaOuvinte.innerHTML += `<li ${ativo}><span class="song-title">${i + 1}. ${m.nome}</span></li>`;\
\
                listaAdm.innerHTML += `\
                    <li ${ativo}>\
                        <span class="song-title">${i + 1}. ${m.nome}</span>\
                        <div>\
                            <button class="btn-small" onclick="tocarMusica(${i})">‚É∂∂Ô∏ÉØ</button>\
                            <button class="btn-small" onclick="moverParaCima(${i})">‚¨É¶Ô∏ÉØ</button>\
                            <button class="btn-small" onclick="moverParaBaixo(${i})">‚¨ÉßÔ∏ÉØ</button>\
                            <button class="btn-small btn-danger" onclick="removerMusica(${i})">‚ÉΩÉ¨</button>\
                        </div>\
                    </li>`;\
            });\
        }\
\
        function enviarPedidoPublico() {\
            const input = document.getElementById('linkMusicaOuvinte');\
            if (input.value.trim() !== '') {\
                socket.emit('novoPedido', input.value.trim());\
                alert('Pedido enviado!');\
                input.value = '';\
            }\
        }\
\
        socket.on('receberPedido', (url) => {\
            listaEspera.push(url);\
            atualizarListaEspera();\
        });\
\
        function atualizarListaEspera() {\
            const ul = document.getElementById('listaEspera');\
            ul.innerHTML = '';\
            listaEspera.forEach((url, i) => {\
                ul.innerHTML += `\
                    <li>\
                        <span class="song-title">${url}</span>\
                        <div>\
                            <button class="btn-small btn-success" onclick="aprovarPedido(${i})">‚ÉºÉ• Aprovar</button>\
                            <button class="btn-small btn-danger" onclick="recusarPedido(${i})">‚ÉΩÉ¨ Recusar</button>\
                        </div>\
                    </li>`;\
            });\
        }\
\
        function aprovarPedido(i) {\
            filaMusicas.push({ nome: "Pedido do P√∫blico", url: listaEspera[i] });\
            listaEspera.splice(i, 1);\
            atualizarListaEspera();\
            atualizarFila();\
        }\
\
        function recusarPedido(i) {\
            listaEspera.splice(i, 1);\
            atualizarListaEspera();\
        }\
\
        function mudarEstiloVisualizer(val) { visualizerMode = val; }\
        function atualizarEqualizador() {\
            if (!audioCtx) return;\
            bassNode.gain.value = parseFloat(document.getElementById('bassRange').value);\
            midNode.gain.value = parseFloat(document.getElementById('midRange').value);\
            trebleNode.gain.value = parseFloat(document.getElementById('trebleRange').value);\
        }\
        function toggleGraveExtreme() {\
            if (!audioCtx) return;\
            graveExtremeAtivo = !graveExtremeAtivo;\
            const btn = document.getElementById('btnGraveExtreme');\
            if (graveExtremeAtivo) {\
                extremeBassNode.gain.value = 25;\
                btn.classList.add('active');\
                btn.innerText = "ÉøÉ≤• GRAVE EXTREME ATIVADO";\
            } else {\
                extremeBassNode.gain.value = 0;\
                btn.classList.remove('active');\
                btn.innerText = "ÉøÉ¥É™ LIGAR GRAVE EXTREME";\
            }\
        }\
        function mudarCor(variable, value) { document.documentElement.style.setProperty(variable, value); }\
        function alterarTipoFundo(val) {\
            document.body.className = '';\
            document.body.style.backgroundImage = 'none';\
            document.getElementById('groupCorFundo').style.display = 'none';\
            document.getElementById('groupFotoFundo').style.display = 'none';\
\
            if (val === 'solido') document.getElementById('groupCorFundo').style.display = 'flex';\
            if (val === 'glitter') document.body.classList.add('glitter-bg');\
            if (val === 'foto') document.getElementById('groupFotoFundo').style.display = 'block';\
        }\
        function aplicarFotoFundo() {\
            const url = document.getElementById('urlFotoFundo').value;\
            if (url) document.body.style.backgroundImage = `url('${url}')`;\
        }\
    </script>\
</body>\
</html>\
EOF\

