: 1786114830:0;cat << 'EOF' > public/index.html\
<!DOCTYPE html>\
<html lang="pt-BR">\
<head>\
    <meta charset="UTF-8">\
    <meta name="viewport" content="width=device-width, initial-scale=1.0">\
    <title>ÉøÉ≥ª R√ÉÅdio Web Sincronizada</title>\
    <script src="/socket.io/socket.io.js"></script>\
    <style>\
        body { background: #121212; color: #fff; font-family: sans-serif; text-align: center; padding: 20px; }\
        .card { background: #1e1e1e; padding: 20px; border-radius: 10px; max-width: 450px; margin: 0 auto; }\
        \
        /* Quadrado de aviso do Link */\
        .box-link {\
            background: #282828;\
            border: 2px dashed #1db954;\
            border-radius: 8px;\
            padding: 15px;\
            margin: 15px 0;\
        }\
        .box-link p { margin: 0 0 8px 0; font-weight: bold; color: #1db954; }\
        .box-link input { width: 90%; text-align: center; font-size: 12px; background: #121212; color: #fff; border: 1px solid #444; padding: 8px; border-radius: 5px; }\
\
        input[type="text"] { width: 80%; padding: 10px; border-radius: 5px; border: none; margin-bottom: 10px; }\
        button { padding: 10px 15px; border-radius: 5px; border: none; background: #1db954; color: #fff; font-weight: bold; cursor: pointer; margin: 3px; }\
        audio { width: 100%; margin-top: 15px; }\
        ul { text-align: left; background: #2a2a2a; padding: 15px 30px; border-radius: 5px; }\
    </style>\
</head>\
<body>\
    <div class="card">\
        <h1>ÉøÉ≥ª Minha R√ÉÅdio Web</h1>\
\
        <!-- Quadrado com Aviso e Link -->\
        <div class="box-link">\
            <p>ÉøÉ≥ÉÇ LINK OFICIAL DA R√ÅDIO</p>\
            <input type="text" id="urlRadio" readonly>\
            <br><br>\
            <button onclick="copiarLink()">ÉøÉ≥É´ Copiar Link da R√ÉÅdio</button>\
        </div>\
        \
        <p id="status">Tocando: Nenhuma m√∫sica na fila</p>\
        <audio id="player" controls autoplay></audio>\
\
        <hr style="margin: 20px 0; border-color: #333;">\
\
        <h3>‚ÉæÉµ Adicionar M√∫sica (Link MP3)</h3>\
        <input type="text" id="linkMusica" placeholder="Cole a URL do √ÉÅudio (.mp3)">\
        <button onclick="adicionar()">Adicionar √ÉÄ Fila</button>\
        <br>\
        <button onclick="pular()" style="background: #e74c3c;">‚ÉØ≠Ô∏ÉØ Pular M√∫sica</button>\
\
        <h3>ÉøÉ≥Éº Pr√≥ximas M√∫sicas</h3>\
        <ul id="fila"></ul>\
    </div>\
\
    <script>\
        const socket = io();\
        const player = document.getElementById('player');\
        const status = document.getElementById('status');\
        const fila = document.getElementById('fila');\
\
        // Mostra o link atual no quadrado automaticamente\
        document.getElementById('urlRadio').value = window.location.href;\
\
        function copiarLink() {\
            const input = document.getElementById('urlRadio');\
            input.select();\
            navigator.clipboard.writeText(input.value);\
            alert('Link da r√ÉÅdio copiado com sucesso!');\
        }\
\
        socket.on('novaMusica', (data) => {\
            if (data && data.musica) {\
                status.innerText = 'Tocando: ' + data.musica;\
                player.src = data.musica;\
                player.currentTime = data.tempoDecorrido;\
                player.play().catch(() => console.log("Interaja com a p√ÉÅgina para tocar"));\
            } else {\
                status.innerText = 'Tocando: Nenhuma m√∫sica na fila';\
                player.src = '';\
            }\
        });\
\
        socket.on('atualizarFila', (lista) => {\
            fila.innerHTML = '';\
            lista.forEach((item, index) => {\
                fila.innerHTML += `<li>${index + 1}. ${item}</li>`;\
            });\
        });\
\
        function adicionar() {\
            const input = document.getElementById('linkMusica');\
            if (input.value.trim() !== '') {\
                socket.emit('adicionarMusica', input.value.trim());\
                input.value = '';\
            }\
        }\
\
        function pular() {\
            socket.emit('proximaMusica');\
        }\
    </script>\
</body>\
</html>\
EOF\

