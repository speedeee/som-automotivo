import os\
\
html_content = '''<!DOCTYPE html>\
<html lang="pt-BR">\
<head>\
  <meta charset="UTF-8">\
  <meta name="viewport" content="width=device-width, initial-scale=1.0">\
  <title>Configurador de Som Automotivo & DSP</title>\
  <style>\
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: sans-serif; }\
    body { background-color: #0f1117; color: #e1e7ef; padding: 20px; display: flex; justify-content: center; }\
    .container { max-width: 800px; width: 100%; background: #161922; padding: 20px; border-radius: 12px; border: 1px solid #2a2f3d; }\
    h1 { text-align: center; color: #ff3366; margin-bottom: 20px; font-size: 1.5rem; }\
    .section { background: #1f2430; padding: 15px; border-radius: 8px; margin-bottom: 15px; border-left: 4px solid #ff3366; }\
    .section h2 { color: #00d2ff; font-size: 1.1rem; margin-bottom: 10px; }\
    .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 10px; }\
    label { display: block; font-size: 0.8rem; color: #a0aec0; margin-bottom: 4px; }\
    select, input { width: 100%; padding: 8px; border-radius: 6px; border: 1px solid #3a4254; background: #12151e; color: #fff; }\
    .preview-box { background: #0a0c10; padding: 15px; text-align: center; margin-top: 10px; border-radius: 8px; border: 2px solid #00d2ff; }\
    button { width: 100%; padding: 12px; background: linear-gradient(45deg, #ff3366, #ff6533); border: none; border-radius: 6px; color: #fff; font-weight: bold; cursor: pointer; margin-top: 10px; }\
    .output-box { background: #12151e; border: 1px solid #00d2ff; border-radius: 8px; padding: 15px; white-space: pre-wrap; font-family: monospace; font-size: 0.85rem; color: #00ffcc; margin-top: 10px; }\
  </style>\
</head>\
<body>\
  <div class="container">\
    <h1>ÉøÉ¥É™ CONFIGURADOR DE SOM AUTOMOTIVO</h1>\
    \
    <div class="section">\
      <h2>1. Componentes da Caixa</h2>\
      <div class="grid">\
        <div>\
          <label>Player:</label>\
          <select id="player">\
            <option>Pioneer MVH-X3000BR</option>\
            <option>Stetsom Player BT</option>\
            <option>Expert Central</option>\
          </select>\
        </div>\
        <div>\
          <label>Tamanho do Woofer:</label>\
          <select id="wooferSize">\
            <option value="12">12" (Grave R√ÉÅpido)</option>\
            <option value="15" selected>15" (Grave Misto / Pared√£o)</option>\
            <option value="18">18" (Subgrave Profundo)</option>\
          </select>\
        </div>\
        <div>\
          <label>Quantidade de Woofers:</label>\
          <input type="number" id="wooferQty" value="2">\
        </div>\
        <div>\
          <label>Pot√™ncia RMS (Por Falante):</label>\
          <input type="number" id="wooferRms" value="1500">\
        </div>\
      </div>\
    </div>\
\
    <div class="section">\
      <h2>2. Drivers, Cornetas e Neon</h2>\
      <div class="grid">\
        <div>\
          <label>Formato Corneta:</label>\
          <select id="hornFormat"><option>Redonda</option><option>Quadrada</option></select>\
        </div>\
        <div>\
          <label>Material Corneta:</label>\
          <select id="hornMaterial"><option>Alum√≠nio</option><option>Pl√ÉÅstico ABS</option></select>\
        </div>\
        <div>\
          <label>Cor Neon RGB:</label>\
          <input type="color" id="neonColor" value="#00d2ff">\
        </div>\
      </div>\
      <div class="preview-box" id="neonPreview">\
