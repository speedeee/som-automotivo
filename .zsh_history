: 1786115551:0;cat << 'EOF' > server.js\
import express from 'express';\
import { createServer } from 'http';\
import { Server } from 'socket.io';\
\
const app = express();\
const server = createServer(app);\
const io = new Server(server, { maxHttpBufferSize: 1e8 });\
\
app.use(express.static('public'));\
app.use(express.json());\
\
// Dados de Login\
const ADMIN_USER = 'fabiojr074@gmail.com';\
const ADMIN_PASS = 'Deus777';\
\
let playlist = [];\
let musicaAtual = null;\
let tempoInicioMusica = 0;\
let locucaoAoVivo = false;\
\
app.post('/api/login', (req, res) => {\
  const { email, password } = req.body;\
  if (email === ADMIN_USER && password === ADMIN_PASS) {\
    return res.json({ success: true, token: 'session_admin_active' });\
  }\
  return res.status(401).json({ success: false, message: 'Credenciais inv√ÉÅlidas!' });\
});\
\
setInterval(() => {\
  if (!musicaAtual && playlist.length > 0 && !locucaoAoVivo) {\
    musicaAtual = playlist.shift();\
    tempoInicioMusica = Date.now();\
    io.emit('novaMusica', { musica: musicaAtual, tempoDecorrido: 0 });\
    io.emit('atualizarFila', playlist);\
  }\
}, 1000);\
\
io.on('connection', (socket) => {\
  if (musicaAtual) {\
    const tempoDecorrido = (Date.now() - tempoInicioMusica) / 1000;\
    socket.emit('novaMusica', { musica: musicaAtual, tempoDecorrido });\
  }\
  socket.emit('atualizarFila', playlist);\
\
  // √Åudio do Microfone do DJ\
  socket.on('streamAudio', (data) => {\
    locucaoAoVivo = true;\
    socket.broadcast.emit('receberAudioLive', data);\
  });\
\
  socket.on('pararStream', () => {\
    locucaoAoVivo = false;\
    socket.broadcast.emit('fimAudioLive');\
  });\
\
  // Controles de DJ\
  socket.on('adicionarMusica', (url) => {\
    if (url) {\
      playlist.push(url);\
      io.emit('atualizarFila', playlist);\
    }\
  });\
\
  socket.on('proximaMusica', () => {\
    musicaAtual = null;\
    io.emit('novaMusica', null);\
  });\
\
  socket.on('removerMusica', (index) => {\
    if (index >= 0 && index < playlist.length) {\
      playlist.splice(index, 1);\
      io.emit('atualizarFila', playlist);\
    }\
  });\
\
  socket.on('limparFila', () => {\
    playlist = [];\
    io.emit('atualizarFila', playlist);\
  });\
});\
\
server.listen(3000, '0.0.0.0', () => {\
  console.log('ÉøÉ∫Ä R√ÉÅdio Web com Painel ADM e Microfone Ativados!');\
});\
EOF\

