          </select>\
        </div>\
        <div>\
          <label>Efeito do LED Caixa:</label>\
          <select id="ledMode" onchange="atualizarLeds()">\
            <option value="estatico">Est√ÉÅtico</option>\
            <option value="pisca">Strobo / Sincronizado √Åudio</option>\
            <option value="giratorio">Rainbow Girat√≥rio</option>\
          </select>\
        </div>\
      </div>\
\
      <div class="grid-2">\
        <div>\
          <label>Cor LED 1:</label>\
          <input type="color" id="ledColor1" value="#00f0ff" onchange="atualizarLeds()">\
        </div>\
        <div>\
          <label>Cor LED 2:</label>\
          <input type="color" id="ledColor2" value="#ff0055" onchange="atualizarLeds()">\
        </div>\
      </div>\
      <label>Fundo App (Foto/GIF):</label>\
      <input type="file" id="bgFile" accept="image/*" onchange="alterarFundoApp(event)">\
    </div>\
\
    <div class="card">\
      <h3>ÉøÉÆÉª Ilumina√ß√£o e LEDs do Player</h3>\
      <div class="grid-2">\
        <div>\
          <label>Cor do LED do Player:</label>\
          <input type="color" id="playerLedColor" value="#00f0ff" onchange="alterarCorPlayerLed(this.value)">\
        </div>\
        <div>\
          <label>Modo LED Player:</label>\
          <select id="playerLedMode" onchange="atualizarModoLedPlayer()">\
            <option value="normal">Cor √É∫nica Fixa</option>\
            <option value="rainbow">Girat√≥rio Rainbow</option>\
            <option value="ritmo">Bater no Ritmo da M√∫sica</option>\
          </select>\
        </div>\
      </div>\
    </div>\
  </div>\
\
  <div id="screen-audio" class="screen">\
    <div class="card">\
      <h3>ÉøÉÆÉπÔ∏ÉØ Mesa de Som Automotiva</h3>\
      <div class="grid-2">\
        <div>\
          <label>Modelo da Mesa:</label>\
          <select id="mixerBrand">\
            <option value="Taramps MX1 / MX2">Taramps MX1 / MX2 Pro</option>\
            <option value="Stetsom STM1003">Stetsom STM1003 3 Vias</option>\
            <option value="Expert MX-AIR">Expert Electronics MX-AIR</option>\
          </select>\
        </div>\
        <div>\
          <label>Ganho do Microfone/Aux:</label>\
          <input type="range" min="0" max="100" value="75">\
        </div>\
      </div>\
    </div>\
\
    <div class="card">\
      <h3>ÉøÉÆÉª Processador DSP / Crossover</h3>\
      <label>Modelo do DSP Processador:</label>\
      <select id="dspModel">\
        <option value="Stetsom STX2448 Digital">Stetsom STX2448 / STX2848</option>\
        <option value="Expert PX-2 PRO Bluetooth">Expert PX-1 / PX-2 PRO</option>\
        <option value="JFA X5 Crossover">JFA X5 Crossover 4 Vias</option>\
        <option value="Taramps Pro 2.4S DSP">Taramps Pro 2.4S DSP</option>\
      </select>\
    </div>\
\
    <div class="card">\
      <h3>ÉøÉÆÉª Equaliza√ß√£o & Bass Xtreme</h3>\
      <div class="grid-2">\
        <div>\
          <label>Grave (Bass):</label>\
          <input type="range" id="eqBass" min="-20" max="20" value="0" oninput="atualizarFiltrosAudio()">\
        </div>\
        <div>\
          <label>M√©dio (Mid):</label>\
          <input type="range" id="eqMid" min="-20" max="20" value="0" oninput="atualizarFiltrosAudio()">\
        </div>\
      </div>\
      <label>Agudo (High):</label>\
      <input type="range" id="eqHigh" min="-20" max="20" value="0" oninput="atualizarFiltrosAudio()">\
\
      <button class="btn-xtreme" id="btnXtreme" onclick="toggleBassXtreme()">ÉøÉ¥• BASS XTREME: DESATIVADO</button>\
    </div>\
  </div>\
\
  <div id="screen-eletrica" class="screen">\
    <div class="card">\
      <h3>ÉøÉ¥É´ Regulagem & Troca de Baterias</h3>\
      <div class="grid-2">\
        <div>\
          <label>Modelo Bateria / Fonte:</label>\
          <select id="batteryModel" onchange="calcularEletrica()">\
            <option value="moura">Moura Clean / Chumbo-√Åcido</option>\
            <option value="litio">Bateria de L√≠tio (LiFePO4 HQ)</option>\
            <option value="agm">Bateria de Gel / AGM Deep Cycle</option>\
            <option value="usina">Fonte Automotiva Usina / JFA</option>\
          </select>\
        </div>\
        <div>\
          <label>Capacidade (Ah):</label>\
          <input type="number" id="batteryAh" value="150" min="40" max="1000" oninput="calcularEletrica()">\
        </div>\
      </div>\
\
      <div class="grid-2">\
        <div>\
          <label>Tens√£o Nominal (Volts):</label>\
          <input type="number" id="batteryVolts" value="12.6" step="0.1" min="10" max="15" oninput="calcularEletrica()">\
        </div>\
        <div>\
          <label>Efici√™ncia / Carga %:</label>\
          <input type="range" id="batteryHealth" min="20" max="100" value="100" oninput="calcularEletrica()">\
        </div>\
      </div>\
    </div>\
\
    <div class="card">\
      <h3>ÉøÉ≥É™ Dimensionamento & Relat√≥rio T√©cnico</h3>\
      <button style="width:100%; padding:10px; background:var(--neon-cyan); border:none; font-weight:bold; border-radius:6px;" onclick="gerarProjeto()">GERAR RELAT√É≥RIO T√É©CNICO</button>\
      <textarea id="relatorioOutput" readonly placeholder="O relat√≥rio detalhado aparecer√ÉÅ aqui..."></textarea>\
    </div>\
  </div>\
\
  <nav class="tab-bar">\
    <button class="tab-btn active" id="btnTabPalco" onclick="trocarTela('screen-palco', this)">\
      <span>ÉøÉ≥ª</span> Palco\
    </button>\
    <button class="tab-btn" onclick="trocarTela('screen-caixa', this)">\
      <span>‚É∫ÉπÔ∏ÉØ</span> Caixa\
    </button>\
    <button class="tab-btn" onclick="trocarTela('screen-leds', this)">\
      <span>ÉøÉ≤ÉÅ</span> LEDs\
    </button>\
    <button class="tab-btn" id="btnTabAudio" onclick="trocarTela('screen-audio', this)">\
      <span>ÉøÉÆÉª</span> √Åudio\
    </button>\
    <button class="tab-btn" onclick="trocarTela('screen-eletrica', this)">\
      <span>‚É∫ÉÅ</span> El√©trica\
    </button>\
  </nav>\
\
  <script>\
    let playlist = [];\
    let currentIndex = 0;\
    let isXtremeActive = false;\
    let currentPlayerModel = 'pioneer';\
    const audio = document.getElementById('audioPlayer');\
    let audioCtx, source, analyser, bassFilter, midFilter, highFilter;\
    let isAudioSetup = false;\
    let animationFrameId;\
\
    function trocarTela(screenId, btn) {\
      document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));\
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));\
      document.getElementById(screenId).classList.add('active');\
      if (btn) btn.classList.add('active');\
    }\
\
    function irParaTelaAudio() {\
      trocarTela('screen-audio', document.getElementById('btnTabAudio'));\
    }\
\
    function initWebAudio() {\
      if (isAudioSetup) return;\
      const AudioContext = window.AudioContext || window.webkitAudioContext;\
      audioCtx = new AudioContext();\
      source = audioCtx.createMediaElementSource(audio);\
\
      analyser = audioCtx.createAnalyser();\
      analyser.fftSize = 64;\
\
      bassFilter = audioCtx.createBiquadFilter();\
      bassFilter.type = 'lowshelf';\
      bassFilter.frequency.value = 80;\
\
      midFilter = audioCtx.createBiquadFilter();\
      midFilter.type = 'peaking';\
      midFilter.frequency.value = 1000;\
\
      highFilter = audioCtx.createBiquadFilter();\
      highFilter.type = 'highshelf';\
      highFilter.frequency.value = 6000;\
\
      source.connect(bassFilter);\
      bassFilter.connect(midFilter);\
      midFilter.connect(highFilter);\
      highFilter.connect(analyser);\
      analyser.connect(audioCtx.destination);\
\
      isAudioSetup = true;\
      processAudioRealtime();\
    }\
\
    function processAudioRealtime() {\
      if (!analyser) return;\
\
      const bufferLength = analyser.frequencyBinCount;\
      const dataArray = new Uint8Array(bufferLength);\
      analyser.getByteFrequencyData(dataArray);\
\
      let bassSum = 0;\
      for (let i = 0; i < 4; i++) bassSum += dataArray[i];\
      let bassAvg = bassSum / 4;\
\
      let trebleSum = 0;\
      for (let i = 12; i < 24; i++) trebleSum += dataArray[i];\
      let trebleAvg = trebleSum / 12;\
\
      let bassScale = 1 + (bassAvg / 255) * (isXtremeActive ? 0.42 : 0.25);\
      document.querySelectorAll('.real-woofer').forEach(w => {\
        w.style.transform = `scale(${bassScale})`;\
      });\
\
      let driverGlow = trebleAvg / 255;\
      document.querySelectorAll('.real-driver-led-throat').forEach(led => {\
        led.style.background = `rgba(0, 240, 255, ${driverGlow})`;\
        led.style.boxShadow = `0 0 ${driverGlow * 12}px #00f0ff`;\
      });\
\
      let baseVolts = parseFloat(document.getElementById('batteryVolts').value) || 12.6;\
      let drop = (bassAvg / 255) * (isXtremeActive ? 2.8 : 1.6);\
      let realVolts = Math.max(8.5, (baseVolts - drop)).toFixed(1);\
      document.getElementById('voltsEmbutido').innerText = realVolts + 'V';\
\
      const playerLedMode = document.getElementById('playerLedMode').value;\
      if (playerLedMode === 'ritmo') {\
        let currentColor = document.getElementById('playerLedColor').value || '#00f0ff';\
        document.documentElement.style.setProperty('--player-led-color', currentColor);\
      }\
\
      animationFrameId = requestAnimationFrame(processAudioRealtime);\
    }\
\
    function atualizarFiltrosAudio() {\
      if (!isAudioSetup) initWebAudio();\
      const valBass = parseFloat(document.getElementById('eqBass').value);\
      const valMid = parseFloat(document.getElementById('eqMid').value);\
      const valHigh = parseFloat(document.getElementById('eqHigh').value);\
\
      bassFilter.gain.value = valBass + (isXtremeActive ? 15 : 0);\
      midFilter.gain.value = valMid;\
      highFilter.gain.value = valHigh;\
    }\
\
    function toggleBassXtreme() {\
      isXtremeActive = !isXtremeActive;\
      const btn = document.getElementById('btnXtreme');\
      if (isXtremeActive) {\
        btn.classList.add('active');\
        btn.innerText = 'ÉøÉ¥• BASS XTREME: ATIVADO (+15dB SUBGUTURAL)';\
      } else {\
        btn.classList.remove('active');\
        btn.innerText = 'ÉøÉ¥• BASS XTREME: DESATIVADO';\
      }\
      atualizarFiltrosAudio();\
    }\
\
    function trocandoMusica(dir) {\
      if (!playlist.length) return;\
      let newIdx = currentIndex + dir;\
      if (newIdx < 0) newIdx = playlist.length - 1;\
      if (newIdx >= playlist.length) newIdx = 0;\
      tocarMusica(newIdx);\
    }\
\
    function togglePlayPause() {\
      if (!playlist.length) return;\
      if (audio.paused) {\
        if (audioCtx && audioCtx.state === 'suspended') audioCtx.resume();\
        audio.play();\
      } else {\
        audio.pause();\
      }\
      renderPlayerHardware();\
    }\
\
    function trocarPlayerPeloMenu(val) {\
      currentPlayerModel = val;\
      renderPlayerHardware();\
    }\
\
    function alterarCorPlayerLed(hex) {\
      document.documentElement.style.setProperty('--player-led-color', hex);\
    }\
\
    function atualizarModoLedPlayer() {\
      const playerCase = document.getElementById('playerHardwareContainer');\
      const mode = document.getElementById('playerLedMode').value;\
      if (mode === 'rainbow') {\
        playerCase.classList.add('player-led-rainbow');\
      } else {\
        playerCase.classList.remove('player-led-rainbow');\
      }\
    }\
\
    function renderPlayerHardware() {\
      const container = document.getElementById('playerHardwareContainer');\
      const trackName = playlist[currentIndex] ? playlist[currentIndex].name : "NENHUMA M√É∫SICA";\
      const isPlaying = !audio.paused && audio.src !== "";\
\
      if (currentPlayerModel === 'pioneer') {\
        container.innerHTML = `\
          <div class="pioneer-face">\
            <div class="pioneer-top-row">\
              <button class="pioneer-knob-btn" onclick="togglePlayPause()" title="Play/Pause">\
                ${isPlaying ? '‚ÉΩÉ∫‚ÉΩÉ∫' : '‚É∂∂'}\
              </button>\
              <div class="pioneer-screen-blue">\
                <div style="font-weight:bold; font-size:9px; display:flex; justify-content:space-between;">\
                  <span>ÉøÉ∞¨ PIONEER BT</span>\
                  <span>${isPlaying ? '‚É∂∂ PLAY' : '‚ÉΩÉ∫‚ÉΩÉ∫ PAUSE'}</span>\
                </div>\
                <div style="white-space:nowrap; overflow:hidden; text-overflow:ellipsis; margin-top:2px; font-weight:bold;">\
                  ${trackName}\
                </div>\
              </div>\
            </div>\
\
            <div class="pioneer-controls-row">\
              <button class="btn-hw" onclick="trocandoMusica(-1)">‚ÉØÆ VOLTAR</button>\
              <button class="btn-hw" onclick="togglePlayPause()">${isPlaying ? 'PAUSE' : 'PLAY'}</button>\
              <button class="btn-hw" onclick="trocandoMusica(1)">AVAN√ÉßAR ‚ÉØ≠</button>\
              <button class="btn-hw" onclick="irParaTelaAudio()">EQ/BASS ÉøÉÆÉª</button>\
            </div>\
          </div>\
        `;\
      } else if (currentPlayerModel === 'android') {\
        container.innerHTML = `\
          <div class="android-screen-container">\
            <div class="android-display-hdr">\
              <div class="android-album-art">ÉøÉÆµ</div>\
              <div style="flex:1; overflow:hidden;">\
                <div style="font-size:9px; color:var(--player-led-color); font-weight:bold;">ANDROID TOUCH MULTIM√É≠DIA</div>\
                <div style="font-size:11px; color:#fff; font-weight:bold; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">\
                  ${trackName}\
                </div>\
                <div style="font-size:8px; color:#aaa; margin-top:2px;">\
                  ${isPlaying ? '‚É∂∂ Reproduzindo em Alta Fidelidade' : '‚ÉΩÉ∫‚ÉΩÉ∫ Em Pausa'}\
                </div>\
              </div>\
            </div>\
\
            <div class="pioneer-controls-row">\
              <button class="btn-hw" onclick="trocandoMusica(-1)">‚ÉØÆ ANTERIOR</button>\
              <button class="btn-hw" onclick="togglePlayPause()">${isPlaying ? '‚ÉΩÉ∫‚ÉΩÉ∫ PAUSE' : '‚É∂∂ PLAY'}</button>\
              <button class="btn-hw" onclick="trocandoMusica(1)">PR√É≥XIMA ‚ÉØ≠</button>\
              <button class="btn-hw" onclick="irParaTelaAudio()">DSP ÉøÉÆÉª</button>\
            </div>\
          </div>\
        `;\
      } else {\
        container.innerHTML = `\
          <div class="pioneer-face">\
            <div class="pioneer-top-row">\
              <div class="pioneer-screen-blue">\
                <div style="font-weight:bold; font-size:9px;">ÉøÉ¥¥ DVD PLAYER 1DIN NEON</div>\
                <div style="white-space:nowrap; overflow:hidden; text-overflow:ellipsis; margin-top:2px;">\
                  ${trackName}\
                </div>\
              </div>\
            </div>\
\
            <div class="pioneer-controls-row" style="margin-top:6px;">\
              <button class="btn-hw" onclick="trocandoMusica(-1)">‚ÉØÆ ANTERIOR</button>\
              <button class="btn-hw" onclick="togglePlayPause()">${isPlaying ? 'PAUSE' : 'PLAY'}</button>\
              <button class="btn-hw" onclick="trocandoMusica(1)">PR√É≥XIMA ‚ÉØ≠</button>\
              <button class="btn-hw" onclick="irParaTelaAudio()">EQ ÉøÉÆÉª</button>\
            </div>\
          </div>\
        `;\
      }\
      atualizarModoLedPlayer();\
    }\
\
    function atualizarLeds() {\
      const mode = document.getElementById('ledMode').value;\
      const c1 = document.getElementById('ledColor1').value;\
      const c2 = document.getElementById('ledColor2').value;\
      const palco = document.getElementById('palcoVirtual');\
\
      document.documentElement.style.setProperty('--led-color1', c1);\
      document.documentElement.style.setProperty('--led-color2', c2);\
\
      palco.classList.remove('led-pisca', 'led-giratorio');\
      if (mode === 'pisca') palco.classList.add('led-pisca');\
      if (mode === 'giratorio') palco.classList.add('led-giratorio');\
    }\
\
    function alterarCorCaixa() {\
      const color = document.getElementById('caixaBgColor').value;\
      document.documentElement.style.setProperty('--caixa-bg-color', color);\
    }\
\
    function alterarMaterialCaixa() {\
      const mat = document.getElementById('boxMaterial').value;\
      let texture = 'none';\
\
      if (mat === 'couro') {\
        texture = 'radial-gradient(circle, rgba(0,0,0,0.6) 0%, rgba(0,0,0,0.9) 100%)';\
        document.documentElement.style.setProperty('--caixa-bg-color', '#111113');\
      } else if (mat === 'carbono') {\
        texture = 'linear-gradient(45deg, #111 25%, #222 25%, #222 50%, #111 50%, #111 75%, #222 75%, #222 100%)';\
        document.documentElement.style.setProperty('--caixa-bg-color', '#0a0a0c');\
      } else if (mat === 'mdf') {\
        texture = 'linear-gradient(180deg, rgba(160,82,45,0.8) 0%, rgba(110,50,20,0.9) 100%)';\
        document.documentElement.style.setProperty('--caixa-bg-color', '#8B4513');\
      } else {\
        texture = 'radial-gradient(circle, #18181b 0%, #09090b 100%)';\
        document.documentElement.style.setProperty('--caixa-bg-color', '#18181b');\
      }\
\
      document.documentElement.style.setProperty('--caixa-texture', texture);\
    }\
\
    function alterarFotoCaixa(event) {\
      const file = event.target.files[0];\
      if (file) {\
        const url = URL.createObjectURL(file);\
        document.documentElement.style.setProperty('--caixa-texture', `url('${url}')`);\
      }\
    }\
\
    function alterarFundoApp(event) {\
      const file = event.target.files[0];\
      if (file) {\
        const url = URL.createObjectURL(file);\
        document.body.style.backgroundImage = `url('${url}')`;\
      }\
    }\
\
    function atualizarPalco() {\
      const wooferQty = parseInt(document.getElementById('wooferQty').value) || 2;\
      const wooferBrand = document.getElementById('wooferBrand').value;\
      const driverQty = parseInt(document.getElementById('driverQty').value) || 2;\
      const dutoType = document.getElementById('dutoType').value;\
\
      const pCornetas = document.getElementById('painelCornetas');\
      const pWoofers = document.getElementById('painelWoofers');\
      const pDutos = document.getElementById('painelDutos');\
\
      pCornetas.innerHTML = '';\
      pWoofers.innerHTML = '';\
      pDutos.innerHTML = '';\
\
      for(let i = 0; i < driverQty; i++) {\
        const driver = document.createElement('div');\
        driver.className = 'real-driver';\
        driver.innerHTML = `<div class="real-driver-led-throat"></div><span>CORNETA</span>`;\
        pCornetas.appendChild(driver);\
      }\
\
      for(let i = 0; i < wooferQty; i++) {\
        const woofer = document.createElement('div');\
        woofer.className = 'real-woofer';\
        woofer.innerText = wooferBrand;\
        pWoofers.appendChild(woofer);\
      }\
\
      if (dutoType === 'quadrado') {\
        const duto = document.createElement('div');\
        duto.className = 'duto-quadrado';\
        pDutos.appendChild(duto);\
      } else if (dutoType === 'triangular') {\
        for(let i = 0; i < 2; i++) {\
          const duto = document.createElement('div');\
          duto.className = 'duto-triangular';\
          pDutos.appendChild(duto);\
        }\
      } else {\
        for(let i = 0; i < 2; i++) {\
          const duto = document.createElement('div');\
          duto.className = 'duto-redondo';\
          pDutos.appendChild(duto);\
        }\
      }\
\
      renderPlayerHardware();\
    }\
\
    function carregarPlaylist(event) {\
      const files = event.target.files;\
      if (!files.length) return;\
      playlist = Array.from(files);\
      currentIndex = 0;\
      renderPlaylist();\
      tocarMusica(currentIndex);\
    }\
\
    function renderPlaylist() {\
      const container = document.getElementById('playlistContainer');\
      container.innerHTML = '';\
      playlist.forEach((file, index) => {\
        const item = document.createElement('div');\
        item.className = 'playlist-item' + (index === currentIndex ? ' ativo' : '');\
        item.innerText = `${index + 1}. ${file.name}`;\
        item.onclick = () => tocarMusica(index);\
        container.appendChild(item);\
      });\
    }\
\
    function tocarMusica(index) {\
      if (index < 0 || index >= playlist.length) return;\
      currentIndex = index;\
      const file = playlist[currentIndex];\
      audio.src = URL.createObjectURL(file);\
      if (audioCtx && audioCtx.state === 'suspended') audioCtx.resume();\
      audio.play();\
      renderPlaylist();\
      renderPlayerHardware();\
    }\
\
    audio.onplay = () => {\
      if (!isAudioSetup) initWebAudio();\
      renderPlayerHardware();\
    };\
\
    audio.onpause = () => {\
      renderPlayerHardware();\
    };\
\
    function calcularEletrica() {\
      const v = parseFloat(document.getElementById('batteryVolts').value) || 12.6;\
      document.getElementById('voltsEmbutido').innerText = v.toFixed(1) + 'V';\
    }\
\
    function gerarProjeto() {\
      const dsp = document.getElementById('dspModel').value;\
      const mixer = document.getElementById('mixerBrand').value;\
      const remote = document.getElementById('remoteBrand').value;\
      const ledCentral = document.getElementById('ledCentralBrand').value;\
      const boxMaker = document.getElementById('boxMaker').value;\
      const boxStructure = document.getElementById('boxStructure').value;\
      const wooferBrand = document.getElementById('wooferBrand').value;\
      const qty = parseInt(document.getElementById('wooferQty').value) || 2;\
      const driverQty = parseInt(document.getElementById('driverQty').value) || 0;\
      const batModel = document.getElementById('batteryModel').value;\
      const batAh = document.getElementById('batteryAh').value;\
\
      const totalRmsGeral = (qty * 1500) + (driverQty * 160);\
\
      document.getElementById('relatorioOutput').value = \
`======================================================\
ÉøÉ¥É™ RELAT√É≥RIO COMPLETO E CALCULADO MASTER PRO\
======================================================\
‚ÄÉÇ Estrutura: Caixa ${boxStructure.toUpperCase()} (${boxMaker})\
‚ÄÉÇ Configura√ß√£o: ${qty}x Woofers ${wooferBrand} + ${driverQty}x Drivers\
‚ÄÉÇ Mesa de Som: ${mixer}\
‚ÄÉÇ Processador DSP: ${dsp}\
‚ÄÉÇ Controle Longa Dist√ÉÇncia: ${remote}\
‚ÄÉÇ Central de LED RGB: ${ledCentral}\
‚ÄÉÇ Fonte/Bateria: Bateria ${batModel.toUpperCase()} - ${batAh}Ah\
‚ÄÉÇ Pot√™ncia Total Estimada: ~${totalRmsGeral}W RMS\
‚ÄÉÇ Autonomia: Calculada com base na Carga da Bateria em Tempo Real`;\
    }\
\
    atualizarPalco();\
    atualizarLeds();\
  </script>\
</body>\
</html>\
EOF\

