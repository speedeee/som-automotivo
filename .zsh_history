<!DOCTYPE html>\
<html lang="pt-BR">\
<head>\
  <meta charset="UTF-8">\
  <meta name="viewport" content="width=device-width, initial-scale=1.0">\
  <title>Simulador & Configurador de Som Automotivo Pro</title>\
  <style>\
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, sans-serif; }\
    body { background-color: #0b0d12; color: #e1e7ef; padding: 12px; display: flex; justify-content: center; }\
    .container { max-width: 900px; width: 100%; background: #131722; padding: 18px; border-radius: 12px; border: 1px solid #232838; box-shadow: 0 10px 25px rgba(0,0,0,0.6); }\
    h1 { text-align: center; color: #ff3366; margin-bottom: 15px; font-size: 1.3rem; text-transform: uppercase; letter-spacing: 1px; }\
    \
    .section { background: #1a1f2c; padding: 14px; border-radius: 8px; margin-bottom: 14px; border-left: 4px solid #ff3366; }\
    .section h2 { color: #00d2ff; font-size: 0.95rem; margin-bottom: 10px; }\
    .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px; }\
    label { display: block; font-size: 0.78rem; color: #94a3b8; margin-bottom: 4px; font-weight: 600; }\
    select, input { width: 100%; padding: 8px; border-radius: 6px; border: 1px solid #334155; background: #0f121a; color: #fff; font-size: 0.85rem; }\
\
    /* VOLT√É≠METRO DIGITAL */\
    .voltmeter-card { background: #080a0f; border: 2px solid #ff3366; border-radius: 10px; padding: 12px; text-align: center; margin-bottom: 15px; box-shadow: 0 0 15px rgba(255, 51, 102, 0.2); }\
    .voltmeter-display { font-size: 2.2rem; font-weight: bold; font-family: monospace; color: #00ffcc; text-shadow: 0 0 10px rgba(0, 255, 204, 0.6); letter-spacing: 2px; }\
    .voltmeter-status { font-size: 0.78rem; font-weight: bold; margin-top: 4px; text-transform: uppercase; }\
\
    /* ESTRUTURA VISUAL DA CAIXA DE SOM (REPARTI√Éß√ÉµES) */\
    .car-audio-box { background: #07090e; border: 3px solid #2a324b; border-radius: 10px; padding: 12px; margin: 15px 0; box-shadow: inset 0 0 15px rgba(0,0,0,0.8); }\
    .box-title { text-align: center; font-size: 0.75rem; color: #00d2ff; font-weight: bold; margin-bottom: 10px; text-transform: uppercase; letter-spacing: 1px; }\
    \
    .box-partition { background: #10141f; border: 2px solid #1e2638; border-radius: 8px; padding: 10px; margin-bottom: 10px; position: relative; }\
    .box-partition-label { font-size: 0.7rem; color: #ff3366; font-weight: bold; text-transform: uppercase; margin-bottom: 8px; display: block; border-bottom: 1px solid #232838; padding-bottom: 4px; }\
    .speakers-row { display: flex; justify-content: center; align-items: center; gap: 10px; flex-wrap: wrap; min-height: 50px; }\
\
    /* DESIGN DOS FALANTES */\
    .speaker-woofer { width: 85px; height: 85px; border-radius: 50%; background: radial-gradient(circle, #222 30%, #111 70%, #444 100%); border: 5px solid #333; display: flex; justify-content: center; align-items: center; transition: transform 0.03s ease; box-shadow: 0 4px 8px rgba(0,0,0,0.5); }\
    .speaker-woofer .inner { width: 32px; height: 32px; border-radius: 50%; background: #050505; border: 2px solid #555; }\
\
    .speaker-mid { width: 60px; height: 60px; border-radius: 50%; background: radial-gradient(circle, #282828 30%, #181818 70%, #3a3a3a 100%); border: 4px solid #444; display: flex; justify-content: center; align-items: center; }\
    .speaker-mid .inner { width: 20px; height: 20px; border-radius: 50%; background: #000; border: 1px solid #777; }\
\
    .speaker-horn { width: 45px; height: 45px; background: #1a1a1a; border: 2px solid #00d2ff; display: flex; justify-content: center; align-items: center; color: #00d2ff; font-size: 0.6rem; font-weight: bold; }\
    .speaker-horn.round { border-radius: 50%; }\
    .speaker-horn.square { border-radius: 4px; }\
\
    .speaker-tweeter { width: 32px; height: 32px; border-radius: 50%; background: #222; border: 2px solid #ffcc00; display: flex; justify-content: center; align-items: center; color: #ffcc00; font-size: 0.55rem; font-weight: bold; }\
\
    /* PLAYER & PLAYLIST */\
    .player-controls { background: #111520; padding: 12px; border-radius: 8px; border: 1px solid #00d2ff; }\
    .controls-btn-group { display: flex; gap: 8px; margin-top: 10px; }\
    .playlist-box { margin-top: 10px; background: #0a0c10; border: 1px solid #232838; border-radius: 6px; padding: 10px; max-height: 140px; overflow-y: auto; }\
    .playlist-box li { font-size: 0.8rem; color: #94a3b8; padding: 5px 8px; border-radius: 4px; cursor: pointer; margin-bottom: 3px; background: #131722; word-break: break-all; list-style: none; }\
    .playlist-box li.active { background: #ff3366; color: #fff; font-weight: bold; }\
\
    /* EQUALIZADOR DSP */\
    .dsp-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 10px; margin-top: 10px; }\
    .dsp-card { background: #0f121a; border: 1px solid #334155; padding: 10px; border-radius: 6px; text-align: center; }\
    .dsp-card span { font-size: 0.8rem; font-weight: bold; color: #00d2ff; display: block; margin-top: 4px; }\
    .dsp-slider { width: 100%; margin-top: 6px; cursor: pointer; }\
\
    button { width: 100%; padding: 11px; background: linear-gradient(45deg, #ff3366, #ff6533); border: none; border-radius: 6px; color: #fff; font-weight: bold; cursor: pointer; margin-top: 10px; font-size: 0.9rem; }\
    .output-box { background: #0f121a; border: 1px solid #00d2ff; border-radius: 8px; padding: 12px; white-space: pre-wrap; font-family: monospace; font-size: 0.8rem; color: #00ffcc; margin-top: 10px; }\
  </style>\
</head>\
<body>\
  <div class="container">\
    <h1>ÉøÉ¥É™ SIMULADOR & CONFIGURADOR DE SOM PRO</h1>\
\
    <div class="voltmeter-card">\
      <label style="color:#aaa; font-weight:bold;">‚É∫ÉÅ VOLT√É≠METRO AUTOMOTIVO DIGITAL (BARRAMENTO)</label>\
      <div class="voltmeter-display" id="voltmeterDisplay">12.6 V</div>\
      <div class="voltmeter-status" id="voltmeterStatus" style="color: #00ffcc;">SISTEMA PRONTO / STANDBY</div>\
    </div>\
\
    <div class="car-audio-box">\
      <div class="box-title">ÉøÉ≥¶ ESTRUTURA VISUAL DA CAIXA DE SOM (REPARTI√Éß√ÉµES)</div>\
      \
      <div class="box-partition">\
        <span class="box-partition-label">ÉøÉ≥ÉÇ REPARTI√Éß√É£O DE ALTO-FALANTES AGUDOS (CORNETAS & TWEETERS)</span>\
        <div class="speakers-row" id="partitionHornsTweeters"></div>\
      </div>\
\
      <div class="box-partition">\
        <span class="box-partition-label">ÉøÉÆÉªÔ∏ÉØ REPARTI√Éß√É£O DE M√É©DIOS (M√É©DIO-GRAVE 8" / 10")</span>\
        <div class="speakers-row" id="partitionMids"></div>\
      </div>\
\
      <div class="box-partition">\
        <span class="box-partition-label">ÉøÉ¥É™ REPARTI√Éß√É£O DE GRAVES (WOOFERS / SUBWOOFERS)</span>\
        <div class="speakers-row" id="partitionWoofers"></div>\
      </div>\
    </div>\
\
    <div class="section">\
      <h2>1. Componentes e Falantes</h2>\
      <div class="grid">\
        <div>\
          <label>Player Central:</label>\
          <select id="player">\
            <option>Pioneer MVH-X3000BR (Graves Xtreme)</option>\
            <option>Stetsom Player Bluetooth</option>\
            <option>Expert Electronics Central</option>\
          </select>\
        </div>\
        <div>\
          <label>Tamanho do Woofer:</label>\
          <select id="wooferSize" onchange="atualizarCaixaVisual()">\
            <option value="12">12" (Grave Seco)</option>\
            <option value="15" selected>15" (Grave Misto / Pared√£o)</option>\
            <option value="18">18" (Subgrave Profundo)</option>\
          </select>\
        </div>\
        <div>\
          <label>Qtd de Woofers:</label>\
          <input type="number" id="wooferQty" value="2" min="1" max="8" onchange="atualizarCaixaVisual()">\
        </div>\
        <div>\
          <label>RMS por Woofer:</label>\
          <input type="number" id="wooferRms" value="1500" onchange="atualizarCaixaVisual()">\
        </div>\
        <div>\
          <label>Qtd de M√©dios (8"/10"):</label>\
          <input type="number" id="midQty" value="2" min="0" max="8" onchange="atualizarCaixaVisual()">\
        </div>\
        <div>\
          <label>RMS por M√©dio:</label>\
          <input type="number" id="midRms" value="400">\
        </div>\
      </div>\
    </div>\
\
    <div class="section">\
      <h2>2. Drivers, Cornetas e Tweeters</h2>\
      <div class="grid">\
        <div>\
          <label>Qtd de Cornetas/Drivers:</label>\
          <input type="number" id="hornQty" value="2" min="0" max="8" onchange="atualizarCaixaVisual()">\
        </div>\
        <div>\
          <label>Formato Corneta:</label>\
          <select id="hornFormat" onchange="atualizarCaixaVisual()">\
            <option value="round">Redonda</option>\
            <option value="square">Quadrada</option>\
          </select>\
        </div>\
        <div>\
          <label>Qtd de Tweeters:</label>\
          <input type="number" id="tweeterQty" value="2" min="0" max="8" onchange="atualizarCaixaVisual()">\
        </div>\
      </div>\
    </div>\
\
    <div class="section">\
      <h2>‚É∫ÉÅ Sistema El√©trico e Baterias</h2>\
      <div class="grid">\
        <div>\
          <label>Qtd de Baterias Auxiliares:</label>\
          <input type="number" id="batteryQty" value="1" min="1" max="10">\
        </div>\
        <div>\
          <label>Capacidade por Bateria (Ah):</label>\
          <select id="batteryAh">\
            <option value="60">60 Ah</option>\
            <option value="100">100 Ah</option>\
            <option value="150" selected>150 Ah (AGM / Estacion√ÉÅria)</option>\
            <option value="220">220 Ah (Caminh√£o / Nobreak)</option>\
          </select>\
        </div>\
        <div>\
          <label>Fonte Automotiva:</label>\
          <select id="fontePower">\
            <option value="0">Nenhuma (Apenas Bateria)</option>\
            <option value="120">Fonte 120 Amperes</option>\
            <option value="200" selected>Fonte 200 Amperes</option>\
          </select>\
        </div>\
      </div>\
    </div>\
\
    <div class="section">\
      <h2>ÉøÉ≥ª Player de M√∫sica Completo</h2>\
      <div class="player-controls">\
        <label>ÉøÉ≥Å Selecionar M√∫sicas do Celular (.mp3 / .wav):</label>\
        <input type="file" id="audioFile" accept="audio/*" multiple>\
\
        <div style="margin-top: 10px;">\
          <p id="currentTrackDisplay" style="font-size:0.85rem; color:#00d2ff; font-weight:bold;">Nenhuma m√∫sica tocando</p>\
        </div>\
\
        <audio id="mainAudio" style="width:100%; margin-top:8px;" controls></audio>\
\
        <div class="controls-btn-group">\
          <button onclick="prevTrack()" style="background:#334155;">‚ÉØÆÔ∏ÉØ Anterior</button>\
          <button onclick="togglePlay()" style="background:#00d2ff; color:#000;">‚ÉØØÔ∏ÉØ Play/Pausa</button>\
          <button onclick="nextTrack()" style="background:#334155;">Pr√≥xima ‚ÉØ≠Ô∏ÉØ</button>\
        </div>\
\
        <div class="playlist-box">\
          <p style="font-size:0.75rem; color:#00d2ff; margin-bottom:6px; font-weight:bold;">ÉøÉ≥É´ LISTA DE M√É∫SICAS:</p>\
          <ul id="playlistList">\
            <li style="background:transparent; color:#666;">Nenhuma m√∫sica carregada.</li>\
          </ul>\
        </div>\
      </div>\
    </div>\
\
    <div class="section">\
      <h2>ÉøÉÆÉªÔ∏ÉØ Processador de √Åudio DSP / Equalizador (Regulagem Ao Vivo)</h2>\
      <div class="dsp-grid">\
        <div class="dsp-card">\
          <label>ÉøÉ¥É™ Grave / Subwoofer</label>\
          <input type="range" class="dsp-slider" id="bassGain" min="-12" max="15" value="6" oninput="updateBass(this.value)">\
          <span id="bassValDisplay">+6 dB</span>\
        </div>\
        <div class="dsp-card">\
          <label>ÉøÉÆÉªÔ∏ÉØ M√©dios</label>\
          <input type="range" class="dsp-slider" id="midGain" min="-12" max="15" value="0" oninput="updateMid(this.value)">\
          <span id="midValDisplay">0 dB</span>\
        </div>\
        <div class="dsp-card">\
          <label>ÉøÉ≥ÉÇ Cornetas / Drivers</label>\
          <input type="range" class="dsp-slider" id="driverGain" min="-12" max="15" value="2" oninput="updateDriver(this.value)">\
          <span id="driverValDisplay">+2 dB</span>\
        </div>\
        <div class="dsp-card">\
          <label>‚Éº® Tweeters / Agudos</label>\
          <input type="range" class="dsp-slider" id="tweeterGain" min="-12" max="15" value="3" oninput="updateTweeter(this.value)">\
          <span id="tweeterValDisplay">+3 dB</span>\
        </div>\
      </div>\
    </div>\
\
    <button onclick="gerarProjeto()">‚É∫ÉÅ CALCULAR TUDO & GERAR RELAT√É≥RIO COMPLETO</button>\
\
    <div class="section" style="margin-top:15px;">\
      <h2>ÉøÉ≥É™ Relat√≥rio do Sistema e Dimensionamento</h2>\
      <div class="output-box" id="relatorioOutput">Clique no bot√£o acima para calcular e gerar...</div>\
    </div>\
  </div>\
\
  <script>\
    let audioCtx, source, bassFilter, midFilter, driverFilter, tweeterFilter, analyser;\
    let playlist = [];\
    let currentIndex = 0;\
\
    const audio = document.getElementById('mainAudio');\
    const fileInput = document.getElementById('audioFile');\
\
    fileInput.addEventListener('change', function(e) {\
      const files = Array.from(e.target.files);\
      if (files.length === 0) return;\
\
      playlist = files.map(file => ({\
        name: file.name,\
        url: URL.createObjectURL(file)\
      }));\
\
      renderPlaylist();\
      playTrack(0);\
    });\
\
    function initAudioEngine() {\
      if (!audioCtx) {\
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();\
        source = audioCtx.createMediaElementSource(audio);\
\
        bassFilter = audioCtx.createBiquadFilter();\
        bassFilter.type = 'lowshelf';\
        bassFilter.frequency.value = 80;\
        bassFilter.gain.value = parseFloat(document.getElementById('bassGain').value);\
\
        midFilter = audioCtx.createBiquadFilter();\
        midFilter.type = 'peaking';\
        midFilter.frequency.value = 800;\
        midFilter.gain.value = parseFloat(document.getElementById('midGain').value);\
\
        driverFilter = audioCtx.createBiquadFilter();\
        driverFilter.type = 'peaking';\
        driverFilter.frequency.value = 3000;\
        driverFilter.gain.value = parseFloat(document.getElementById('driverGain').value);\
\
        tweeterFilter = audioCtx.createBiquadFilter();\
        tweeterFilter.type = 'highshelf';\
        tweeterFilter.frequency.value = 9000;\
        tweeterFilter.gain.value = parseFloat(document.getElementById('tweeterGain').value);\
\
        analyser = audioCtx.createAnalyser();\
        analyser.fftSize = 256;\
\
        source.connect(bassFilter);\
        bassFilter.connect(midFilter);\
        midFilter.connect(driverFilter);\
        driverFilter.connect(tweeterFilter);\
        tweeterFilter.connect(analyser);\
        analyser.connect(audioCtx.destination);\
\
        monitorVoltmeterRealtime();\
      } else if (audioCtx.state === 'suspended') {\
        audioCtx.resume();\
      }\
    }\
\
    function monitorVoltmeterRealtime() {\
      const bufferLength = analyser.frequencyBinCount;\
      const dataArray = new Uint8Array(bufferLength);\
\
      function update() {\
        requestAnimationFrame(update);\
\
        let fonteAmps = parseFloat(document.getElementById('fontePower').value) || 0;\
        let baseVoltage = fonteAmps > 0 ? 14.4 : 12.6;\
\
        if (audio.paused) {\
          document.getElementById('voltmeterDisplay').innerText = baseVoltage.toFixed(1) + " V";\
          document.getElementById('voltmeterStatus').innerText = fonteAmps > 0 ? "‚É∫ÉÅ FONTE LIGADA (SISTEMA EM STANDBY)" : "SISTEMA EM STANDBY";\
          document.getElementById('voltmeterStatus').style.color = "#00ffcc";\
          document.querySelectorAll('.speaker-woofer').forEach(w => w.style.transform = 'scale(1)');\
          return;\
        }\
\
        analyser.getByteFrequencyData(dataArray);\
\
        // Calcular energia dos graves\
        let bassSum = 0;\
        for(let i = 0; i < 8; i++) bassSum += dataArray[i];\
        let bassAvg = bassSum / 8; // 0 - 255\
\
        // Calcular Watts RMS totais do som\
        let wRms = parseFloat(document.getElementById('wooferRms').value) || 1500;\
        let wQty = parseInt(document.getElementById('wooferQty').value) || 1;\
        let mRms = parseFloat(document.getElementById('midRms').value) || 400;\
        let mQty = parseInt(document.getElementById('midQty').value) || 0;\
        let totalWatts = (wRms * wQty) + (mRms * mQty) + 600;\
\
        // Calcular Baterias Totais em Ah\
        let batQty = parseInt(document.getElementById('batteryQty').value) || 1;\
        let batAhUnit = parseFloat(document.getElementById('batteryAh').value) || 150;\
        let totalAh = batQty * batAhUnit;\
\
        // C√ÉÅlculo din√ÉÇmico da queda de tens√£o baseado na amperagem + ganho de grave\
        let bassGainBoost = parseFloat(document.getElementById('bassGain').value) || 0;\
        let bassIntensity = (bassAvg / 255) * (1 + (bassGainBoost / 10));\
        \
        let currentDrawAmps = (totalWatts * bassIntensity) / 12.6;\
        let netAmps = Math.max(0, currentDrawAmps - (fonteAmps * 0.7));\
\
        // Quanto maior o Ah total de bateria, menor a queda\
        let voltageDrop = (netAmps / (totalAh * 0.4)) * 1.5;\
        let currentVoltage = baseVoltage - voltageDrop - (Math.random() * 0.05);\
\
        if (currentVoltage < 9.5) currentVoltage = 9.5;\
\
        const voltElem = document.getElementById('voltmeterDisplay');\
        const statusElem = document.getElementById('voltmeterStatus');\
\
        voltElem.innerText = currentVoltage.toFixed(1) + " V";\
\
        if (currentVoltage < 11.0) {\
          voltElem.style.color = "#ff3333";\
          statusElem.innerText = "ÉøÉ∫® BASS DROP! QUEDA CR√É≠TICA! ADICIONE BATERIA!";\
          statusElem.style.color = "#ff3333";\
        } else if (currentVoltage < 12.0) {\
          voltElem.style.color = "#ffcc00";\
          statusElem.innerText = "‚É∫ÉÄÔ∏ÉØ CONSUMINDO ELEVADO (GRAVE FORTE)";\
          statusElem.style.color = "#ffcc00";\
        } else {\
          voltElem.style.color = "#00ffcc";\
          statusElem.innerText = fonteAmps > 0 ? "‚É∫ÉÅ FONTE ALIMENTANDO BARRAMENTO OK" : "‚ÉºÉ• BARRAMENTO EST√ÅVEL";\
          statusElem.style.color = "#00ffcc";\
        }\
\
        // Anima√ß√£o Woofers pulsando no Grave\
        let scale = 1 + (bassAvg / 255) * 0.22;\
        document.querySelectorAll('.speaker-woofer').forEach(w => {\
          w.style.transform = `scale(${scale})`;\
        });\
      }\
\
      update();\
    }\
\
    // Fun√ß√µes do DSP\
    function updateBass(val) {\
      document.getElementById('bassValDisplay').innerText = (val > 0 ? '+' : '') + val + ' dB';\
      if (bassFilter) bassFilter.gain.value = parseFloat(val);\
    }\
    function updateMid(val) {\
      document.getElementById('midValDisplay').innerText = (val > 0 ? '+' : '') + val + ' dB';\
      if (midFilter) midFilter.gain.value = parseFloat(val);\
    }\
    function updateDriver(val) {\
      document.getElementById('driverValDisplay').innerText = (val > 0 ? '+' : '') + val + ' dB';\
      if (driverFilter) driverFilter.gain.value = parseFloat(val);\
    }\
    function updateTweeter(val) {\
      document.getElementById('tweeterValDisplay').innerText = (val > 0 ? '+' : '') + val + ' dB';\
      if (tweeterFilter) tweeterFilter.gain.value = parseFloat(val);\
    }\
\
    function renderPlaylist() {\
      const list = document.getElementById('playlistList');\
      list.innerHTML = '';\
      playlist.forEach((item, index) => {\
        const li = document.createElement('li');\
        li.innerText = (index + 1) + ". " + item.name;\
        if (index === currentIndex) li.className = 'active';\
        li.onclick = () => playTrack(index);\
        list.appendChild(li);\
      });\
    }\
\
    function playTrack(index) {\
      if (playlist.length === 0) return;\
      currentIndex = index;\
      audio.src = playlist[currentIndex].url;\
      document.getElementById('currentTrackDisplay').innerText = "Tocando (" + (currentIndex + 1) + "/" + playlist.length + "): " + playlist[currentIndex].name;\
\
      initAudioEngine();\
      audio.play().catch(e => console.log("Aguardando interacao"));\
      renderPlaylist();\
    }\
\
    function togglePlay() {\
      if (!audio.src && playlist.length > 0) playTrack(0);\
      else if (audio.paused) {\
        initAudioEngine();\
        audio.play();\
      } else {\
        audio.pause();\
      }\
    }\
\
    function nextTrack() {\
      if (playlist.length === 0) return;\
      currentIndex = (currentIndex + 1) % playlist.length;\
      playTrack(currentIndex);\
    }\
\
    function prevTrack() {\
      if (playlist.length === 0) return;\
      currentIndex = (currentIndex - 1 + playlist.length) % playlist.length;\
      playTrack(currentIndex);\
    }\
\
    audio.onended = nextTrack;\
\
    // DESENHAR CAIXA COM REPARTI√Éß√ÉµES SEPARADAS\
    function atualizarCaixaVisual() {\
      const wQty = parseInt(document.getElementById('wooferQty').value) || 0;\
      const wSize = document.getElementById('wooferSize').value;\
      const mQty = parseInt(document.getElementById('midQty').value) || 0;\
      const hQty = parseInt(document.getElementById('hornQty').value) || 0;\
      const hFormat = document.getElementById('hornFormat').value;\
      const tQty = parseInt(document.getElementById('tweeterQty').value) || 0;\
\
      // 1. Reparti√ß√£o Cornetas & Tweeters\
      const boxHornsTweeters = document.getElementById('partitionHornsTweeters');\
      boxHornsTweeters.innerHTML = '';\
      for(let i=0; i<hQty; i++) {\
        const h = document.createElement('div');\
        h.className = 'speaker-horn ' + hFormat;\
        h.innerText = 'DRIVER';\
        boxHornsTweeters.appendChild(h);\
      }\
      for(let i=0; i<tQty; i++) {\
        const t = document.createElement('div');\
        t.className = 'speaker-tweeter';\
        t.innerText = 'TW';\
        boxHornsTweeters.appendChild(t);\
      }\
\
      // 2. Reparti√ß√£o M√©dios\
      const boxMids = document.getElementById('partitionMids');\
      boxMids.innerHTML = '';\
      for(let i=0; i<mQty; i++) {\
        const m = document.createElement('div');\
        m.className = 'speaker-mid';\
        m.innerHTML = '<div class="inner"></div>';\
        boxMids.appendChild(m);\
      }\
\
      // 3. Reparti√ß√£o Woofers / Subs\
      const boxWoofers = document.getElementById('partitionWoofers');\
      boxWoofers.innerHTML = '';\
      for(let i=0; i<wQty; i++) {\
        const w = document.createElement('div');\
        w.className = 'speaker-woofer';\
        w.style.width = wSize == '18' ? '100px' : (wSize == '15' ? '85px' : '72px');\
        w.style.height = w.style.width;\
        w.innerHTML = '<div class="inner"></div>';\
        boxWoofers.appendChild(w);\
      }\
    }\
\
    function gerarProjeto() {\
      const p = document.getElementById('player').value;\
      const wSize = document.getElementById('wooferSize').value;\
      const wQty = parseInt(document.getElementById('wooferQty').value) || 0;\
      const wRms = parseInt(document.getElementById('wooferRms').value) || 0;\
      const mQty = parseInt(document.getElementById('midQty').value) || 0;\
      const mRms = parseInt(document.getElementById('midRms').value) || 0;\
      const hQty = parseInt(document.getElementById('hornQty').value) || 0;\
      const tQty = parseInt(document.getElementById('tweeterQty').value) || 0;\
\
      const batQty = parseInt(document.getElementById('batteryQty').value) || 1;\
      const batAhUnit = parseInt(document.getElementById('batteryAh').value) || 150;\
      const totalAh = batQty * batAhUnit;\
      const fonte = document.getElementById('fontePower').value;\
\
      const totalRms = (wQty * wRms) + (mQty * mRms) + (hQty * 150) + (tQty * 100);\
      const cabo = totalRms <= 3000 ? "35mm¬≤" : "50mm¬≤ 100% Cobre";\
\
      document.getElementById('relatorioOutput').textContent = \
"=======================================================\n" +\
"ÉøÉªÉÄÔ∏ÉØ RELAT√É≥RIO DO SISTEMA AUTOMOTIVO PRO\n" +\
"=======================================================\n\n" +\
"ÉøÉ≥ª PLAYER CENTRAL:\n  ‚ÄÉÇ " + p + "\n\n" +\
"ÉøÉ≥¶ CAIXA Trio / PARED√É£O (REPARTI√Éß√ÉµES):\n" +\
"  ‚ÄÉÇ Caixa de Grave: " + wQty + "x Woofers de " + wSize + '" (' + wRms + "W RMS cada)\n" +\
"  ‚ÄÉÇ Caixa de M√©dio: " + mQty + "x Falantes de M√©dio (" + mRms + "W RMS cada)\n" +\
"  ‚ÄÉÇ Reparti√ß√£o Agudos: " + hQty + "x Cornetas/Drivers + " + tQty + "x Tweeters\n\n" +\
"‚É∫ÉÅ EL√É©TRICA, BATERIA E BARRAMENTO (~" + totalRms + "W RMS Total):\n" +\
"  ‚ÄÉÇ Baterias Instaladas: " + batQty + "x de " + batAhUnit + "Ah (" + totalAh + " Ah Total)\n" +\
"  ‚ÄÉÇ Fonte Automotiva: " + (fonte > 0 ? fonte + " Amperes" : "Sem Fonte Externa") + "\n" +\
"  ‚ÄÉÇ Fia√ß√£o do Barramento: " + cabo + "\n" +\
"  ‚ÄÉÇ Volt√≠metro: Leitura instant√ÉÇnea por pico de grave ativa.";\
    }\
\
    atualizarCaixaVisual();\
  </script>\
</body>\
</html>\
EOF\
\
