cat << 'EOF' > $PREFIX/bin/ligar\
#!/bin/bash\
pkill -f node\
pkill -f cloudflared\
rm -f ~/cf.log\
clear\
\
echo "========================================"\
echo "      ‚É∫ÉÅ SPEED R√ÅDIO - LIGANDO...       "\
echo "========================================"\
\
node ~/minha-radio/server.js > /dev/null 2>&1 &\
cloudflared tunnel --url http://localhost:3000 > ~/cf.log 2>&1 &\
\
echo -n "‚ÉØ≥ Conectando ao servidor e gerando link"\
while ! grep -q "trycloudflare.com" ~/cf.log 2>/dev/null; do\
    echo -n "."\
    sleep 1\
done\
\
echo ""\
echo ""\
echo "========================================"\
echo "ÉøÉ¥É∑ LINK DA SUA R√ÅDIO PRONTO ABAIXO:"\
echo "----------------------------------------"\
grep -o 'https://[a-zA-Z0-9-]*\.trycloudflare\.com' ~/cf.log | head -n 1\
echo "========================================"\
EOF\
\
chmod +x $PREFIX/bin/ligar\

