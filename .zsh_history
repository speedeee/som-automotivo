\
    <!-- Banner de Promo√ß√£o com Contador Regressivo -->\
    <div class="promo-banner">\
        <h3 style="margin: 0;">ÉøÉ¥• PROMO√Éß√É£O REL√ÇMPAGO</h3>\
        <p style="margin: 5px 0 0 0;">Descontos exclusivos por tempo limitado!</p>\
        <div class="timer" id="countdown">02:59:45</div>\
    </div>\
\
    <!-- Selos de Seguran√ßa e Confian√ßa -->\
    <div class="security-box" style="display: flex; justify-content: space-around; text-align: center; font-size: 13px; border-left-color: #00cc66; padding: 10px;">\
