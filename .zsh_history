\
        function verAba(aba) {\
            document.getElementById('abaOuvinte').style.display = aba === 'ouvinte' ? 'block' : 'none';\
            document.getElementById('abaAdm').style.display = aba === 'adm' ? 'block' : 'none';\
            document.getElementById('btnTabOuvinte').classList.toggle('active-tab', aba === 'ouvinte');\
            document.getElementById('btnTabAdm').classList.toggle('active-tab', aba === 'adm');\
        }\
\
        function fazerLogin() {\
            const email = document.getElementById('loginEmail').value;\
            const password = document.getElementById('loginPass').value;\
\
            fetch('/api/login', {\
                method: 'POST',\
                headers: { 'Content-Type': 'application/json' },\
                body: JSON.stringify({ email, password })\
            })\
            .then(res => res.json())\
            .then(data => {\
                if(data.success) {\
                    localStorage.setItem('adm_token', data.token);\
                    carregarPainel();\
                } else {\
                    alert(data.message);\
                }\
            });\
        }\
\
        function carregarPainel() {\
            if(localStorage.getItem('adm_token')) {\
                document.getElementById('areaLogin').style.display = 'none';\
                document.getElementById('areaDj').style.display = 'block';\
            }\
        }\
\
        function logout() {\
            localStorage.removeItem('adm_token');\
            document.getElementById('areaLogin').style.display = 'block';\
            document.getElementById('areaDj').style.display = 'none';\
        }\
\
        function extrairPlayer(url) {\
            if (!url) return null;\
\
            let ytMatch = url.match(/(?:youtu\.be\/|youtube\.com\/(?:embed\/|v\/|watch\?v=|watch\?.+&v=))([\w-]{11})/);\
            if (ytMatch && ytMatch[1]) {\
                return {\
                    tipo: 'youtube',\
                    embedUrl: `https://www.youtube.com/embed/${ytMatch[1]}?autoplay=1&enablejsapi=1`\
                };\
            }\
\
            if (url.includes('spotify.com')) {\
                let spotUrl = url.replace('open.spotify.com/', 'open.spotify.com/embed/');\
                return {\
                    tipo: 'spotify',\
                    embedUrl: spotUrl\
                };\
            }\
\
            if (url.includes('soundcloud.com')) {\
                return {\
                    tipo: 'soundcloud',\
                    embedUrl: `https://w.soundcloud.com/player/?url=${encodeURIComponent(url)}&color=%23ff5500&auto_play=true`\
                };\
            }\
\
            return {\
                tipo: 'audio',\
                src: url\
            };\
        }\
\
        socket.on('novaMusica', (data) => {\
            playerContainer.innerHTML = '';\
\
            if (data && data.musica) {\
                status.innerText = 'Tocando agora: ' + data.musica;\
                const info = extrairPlayer(data.musica);\
\
                if (info.tipo === 'audio') {\
                    const audioEl = document.createElement('audio');\
                    audioEl.src = info.src;\
                    audioEl.controls = true;\
                    audioEl.autoplay = true;\
                    if (data.tempoDecorrido) audioEl.currentTime = data.tempoDecorrido;\
                    playerContainer.appendChild(audioEl);\
                    audioEl.play().catch(() => {});\
                } else {\
                    const iframeEl = document.createElement('iframe');\
                    iframeEl.src = info.embedUrl;\
                    iframeEl.allow = "autoplay; clipboard-write; encrypted-media; picture-in-picture";\
                    playerContainer.appendChild(iframeEl);\
                }\
            } else {\
                status.innerText = 'Status: Nenhuma m√∫sica na fila';\
            }\
        });\
\
        socket.on('atualizarFila', (lista) => {\
            filaOuvinte.innerHTML = '';\
            filaAdm.innerHTML = '';\
            \
            lista.forEach((item, index) => {\
                let platformTag = ' [Link]';\
                if (item.includes('youtu')) platformTag = ' <span class="badge-plat">YouTube</span>';\
                else if (item.includes('spotify')) platformTag = ' <span class="badge-plat">Spotify</span>';\
                else if (item.includes('soundcloud')) platformTag = ' <span class="badge-plat">SoundCloud</span>';\
                else if (item.includes('.mp3')) platformTag = ' <span class="badge-plat">MP3</span>';\
\
                filaOuvinte.innerHTML += `<li><span>${index + 1}. ${item}${platformTag}</span></li>`;\
                filaAdm.innerHTML += `<li><span>${index + 1}. ${item}${platformTag}</span> <button class="btn-danger" style="padding:2px 8px;" onclick="remover(${index})">X</button></li>`;\
            });\
        });\
\
        function adicionarOuvinte() {\
            const input = document.getElementById('linkMusicaOuvinte');\
            if (input.value.trim() !== '') {\
                socket.emit('adicionarMusica', input.value.trim());\
                input.value = '';\
                alert('M√∫sica enviada para a SPEED R√ÅDIO com sucesso!');\
            }\
        }\
\
        function adicionarAdm() {\
            const input = document.getElementById('linkMusicaAdm');\
            if (input.value.trim() !== '') {\
                socket.emit('adicionarMusica', input.value.trim());\
                input.value = '';\
            }\
        }\
\
        function pular() { socket.emit('proximaMusica'); }\
        function remover(index) { socket.emit('removerMusica', index); }\
        function limparFila() { socket.emit('limparFila'); }\
\
        let mediaRecorder;\
        let isRecording = false;\
\
        async function toggleMicrofone() {\
            const btn = document.getElementById('btnMicrofone');\
            const statusMic = document.getElementById('statusMic');\
\
            if (!isRecording) {\
                try {\
                    const stream = await navigator.mediaDevices.getUserMedia({ audio: true });\
                    mediaRecorder = new MediaRecorder(stream, { mimeType: 'audio/webm' });\
                    \
                    mediaRecorder.ondataavailable = (event) => {\
                        if (event.data.size > 0) {\
                            socket.emit('streamAudio', event.data);\
                        }\
                    };\
\
                    mediaRecorder.start(250);\
                    isRecording = true;\
                    btn.classList.add('recording');\
                    btn.innerText = 'ÉøÉªÉ± Desligar Microfone';\
                    statusMic.innerText = 'ÉøÉ¥¥ AO VIVO NO MICROFONE';\
                } catch (err) {\
                    alert('Erro ao acessar o microfone: ' + err.message);\
                }\
            } else {\
                mediaRecorder.stop();\
                socket.emit('pararStream');\
                isRecording = false;\
                btn.classList.remove('recording');\
                btn.innerText = 'ÉøÉÆÉπÔ∏ÉØ Ligar Microfone';\
                statusMic.innerText = 'Microfone Desligado';\
            }\
        }\
\
        socket.on('receberAudioLive', (data) => {\
            document.getElementById('statusAoVivo').style.display = 'block';\
            let blob = new Blob([data], { type: 'audio/webm' });\
            let audioURL = URL.createObjectURL(blob);\
            let liveAudio = new Audio(audioURL);\
            liveAudio.play().catch(() => {});\
        });\
\
        socket.on('fimAudioLive', () => {\
            document.getElementById('statusAoVivo').style.display = 'none';\
        });\
\
        carregarPainel();\
    </script>\
</body>\
</html>\
EOF\

