: 1786209948:0;cat << 'EOF' > index.html\
<!DOCTYPE html>\
<html lang="pt-BR">\
<head>\
  <meta charset="UTF-8">\
  <meta name="viewport" content="width=device-width, initial-scale=1.0">\
  <title>Simulador Master PRO - Som Automotivo Realista</title>\
  <style>\
    :root {\
      --bg-dark: #04060c;\
      --card-bg: #0b1120;\
      --border-color: #1e293b;\
      --accent-red: #ff0055;\
      --neon-cyan: #00f0ff;\
      --neon-yellow: #ffcc00;\
      --neon-green: #00ff66;\
      --led-color1: #00f0ff;\
      --led-color2: #ff0055;\
      --caixa-bg-color: #18181b;\
      --caixa-texture: none;\
      --text-main: #f8fafc;\
    }\
\
    body {\
      background-color: var(--bg-dark);\
      background-size: cover;\
      background-position: center;\
      background-attachment: fixed;\
      color: var(--text-main);\
      font-family: 'Segoe UI', Roboto, sans-serif;\
      margin: 0;\
      padding: 10px;\
      padding-bottom: 75px;\
    }\
\
    h1 {\
      text-align: center;\
      color: var(--accent-red);\
      font-size: 16px;\
      margin: 6px 0 12px 0;\
      text-transform: uppercase;\
      letter-spacing: 1px;\
      text-shadow: 0 0 10px var(--led-color1);\
    }\
\
    /* MENU SUPERIOR E DE RODAP√É© PARA NAVEGA√Éß√É£O ENTRE TELAS */\
    .tab-bar {\
      position: fixed;\
      bottom: 0;\
      left: 0;\
      right: 0;\
      background: #020617;\
      border-top: 2px solid var(--border-color);\
      display: flex;\
      justify-content: space-around;\
      padding: 8px 4px;\
      z-index: 1000;\
      backdrop-filter: blur(10px);\
    }\
\
    .tab-btn {\
      background: none;\
      border: none;\
      color: #64748b;\
      font-size: 10px;\
      display: flex;\
      flex-direction: column;\
      align-items: center;\
      gap: 3px;\
      cursor: pointer;\
      font-weight: bold;\
      text-transform: uppercase;\
      flex: 1;\
    }\
\
    .tab-btn span { font-size: 16px; }\
\
    .tab-btn.active {\
      color: var(--neon-cyan);\
      text-shadow: 0 0 8px var(--neon-cyan);\
    }\
\
    /* SISTEMA DE TELAS SEPARADAS */\
    .screen {\
      display: none;\
    }\
\
    .screen.active {\
      display: block;\
      animation: fadeIn 0.2s ease-in-out;\
    }\
\
    @keyframes fadeIn {\
      from { opacity: 0; transform: translateY(4px); }\
      to { opacity: 1; transform: translateY(0); }\
    }\
\
    .card {\
      background: rgba(11, 17, 32, 0.92);\
      border: 1px solid var(--border-color);\
      border-radius: 10px;\
      padding: 12px;\
      margin-bottom: 12px;\
      box-shadow: 0 4px 15px rgba(0,0,0,0.8);\
    }\
\
    .card h3 {\
      font-size: 12px;\
      color: var(--neon-cyan);\
      text-transform: uppercase;\
      margin-top: 0;\
      border-bottom: 1px solid var(--border-color);\
      padding-bottom: 6px;\
      margin-bottom: 10px;\
      display: flex;\
      align-items: center;\
      gap: 6px;\
    }\
\
    /* PALCO REALISTA */\
    .palco-container {\
      background: #000;\
      border: 3px solid var(--led-color1);\
      border-radius: 12px;\
      padding: 15px;\
      display: flex;\
      flex-direction: column;\
      align-items: center;\
      gap: 12px;\
      position: relative;\
      box-shadow: inset 0 0 30px rgba(0,0,0,0.9), 0 0 15px var(--led-color1);\
    }\
\
    .palco-container.led-giratorio {\
      animation: rotateLed 3s linear infinite;\
    }\
\
    .palco-container.led-pisca {\
      animation: piscaLed 0.3s infinite alternate;\
    }\
\
    @keyframes rotateLed {\
      0% { filter: hue-rotate(0deg); }\
      100% { filter: hue-rotate(360deg); }\
    }\
\
    @keyframes piscaLed {\
      0% { opacity: 0.4; }\
      100% { opacity: 1; box-shadow: 0 0 25px var(--led-color1); }\
    }\
\
    /* CAIXA AC√É∫STICA REALISTA */\
    .caixa-acustica {\
      background-color: var(--caixa-bg-color);\
      background-image: var(--caixa-texture);\
      background-size: cover;\
      background-position: center;\
      border: 4px solid #27272a;\
      border-radius: 10px;\
      padding: 15px;\
      width: 100%;\
      box-sizing: border-box;\
      display: flex;\
      flex-direction: column;\
      align-items: center;\
      gap: 12px;\
      box-shadow: inset 0 0 25px #000;\
    }\
\
    .painel-cornetas, .painel-woofers, .painel-dutos {\
      display: flex;\
      flex-wrap: wrap;\
      justify-content: center;\
      gap: 10px;\
      width: 100%;\
    }\
\
    /* DUTOS */\
    .duto-redondo {\
      width: 40px;\
      height: 40px;\
      border-radius: 50%;\
      background: radial-gradient(circle, #000 35%, #18181b 75%, #3f3f46 100%);\
      border: 3px solid var(--led-color1);\
      box-shadow: inset 0 0 8px #000, 0 0 10px var(--led-color1);\
    }\
\
    .duto-quadrado {\
      width: 90%;\
      height: 20px;\
      background: linear-gradient(180deg, #000 0%, #18181b 100%);\
      border: 2px solid var(--led-color1);\
      border-radius: 4px;\
      box-shadow: inset 0 0 10px #000, 0 0 10px var(--led-color1);\
    }\
\
    .duto-triangular {\
      width: 0;\
      height: 0;\
      border-left: 18px solid transparent;\
      border-right: 18px solid transparent;\
      border-bottom: 30px solid #111;\
      filter: drop-shadow(0 0 4px var(--led-color1));\
    }\
\
    /* FALANTES REALISTAS */\
    .real-woofer {\
      width: 80px;\
      height: 80px;\
      border-radius: 50%;\
      background: radial-gradient(circle, #27272a 15%, #09090b 55%, #18181b 85%, #000 100%);\
      border: 5px solid #3f3f46;\
      outline: 2px solid var(--led-color2);\
      box-shadow: inset 0 0 12px #000, 0 0 10px var(--led-color2);\
      position: relative;\
      display: flex;\
      align-items: center;\
      justify-content: center;\
      font-size: 8px;\
      font-weight: 900;\
      color: #e4e4e7;\
      text-transform: uppercase;\
      transition: transform 0.05s ease-in-out;\
    }\
\
    .real-woofer::after {\
      content: '';\
      width: 26px;\
      height: 26px;\
      border-radius: 50%;\
      background: radial-gradient(circle, #52525b 0%, #18181b 100%);\
      border: 1px solid #71717a;\
    }\
\
    .real-driver {\
      width: 50px;\
      height: 50px;\
      background: linear-gradient(145deg, #27272a, #09090b);\
      border: 2px solid #a1a1aa;\
      outline: 1px solid var(--led-color1);\
      color: var(--neon-cyan);\
      font-size: 8px;\
      font-weight: bold;\
      display: flex;\
      align-items: center;\
      justify-content: center;\
      box-shadow: 0 0 8px var(--led-color1);\
    }\
\
    .driver-square { border-radius: 4px; }\
    .driver-round { border-radius: 50%; }\
    .driver-guia { width: 90px; height: 32px; border-radius: 4px; }\
\
    .real-woofer.vibrando { animation: pulsoReal 0.08s infinite alternate; }\
    .real-woofer.xtreme-pulse { animation: pulsoXtremeReal 0.05s infinite alternate; }\
\
    @keyframes pulsoReal {\
      0% { transform: scale(1); }\
      100% { transform: scale(1.12); box-shadow: 0 0 18px var(--led-color2); }\
    }\
\
    @keyframes pulsoXtremeReal {\
      0% { transform: scale(1.02); }\
      100% { transform: scale(1.25); box-shadow: 0 0 25px var(--accent-red); }\
    }\
\
    /* PLAYERS REALISTAS */\
    .player-pioneer-real {\
      background: linear-gradient(180deg, #111 0%, #000 100%);\
      border: 3px solid #333;\
      border-radius: 6px;\
      padding: 8px 12px;\
      display: flex;\
      justify-content: space-between;\
      align-items: center;\
      box-shadow: inset 0 0 10px #000, 0 4px 10px rgba(0,0,0,0.8);\
      width: 100%;\
      box-sizing: border-box;\
    }\
\
    .pioneer-knob {\
      width: 28px;\
      height: 28px;\
      border-radius: 50%;\
      background: radial-gradient(circle, #555 20%, #111 80%);\
      border: 2px solid #888;\
    }\
\
    .pioneer-display {\
      background: #000;\
      border: 1px solid #00f0ff;\
      color: #00f0ff;\
      font-family: monospace;\
      font-size: 10px;\
      padding: 4px 10px;\
      border-radius: 4px;\
      text-shadow: 0 0 6px #00f0ff;\
    }\
\
    /* VOLT√É≠METRO */\
    .voltimetro-card {\
      background: radial-gradient(circle, #111 0%, #000 100%);\
      border: 2px solid var(--accent-red);\
      text-align: center;\
      border-radius: 8px;\
      padding: 10px;\
    }\
\
    .voltimetro-valor {\
      font-size: 38px;\
      font-weight: 900;\
      color: #ff2a2a;\
      text-shadow: 0 0 15px #ff0000;\
      font-family: monospace;\
      margin: 2px 0;\
    }\
\
    /* CONTROLES E INPUTS */\
    label {\
      display: block;\
      font-size: 10px;\
      color: #94a3b8;\
      margin-top: 6px;\
      text-transform: uppercase;\
      font-weight: 600;\
    }\
\
    select, input[type="text"], input[type="number"], input[type="range"] {\
      width: 100%;\
      padding: 8px;\
      margin-top: 3px;\
      background: #020617;\
      border: 1px solid #334155;\
      color: #fff;\
      border-radius: 6px;\
      box-sizing: border-box;\
      font-size: 11px;\
    }\
\
    .grid-2 { display: flex; gap: 8px; }\
    .grid-2 > div { flex: 1; }\
\
    .btn-xtreme {\
      width: 100%;\
      background: #1e293b;\
      color: #888;\
      border: 2px solid #334155;\
      padding: 10px;\
      font-weight: 900;\
      border-radius: 6px;\
      font-size: 12px;\
      cursor: pointer;\
      margin-top: 10px;\
      text-transform: uppercase;\
    }\
\
    .btn-xtreme.active {\
      background: linear-gradient(90deg, #ff0055, #ff5500);\
      color: #fff;\
      border-color: #ff0055;\
      box-shadow: 0 0 15px rgba(255, 0, 85, 0.8);\
    }\
\
    .playlist-box {\
      background: #020617;\
      border: 1px solid #1e293b;\
      border-radius: 6px;\
      padding: 6px;\
      max-height: 90px;\
      overflow-y: auto;\
      font-size: 10px;\
      margin-top: 6px;\
    }\
\
    .playlist-item {\
      padding: 4px;\
      border-bottom: 1px solid #0f172a;\
      cursor: pointer;\
      color: #94a3b8;\
    }\
\
    .playlist-item.ativo {\
      color: #fff;\
      background: var(--accent-red);\
      font-weight: bold;\
      border-radius: 3px;\
    }\
\
    textarea {\
      width: 100%;\
      height: 180px;\
      background: #020617;\
      color: #00ffcc;\
      border: 1px solid var(--neon-cyan);\
      border-radius: 6px;\
      padding: 8px;\
      font-family: monospace;\
      font-size: 10px;\
      box-sizing: border-box;\
      margin-top: 6px;\
    }\
  </style>\
</head>\
<body>\
\
  <h1>ÉøÉ¥É™ SIMULADOR MASTER PRO</h1>\
\
  <div id="screen-palco" class="screen active">\
    <div class="card">\
      <h3>ÉøÉ≥ª Palco do Som & Player Ativo</h3>\
      <div class="palco-container" id="palcoVirtual">\
        <div class="caixa-acustica" id="caixaAcustica">\
          <div class="painel-cornetas" id="painelCornetas"></div>\
          <div class="painel-woofers" id="painelWoofers"></div>\
          <div class="painel-dutos" id="painelDutos"></div>\
        </div>\
      </div>\
      <div id="playerContainer" style="margin-top: 10px;"></div>\
    </div>\
\
    <div class="card">\
      <h3>ÉøÉÆµ Player de M√∫sicas MP3</h3>\
      <input type="file" id="audioFiles" multiple accept="audio/*" onchange="carregarPlaylist(event)">\
      <audio id="audioPlayer" style="width: 100%; margin-top: 8px;" controls crossorigin="anonymous"></audio>\
      <div class="playlist-box" id="playlistContainer">\
        <div style="color: #64748b;">Nenhum √ÉÅudio carregado...</div>\
      </div>\
    </div>\
  </div>\
\
  <div id="screen-caixa" class="screen">\
    <div class="card">\
      <h3>ÉøÉ≥¶ Estrutura Ac√∫stica & Dutos</h3>\
      <div class="grid-2">\
        <div>\
          <label>Modelo de Caixa:</label>\
          <select id="boxStructure" onchange="atualizarPalco()">\
            <option value="dutada">Dutada Tradicional</option>\
            <option value="euclides">Euclides / Trio</option>\
            <option value="manifold">Manifold / Bandpass</option>\
            <option value="canhao">Canh√£o / T18 / Turbina</option>\
            <option value="bob">Bob Sponge / Residencial</option>\
          </select>\
        </div>\
        <div>\
          <label>Tipo de Duto:</label>\
          <select id="dutoType" onchange="atualizarPalco()">\
            <option value="redondo">Redondo com LED</option>\
            <option value="quadrado">R√©gua / Retangular</option>\
            <option value="triangular">Triangular / Canto</option>\
          </select>\
        </div>\
      </div>\
    </div>\
\
    <div class="card">\
      <h3>ÉøÉÆ® Material & Fundo da Caixa</h3>\
      <div class="grid-2">\
        <div>\
          <label>Revestimento:</label>\
          <select id="boxMaterial" onchange="alterarMaterialCaixa()">\
            <option value="padrao">Padr√£o Grafitado</option>\
            <option value="couro">Couro Preto Costurado</option>\
            <option value="carbono">Vinil Fibra de Carbono 3D</option>\
            <option value="mdf">Madeira / MDF Cru</option>\
            <option value="liso">Pintura Liso Gloss</option>\
          </select>\
        </div>\
        <div>\
          <label>Cor Interna:</label>\
          <input type="color" id="caixaBgColor" value="#18181b" onchange="alterarCorCaixa()">\
        </div>\
      </div>\
      <label>ÉøÉ≥∏ Foto da sua Galeria na Caixa:</label>\
      <input type="file" id="boxBgFile" accept="image/*" onchange="alterarFotoCaixa(event)">\
    </div>\
\
    <div class="card">\
      <h3>ÉøÉ¥É™ Alto-Falantes & Cornetas</h3>\
      <div class="grid-2">\
        <div>\
          <label>Marca Woofers:</label>\
          <select id="wooferBrand" onchange="atualizarPalco()">\
            <option value="Eros">Eros Target Bass / Hammer</option>\
            <option value="Triton">Triton Shocker / Vulcano</option>\
            <option value="Hard Power">Hard Power HP</option>\
            <option value="JBL">JBL Vulcano / Tornado</option>\
            <option value="7Driver">7Driver Bass / Thunder</option>\
          </select>\
        </div>\
        <div>\
          <label>Qtd Woofers:</label>\
          <input type="number" id="wooferQty" value="2" min="1" max="8" onchange="atualizarPalco()">\
        </div>\
      </div>\
\
      <div class="grid-2">\
        <div>\
          <label>Qtd Drivers:</label>\
          <input type="number" id="driverQty" value="2" min="0" max="8" onchange="atualizarPalco()">\
        </div>\
        <div>\
          <label>Formato Corneta:</label>\
          <select id="hornFormat" onchange="atualizarPalco()">\
            <option value="square">Jararaca / Quadrada</option>\
            <option value="round">Redonda / Oval</option>\
            <option value="guia">Guia de Onda Trio</option>\
          </select>\
        </div>\
      </div>\
    </div>\
  </div>\
\
  <div id="screen-leds" class="screen">\
    <div class="card">\
      <h3>ÉøÉ≤ÉÅ Ilumina√ß√£o & Efeitos Neon</h3>\
      <div class="grid-2">\
        <div>\
          <label>Efeito do LED:</label>\
          <select id="ledMode" onchange="atualizarLeds()">\
            <option value="estatico">Est√ÉÅtico</option>\
            <option value="pisca">Strobo / Pisca no Ritmo</option>\
            <option value="giratorio">Rainbow Girat√≥rio</option>\
          </select>\
        </div>\
        <div>\
          <label>Cor LED 1:</label>\
          <input type="color" id="ledColor1" value="#00f0ff" onchange="atualizarLeds()">\
        </div>\
      </div>\
\
      <div class="grid-2">\
        <div>\
          <label>Cor LED 2:</label>\
          <input type="color" id="ledColor2" value="#ff0055" onchange="atualizarLeds()">\
        </div>\
        <div>\
          <label>Fundo do App (Foto/GIF):</label>\
          <input type="file" id="bgFile" accept="image/*" onchange="alterarFundoApp(event)">\
        </div>\
      </div>\
    </div>\
  </div>\
\
  <div id="screen-audio" class="screen">\
    <div class="card">\
      <h3>ÉøÉÆÉª Processador DSP & Players</h3>\
      <div class="grid-2">\
        <div>\
          <label>Player do Painel:</label>\
          <select id="playerModel" onchange="atualizarPlayerUI()">\
            <option value="pioneer">Pioneer Golfinho (1DIN Real)</option>\
            <option value="android">Central Multim√≠dia Android</option>\
            <option value="expert">Expert Longa Dist√ÉÇncia</option>\
          </select>\
        </div>\
        <div>\
          <label>Processador (DSP):</label>\
          <select id="dspModel">\
            <option value="Stetsom STX2448 Digital">Stetsom STX2448 / STX2848</option>\
            <option value="Expert PX-2 PRO Bluetooth">Expert PX-1 / PX-2 PRO</option>\
            <option value="JFA X5 Crossover">JFA X5 Crossover 4 Vias</option>\
            <option value="Taramps Pro 2.4S DSP">Taramps Pro 2.4S DSP</option>\
          </select>\
        </div>\
      </div>\
    </div>\
\
    <div class="card">\
      <h3>ÉøÉÆÉª Equaliza√ß√£o & Bass Xtreme</h3>\
      <div class="grid-2">\
        <div>\
          <label>Grave (Bass):</label>\
          <input type="range" id="eqBass" min="-20" max="20" value="0" oninput="atualizarFiltrosAudio()">\
        </div>\
        <div>\
          <label>M√©dio (Mid):</label>\
          <input type="range" id="eqMid" min="-20" max="20" value="0" oninput="atualizarFiltrosAudio()">\
        </div>\
      </div>\
      <label>Agudo (High):</label>\
      <input type="range" id="eqHigh" min="-20" max="20" value="0" oninput="atualizarFiltrosAudio()">\
\
      <button class="btn-xtreme" id="btnXtreme" onclick="toggleBassXtreme()">ÉøÉ¥• BASS XTREME: DESATIVADO</button>\
    </div>\
  </div>\
\
  <div id="screen-eletrica" class="screen">\
    <div class="card">\
      <h3>‚É∫ÉÅ Monitora√ß√£o de Tens√£o (Barramento)</h3>\
      <div class="voltimetro-card">\
        <div style="font-size: 9px; color: #aaa;">VOLT√É≠METRO DIGITAL</div>\
        <div class="voltimetro-valor" id="voltsDisplay">12.6 V</div>\
        <div style="font-size: 10px; color: var(--neon-yellow);" id="alertaDisplay">SISTEMA EM REPOUSO</div>\
      </div>\
    </div>\
\
    <div class="card">\
      <h3>ÉøÉ≥É™ Dimensionamento & Relat√≥rio T√©cnico</h3>\
      <button style="width:100%; padding:10px; background:var(--neon-cyan); border:none; font-weight:bold; border-radius:6px;" onclick="gerarProjeto()">GERAR RELAT√É≥RIO T√É©CNICO</button>\
      <textarea id="relatorioOutput" readonly placeholder="O relat√≥rio detalhado aparecer√ÉÅ aqui..."></textarea>\
    </div>\
  </div>\
\
  <nav class="tab-bar">\
    <button class="tab-btn active" onclick="trocarTela('screen-palco', this)">\
      <span>ÉøÉ≥ª</span> Palco\
    </button>\
    <button class="tab-btn" onclick="trocarTela('screen-caixa', this)">\
      <span>‚É∫ÉπÔ∏ÉØ</span> Caixa\
    </button>\
    <button class="tab-btn" onclick="trocarTela('screen-leds', this)">\
      <span>ÉøÉ≤ÉÅ</span> LEDs\
    </button>\
    <button class="tab-btn" onclick="trocarTela('screen-audio', this)">\
      <span>ÉøÉÆÉª</span> √Åudio\
    </button>\
    <button class="tab-btn" onclick="trocarTela('screen-eletrica', this)">\
      <span>‚É∫ÉÅ</span> El√©trica\
    </button>\
  </nav>\
\
  <script>\
    let playlist = [];\
    let currentIndex = 0;\
    let isXtremeActive = false;\
    const audio = document.getElementById('audioPlayer');\
    let audioCtx, source, bassFilter, midFilter, highFilter;\
    let isAudioSetup = false;\
\
    function trocarTela(screenId, btn) {\
      document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));\
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));\
      document.getElementById(screenId).classList.add('active');\
      btn.classList.add('active');\
    }\
\
    function initWebAudio() {\
      if (isAudioSetup) return;\
      const AudioContext = window.AudioContext || window.webkitAudioContext;\
      audioCtx = new AudioContext();\
      source = audioCtx.createMediaElementSource(audio);\
\
      bassFilter = audioCtx.createBiquadFilter();\
      bassFilter.type = 'lowshelf';\
      bassFilter.frequency.value = 80;\
\
      midFilter = audioCtx.createBiquadFilter();\
      midFilter.type = 'peaking';\
      midFilter.frequency.value = 1000;\
\
      highFilter = audioCtx.createBiquadFilter();\
      highFilter.type = 'highshelf';\
      highFilter.frequency.value = 6000;\
\
      source.connect(bassFilter);\
      bassFilter.connect(midFilter);\
      midFilter.connect(highFilter);\
      highFilter.connect(audioCtx.destination);\
      isAudioSetup = true;\
    }\
\
    function atualizarFiltrosAudio() {\
      if (!isAudioSetup) initWebAudio();\
      const valBass = parseFloat(document.getElementById('eqBass').value);\
      const valMid = parseFloat(document.getElementById('eqMid').value);\
      const valHigh = parseFloat(document.getElementById('eqHigh').value);\
\
      bassFilter.gain.value = valBass + (isXtremeActive ? 15 : 0);\
      midFilter.gain.value = valMid;\
      highFilter.gain.value = valHigh;\
    }\
\
    function toggleBassXtreme() {\
      isXtremeActive = !isXtremeActive;\
      const btn = document.getElementById('btnXtreme');\
      if (isXtremeActive) {\
        btn.classList.add('active');\
        btn.innerText = 'ÉøÉ¥• BASS XTREME: ATIVADO (+15dB SUBGUTURAL)';\
      } else {\
        btn.classList.remove('active');\
        btn.innerText = 'ÉøÉ¥• BASS XTREME: DESATIVADO';\
      }\
      atualizarFiltrosAudio();\
    }\
\
    function atualizarLeds() {\
      const mode = document.getElementById('ledMode').value;\
      const c1 = document.getElementById('ledColor1').value;\
      const c2 = document.getElementById('ledColor2').value;\
      const palco = document.getElementById('palcoVirtual');\
\
      document.documentElement.style.setProperty('--led-color1', c1);\
      document.documentElement.style.setProperty('--led-color2', c2);\
\
      palco.classList.remove('led-pisca', 'led-giratorio');\
      if (mode === 'pisca') palco.classList.add('led-pisca');\
      if (mode === 'giratorio') palco.classList.add('led-giratorio');\
    }\
\
    function alterarCorCaixa() {\
      const color = document.getElementById('caixaBgColor').value;\
      document.documentElement.style.setProperty('--caixa-bg-color', color);\
    }\
\
    function alterarMaterialCaixa() {\
      const mat = document.getElementById('boxMaterial').value;\
      let texture = 'none';\
\
      if (mat === 'couro') {\
        texture = 'radial-gradient(circle, rgba(0,0,0,0.6) 0%, rgba(0,0,0,0.9) 100%)';\
        document.documentElement.style.setProperty('--caixa-bg-color', '#111113');\
      } else if (mat === 'carbono') {\
        texture = 'linear-gradient(45deg, #111 25%, #222 25%, #222 50%, #111 50%, #111 75%, #222 75%, #222 100%)';\
        document.documentElement.style.setProperty('--caixa-bg-color', '#0a0a0c');\
      } else if (mat === 'mdf') {\
        texture = 'linear-gradient(180deg, rgba(160,82,45,0.8) 0%, rgba(110,50,20,0.9) 100%)';\
        document.documentElement.style.setProperty('--caixa-bg-color', '#8B4513');\
      } else {\
        texture = 'radial-gradient(circle, #18181b 0%, #09090b 100%)';\
        document.documentElement.style.setProperty('--caixa-bg-color', '#18181b');\
      }\
\
      document.documentElement.style.setProperty('--caixa-texture', texture);\
    }\
\
    function alterarFotoCaixa(event) {\
      const file = event.target.files[0];\
      if (file) {\
        const url = URL.createObjectURL(file);\
        document.documentElement.style.setProperty('--caixa-texture', `url('${url}')`);\
      }\
    }\
\
    function alterarFundoApp(event) {\
      const file = event.target.files[0];\
      if (file) {\
        const url = URL.createObjectURL(file);\
        document.body.style.backgroundImage = `url('${url}')`;\
      }\
    }\
\
    function atualizarPalco() {\
      const wooferQty = parseInt(document.getElementById('wooferQty').value) || 2;\
      const wooferBrand = document.getElementById('wooferBrand').value;\
      const driverQty = parseInt(document.getElementById('driverQty').value) || 2;\
      const hornFormat = document.getElementById('hornFormat').value;\
      const dutoType = document.getElementById('dutoType').value;\
\
      const pCornetas = document.getElementById('painelCornetas');\
      const pWoofers = document.getElementById('painelWoofers');\
      const pDutos = document.getElementById('painelDutos');\
\
      pCornetas.innerHTML = '';\
      pWoofers.innerHTML = '';\
      pDutos.innerHTML = '';\
\
      for(let i = 0; i < driverQty; i++) {\
        const driver = document.createElement('div');\
        let shapeClass = 'driver-square';\
        if (hornFormat === 'round') shapeClass = 'driver-round';\
        if (hornFormat === 'guia') shapeClass = 'driver-guia';\
\
        driver.className = `real-driver ${shapeClass}`;\
        driver.innerText = 'DRIVER';\
        pCornetas.appendChild(driver);\
      }\
\
      for(let i = 0; i < wooferQty; i++) {\
        const woofer = document.createElement('div');\
        woofer.className = 'real-woofer';\
        woofer.innerText = wooferBrand;\
        pWoofers.appendChild(woofer);\
      }\
\
      if (dutoType === 'quadrado') {\
        const duto = document.createElement('div');\
        duto.className = 'duto-quadrado';\
        pDutos.appendChild(duto);\
      } else if (dutoType === 'triangular') {\
        for(let i = 0; i < 2; i++) {\
          const duto = document.createElement('div');\
          duto.className = 'duto-triangular';\
          pDutos.appendChild(duto);\
        }\
      } else {\
        for(let i = 0; i < 2; i++) {\
          const duto = document.createElement('div');\
          duto.className = 'duto-redondo';\
          pDutos.appendChild(duto);\
        }\
      }\
\
      atualizarPlayerUI();\
    }\
\
    function atualizarPlayerUI() {\
      const model = document.getElementById('playerModel').value;\
      const container = document.getElementById('playerContainer');\
      const currentTrack = playlist[currentIndex] ? playlist[currentIndex].name : "BLUETOOTH READY";\
\
      if (model === 'pioneer') {\
        container.innerHTML = `\
          <div class="player-pioneer-real">\
            <div class="pioneer-knob"></div>\
            <div class="pioneer-display">ÉøÉ∞¨ ${currentTrack}</div>\
            <span style="color:#666; font-size:9px; font-weight:bold;">PIONEER</span>\
          </div>\
        `;\
      } else if (model === 'android') {\
        container.innerHTML = `\
          <div class="player-pioneer-real" style="border-color:#00ff66;">\
            <span style="color:#00ff66; font-size:9px; font-weight:bold;">ANDROID TOUCH</span>\
            <div class="pioneer-display" style="border-color:#00ff66; color:#00ff66;">‚É∂∂ ${currentTrack}</div>\
          </div>\
        `;\
      } else {\
        container.innerHTML = `\
          <div class="player-pioneer-real" style="border-color:#a855f7;">\
            <span style="color:#a855f7; font-size:9px; font-weight:bold;">EXPERT CONTROL</span>\
            <div class="pioneer-display" style="border-color:#a855f7; color:#e879f9;">ÉøÉ≥∂ ${currentTrack}</div>\
          </div>\
        `;\
      }\
    }\
\
    function carregarPlaylist(event) {\
      const files = event.target.files;\
      if (!files.length) return;\
      playlist = Array.from(files);\
      currentIndex = 0;\
      renderPlaylist();\
      tocarMusica(currentIndex);\
    }\
\
    function renderPlaylist() {\
      const container = document.getElementById('playlistContainer');\
      container.innerHTML = '';\
      playlist.forEach((file, index) => {\
        const item = document.createElement('div');\
        item.className = 'playlist-item' + (index === currentIndex ? ' ativo' : '');\
        item.innerText = `${index + 1}. ${file.name}`;\
        item.onclick = () => tocarMusica(index);\
        container.appendChild(item);\
      });\
    }\
\
    function tocarMusica(index) {\
      if (index < 0 || index >= playlist.length) return;\
      currentIndex = index;\
      const file = playlist[currentIndex];\
      audio.src = URL.createObjectURL(file);\
      if (audioCtx && audioCtx.state === 'suspended') audioCtx.resume();\
      audio.play();\
      renderPlaylist();\
      atualizarPlayerUI();\
    }\
\
    audio.onplay = () => {\
      if (!isAudioSetup) initWebAudio();\
      document.querySelectorAll('.real-woofer').forEach(w => {\
        w.classList.remove('vibrando', 'xtreme-pulse');\
        w.classList.add(isXtremeActive ? 'xtreme-pulse' : 'vibrando');\
      });\
      document.getElementById('voltsDisplay').innerText = isXtremeActive ? '9.8 V' : '10.9 V';\
      document.getElementById('alertaDisplay').innerText = '‚É∫ÉÅ CONSUMO ATIVO / PICO DE GRAVE';\
    };\
\
    audio.onpause = () => {\
      document.querySelectorAll('.real-woofer').forEach(w => w.classList.remove('vibrando', 'xtreme-pulse'));\
      document.getElementById('voltsDisplay').innerText = '12.6 V';\
      document.getElementById('alertaDisplay').innerText = 'SISTEMA EM REPOUSO';\
    };\
\
    function gerarProjeto() {\
      const dsp = document.getElementById('dspModel').value;\
      const player = document.getElementById('playerModel').value;\
      const wooferBrand = document.getElementById('wooferBrand').value;\
      const qty = parseInt(document.getElementById('wooferQty').value) || 2;\
      const driverQty = parseInt(document.getElementById('driverQty').value) || 0;\
\
      const totalRmsGeral = (qty * 1500) + (driverQty * 160);\
      const batAh = Math.round(totalRmsGeral / 18);\
      const fonteAmperes = Math.round(batAh * 0.85);\
\
      document.getElementById('relatorioOutput').value = \
`======================================================\
ÉøÉ¥É™ RELAT√É≥RIO COMPLETO E CALCULADO MASTER PRO\
======================================================\
‚ÄÉÇ Configura√ß√£o: ${qty}x Woofers ${wooferBrand} + ${driverQty}x Drivers\
‚ÄÉÇ Player / DSP: ${player.toUpperCase()} + ${dsp}\
‚ÄÉÇ Pot√™ncia Total Estimada: ~${totalRmsGeral}W RMS\
‚ÄÉÇ Bateria Auxiliar Necess√ÉÅria: ${batAh} Ah\
‚ÄÉÇ Fonte Carregadora M√≠nima: ${fonteAmperes} Amperes`;\
    }\
\
    atualizarPalco();\
    atualizarLeds();\
  </script>\
</body>\
</html>\
EOF\

