            box-shadow: inset 0 0 15px rgba(0, 212, 255, 0.2), 0 0 10px var(--pioneer-glow);\
            color: var(--pioneer-blue);\
            margin-bottom: 15px;\
        }\
\
        /* PARED√É£O AUTOMOTIVO (SUB, CORNETA, TWEETER) */\
        .wall-container {\
            display: flex;\
            justify-content: space-around;\
            align-items: center;\
            background: #050608;\
