<!DOCTYPE html>\
<html lang="pt-BR">\
<head>\
    <meta charset="UTF-8">\
    <meta name="viewport" content="width=device-width, initial-scale=1.0">\
    <title>‚É∫ÉÅ SPEED R√ÅDIO</title>\
    <style>\
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', system-ui, sans-serif; }\
        body { background: #0b0e14; color: #e0e6ed; display: flex; justify-content: center; align-items: center; min-height: 100vh; padding: 12px; }\
        .container { width: 100%; max-width: 440px; background: #121824; border: 1px solid #1e293b; border-radius: 16px; padding: 16px; box-shadow: 0 10px 30px rgba(0,0,0,0.5); position: relative; }\
        .gear-icon { position: absolute; top: 16px; right: 16px; background: #1e293b; border: none; color: #38bdf8; font-size: 1.2rem; width: 36px; height: 36px; border-radius: 50%; cursor: pointer; display: flex; align-items: center; justify-content: center; }\
        .header h1 { color: #38bdf8; font-size: 1.4rem; text-align: center; margin-bottom: 12px; }\
        .now-playing-box { background: #0f172a; border: 1px solid #1e293b; border-radius: 10px; padding: 10px; text-align: center; margin-bottom: 12px; }\
        .now-playing-label { font-size: 0.7rem; color: #94a3b8; letter-spacing: 1px; }\
        .now-playing-title { color: #38bdf8; font-weight: bold; font-size: 0.9rem; margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\
        .link-copy-box { display: flex; gap: 6px; margin-bottom: 12px; }\
        .link-input { flex: 1; background: #0f172a; border: 1px solid #334155; color: #94a3b8; padding: 8px 10px; border-radius: 8px; font-size: 0.8rem; outline: none; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\
        .btn-copy { background: #eab308; color: #0f172a; border: none; font-weight: bold; padding: 8px 12px; border-radius: 8px; cursor: pointer; font-size: 0.8rem; flex-shrink: 0; }\
        .audio-player-container { background: #ffffff; border-radius: 25px; padding: 6px 12px; margin-bottom: 16px; }\
        audio { width: 100%; height: 36px; outline: none; }\
        .speakers-grid { display: flex; justify-content: space-around; margin-bottom: 16px; background: #0f172a; padding: 10px; border-radius: 10px; border: 1px solid #1e293b; }\
        .speaker-item { text-align: center; }\
        .speaker-item span { display: block; font-size: 0.65rem; color: #64748b; margin-bottom: 4px; }\
        .speaker-circle { width: 38px; height: 38px; border-radius: 50%; margin: 0 auto; border: 2px solid #334155; display: flex; align-items: center; justify-content: center; background: #1e293b; }\
        .subwoofer { border-color: #eab308; } .sub-inner { width: 20px; height: 20px; border-radius: 50%; background: #facc15; }\
        .corneta { border-color: #94a3b8; } .corneta-inner { width: 14px; height: 14px; border-radius: 50%; background: #cbd5e1; }\
        .tweeter { border-color: #f8fafc; } .tweeter-inner { width: 8px; height: 8px; border-radius: 50%; background: #ffffff; }\
        .section-title { font-size: 0.9rem; color: #f8fafc; margin-bottom: 8px; font-weight: bold; }\
        .pedir-box { background: #0f172a; border: 1px solid #1e293b; padding: 10px; border-radius: 10px; margin-bottom: 16px; }\
        .pedir-input { width: 100%; background: #1e293b; border: 1px solid #334155; padding: 8px; color: #fff; border-radius: 6px; margin-bottom: 8px; outline: none; font-size: 0.8rem; }\
        .btn-pedir { width: 100%; background: #eab308; color: #0f172a; border: none; font-weight: bold; padding: 8px; border-radius: 6px; cursor: pointer; font-size: 0.8rem; }\
        .queue-container { background: #0f172a; border: 1px solid #1e293b; border-radius: 10px; padding: 8px; max-height: 220px; overflow-y: auto; }\
        .queue-list { list-style: none; }\
        .queue-item { display: flex; align-items: center; justify-content: space-between; background: #1e293b; padding: 8px 10px; border-radius: 6px; margin-bottom: 6px; gap: 8px; }\
        .queue-item-text { flex: 1; min-width: 0; font-size: 0.8rem; color: #38bdf8; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\
        .btn-group { display: flex; gap: 4px; flex-shrink: 0; align-items: center; }\
        .btn-action { background: #eab308; color: #0f172a; border: none; padding: 4px 8px; border-radius: 4px; font-size: 0.75rem; cursor: pointer; font-weight: bold; }\
        .btn-action.btn-danger { background: #ef4444; color: #fff; }\
        .modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.85); justify-content: center; align-items: center; padding: 12px; z-index: 100; }\
        .modal-content { background: #121824; border: 1px solid #334155; width: 100%; max-width: 420px; border-radius: 16px; padding: 16px; max-height: 90vh; overflow-y: auto; }\
        .adm-controls { display: flex; gap: 6px; margin-bottom: 12px; }\
        .btn-control { flex: 1; background: #eab308; color: #0f172a; border: none; padding: 8px; border-radius: 6px; font-weight: bold; cursor: pointer; font-size: 0.75rem; }\
        .file-upload-box { background: #0f172a; border: 1px dashed #334155; padding: 12px; border-radius: 10px; text-align: center; margin-bottom: 12px; }\
        .file-upload-btn { background: #1e293b; color: #cbd5e1; padding: 6px 10px; border-radius: 6px; cursor: pointer; font-size: 0.75rem; display: inline-block; margin-bottom: 6px; border: 1px solid #334155; }\
        .btn-insert { width: 100%; background: #eab308; color: #0f172a; border: none; font-weight: bold; padding: 8px; border-radius: 6px; cursor: pointer; font-size: 0.8rem; }\
        .close-btn { width: 100%; background: #475569; color: #fff; border: none; padding: 10px; border-radius: 8px; margin-top: 12px; cursor: pointer; font-weight: bold; font-size: 0.85rem; }\
    </style>\
</head>\
<body>\
    <div class="container">\
        <button class="gear-icon" onclick="toggleModal(true)">‚É∫ÉπÔ∏ÉØ</button>\
        <div class="header"><h1>‚É∫ÉÅ SPEED R√ÅDIO</h1></div>\
        <div class="now-playing-box">\
            <div class="now-playing-label">TOCANDO AGORA</div>\
            <div class="now-playing-title" id="currentTrack">Nenhuma m√∫sica tocando</div>\
        </div>\
        <div class="link-copy-box">\
            <input type="text" class="link-input" id="radioUrl" readonly value="">\
            <button class="btn-copy" onclick="copyLink()">ÉøÉ≥É´ Copiar Link</button>\
        </div>\
        <div class="audio-player-container">\
            <audio id="audioPlayer" controls autoplay></audio>\
        </div>\
        <div class="speakers-grid">\
            <div class="speaker-item"><span>SUBWOOFER</span><div class="speaker-circle subwoofer"><div class="sub-inner"></div></div></div>\
            <div class="speaker-item"><span>CORNETA</span><div class="speaker-circle corneta"><div class="corneta-inner"></div></div></div>\
            <div class="speaker-item"><span>TWEETER</span><div class="speaker-circle tweeter"><div class="tweeter-inner"></div></div></div>\
        </div>\
        <div class="section-title">ÉøÉÆµ Pedir M√∫sica</div>\
        <div class="pedir-box">\
            <input type="text" class="pedir-input" id="pedirInput" placeholder="Cole o link MP3 ou nome da m√∫sica...">\
            <button class="btn-pedir" onclick="pedirMusica()">‚ÉæÉµ Enviar para Aprova√ß√£o</button>\
        </div>\
        <div class="section-title">ÉøÉ≥Éº Fila Principal (Numerada)</div>\
        <div class="queue-container">\
            <ul class="queue-list" id="publicQueue"></ul>\
        </div>\
    </div>\
\
    <div class="modal" id="admModal">\
        <div class="modal-content">\
            <h2 style="text-align: center; color: #f8fafc; margin-bottom: 12px; font-size: 1rem;">ÉøÉÆÉªÔ∏ÉØ Mesa de Som & Transmiss√£o DJ</h2>\
            <div class="adm-controls">\
                <button class="btn-control" onclick="control('prev')">‚ÉØÆÔ∏ÉØ Voltar</button>\
                <button class="btn-control" onclick="control('toggle')">‚ÉØØÔ∏ÉØ Play/Pause</button>\
                <button class="btn-control" onclick="control('next')">‚ÉØ≠Ô∏ÉØ Avan√ßar</button>\
            </div>\
            <div class="file-upload-box">\
                <span style="font-size: 0.8rem; color: #94a3b8; display: block; margin-bottom: 6px;">ÉøÉ≥Å Adicionar √Åudios do Celular</span>\
                <label class="file-upload-btn">Escolher arquivos<input type="file" id="fileInput" multiple accept="audio/*" style="display:none"></label>\
                <span id="fileCount" style="font-size: 0.7rem; color: #64748b; display: block; margin-bottom: 6px;">0 arquivos selecionados</span>\
                <button class="btn-insert" onclick="uploadFiles()">‚ÉæÉµ Inserir M√∫sicas</button>\
            </div>\
            <div class="section-title">ÉøÉ≥Éº Fila ADM (Organizar e Reordenar)</div>\
            <div class="queue-container" style="max-height: 180px;">\
                <ul class="queue-list" id="admQueue"></ul>\
            </div>\
            <button class="close-btn" onclick="toggleModal(false)">Sair do Painel</button>\
        </div>\
    </div>\
\
    <script>\
        document.getElementById('radioUrl').value = window.location.href;\
        function copyLink() {\
            const input = document.getElementById('radioUrl');\
            input.select();\
            document.execCommand('copy');\
            alert('Link copiado!');\
        }\
        function toggleModal(show) { document.getElementById('admModal').style.display = show ? 'flex' : 'none'; }\
        \
        let sampleTracks = [];\
        \
        async function loadQueue() {\
            try {\
                const res = await fetch('/api/queue');\
                if(res.ok) sampleTracks = await res.json();\
            } catch(e){}\
            renderQueues();\
        }\
\
        function renderQueues() {\
            const publicList = document.getElementById('publicQueue');\
            const admList = document.getElementById('admQueue');\
            publicList.innerHTML = ''; admList.innerHTML = '';\
\
            sampleTracks.forEach((track, index) => {\
                const name = typeof track === 'string' ? track : track.name;\
                \
                const liPub = document.createElement('li');\
                liPub.className = 'queue-item';\
                liPub.innerHTML = `<span class="queue-item-text">${index + 1}. ${name}</span>`;\
                publicList.appendChild(liPub);\
\
                const liAdm = document.createElement('li');\
                liAdm.className = 'queue-item';\
                liAdm.innerHTML = `\
                    <span class="queue-item-text">${index + 1}. ${name}</span>\
                    <div class="btn-group">\
                        <button class="btn-action" onclick="moveUp(${index})">‚¨É¶Ô∏ÉØ</button>\
                        <button class="btn-action" onclick="moveDown(${index})">‚¨ÉßÔ∏ÉØ</button>\
                        <button class="btn-action btn-danger" onclick="removeTrack(${index})">‚ÉΩÉ¨</button>\
                    </div>\
                `;\
                admList.appendChild(liAdm);\
            });\
        }\
\
        function moveUp(idx) {\
            if (idx > 0) {\
                const t = sampleTracks[idx]; sampleTracks[idx] = sampleTracks[idx-1]; sampleTracks[idx-1] = t;\
                renderQueues();\
            }\
        }\
        function moveDown(idx) {\
            if (idx < sampleTracks.length - 1) {\
                const t = sampleTracks[idx]; sampleTracks[idx] = sampleTracks[idx+1]; sampleTracks[idx+1] = t;\
                renderQueues();\
            }\
        }\
        function removeTrack(idx) {\
            sampleTracks.splice(idx, 1);\
            renderQueues();\
        }\
        function pedirMusica() {\
            const val = document.getElementById('pedirInput').value.trim();\
            if(val) {\
                sampleTracks.push({ name: val });\
                renderQueues();\
                document.getElementById('pedirInput').value = '';\
                alert('M√∫sica enviada!');\
            }\
        }\
        loadQueue();\
    </script>\
</body>\
</html>\
EOF\

