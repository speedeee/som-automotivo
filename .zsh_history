    <style>\
        :root { \
            --bg-color: #0a0b0e; \
            --pioneer-blue: #00d4ff; \
            --pioneer-glow: rgba(0, 212, 255, 0.4);\
        }\
        body { background: var(--bg-color); color: #fff; font-family: 'Courier New', Courier, monospace; text-align: center; padding: 15px; margin: 0; }\
        \
        .pioneer-frame {\
            background: linear-gradient(145deg, #1f232a, #0d0e12);\
            border: 4px solid #2a2e38;\
            border-radius: 18px;\
            padding: 20px;\
            max-width: 580px;\
            margin: 0 auto 15px auto;\
            box-shadow: 0 10px 30px rgba(0,0,0,0.9);\
            transition: box-shadow 0.05s ease;\
            position: relative;\
        }\
\
        .lcd-display {\
            background: #00121a;\
            border: 3px solid #002b3d;\
            border-radius: 8px;\
            padding: 12px;\
            box-shadow: inset 0 0 15px rgba(0, 212, 255, 0.2), 0 0 10px var(--pioneer-glow);\
            color: var(--pioneer-blue);\
            margin-bottom: 15px;\
        }\
\
        /* Container de Caixas de Som / Subwoofers */\
        .speaker-wrapper {\
            display: flex;\
            justify-content: space-between;\
            align-items: center;\
            margin: 15px 0;\
            padding: 0 10px;\
        }\
\
        .speaker {\
            width: 75px;\
            height: 75px;\
            background: radial-gradient(circle, #333 15%, #111 60%, #000 100%);\
            border: 4px solid #222;\
            border-radius: 50%;\
            box-shadow: inset 0 0 10px #000, 0 0 8px rgba(0,0,0,0.8);\
            position: relative;\
            display: flex;\
            justify-content: center;\
            align-items: center;\
            transition: transform 0.05s ease-out;\
        }\
\
        .speaker::before {\
            content: '';\
            width: 45px;\
            height: 45px;\
            background: radial-gradient(circle, #e67e22 20%, #d35400 50%, #222 100%);\
            border-radius: 50%;\
            border: 2px solid #111;\
        }\
\
        .speaker::after {\
            content: '';\
            position: absolute;\
            width: 20px;\
            height: 20px;\
            background: radial-gradient(circle, #ccc 10%, #444 80%);\
            border-radius: 50%;\
            box-shadow: 0 0 4px #000;\
        }\
\
        .speaker-left { transform: rotate(-15deg); }\
        .speaker-right { transform: rotate(15deg); }\
\
        .box-link { background: rgba(0, 212, 255, 0.05); border: 1px dashed var(--pioneer-blue); border-radius: 6px; padding: 8px; margin: 10px 0; }\
        .box-link input { width: 90%; text-align: center; font-size: 11px; background: #000; color: var(--pioneer-blue); border: 1px solid #005577; padding: 6px; }\
        \
        input[type="text"], input[type="email"], input[type="password"] { width: 85%; padding: 8px; border-radius: 5px; border: 1px solid #005577; background: #00121a; color: #fff; margin-bottom: 8px; }\
        \
        button { padding: 8px 12px; border-radius: 6px; border: none; background: var(--pioneer-blue); color: #000; font-weight: bold; cursor: pointer; margin: 2px; }\
        .btn-danger { background: #e74c3c; color: #fff; }\
        .btn-small { padding: 4px 8px; font-size: 11px; }\
\
        .vu-container { display: flex; justify-content: center; align-items: flex-end; gap: 4px; height: 35px; background: #00080d; padding: 6px; border-radius: 5px; margin: 10px 0; border: 1px solid #003344; }\
        .vu-bar { width: 8%; background: #003344; height: 10%; border-radius: 2px; transition: height 0.05s ease; }\
        \
        .eq-panel { background: rgba(0,0,0,0.4); padding: 10px; border-radius: 8px; border: 1px solid #003344; margin: 10px 0; text-align: left; }\
        .eq-slider { display: flex; justify-content: space-between; align-items: center; margin: 5px 0; font-size: 12px; }\
        .eq-slider input { width: 60%; }\
\
        #ytPlayerContainer { position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; border-radius: 8px; background: #000; margin-top: 10px; }\
        #ytPlayerContainer iframe, #audioLocalOuvinte, #audioLocalAdm { position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 0; }\
        \
        ul, ol { text-align: left; background: rgba(0, 212, 255, 0.05); padding: 10px 25px; border-radius: 5px; max-height: 140px; overflow-y: auto; border: 1px solid #003344; color: var(--pioneer-blue); font-size: 12px; }\
        li { margin-bottom: 6px; border-bottom: 1px solid #002b3d; padding-bottom: 4px; display: flex; justify-content: space-between; align-items: center; }\
        .switch-container { display: flex; justify-content: center; align-items: center; gap: 10px; margin: 10px 0; font-size: 12px; }\
    </style>\
</head>\
<body>\
\
    <div style="margin-bottom: 15px;">\
        <button onclick="verAba('ouvinte')">ÉøÉ≥ª Display Pioneer (P√∫blico)</button>\
        <button onclick="verAba('adm')">ÉøÉÆÉªÔ∏ÉØ Mesa de DJ / ADM</button>\
    </div>\
\
    <!-- PLAYER OUVINTE -->\
    <div id="abaOuvinte" class="pioneer-frame">\
        <div class="lcd-display">\
            <h1 style="margin: 5px 0; font-size: 18px;">‚É∫ÉÅ SPEED R√ÅDIO</h1>\
            <p id="status" style="margin: 5px 0; font-size: 11px;">[READY] AGUARDANDO COMANDO</p>\
            \
            <div class="vu-container" id="vuMeter">\
                <div class="vu-bar"></div><div class="vu-bar"></div><div class="vu-bar"></div>\
                <div class="vu-bar"></div><div class="vu-bar"></div><div class="vu-bar"></div>\
                <div class="vu-bar"></div><div class="vu-bar"></div><div class="vu-bar"></div>\
            </div>\
        </div>\
        \
        <div class="box-link">\
