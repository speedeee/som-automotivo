<!DOCTYPE html>\
<html lang="pt-BR">\
<head>\
    <meta charset="UTF-8">\
    <meta name="viewport" content="width=device-width, initial-scale=1.0">\
    <title>‚É∫ÉÅ SPEED R√ÅDIO - PIONEER EDITION PRO</title>\
    <script src="/socket.io/socket.io.js"></script>\
    <script src="https://www.youtube.com/iframe_api"></script>\
    <style>\
        :root { \
            --bg-color: #0a0b0e; \
            --pioneer-frame-bg: linear-gradient(145deg, #1f232a, #0d0e12);\
            --pioneer-border: #2a2e38;\
            --pioneer-blue: #00d4ff; \
            --pioneer-glow: rgba(0, 212, 255, 0.4);\
            --speaker-color: #e67e22;\
            --btn-bg: #00d4ff;\
            --btn-text: #000000;\
            --text-color: #00d4ff;\
        }\
        body { background: var(--bg-color); color: #fff; font-family: 'Courier New', Courier, monospace; text-align: center; padding: 15px; margin: 0; }\
        \
        .nav-tabs { display: flex; justify-content: center; gap: 8px; margin-bottom: 15px; flex-wrap: wrap; }\
        .nav-tabs button { padding: 10px 14px; font-size: 12px; }\
\
        .pioneer-frame {\
            background: var(--pioneer-frame-bg);\
            border: 4px solid var(--pioneer-border);\
            border-radius: 18px;\
            padding: 20px;\
            max-width: 600px;\
            margin: 0 auto 15px auto;\
            box-shadow: 0 10px 30px rgba(0,0,0,0.9);\
            position: relative;\
        }\
\
        .lcd-display {\
            background: #00121a;\
            border: 3px solid #002b3d;\
            border-radius: 8px;\
            padding: 12px;\
            box-shadow: inset 0 0 15px var(--pioneer-glow), 0 0 10px var(--pioneer-glow);\
            color: var(--text-color);\
            margin-bottom: 15px;\
        }\
\
        /* PARED√É£O AUTOMOTIVO (SUB, CORNETA, TWEETER) */\
        .wall-container {\
            display: flex;\
            justify-content: space-around;\
            align-items: center;\
            background: #050608;\
            border: 2px solid #1a1d24;\
            border-radius: 12px;\
            padding: 15px 5px;\
            margin: 15px 0;\
        }\
\
        .sound-unit { display: flex; flex-direction: column; align-items: center; gap: 8px; }\
        .unit-label { font-size: 9px; font-weight: bold; color: #888; }\
\
        /* Subwoofer */\
        .subwoofer {\
            width: 65px; height: 65px;\
            background: radial-gradient(circle, #222 15%, #111 60%, #000 100%);\
            border: 3px solid #333; border-radius: 50%;\
            display: flex; justify-content: center; align-items: center;\
            transition: transform 0.05s ease-out;\
        }\
        .subwoofer::before {\
            content: ''; width: 38px; height: 38px;\
            background: radial-gradient(circle, var(--speaker-color) 20%, #111 100%);\
            border-radius: 50%; border: 1px solid #000;\
        }\
\
        /* Corneta (M√©dio Grave) */\
        .horn {\
            width: 50px; height: 50px;\
            background: #111; border: 3px solid #333; border-radius: 6px;\
            display: flex; justify-content: center; align-items: center;\
            transition: transform 0.05s ease-out, box-shadow 0.05s ease;\
        }\
        .horn-inner {\
            width: 28px; height: 28px;\
            background: radial-gradient(circle, var(--speaker-color) 10%, #000 80%);\
            border-radius: 50%; border: 1px solid #444;\
        }\
\
        /* Tweeter (Agudos) */\
        .tweeter {\
            width: 35px; height: 35px;\
            background: #1a1a1a; border: 2px solid #444; border-radius: 50%;\
            display: flex; justify-content: center; align-items: center;\
            transition: opacity 0.05s ease, transform 0.05s ease;\
        }\
        .tweeter-core {\
            width: 14px; height: 14px;\
            background: var(--speaker-color); border-radius: 50%;\
            box-shadow: 0 0 5px var(--speaker-color);\
        }\
\
        .box-link { background: rgba(0, 212, 255, 0.05); border: 1px dashed var(--pioneer-blue); border-radius: 6px; padding: 8px; margin: 10px 0; }\
        .box-link input { width: 90%; text-align: center; font-size: 11px; background: #000; color: var(--text-color); border: 1px solid #005577; padding: 6px; }\
        \
        input[type="text"], input[type="email"], input[type="password"] { width: 85%; padding: 8px; border-radius: 5px; border: 1px solid #005577; background: #00121a; color: #fff; margin-bottom: 8px; }\
        \
        button { padding: 8px 12px; border-radius: 6px; border: none; background: var(--btn-bg); color: var(--btn-text); font-weight: bold; cursor: pointer; margin: 2px; }\
        .btn-danger { background: #e74c3c !important; color: #fff !important; }\
        .btn-extreme { background: #ff0055 !important; color: #fff !important; font-weight: bold; box-shadow: 0 0 10px #ff0055; }\
        .btn-extreme.active { background: #00ff66 !important; color: #000 !important; box-shadow: 0 0 15px #00ff66; }\
        .btn-small { padding: 4px 8px; font-size: 11px; }\
\
        .vu-container { display: flex; justify-content: center; align-items: flex-end; gap: 4px; height: 30px; background: #00080d; padding: 6px; border-radius: 5px; margin: 10px 0; border: 1px solid #003344; }\
        .vu-bar { width: 8%; background: #003344; height: 10%; border-radius: 2px; transition: height 0.05s ease; }\
        \
        .eq-panel { background: rgba(0,0,0,0.4); padding: 10px; border-radius: 8px; border: 1px solid #003344; margin: 10px 0; text-align: left; }\
        .eq-slider { display: flex; justify-content: space-between; align-items: center; margin: 8px 0; font-size: 12px; }\
        .eq-slider input { width: 50%; }\
\
        #ytPlayerContainer { position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; border-radius: 8px; background: #000; margin-top: 10px; }\
        #ytPlayerContainer iframe { position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 0; }\
        \
        /* CONTAINER DE √ÅUDIO BLOQUEADO PARA O P√É∫BLICO */\
        .public-audio-wrapper {\
            position: relative;\
            background: #111;\
            padding: 8px;\
            border-radius: 8px;\
            margin: 10px 0;\
            border: 1px solid var(--pioneer-border);\
        }\
        .public-audio-wrapper audio {\
            width: 100%;\
            pointer-events: none; /* Bloqueia clique, pause e altera√ß√£o de volume pelo p√∫blico */\
            user-select: none;\
            opacity: 0.85;\
        }\
        .public-audio-overlay {\
            position: absolute;\
            top: 0; left: 0; right: 0; bottom: 0;\
            background: transparent;\
            z-index: 10;\
        }\
\
        ul, ol { text-align: left; background: rgba(0, 212, 255, 0.05); padding: 10px 25px; border-radius: 5px; max-height: 140px; overflow-y: auto; border: 1px solid #003344; color: var(--text-color); font-size: 12px; }\
        li { margin-bottom: 6px; border-bottom: 1px solid #002b3d; padding-bottom: 4px; display: flex; justify-content: space-between; align-items: center; }\
        \
        .color-group { display: flex; align-items: center; justify-content: space-between; margin: 8px 0; font-size: 12px; }\
        .color-group input[type="color"] { border: none; width: 40px; height: 30px; cursor: pointer; background: none; }\
    </style>\
</head>\
<body>\
\
    <!-- NAV TABS DE NAVEGA√Éß√É£O -->\
    <div class="nav-tabs">\
        <button onclick="verAba('ouvinte')">ÉøÉ≥ª Display Pioneer (P√∫blico)</button>\
        <button onclick="solicitarAcesso('adm')">ÉøÉÆÉªÔ∏ÉØ Mesa de DJ / ADM</button>\
        <button onclick="solicitarAcesso('custom')">ÉøÉÆ® Edi√ß√£o de Display & Som</button>\
    </div>\
\
    <!-- LOGIN MODAL / BLOQUEIO ADM -->\
    <div id="modalLogin" class="pioneer-frame" style="display:none; border-color: #ffcc00;">\
        <h3 style="color:#ffcc00;">ÉøÉ¥É≤ √Årea Restrita ADM</h3>\
        <input type="email" id="loginEmail" placeholder="E-mail ADM">\
        <input type="password" id="loginPass" placeholder="Senha ADM">\
        <br>\
        <button onclick="validarLogin()">Acessar Painel</button>\
        <button onclick="cancelarLogin()" class="btn-danger">Cancelar</button>\
    </div>\
\
    <!-- ABA 1: PLAYER OUVINTE (CONTROLES TOTALMENTE BLOQUEADOS PARA O P√É∫BLICO) -->\
    <div id="abaOuvinte" class="pioneer-frame">\
        <div class="lcd-display">\
            <h1 style="margin: 5px 0; font-size: 18px;">‚É∫ÉÅ SPEED R√ÅDIO</h1>\
            <p id="status" style="margin: 5px 0; font-size: 11px;">[READY] AGUARDANDO COMANDO DO DJ</p>\
            \
            <div class="vu-container">\
                <div class="vu-bar"></div><div class="vu-bar"></div><div class="vu-bar"></div>\
                <div class="vu-bar"></div><div class="vu-bar"></div><div class="vu-bar"></div>\
                <div class="vu-bar"></div><div class="vu-bar"></div><div class="vu-bar"></div>\
            </div>\
        </div>\
        \
        <div class="box-link">\
            <input type="text" id="urlRadio" readonly>\
            <button onclick="copiarLink()">ÉøÉ≥É´ Copiar Link</button>\
        </div>\
\
        <div id="ytPlayerContainer">\
            <div id="player"></div>\
        </div>\
\
        <!-- BARRA VIS√É≠VEL MAS BLOQUEADA PARA O P√É∫BLICO -->\
        <div class="public-audio-wrapper">\
            <div class="public-audio-overlay"></div>\
            <audio id="audioLocalOuvinte" controls style="display:block;"></audio>\
            <span style="font-size: 10px; color: #aaa; display: block; margin-top: 4px;">ÉøÉ¥É≤ Controles do Player Exclusivos do ADM / DJ</span>\
        </div>\
\
        <!-- PARED√É£O AUTOMOTIVO VISUAL (OUVINTE) -->\
        <div class="wall-container">\
            <div class="sound-unit">\
                <div class="unit-label">SUBWOOFER</div>\
                <div class="subwoofer spk-sub"></div>\
            </div>\
            <div class="sound-unit">\
                <div class="unit-label">CORNETA</div>\
                <div class="horn spk-horn"><div class="horn-inner"></div></div>\
            </div>\
            <div class="sound-unit">\
                <div class="unit-label">TWEETER</div>\
                <div class="tweeter spk-tweeter"><div class="tweeter-core"></div></div>\
