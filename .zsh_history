            </div>\
            <div class="sound-unit">\
                <div class="unit-label">TWEETER</div>\
                <div class="tweeter spk-tweeter"><div class="tweeter-core"></div></div>\
            </div>\
        </div>\
\
        <div style="margin: 10px 0;">\
            <button onclick="tocarRadioOuvinte()" style="font-size: 14px; padding: 10px 18px;">‚É∂∂Ô∏ÉØ Conectar na R√ÉÅdio</button>\
        </div>\
\
        <h3>ÉøÉÆµ Pedir M√∫sica</h3>\
        <input type="text" id="linkMusicaOuvinte" placeholder="Cole o link aqui...">\
        <button onclick="enviarPedidoPublico()">‚ÉæÉµ Enviar para Aprova√ß√£o</button>\
\
        <h3>ÉøÉ≥Éº Fila Principal</h3>\
        <ol id="filaOuvinte"></ol>\
    </div>\
\
    <!-- ABA 2: MESA DE DJ / TRANSMISS√É£O (ADM EXCLUSIVO) -->\
    <div id="abaAdm" class="pioneer-frame" style="display: none;">\
        <h2>ÉøÉÆÉªÔ∏ÉØ Mesa de Som & Transmiss√£o DJ</h2>\
\
        <!-- MONITOR DE √ÅUDIO DJ -->\
        <div class="eq-panel">\
            <h4>ÉøÉÆß Monitor de √Åudio Oficial DJ</h4>\
            <audio id="audioLocalAdm" controls style="width: 100%; height: 35px;"></audio>\
        </div>\
\
        <!-- CONTROLES TRANSMISS√É£O -->\
        <div style="margin: 15px 0;">\
            <button onclick="voltarMusica()">‚ÉØÆÔ∏ÉØ Voltar</button>\
            <button onclick="pausarEPlay()">‚ÉØØÔ∏ÉØ Play/Pause Transmiss√£o</button>\
            <button onclick="proximaMusica()">‚ÉØ≠Ô∏ÉØ Avan√ßar</button>\
            <button onclick="misturarFila()">ÉøÉ¥Ä Shuffle</button>\
        </div>\
\
        <!-- ADICIONAR MP3 LOCAL -->\
        <div class="eq-panel">\
            <h4>ÉøÉ≥Å Adicionar MP3 do Celular</h4>\
            <input type="file" id="fileInput" accept="audio/*" multiple style="font-size: 11px;">\
            <button onclick="carregarMp3Locais()">‚ÉæÉµ Inserir na Fila</button>\
        </div>\
\
        <!-- MODERA√Éß√É£O DE PEDIDOS DO P√É∫BLICO -->\
        <div class="eq-panel" style="border-color: #ffcc00;">\
            <h4 style="color: #ffcc00;">ÉøÉ≥• Pedidos do P√∫blico (Aguardando)</h4>\
            <ul id="listaEspera"></ul>\
        </div>\
\
        <!-- FILA PRINCIPAL ADM -->\
        <h4>ÉøÉ≥Éº Gerenciador de Fila ADM</h4>\
        <div style="margin-bottom: 5px;">\
            <button onclick="selecionarTodasFila(true)" class="btn-small">Marc. Todos</button>\
            <button onclick="selecionarTodasFila(false)" class="btn-small">Desmarc. Todos</button>\
            <button onclick="excluirMarcados()" class="btn-small btn-danger">Excluir Marcados</button>\
        </div>\
        <ul id="filaAdm"></ul>\
\
        <button onclick="limparFila()" class="btn-danger">ÉøÉ∑É±Ô∏ÉØ Limpar Toda Fila</button>\
        <br><br>\
        <button onclick="logout()" style="background: #444; color: #fff;">Sair do Painel</button>\
    </div>\
\
    <!-- ABA 3: EDI√Éß√É£O DE DISPLAY & PARED√É£O AUTOMOTIVO (CUSTOMIZA√Éß√É£O TOTAL DE CORES E GRAVE EXTREME) -->\
    <div id="abaCustom" class="pioneer-frame" style="display: none;">\
        <h2>ÉøÉÆ® Edi√ß√£o de Display, Cores & Som</h2>\
\
        <!-- FUN√Éß√É£O GRAVE EXTREME -->\
        <div class="eq-panel" style="border: 2px solid #ff0055; background: rgba(255, 0, 85, 0.1);">\
            <h3 style="color: #ff0055; margin: 5px 0;">ÉøÉ≤• MODO GRAVE EXTREME (SUB-BASS POWER)</h3>\
            <p style="font-size: 11px; color: #ddd;">Ativa o subwoofer no limite m√ÉÅximo de graves pesados (Sub-bass Pancad√£o at√© +35dB).</p>\
            <button id="btnGraveExtreme" class="btn-extreme" onclick="toggleGraveExtreme()">ÉøÉ¥É™ LIGAR GRAVE EXTREME</button>\
        </div>\
\
        <!-- CUSTOMIZA√Éß√É£O DE CORES DA INTERFACE -->\
        <div class="eq-panel">\
            <h4>ÉøÉÆ® Mudar Cores da Interface & Display</h4>\
            <div class="color-group">\
                <span>1. Cor dos Cones do Som:</span>\
                <input type="color" id="pickerCone" value="#e67e22" onchange="mudarCorElemento('--speaker-color', this.value)">\
            </div>\
            <div class="color-group">\
                <span>2. Cor dos Bot√µes:</span>\
                <input type="color" id="pickerBtn" value="#00d4ff" onchange="mudarCorElemento('--btn-bg', this.value)">\
            </div>\
            <div class="color-group">\
                <span>3. Cor do Texto / Neon Display:</span>\
                <input type="color" id="pickerText" value="#00d4ff" onchange="mudarCorElemento('--text-color', this.value); mudarCorElemento('--pioneer-blue', this.value)">\
            </div>\
            <div class="color-group">\
                <span>4. Cor do Glow / LED Display:</span>\
                <input type="color" id="pickerGlow" value="#00d4ff" onchange="mudarGlowDisplay(this.value)">\
            </div>\
            <div class="color-group">\
                <span>5. Cor do Fundo Geral (Background):</span>\
                <input type="color" id="pickerBg" value="#0a0b0e" onchange="mudarCorElemento('--bg-color', this.value)">\
            </div>\
            <div class="color-group">\
                <span>6. Cor da Moldura / Borda Pioneer:</span>\
                <input type="color" id="pickerBorder" value="#2a2e38" onchange="mudarCorElemento('--pioneer-border', this.value)">\
            </div>\
        </div>\
\
        <!-- EQUALIZADOR INDEPENDENTE -->\
        <div class="eq-panel">\
            <h4>ÉøÉÆÉ∫Ô∏ÉØ Ajuste do Equalizador (Responsa dos Componentes)</h4>\
            <div class="eq-slider">\
                <span>ÉøÉ¥É™ Crossfade: <b id="valCross">3</b>s</span>\
                <input type="range" id="crossfadeTimer" min="0" max="10" value="3" oninput="document.getElementById('valCross').innerText=this.value">\
            </div>\
            <div class="eq-slider">\
                <span>ÉøÉ¥É™ Grave (Subwoofer):</span>\
                <input type="range" id="eqBass" min="-10" max="25" value="8" onchange="atualizarAudioCtx()">\
            </div>\
            <div class="eq-slider">\
                <span>ÉøÉ¥É™ Grave de Lata (Pancad√£o):</span>\
                <input type="range" id="eqLata" min="0" max="25" value="12" onchange="atualizarAudioCtx()">\
            </div>\
            <div class="eq-slider">\
                <span>ÉøÉ¥É™ M√©dio (Cornetas/Voz):</span>\
                <input type="range" id="eqMid" min="-10" max="20" value="5" onchange="atualizarAudioCtx()">\
            </div>\
            <div class="eq-slider">\
                <span>ÉøÉ¥É™ Agudo (Tweeters/Brilho):</span>\
                <input type="range" id="eqTreble" min="-10" max="20" value="6" onchange="atualizarAudioCtx()">\
            </div>\
        </div>\
\
        <button onclick="logout()" style="background: #444; color: #fff;">Sair do Painel</button>\
    </div>\
\
    <script>\
        const socket = io();\
        let ytPlayer;\
        let playlistLocal = [];\
        let listaEspera = [];\
        let indexAtual = -1;\
        let admAutenticado = false;\
        let abaPendente = '';\
        let graveExtremeAtivo = false;\
        \
        let audioCtx, bassNode, extremeBassNode, lataNode, midNode, trebleNode, gainNode;\
\
        const audioOuvinte = document.getElementById('audioLocalOuvinte');\
        const audioAdm = document.getElementById('audioLocalAdm');\
\
        document.getElementById('urlRadio').value = window.location.href;\
\
        function initAudioContext() {\
            if (!audioCtx) {\
                audioCtx = new (window.AudioContext || window.webkitAudioContext)();\
                \
                bassNode = audioCtx.createBiquadFilter();\
                bassNode.type = 'lowshelf';\
                bassNode.frequency.value = 100;\
\
                extremeBassNode = audioCtx.createBiquadFilter();\
                extremeBassNode.type = 'peaking';\
                extremeBassNode.frequency.value = 45; // Frequ√™ncia Sub-bass ultra profunda\
                extremeBassNode.Q.value = 4.0;\
                extremeBassNode.gain.value = 0;\
\
                lataNode = audioCtx.createBiquadFilter();\
                lataNode.type = 'peaking';\
                lataNode.frequency.value = 80; lataNode.Q.value = 5; \
\
                midNode = audioCtx.createBiquadFilter();\
                midNode.type = 'peaking';\
                midNode.frequency.value = 1000;\
\
                trebleNode = audioCtx.createBiquadFilter();\
                trebleNode.type = 'highshelf';\
                trebleNode.frequency.value = 4000;\
\
                gainNode = audioCtx.createGain();\
\
                let src = audioCtx.createMediaElementSource(audioOuvinte);\
                src.connect(bassNode);\
                bassNode.connect(extremeBassNode);\
                extremeBassNode.connect(lataNode);\
                lataNode.connect(midNode);\
                midNode.connect(trebleNode);\
                trebleNode.connect(gainNode);\
                gainNode.connect(audioCtx.destination);\
            }\
            atualizarAudioCtx();\
        }\
\
        function atualizarAudioCtx() {\
            if (bassNode && lataNode && midNode && trebleNode) {\
                bassNode.gain.value = parseFloat(document.getElementById('eqBass').value);\
                lataNode.gain.value = parseFloat(document.getElementById('eqLata').value);\
                midNode.gain.value = parseFloat(document.getElementById('eqMid').value);\
                trebleNode.gain.value = parseFloat(document.getElementById('eqTreble').value);\
\
                if (graveExtremeAtivo) {\
                    extremeBassNode.gain.value = 35; // Impulso Monstruoso no Sub-bass\
                    bassNode.gain.value = 25;\
                } else {\
                    extremeBassNode.gain.value = 0;\
                }\
            }\
        }\
\
        function toggleGraveExtreme() {\
            graveExtremeAtivo = !graveExtremeAtivo;\
            let btn = document.getElementById('btnGraveExtreme');\
            if (graveExtremeAtivo) {\
                btn.innerText = "ÉøÉ≤• GRAVE EXTREME: LIGADO ÉøÉ¥•";\
                btn.classList.add('active');\
            } else {\
                btn.innerText = "ÉøÉ¥É™ LIGAR GRAVE EXTREME";\
                btn.classList.remove('active');\
            }\
            atualizarAudioCtx();\
        }\
\
        function mudarCorElemento(varCss, cor) {\
            document.documentElement.style.setProperty(varCss, cor);\
        }\
\
        function mudarGlowDisplay(cor) {\
            let rgbaGlow = hexToRgba(cor, 0.4);\
            document.documentElement.style.setProperty('--pioneer-glow', rgbaGlow);\
        }\
\
        function hexToRgba(hex, alpha) {\
            let c = hex.replace('#', '');\
            if (c.length === 3) c = c.split('').map(x => x + x).join('');\
            let num = parseInt(c, 16);\
            return `rgba(${(num >> 16) & 255}, ${(num >> 8) & 255}, ${num & 255}, ${alpha})`;\
        }\
\
        function extrairIdYoutube(url) {\
            let regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|\&v=)([^#\&\?]*).*/;\
            let match = url ? url.match(regExp) : null;\
            return (match && match[2].length === 11) ? match[2] : url;\
        }\
\
        function onYouTubeIframeAPIReady() {\
            ytPlayer = new YT.Player('player', {\
                height: '100%', width: '100%',\
                playerVars: { 'autoplay': 1, 'controls': 1 },\
                events: { 'onStateChange': (e) => { if (e.data === 0) proximaMusica(); } }\
            });\
        }\
\
        audioOuvinte.onended = () => { proximaMusica(); };\
\
        function tocarRadioOuvinte() {\
            initAudioContext();\
            if (indexAtual >= 0 && playlistLocal[indexAtual]) {\
                tocarItem(playlistLocal[indexAtual]);\
            } else if (playlistLocal.length > 0) {\
                indexAtual = 0;\
                tocarItem(playlistLocal[0]);\
            }\
        }\
\
        function enviarPedidoPublico() {\
            const input = document.getElementById('linkMusicaOuvinte');\
            if (input.value) {\
                listaEspera.push({ nome: input.value, url: input.value });\
                input.value = '';\
                atualizarExibicaoFila();\
                alert('Pedido enviado para aprova√ß√£o do DJ!');\
            }\
        }\
\
        function aprovarPedido(i) {\
            let item = listaEspera.splice(i, 1)[0];\
            playlistLocal.push({ tipo: 'web', nome: item.nome, url: item.url, checado: false });\
            atualizarExibicaoFila();\
            if (indexAtual === -1) proximaMusica();\
        }\
\
        function recusarPedido(i) {\
            listaEspera.splice(i, 1);\
            atualizarExibicaoFila();\
        }\
\
        function carregarMp3Locais() {\
            const files = document.getElementById('fileInput').files;\
            for (let i = 0; i < files.length; i++) {\
                playlistLocal.push({\
                    tipo: 'local',\
                    nome: files[i].name,\
                    url: URL.createObjectURL(files[i]),\
                    checado: false\
                });\
            }\
            atualizarExibicaoFila();\
            if (indexAtual === -1) proximaMusica();\
        }\
\
        function tocarItem(item) {\
            if (!item) return;\
            document.getElementById('status').innerText = 'TOCANDO: ' + item.nome.toUpperCase();\
\
            if (item.tipo === 'local') {\
                if (ytPlayer?.stopVideo) ytPlayer.stopVideo();\
                document.getElementById('ytPlayerContainer').style.display = 'none';\
                audioOuvinte.style.display = 'block';\
                audioOuvinte.src = item.url;\
                audioAdm.src = item.url;\
                \
                let crossSecs = parseFloat(document.getElementById('crossfadeTimer').value);\
                audioOuvinte.volume = 0;\
                audioOuvinte.play();\
                audioAdm.play();\
                \
                let vol = 0;\
                let interval = setInterval(() => {\
                    if (vol < 1) { vol += 0.1; audioOuvinte.volume = Math.min(1, vol); }\
                    else { clearInterval(interval); }\
                }, (crossSecs * 100));\
\
            } else {\
                audioOuvinte.pause();\
                audioOuvinte.style.display = 'none';\
                document.getElementById('ytPlayerContainer').style.display = 'block';\
                let id = extrairIdYoutube(item.url);\
                if (ytPlayer?.loadVideoById) ytPlayer.loadVideoById(id);\
            }\
        }\
\
        function proximaMusica() {\
            if (indexAtual < playlistLocal.length - 1) {\
                indexAtual++;\
                tocarItem(playlistLocal[indexAtual]);\
                atualizarExibicaoFila();\
            }\
        }\
\
        function voltarMusica() {\
            if (indexAtual > 0) {\
                indexAtual--;\
                tocarItem(playlistLocal[indexAtual]);\
                atualizarExibicaoFila();\
            }\
        }\
\
        function misturarFila() {\
            playlistLocal.sort(() => Math.random() - 0.5);\
            indexAtual = 0;\
            atualizarExibicaoFila();\
            if(playlistLocal.length > 0) tocarItem(playlistLocal[0]);\
        }\
\
        function alternarCheck(i) { playlistLocal[i].checado = !playlistLocal[i].checado; }\
        function selecionarTodasFila(st) { playlistLocal.forEach(m => m.checado = st); atualizarExibicaoFila(); }\
        function excluirMarcados() { playlistLocal = playlistLocal.filter(m => !m.checado); indexAtual = -1; atualizarExibicaoFila(); }\
\
        function atualizarExibicaoFila() {\
            document.getElementById('filaOuvinte').innerHTML = playlistLocal.map((m, i) => \
                `<li ${i === indexAtual ? 'style="font-weight:bold; color:#fff;"' : ''}>${i+1}. ${m.nome} ${i === indexAtual ? '‚É∂∂' : ''}</li>`\
            ).join('');\
\
            document.getElementById('filaAdm').innerHTML = playlistLocal.map((m, i) => `\
                <li>\
                    <span><input type="checkbox" ${m.checado ? 'checked' : ''} onclick="alternarCheck(${i})"> ${i+1}. ${m.nome}</span>\
                </li>\
            `).join('');\
\
            document.getElementById('listaEspera').innerHTML = listaEspera.map((m, i) => `\
                <li>\
                    <span>${m.nome}</span>\
                    <div>\
                        <button class="btn-small" onclick="aprovarPedido(${i})">‚ÉæÉµ</button>\
                        <button class="btn-small btn-danger" onclick="recusarPedido(${i})">‚ÉΩÉ¨</button>\
                    </div>\
                </li>\
            `).join('');\
        }\
\
        function pausarEPlay() {\
            if (audioOuvinte.paused) { audioOuvinte.play(); audioAdm.play(); }\
            else { audioOuvinte.pause(); audioAdm.pause(); }\
        }\
\
        function limparFila() {\
            playlistLocal = []; indexAtual = -1;\
            audioOuvinte.pause(); audioAdm.pause();\
            if (ytPlayer?.stopVideo) ytPlayer.stopVideo();\
            atualizarExibicaoFila();\
        }\
\
        /* ANIMA√Éß√É£O INDEPENDENTE: SUBWOOFER, CORNETA E TWEETER */\
        setInterval(() => {\
            const bars = document.querySelectorAll('.vu-bar');\
            const tocando = !audioOuvinte.paused || (ytPlayer && ytPlayer.getPlayerState && ytPlayer.getPlayerState() === 1);\
\
            let subs = document.querySelectorAll('.spk-sub');\
            let horns = document.querySelectorAll('.spk-horn');\
            let tweeters = document.querySelectorAll('.spk-tweeter');\
\
            bars.forEach((bar) => {\
                if (tocando) {\
                    let lvl = Math.floor(Math.random() * 85) + 15;\
                    bar.style.height = lvl + '%';\
                    \
                    /* Subwoofer pula no grave */\
                    let bassBoost = parseFloat(document.getElementById('eqBass').value) + (graveExtremeAtivo ? 20 : 0);\
                    let subScale = 1 + ((lvl + bassBoost * 2) / 300);\
                    subs.forEach(s => s.style.transform = `scale(${subScale})`);\
\
                    /* Corneta vibra no m√©dio */\
                    let midBoost = parseFloat(document.getElementById('eqMid').value);\
                    let hornScale = 1 + ((lvl + midBoost * 2) / 500);\
                    horns.forEach(h => {\
                        h.style.transform = `scale(${hornScale})`;\
                        h.style.boxShadow = lvl > 60 ? '0 0 10px var(--speaker-color)' : 'none';\
                    });\
\
                    /* Tweeter pisca no agudo */\
                    let trebleBoost = parseFloat(document.getElementById('eqTreble').value);\
                    tweeters.forEach(t => {\
                        t.style.opacity = (lvl + trebleBoost * 3) / 100;\
                        t.style.transform = lvl > 70 ? 'scale(1.15)' : 'scale(1)';\
                    });\
\
                } else {\
                    bar.style.height = '10%';\
                    subs.forEach(s => s.style.transform = 'scale(1)');\
                    horns.forEach(h => { h.style.transform = 'scale(1)'; h.style.boxShadow = 'none'; });\
                    tweeters.forEach(t => { t.style.opacity = '0.5'; t.style.transform = 'scale(1)'; });\
                }\
            });\
        }, 100);\
\
        function verAba(aba) {\
            document.getElementById('abaOuvinte').style.display = aba === 'ouvinte' ? 'block' : 'none';\
            document.getElementById('abaAdm').style.display = aba === 'adm' ? 'block' : 'none';\
            document.getElementById('abaCustom').style.display = aba === 'custom' ? 'block' : 'none';\
        }\
\
        function solicitarAcesso(abaTarget) {\
            if (admAutenticado) {\
                verAba(abaTarget);\
            } else {\
                abaPendente = abaTarget;\
                document.getElementById('modalLogin').style.display = 'block';\
            }\
        }\
\
        function validarLogin() {\
            if (document.getElementById('loginEmail').value === 'fabiojr073@gmail.com' && document.getElementById('loginPass').value === 'Deus777') {\
                admAutenticado = true;\
                document.getElementById('modalLogin').style.display = 'none';\
                verAba(abaPendente);\
            } else { alert('Dados de ADM incorretos!'); }\
        }\
\
        function cancelarLogin() { document.getElementById('modalLogin').style.display = 'none'; }\
        function copiarLink() { navigator.clipboard.writeText(document.getElementById('urlRadio').value); alert('Link copiado!'); }\
        function logout() { location.reload(); }\
    </script>\
</body>\
</html>\
EOF\

