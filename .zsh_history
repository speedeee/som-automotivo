    players = {"1": "Pioneer MVH-X3000BR", "2": "Stetsom Player", "3": "Expert Electronics", "4": "Alpine/Kenwood"}\
    player_eleito = players.get(player_opt, "Pioneer MVH-X3000BR")\
\
    # 2. Tamanho dos Alto-Falantes de Grave\
    print("\n[2] TAMANHO DOS WOOFERS / SUBWOOFERS:")\
    print("  1. Woofers de 12\" (Grave r√ÉÅpido, seco e de ataque)")\
    print("  2. Woofers de 15\" (O mais vers√ÉÅtil, grave forte pra fora)")\
    print("  3. Woofers de 18\" (Subgrave profundo e longo alcance)")\
    woofer_opt = input(" Escolha o tamanho (1-3): ")\
    woofers = {"1": "Woofers 12\"", "2": "Woofers 15\"", "3": "Woofers 18\""}\
    size_eleito = woofers.get(woofer_opt, "Woofers 15\"")\
    \
    qtd_woofers = input(" Quantidade de Woofers (ex: 2): ") or "2"\
    rms_woofer = input(" Pot√™ncia RMS por falante em Watts (ex: 1500): ") or "1500"\
\
    # 3. Cornetas e Drivers\
    print("\n[3] TIPO E MATERIAL DAS CORNETAS:")\
    fmt = input(" Formato da Corneta -> [1] Redonda | [2] Quadrada: ")\
    formato = "Redonda" if fmt == "1" else "Quadrada"\
    \
    mat = input(" Material do Horn  -> [1] Alum√≠nio | [2] Pl√ÉÅstico ABS: ")\
    material = "Alum√≠nio" if mat == "1" else "Pl√ÉÅstico ABS"\
    \
    qtd_cornetas = input(" Quantidade de Cornetas (ex: 2 ou 4): ") or "2"\
\
    # 4. Pot√™ncia El√©trica Total e Cobre\
    tot_rms = (int(qtd_woofers) * int(rms_woofer)) + 800  # Adicionando m√©dia de voz/agudo\
    \
    # C√ÉÅlculos El√©tricos\
    ah_recomendado = int(tot_rms / 20)  # Regra de bolso ~20W RMS por Ah\
    cabo_mm = "35mm¬≤" if tot_rms <= 3000 else "50mm¬≤"\
    disjuntor = "150A" if tot_rms <= 3000 else "200A"\
\
    # 5. Apresenta√ß√£o do Script de Montagem e Regulagem\
    limpar_tela()\
    relatorio = f"""\
=======================================================\
 ÉøÉªÉÄÔ∏ÉØ PROJETO DE SOM AUTOMOTIVO - RELAT√É≥RIO FINAL ÉøÉªÉÄÔ∏ÉØ\
=======================================================\
\
ÉøÉ≥ª UNIDADE CENTRAL:\
  ‚ÄÉÇ Player Selecionado: {player_eleito}\
  ‚ÄÉÇ Sa√≠das M√≠nimas Recomendadas: 3 Pares RCA (Front, Rear, Sub)\
\
ÉøÉ¥É™ CAIXA TRIO / PARED√É£O:\
  ‚ÄÉÇ Grave: {qtd_woofers}x {size_eleito} ({rms_woofer}W RMS cada)\
  ‚ÄÉÇ Voz/M√©dio-Agudo: {qtd_cornetas}x Drivers com Corneta {formato} em {material}\
  ‚ÄÉÇ Ilumina√ß√£o Visual: Fita Neon Flex RGB com Central Bluetooth/Strobe\
\
ÉøÉÆÉªÔ∏ÉØ CONFIGURA√Éß√É£O DE CROSSOVER NO PROCESSADOR (DSP):\
  -----------------------------------------------------\
  [CANAL 1 - GRAVE ({size_eleito})]\
    - HPF (Corte Subs√¥nico): 40 Hz (BT24)\
    - LPF (Corte Superior) : 200 Hz (BT24)\
    \
  [CANAL 2 - M√É©DIO GRAVE (8" ou 10")]\
    - HPF: 200 Hz (BT24)\
    - LPF: 1200 Hz (BT24)\
    \
  [CANAL 3 - CORNETAS ({material})]\
    - HPF: 1200 Hz (BT24)\
    - LPF: 5000 Hz (BT24)\
    \
  [CANAL 4 - SUPER TWEETERS]\
    - HPF: 5000 Hz (BT24)\
    - LPF: 20000 Hz (BT24)\
\
‚É∫ÉÅ DIMENSIONAMENTO EL√É©TRICO E FIA√Éß√É£O (PARA ~{tot_rms}W RMS):\
  -----------------------------------------------------\
  ‚ÄÉÇ Bateria Auxiliar M√≠nima: {ah_recomendado} Ah (AGM/Gel/Estacion√ÉÅria)\
  ‚ÄÉÇ Fonte Automotiva      : Fonte {int(ah_recomendado * 0.8)}A a {ah_recomendado}A\
  ‚ÄÉÇ Bitola Cabos Energia  : {cabo_mm} 100% Cobre\
  ‚ÄÉÇ Disjuntor no Cofre    : {disjuntor}\
  ‚ÄÉÇ Distribui√ß√£o          : Barramento de Cobre Maci√ßo (Positivo e Negativo)\
\
=======================================================\
    """\
    print(relatorio)\
    \
    salvar = input("Deseja salvar este relat√≥rio em 'projeto_som.txt'? (s/n): ")\
    if salvar.lower() == 's':\
        with open("projeto_som.txt", "w", encoding="utf-8") as f:\
            f.write(relatorio)\
        print("\n‚ÉºÉ• Arquivo 'projeto_som.txt' salvo com sucesso!")\
\
if __name__ == "__main__":\
    menu_principal()\

