#!/bin/bash\
clear\
pkill -f node > /dev/null 2>&1\
pkill -f cloudflared > /dev/null 2>&1\
sleep 1\
\
cd ~/minha-radio && node server.js > /dev/null 2>&1 &\
\
echo "=========================================="\
echo "      ‚É∫ÉÅ SPEED R√ÅDIO - ONLINE ‚É∫ÉÅ          "\
echo "=========================================="\
echo ""\
echo "Gerando link da r√ÉÅdio, aguarde..."\
\
cloudflared tunnel --url http://127.0.0.1:3000 2>&1 | grep -o 'https://[a-zA-Z0-9-]*\.trycloudflare\.com' | while read -r LINK; do\
    clear\
    echo "=================================================="\
    echo "         ‚É∫ÉÅ SPEED R√ÅDIO - AO VIVO ‚É∫ÉÅ               "\
    echo "=================================================="\
    echo ""\
    echo "   COPIE E ENVIE O LINK ABAIXO PARA OS OUVINTES: "\
    echo ""\
    echo "   ÉøÉ±É©  $LINK  ÉøÉ±É®"\
    echo ""\
    echo "=================================================="\
    echo " Presione CTRL + C para desligar a r√ÉÅdio."\
done\
EOF\
chmod +x ~/iniciar.sh\

