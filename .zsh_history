: 1786209481:0;cat << 'EOF' > index.html\
<!DOCTYPE html>\
<html lang="pt-BR">\
<head>\
  <meta charset="UTF-8">\
  <meta name="viewport" content="width=device-width, initial-scale=1.0">\
  <title>Simulador Master PRO - Som Automotivo Realista</title>\
  <style>\
    :root {\
      --bg-dark: #04060c;\
      --card-bg: #0b1120;\
      --border-color: #1e293b;\
      --accent-red: #ff0055;\
      --neon-cyan: #00f0ff;\
      --neon-yellow: #ffcc00;\
      --led-color1: #00f0ff;\
      --led-color2: #ff0055;\
      --caixa-bg-color: #18181b;\
      --caixa-texture: none;\
      --text-main: #f8fafc;\
    }\
\
    body {\
      background-color: var(--bg-dark);\
      background-size: cover;\
      background-position: center;\
      color: var(--text-main);\
      font-family: 'Segoe UI', Roboto, sans-serif;\
      margin: 0;\
      padding: 10px;\
      padding-bottom: 60px;\
    }\
\
    h1 {\
      text-align: center;\
      color: var(--accent-red);\
      font-size: 18px;\
      margin-bottom: 10px;\
      text-transform: uppercase;\
      letter-spacing: 1.5px;\
      text-shadow: 0 0 10px var(--led-color1);\
    }\
\
    .reparticao {\
      background: rgba(11, 17, 32, 0.95);\
      border: 1px solid var(--border-color);\
      border-radius: 10px;\
      padding: 12px;\
      margin-bottom: 14px;\
      box-shadow: 0 6px 20px rgba(0,0,0,0.8);\
    }\
\
    .reparticao-titulo {\
      font-size: 12px;\
      font-weight: bold;\
      color: var(--neon-cyan);\
      text-transform: uppercase;\
      border-bottom: 1px solid var(--border-color);\
      padding-bottom: 6px;\
      margin-bottom: 10px;\
      display: flex;\
      align-items: center;\
      gap: 6px;\
    }\
\
    /* REPARTI√Éß√É£O 1: PALCO E CAIXA AC√É∫STICA */\
    .palco-caixa {\
      background: #000;\
      border: 3px solid var(--led-color1);\
      border-radius: 12px;\
      padding: 15px;\
      display: flex;\
      flex-direction: column;\
      align-items: center;\
      gap: 12px;\
      position: relative;\
      box-shadow: inset 0 0 30px rgba(0,0,0,0.9), 0 0 15px var(--led-color1);\
      transition: all 0.2s;\
    }\
\
    /* CAIXA AC√É∫STICA COM REVESTIMENTO CUSTOMIZADO */\
    .caixa-acustica {\
      background-color: var(--caixa-bg-color);\
      background-image: var(--caixa-texture);\
      background-size: cover;\
      background-position: center;\
      border: 5px solid #27272a;\
      border-radius: 10px;\
      padding: 15px;\
      width: 95%;\
      box-sizing: border-box;\
      display: flex;\
      flex-direction: column;\
      align-items: center;\
      gap: 12px;\
      box-shadow: inset 0 0 25px #000, 0 8px 25px rgba(0,0,0,0.9);\
      position: relative;\
      transition: all 0.3s ease;\
    }\
\
    .painel-cornetas, .painel-woofers, .painel-dutos {\
      display: flex;\
      flex-wrap: wrap;\
      justify-content: center;\
      gap: 12px;\
      width: 100%;\
    }\
\
    /* LEDS NOS DUTOS */\
    .duto-redondo {\
      width: 42px;\
      height: 42px;\
      border-radius: 50%;\
      background: radial-gradient(circle, #000 35%, #18181b 75%, #3f3f46 100%);\
      border: 3px solid var(--led-color1);\
      box-shadow: inset 0 0 8px #000, 0 0 12px var(--led-color1);\
    }\
\
    .duto-quadrado {\
      width: 88%;\
      height: 22px;\
      background: linear-gradient(180deg, #000 0%, #18181b 100%);\
      border: 2px solid var(--led-color1);\
      border-radius: 4px;\
      box-shadow: inset 0 0 10px #000, 0 0 12px var(--led-color1);\
    }\
\
    /* ALTO-FALANTES REALISTAS */\
    .real-woofer {\
      width: 82px;\
      height: 82px;\
      border-radius: 50%;\
      background: radial-gradient(circle, #27272a 15%, #09090b 55%, #18181b 85%, #000 100%);\
      border: 6px solid #3f3f46;\
      outline: 2px solid var(--led-color2);\
      box-shadow: inset 0 0 15px #000, 0 0 12px var(--led-color2);\
      position: relative;\
      display: flex;\
      align-items: center;\
      justify-content: center;\
      font-size: 8px;\
      font-weight: 900;\
      color: #e4e4e7;\
      text-transform: uppercase;\
    }\
\
    .real-woofer::after {\
      content: '';\
      width: 28px;\
      height: 28px;\
      border-radius: 50%;\
      background: radial-gradient(circle, #52525b 0%, #18181b 100%);\
      border: 1px solid #71717a;\
    }\
\
    .real-driver {\
      width: 55px;\
      height: 55px;\
      background: linear-gradient(145deg, #27272a, #09090b);\
      border: 2px solid #a1a1aa;\
      outline: 1px solid var(--led-color1);\
      color: var(--neon-cyan);\
      font-size: 8px;\
      font-weight: bold;\
      display: flex;\
      align-items: center;\
      justify-content: center;\
      text-align: center;\
      box-shadow: 0 0 8px var(--led-color1);\
    }\
\
    .driver-square { border-radius: 4px; }\
\
    .real-woofer.vibrando { animation: pulsoReal 0.08s infinite alternate; }\
    @keyframes pulsoReal {\
      0% { transform: scale(1); }\
      100% { transform: scale(1.14); box-shadow: 0 0 20px var(--led-color2); }\
    }\
\
    /* RACK DE APARELHOS */\
    .rack-frame {\
      background: #02040a;\
      border: 2px solid #1e293b;\
      border-radius: 8px;\
      padding: 10px;\
      display: flex;\
      flex-direction: column;\
      gap: 10px;\
    }\
\
    .player-pioneer-real {\
      background: linear-gradient(180deg, #111 0%, #000 100%);\
      border: 3px solid #333;\
      border-radius: 6px;\
      padding: 8px 12px;\
      display: flex;\
      justify-content: space-between;\
      align-items: center;\
      box-shadow: inset 0 0 10px #000, 0 4px 10px rgba(0,0,0,0.8);\
    }\
\
    .pioneer-knob {\
      width: 30px;\
      height: 30px;\
      border-radius: 50%;\
      background: radial-gradient(circle, #555 20%, #111 80%);\
      border: 2px solid #888;\
      box-shadow: 0 0 5px #000;\
    }\
\
    .pioneer-display {\
      background: #000;\
      border: 1px solid #00f0ff;\
      color: #00f0ff;\
      font-family: monospace;\
      font-size: 10px;\
      padding: 4px 10px;\
      border-radius: 4px;\
      text-shadow: 0 0 6px #00f0ff;\
      display: flex;\
      align-items: center;\
      gap: 6px;\
    }\
\
    .voltimetro-box {\
      background: #000;\
      border: 2px solid var(--accent-red);\
      border-radius: 8px;\
      text-align: center;\
      padding: 10px;\
    }\
\
    .voltimetro-num {\
      font-size: 36px;\
      font-weight: 900;\
      color: #ff2a2a;\
      font-family: monospace;\
      text-shadow: 0 0 15px #ff0000;\
    }\
\
    label {\
      display: block;\
      font-size: 10px;\
      color: #94a3b8;\
      margin-top: 6px;\
      text-transform: uppercase;\
      font-weight: bold;\
    }\
\
    select, input[type="text"], input[type="number"], input[type="range"] {\
      width: 100%;\
      padding: 8px;\
      margin-top: 3px;\
      background: #020617;\
      border: 1px solid #334155;\
      color: #fff;\
      border-radius: 6px;\
      box-sizing: border-box;\
      font-size: 11px;\
    }\
\
    .grid-2 { display: flex; gap: 8px; }\
    .grid-2 > div { flex: 1; }\
\
    .playlist-box {\
      background: #020617;\
      border: 1px solid #1e293b;\
      border-radius: 6px;\
      padding: 6px;\
      max-height: 100px;\
      overflow-y: auto;\
      font-size: 10px;\
      margin-top: 6px;\
    }\
\
    .playlist-item {\
      padding: 4px;\
      border-bottom: 1px solid #0f172a;\
      color: #94a3b8;\
      cursor: pointer;\
    }\
\
    .playlist-item.ativo {\
      color: #fff;\
      background: var(--accent-red);\
      font-weight: bold;\
      border-radius: 3px;\
    }\
  </style>\
</head>\
<body>\
\
  <h1>ÉøÉ¥É™ SIMULADOR AUTOMOTIVO MASTER PRO</h1>\
\
  <div class="reparticao">\
    <div class="reparticao-titulo">ÉøÉ≥¶ Reparti√ß√£o 1: Palco & Caixa Ac√∫stica</div>\
    <div class="palco-caixa" id="palcoVirtual">\
      <div class="caixa-acustica" id="caixaAcustica">\
        <div class="painel-cornetas" id="painelCornetas"></div>\
        <div class="painel-woofers" id="painelWoofers"></div>\
        <div class="painel-dutos" id="painelDutos"></div>\
      </div>\
    </div>\
  </div>\
\
  <div class="reparticao">\
    <div class="reparticao-titulo">ÉøÉ≥ª Reparti√ß√£o 2: Rack de Eletr√¥nicos & Players</div>\
    <div class="rack-frame">\
      <div id="playerContainer"></div>\
      <div style="background:#09090b; border:1px solid #27272a; padding:8px; border-radius:6px; font-size:10px;">\
        <span style="color:var(--neon-cyan); font-weight:bold;">ÉøÉÆÉª DSP PROCESSADOR:</span>\
        <span id="txtDspSelected">Stetsom STX2448 Digital</span>\
      </div>\
    </div>\
  </div>\
\
  <div class="reparticao">\
    <div class="reparticao-titulo">‚É∫ÉÅ Reparti√ß√£o 3: Barramento & Voltagem</div>\
    <div class="voltimetro-box">\
      <div style="font-size:9px; color:#aaa;">MONITOR DE BATERIA</div>\
      <div class="voltimetro-num" id="voltsDisplay">12.6 V</div>\
      <div style="font-size:10px; color:var(--neon-yellow);" id="alertaDisplay">SISTEMA EST√ÅVEL</div>\
    </div>\
  </div>\
\
  <div class="reparticao">\
    <div class="reparticao-titulo">ÉøÉÆ® Customiza√ß√£o da Caixa (Materiais & Foto)</div>\
    \
    <div class="grid-2">\
      <div>\
        <label>Material da Caixa:</label>\
        <select id="boxMaterial" onchange="alterarMaterialCaixa()">\
          <option value="padrao">Padr√£o Grafitado</option>\
          <option value="couro">Couro Preto Costurado</option>\
          <option value="carbono">Vinil Fibra de Carbono 3D</option>\
          <option value="mdf">Madeira / MDF Cru</option>\
          <option value="liso">Pintura Liso Gloss</option>\
        </select>\
      </div>\
      <div>\
        <label>Cor do Fundo da Caixa:</label>\
        <input type="color" id="caixaBgColor" value="#18181b" onchange="alterarCorCaixa()">\
      </div>\
    </div>\
\
    <label>ÉøÉ≥∏ Carregar Foto do Celular no Fundo da Caixa:</label>\
    <input type="file" id="boxBgFile" accept="image/*" onchange="alterarFotoCaixa(event)">\
  </div>\
\
  <div class="reparticao">\
    <div class="reparticao-titulo">ÉøÉªÉÄ Painel de Componentes & LEDs</div>\
    \
    <div class="grid-2">\
      <div>\
        <label>Cor LED 1:</label>\
        <input type="color" id="ledColor1" value="#00f0ff" onchange="atualizarLeds()">\
      </div>\
      <div>\
        <label>Cor LED 2:</label>\
        <input type="color" id="ledColor2" value="#ff0055" onchange="atualizarLeds()">\
      </div>\
    </div>\
\
    <div class="grid-2">\
      <div>\
        <label>Player Principal:</label>\
        <select id="playerModel" onchange="atualizarPlayerUI()">\
          <option value="pioneer">Pioneer Golfinho (1DIN Real)</option>\
          <option value="android">Central Multim√≠dia Android</option>\
        </select>\
      </div>\
      <div>\
        <label>Processador DSP:</label>\
        <select id="dspModel" onchange="atualizarRack()">\
          <option value="Stetsom STX2448 Digital">Stetsom STX2448</option>\
          <option value="Expert PX-2 PRO">Expert PX-2 PRO</option>\
          <option value="Taramps Pro 2.4S">Taramps Pro 2.4S</option>\
        </select>\
      </div>\
    </div>\
\
    <div class="grid-2">\
      <div>\
        <label>Marca Woofers:</label>\
        <select id="wooferBrand" onchange="atualizarPalco()">\
          <option value="Eros">Eros Target Bass</option>\
          <option value="Triton">Triton Shocker</option>\
          <option value="JBL">JBL Vulcano/Tornado</option>\
          <option value="Hard Power">Hard Power</option>\
        </select>\
      </div>\
      <div>\
        <label>Qtd Woofers:</label>\
        <input type="number" id="wooferQty" value="2" min="1" max="8" onchange="atualizarPalco()">\
      </div>\
    </div>\
\
    <div class="grid-2">\
      <div>\
        <label>Tipo de Duto:</label>\
        <select id="dutoType" onchange="atualizarPalco()">\
          <option value="redondo">Redondo com LED</option>\
          <option value="quadrado">R√©gua com LED</option>\
        </select>\
      </div>\
      <div>\
        <label>Drivers/Cornetas:</label>\
        <input type="number" id="driverQty" value="2" min="0" max="8" onchange="atualizarPalco()">\
      </div>\
    </div>\
\
    <label style="margin-top:10px;">ÉøÉ≥ª M√∫sicas do Celular (.mp3):</label>\
    <input type="file" id="audioFiles" multiple accept="audio/*" onchange="carregarPlaylist(event)">\
    <audio id="audioPlayer" style="width:100%; margin-top:8px;" controls crossorigin="anonymous"></audio>\
\
    <div class="playlist-box" id="playlistContainer">\
      <div style="color:#64748b;">Nenhuma m√∫sica carregada...</div>\
    </div>\
  </div>\
\
  <script>\
    let playlist = [];\
    let currentIndex = 0;\
    const audio = document.getElementById('audioPlayer');\
\
    function alterarCorCaixa() {\
      const color = document.getElementById('caixaBgColor').value;\
      document.documentElement.style.setProperty('--caixa-bg-color', color);\
    }\
\
    function alterarMaterialCaixa() {\
      const mat = document.getElementById('boxMaterial').value;\
      let texture = 'none';\
\
      if (mat === 'couro') {\
        texture = 'radial-gradient(circle, rgba(0,0,0,0.6) 0%, rgba(0,0,0,0.9) 100%)';\
        document.documentElement.style.setProperty('--caixa-bg-color', '#111113');\
      } else if (mat === 'carbono') {\
        texture = 'linear-gradient(45deg, #111 25%, #222 25%, #222 50%, #111 50%, #111 75%, #222 75%, #222 100%)';\
        document.documentElement.style.setProperty('--caixa-bg-color', '#0a0a0c');\
      } else if (mat === 'mdf') {\
        texture = 'linear-gradient(180deg, rgba(160,82,45,0.8) 0%, rgba(110,50,20,0.9) 100%)';\
        document.documentElement.style.setProperty('--caixa-bg-color', '#8B4513');\
      } else if (mat === 'liso') {\
        texture = 'none';\
      } else {\
        texture = 'radial-gradient(circle, #18181b 0%, #09090b 100%)';\
        document.documentElement.style.setProperty('--caixa-bg-color', '#18181b');\
      }\
\
      document.documentElement.style.setProperty('--caixa-texture', texture);\
    }\
\
    function alterarFotoCaixa(event) {\
      const file = event.target.files[0];\
      if (file) {\
        const url = URL.createObjectURL(file);\
        document.documentElement.style.setProperty('--caixa-texture', `url('${url}')`);\
      }\
    }\
\
    function atualizarLeds() {\
      const c1 = document.getElementById('ledColor1').value;\
      const c2 = document.getElementById('ledColor2').value;\
      document.documentElement.style.setProperty('--led-color1', c1);\
      document.documentElement.style.setProperty('--led-color2', c2);\
    }\
\
    function atualizarPalco() {\
      const wooferQty = parseInt(document.getElementById('wooferQty').value) || 2;\
      const wooferBrand = document.getElementById('wooferBrand').value;\
      const driverQty = parseInt(document.getElementById('driverQty').value) || 2;\
      const dutoType = document.getElementById('dutoType').value;\
\
      const pCornetas = document.getElementById('painelCornetas');\
      const pWoofers = document.getElementById('painelWoofers');\
      const pDutos = document.getElementById('painelDutos');\
\
      pCornetas.innerHTML = '';\
      pWoofers.innerHTML = '';\
      pDutos.innerHTML = '';\
\
      for(let i = 0; i < driverQty; i++) {\
        const driver = document.createElement('div');\
        driver.className = 'real-driver driver-square';\
        driver.innerText = 'DRIVER';\
        pCornetas.appendChild(driver);\
      }\
\
      for(let i = 0; i < wooferQty; i++) {\
        const woofer = document.createElement('div');\
        woofer.className = 'real-woofer';\
        woofer.innerText = wooferBrand;\
        pWoofers.appendChild(woofer);\
      }\
\
      if (dutoType === 'quadrado') {\
        const duto = document.createElement('div');\
        duto.className = 'duto-quadrado';\
        pDutos.appendChild(duto);\
      } else {\
        for(let i = 0; i < 2; i++) {\
          const duto = document.createElement('div');\
          duto.className = 'duto-redondo';\
          pDutos.appendChild(duto);\
        }\
      }\
    }\
\
    function atualizarPlayerUI() {\
      const model = document.getElementById('playerModel').value;\
      const container = document.getElementById('playerContainer');\
      const currentTrack = playlist[currentIndex] ? playlist[currentIndex].name : "BLUETOOTH READY";\
\
      if (model === 'pioneer') {\
        container.innerHTML = `\
          <div class="player-pioneer-real">\
            <div class="pioneer-knob"></div>\
            <div class="pioneer-display">ÉøÉ∞¨ ${currentTrack}</div>\
            <span style="color:#666; font-size:9px; font-weight:bold;">PIONEER</span>\
          </div>\
        `;\
      } else {\
        container.innerHTML = `\
          <div class="player-pioneer-real" style="border-color:#00ff66;">\
            <span style="color:#00ff66; font-size:9px; font-weight:bold;">ANDROID TOUCH</span>\
            <div class="pioneer-display" style="border-color:#00ff66; color:#00ff66;">‚É∂∂ ${currentTrack}</div>\
          </div>\
        `;\
      }\
    }\
\
    function atualizarRack() {\
      const dsp = document.getElementById('dspModel').value;\
      document.getElementById('txtDspSelected').innerText = dsp;\
    }\
\
    function carregarPlaylist(event) {\
      const files = event.target.files;\
      if (!files.length) return;\
      playlist = Array.from(files);\
      currentIndex = 0;\
      renderPlaylist();\
      tocarMusica(currentIndex);\
    }\
\
    function renderPlaylist() {\
      const container = document.getElementById('playlistContainer');\
      container.innerHTML = '';\
      playlist.forEach((file, index) => {\
        const item = document.createElement('div');\
        item.className = 'playlist-item' + (index === currentIndex ? ' ativo' : '');\
        item.innerText = `${index + 1}. ${file.name}`;\
        item.onclick = () => tocarMusica(index);\
        container.appendChild(item);\
      });\
    }\
\
    function tocarMusica(index) {\
      if (index < 0 || index >= playlist.length) return;\
      currentIndex = index;\
      const file = playlist[currentIndex];\
      audio.src = URL.createObjectURL(file);\
      audio.play();\
      renderPlaylist();\
      atualizarPlayerUI();\
    }\
\
    audio.onplay = () => {\
      document.querySelectorAll('.real-woofer').forEach(w => w.classList.add('vibrando'));\
      document.getElementById('voltsDisplay').innerText = '10.9 V';\
      document.getElementById('alertaDisplay').innerText = '‚É∫ÉÅ BASS DROP / CONSUMO ATIVO';\
    };\
\
    audio.onpause = () => {\
      document.querySelectorAll('.real-woofer').forEach(w => w.classList.remove('vibrando'));\
      document.getElementById('voltsDisplay').innerText = '12.6 V';\
      document.getElementById('alertaDisplay').innerText = 'SISTEMA EST√ÅVEL';\
    };\
\
    atualizarPalco();\
    atualizarLeds();\
    atualizarPlayerUI();\
  </script>\
</body>\
</html>\
EOF\

