<!DOCTYPE html>\
<html lang="pt-BR">\
<head>\
    <meta charset="UTF-8">\
    <meta name="viewport" content="width=device-width, initial-scale=1.0">\
    <title>‚É∫ÉÅ SPEED R√ÅDIO - PIONEER EDITION</title>\
    <script src="/socket.io/socket.io.js"></script>\
    <script src="https://www.youtube.com/iframe_api"></script>\
    <style>\
        :root { \
            --bg-color: #0a0b0e; \
            --pioneer-blue: #00d4ff; \
            --pioneer-dark-blue: #002b3d;\
            --pioneer-glow: rgba(0, 212, 255, 0.4);\
            --card-color: #14161d; \
            --primary-color: #00d4ff; \
            --stage-light: #00d4ff; \
        }\
        body { background: var(--bg-color); color: #fff; font-family: 'Courier New', Courier, monospace; text-align: center; padding: 15px; margin: 0; }\
        \
        /* Moldura Estilo Som de Carro Pioneer */\
        .pioneer-frame {\
            background: linear-gradient(145deg, #1f232a, #0d0e12);\
            border: 4px solid #2a2e38;\
            border-radius: 18px;\
            padding: 20px;\
            max-width: 520px;\
            margin: 0 auto 15px auto;\
            box-shadow: 0 10px 30px rgba(0,0,0,0.9), inset 0 1px 1px rgba(255,255,255,0.1);\
            position: relative;\
        }\
\
        .pioneer-header {\
            display: flex;\
            justify-content: space-between;\
            align-items: center;\
            font-size: 11px;\
            color: #888;\
            margin-bottom: 10px;\
            letter-spacing: 1px;\
            font-weight: bold;\
        }\
\
        /* Visor LCD Cl√ÉÅssico */\
        .lcd-display {\
            background: #00121a;\
            border: 3px solid #002b3d;\
            border-radius: 8px;\
            padding: 12px;\
            box-shadow: inset 0 0 15px rgba(0, 212, 255, 0.2), 0 0 10px var(--pioneer-glow);\
            color: var(--pioneer-blue);\
            text-shadow: 0 0 5px var(--pioneer-blue);\
            margin-bottom: 15px;\
        }\
\
        .box-link { background: rgba(0, 212, 255, 0.05); border: 1px dashed var(--pioneer-blue); border-radius: 6px; padding: 8px; margin: 10px 0; }\
        .box-link input { width: 90%; text-align: center; font-size: 11px; background: #000; color: var(--pioneer-blue); border: 1px solid #005577; padding: 6px; border-radius: 5px; }\
        \
        input[type="text"], input[type="email"], input[type="password"] { width: 85%; padding: 10px; border-radius: 5px; border: 1px solid #005577; background: #00121a; color: #fff; margin-bottom: 10px; box-sizing: border-box; }\
        \
        button { padding: 10px 14px; border-radius: 6px; border: none; background: var(--pioneer-blue); color: #000; font-weight: bold; cursor: pointer; margin: 3px; box-shadow: 0 0 8px var(--pioneer-glow); }\
        .btn-danger { background: #e74c3c; color: #fff; box-shadow: none; }\
        .btn-warning { background: #f39c12; color: #fff; box-shadow: none; }\
        .btn-fx { background: #005577; color: #fff; font-size: 11px; padding: 8px; border: 1px solid var(--pioneer-blue); }\
        .btn-control { background: #14161d; color: var(--pioneer-blue); font-size: 14px; padding: 8px 12px; border: 1px solid var(--pioneer-blue); }\
        \
        /* VU Meter Estilo Pioneer Spectrum Analyzer */\
        .vu-container { display: flex; justify-content: center; align-items: flex-end; gap: 4px; height: 35px; background: #00080d; padding: 6px; border-radius: 5px; margin: 10px 0; border: 1px solid #003344; }\
        .vu-bar { width: 8%; background: #003344; height: 10%; border-radius: 2px; transition: height 0.1s ease; }\
        \
        .light-controls { display: flex; justify-content: center; gap: 5px; margin: 10px 0; }\
        .color-btn { width: 25px; height: 25px; border-radius: 50%; border: 2px solid #fff; cursor: pointer; }\
        \
        #ytPlayerContainer { position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; border-radius: 8px; background: #000; margin-top: 10px; border: 1px solid #003344; }\
        #ytPlayerContainer iframe, #audioLocal { position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 0; }\
        ol { text-align: left; background: rgba(0, 212, 255, 0.05); padding: 15px 30px; border-radius: 5px; max-height: 150px; overflow-y: auto; border: 1px solid #003344; color: var(--pioneer-blue); }\
        li { font-size: 13px; margin-bottom: 6px; border-bottom: 1px solid #002b3d; padding-bottom: 4px; word-break: break-all; }\
        .controls-bar { margin: 12px 0; display: flex; justify-content: center; gap: 6px; flex-wrap: wrap; }\
    </style>\
</head>\
