            { nome: "Headset Gamer RGB Profissional", preco: 89.90, imagem: "https://images.unsplash.com/photo-1546435770-a3e426bf472b?w=500&auto=format&fit=crop&q=60" },\
            { nome: "Fone Bluetooth para Capacete Intercom", preco: 79.90, imagem: "https://images.unsplash.com/photo-1568605117036-5fe5e7bab0b7?w=500&auto=format&fit=crop&q=60" },\
            { nome: "Mousepad Gamer XXL Estampado", preco: 34.90, imagem: "https://images.unsplash.com/photo-1615663245857-ac93bb7c39e7?w=500&auto=format&fit=crop&q=60" }\
        ];\
\
        let produtos = JSON.parse(localStorage.getItem('speed_produtos')) || produtosPadrao;\
