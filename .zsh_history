clear\
echo "=========================================="\
echo "      ‚É∫ÉÅ SPEED R√ÅDIO - LIGANDO...        "\
echo "=========================================="\
echo ""\
\
# 1. Limpa qualquer Node.js rodando em segundo plano pra nao dar erro de porta\
pkill -f node > /dev/null 2>&1\
sleep 1\
\
# 2. Inicia o servidor da radio\
echo "[1/2] Iniciando Servidor da R√ÉÅdio..."\
cd ~/minha-radio && node server.js &\
PID_SERVER=$!\
\
