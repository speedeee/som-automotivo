\
        function aplicarConfiguracoes() {\
            document.getElementById('store-name').innerText = configuracoes.nome;\
            document.getElementById('page-title').innerText = configuracoes.nome;\
            document.getElementById('store-slogan').innerText = configuracoes.slogan;\
            document.documentElement.style.setProperty('--cor-principal', configuracoes.cor);\
