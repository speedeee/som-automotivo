      const rms = parseInt(document.getElementById('wooferRms').value) || 1500;\
      const fmt = document.getElementById('hornFormat').value;\
      const mat = document.getElementById('hornMaterial').value;\
\
      const totalRms = (qty * rms) + 800;\
      const batAh = Math.round(totalRms / 20);\
      const cabo = totalRms <= 3000 ? "35mm¬≤" : "50mm¬≤";\
      const disj = totalRms <= 3000 ? "150A" : "200A";\
\
      document.getElementById('relatorioOutput').textContent = \
"=======================================================\n" +\
"ÉøÉªÉÄÔ∏ÉØ PROJETO DE SOM AUTOMOTIVO - RELAT√É≥RIO COMPLETO\n" +\
"=======================================================\n\n" +\
"ÉøÉ≥ª UNIDADE CENTRAL & EQUALIZA√Éß√É£O:\n" +\
"  ‚ÄÉÇ Player: " + p + "\n" +\
"  ‚ÄÉÇ Regulagem Grave Xtreme: Ativada (+5dB a +12dB em 60Hz)\n\n" +\
"ÉøÉ¥É™ CAIXA TRIO / PARED√É£O:\n" +\
"  ‚ÄÉÇ Woofers: " + qty + "x Falante(s) de " + size + '" (' + rms + "W RMS cada)\n" +\
"  ‚ÄÉÇ Cornetas: Drivers em Cornetas " + (fmt === 'square' ? 'Quadradas' : 'Redondas') + " de " + mat + "\n\n" +\
"ÉøÉÆÉªÔ∏ÉØ CORTE DE FREQU√É™NCIAS NO PROCESSADOR (DSP):\n" +\
"  ‚ÄÉÇ CANAL 1 (Woofers " + size + '"): HPF 40Hz (BT24) | LPF 200Hz (BT24)\n' +\
"  ‚ÄÉÇ CANAL 2 (M√©dio 8"/10"): HPF 200Hz (BT24) | LPF 1200Hz (BT24)\n' +\
"  ‚ÄÉÇ CANAL 3 (Cornetas " + mat + "): HPF 1200Hz (BT24) | LPF 5000Hz (BT24)\n" +\
"  ‚ÄÉÇ CANAL 4 (Super Tweeters): HPF 5000Hz (BT24) | LPF 20000Hz (BT24)\n\n" +\
"‚É∫ÉÅ SISTEMA EL√É©TRICO, BARRAMENTO E FIA√Éß√É£O (~" + totalRms + "W RMS Total):\n" +\
"  ‚ÄÉÇ Bateria Auxiliar M√≠nima: " + batAh + " Ah (AGM / Estacion√ÉÅria)\n" +\
"  ‚ÄÉÇ Fonte Automotiva      : " + Math.round(batAh * 0.8) + "A a " + batAh + "A\n" +\
"  ‚ÄÉÇ Barramento            : Barra de Cobre Maci√ßo (Positivo e Aterramento)\n" +\
"  ‚ÄÉÇ Bitola de Cabos       : " + cabo + " (100% Cobre)\n" +\
"  ‚ÄÉÇ Fus√≠vel/Disjuntor     : " + disj + " no cofre da bateria principal";\
    }\
\
    atualizarPalco();\
  </script>\
</body>\
</html>\
EOF\
\
