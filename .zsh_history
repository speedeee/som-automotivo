          <input type="range" class="vol-slider" id="bassBoost" min="0" max="20" value="5" oninput="ajustarBass(this.value)">\
          <span id="bassValue">N√≠vel Grave Xtreme: +5 dB</span>\
        </div>\
      </div>\
    </div>\
\
    <button onclick="gerarProjeto()">‚É∫ÉÅ CALCULAR TUDO & GERAR SCRIPT COMPLETO</button>\
\
    <div class="section" style="margin-top:15px;">\
      <h2>ÉøÉ≥É™ Script de Montagem, El√©trica e DSP</h2>\
      <div class="output-box" id="relatorioOutput">Clique no bot√£o acima para gerar a configura√ß√£o...</div>\
    </div>\
  </div>\
\
  <script>\
    let audioCtx, source, bassFilter;\
\
    function atualizarPalco() {\
      const qty = parseInt(document.getElementById('wooferQty').value) || 2;\
      const size = document.getElementById('wooferSize').value;\
      const format = document.getElementById('hornFormat').value;\
      const color = document.getElementById('neonColor').value;\
      \
      const stage = document.getElementById('stage');\
      const container = document.getElementById('speakersBox');\
      stage.style.borderColor = color;\
      stage.style.boxShadow = `0 0 15px ${color}88`;\
\
      container.innerHTML = '';\
\
      for(let i=0; i<2; i++) {\
        const horn = document.createElement('div');\
        horn.className = `horn ${format}`;\
        horn.innerText = 'DRIVER';\
        container.appendChild(horn);\
      }\
\
      for(let i=0; i<qty; i++) {\
        const w = document.createElement('div');\
        w.className = 'woofer';\
        w.style.width = size == '18' ? '120px' : (size == '15' ? '100px' : '80px');\
        w.style.height = w.style.width;\
        w.innerHTML = '<div class="woofer-inner"></div>';\
        container.appendChild(w);\
      }\
    }\
\
    function carregarAudioLocal(e) {\
      const file = e.target.files[0];\
      if (file) {\
        const audio = document.getElementById('mainAudio');\
        audio.src = URL.createObjectURL(file);\
        conectarAudioContext(audio);\
        audio.play();\
        ativarBatida();\
      }\
    }\
\
    function carregarAudioUrl() {\
      const url = document.getElementById('audioUrl').value;\
      if (url) {\
        const audio = document.getElementById('mainAudio');\
        audio.src = url;\
        conectarAudioContext(audio);\
        audio.play();\
        ativarBatida();\
      }\
    }\
\
    function conectarAudioContext(audioElement) {\
      if (!audioCtx) {\
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();\
        source = audioCtx.createMediaElementSource(audioElement);\
        bassFilter = audioCtx.createBiquadFilter();\
        bassFilter.type = 'lowshelf';\
        bassFilter.frequency.value = 100;\
        bassFilter.gain.value = 5;\
\
        source.connect(bassFilter);\
        bassFilter.connect(audioCtx.destination);\
      }\
    }\
\
    function ajustarBass(val) {\
      document.getElementById('bassValue').innerText = `N√≠vel Grave Xtreme: +${val} dB`;\
      if (bassFilter) bassFilter.gain.value = val;\
    }\
\
    function ativarBatida() {\
      const woofers = document.querySelectorAll('.woofer');\
      const audio = document.getElementById('mainAudio');\
      \
      audio.onplay = () => {\
        woofers.forEach(w => w.classList.add('vibrating'));\
        document.getElementById('barStatus').innerText = 'Barramento: 12.1V [Consumindo Graves]';\
      };\
      audio.onpause = () => {\
        woofers.forEach(w => w.classList.remove('vibrating'));\
        document.getElementById('barStatus').innerText = 'Barramento: 12.6V [Est√ÉÅvel]';\
      };\
    }\
\
    function interpretarTexto() {\
      const txt = document.getElementById('customPrompt').value.toLowerCase();\
      if (!txt) return;\
\
      if (txt.includes('18')) document.getElementById('wooferSize').value = '18';\
      else if (txt.includes('12')) document.getElementById('wooferSize').value = '12';\
      else document.getElementById('wooferSize').value = '15';\
\
      if (txt.includes('quadrada')) document.getElementById('hornFormat').value = 'square';\
      else document.getElementById('hornFormat').value = 'round';\
\
      atualizarPalco();\
      gerarProjeto();\
    }\
\
    function gerarProjeto() {\
      const p = document.getElementById('player').value;\
      const size = document.getElementById('wooferSize').value;\
      const qty = parseInt(document.getElementById('wooferQty').value) || 2;\
      const rms = parseInt(document.getElementById('wooferRms').value) || 1500;\
      const fmt = document.getElementById('hornFormat').value;\
      const mat = document.getElementById('hornMaterial').value;\
\
      const totalRms = (qty * rms) + 800;\
      const batAh = Math.round(totalRms / 20);\
      const cabo = totalRms <= 3000 ? "35mm¬≤" : "50mm¬≤";\
      const disj = totalRms <= 3000 ? "150A" : "200A";\
\
      document.getElementById('relatorioOutput').textContent = \
`=======================================================\
ÉøÉªÉÄÔ∏ÉØ PROJETO DE SOM AUTOMOTIVO - RELAT√É≥RIO COMPLETO\
=======================================================\
\
ÉøÉ≥ª UNIDADE CENTRAL & EQUALIZA√Éß√É£O:\
  ‚ÄÉÇ Player: ${p}\
  ‚ÄÉÇ Regulagem Grave Xtreme: Ativada (+5dB a +12dB em 60Hz)\
\
ÉøÉ¥É™ CAIXA TRIO / PARED√É£O:\
  ‚ÄÉÇ Woofers: ${qty}x Falante(s) de ${size}" (${rms}W RMS cada)\
  ‚ÄÉÇ Cornetas: Drivers acoplados em Cornetas ${fmt === 'square' ? 'Quadradas' : 'Redondas'} de ${mat}\
\
ÉøÉÆÉªÔ∏ÉØ CORTE DE FREQU√É™NCIAS NO PROCESSADOR (DSP):\
  ‚ÄÉÇ CANAL 1 (Woofers ${size}"): HPF 40Hz (BT24) | LPF 200Hz (BT24)\
  ‚ÄÉÇ CANAL 2 (M√©dio 8"/10"): HPF 200Hz (BT24) | LPF 1200Hz (BT24)\
  ‚ÄÉÇ CANAL 3 (Cornetas ${mat}): HPF 1200Hz (BT24) | LPF 5000Hz (BT24)\
  ‚ÄÉÇ CANAL 4 (Super Tweeters): HPF 5000Hz (BT24) | LPF 20000Hz (BT24)\
\
‚É∫ÉÅ SISTEMA EL√É©TRICO, BARRAMENTO E FIA√Éß√É£O (~${totalRms}W RMS Total):\
  ‚ÄÉÇ Bateria Auxiliar M√≠nima: ${batAh} Ah (AGM / Estacion√ÉÅria)\
  ‚ÄÉÇ Fonte Automotiva      : ${Math.round(batAh * 0.8)}A a ${batAh}A\
  ‚ÄÉÇ Barramento            : Barra de Cobre Maci√ßo (Positivo e Aterramento)\
  ‚ÄÉÇ Bitola de Cabos       : ${cabo} (100% Cobre)\
  ‚ÄÉÇ Fus√≠vel/Disjuntor     : ${disj} no cofre da bateria principal`;\
    }\
\
    atualizarPalco();\
  </script>\
</body>\
</html>'''\
\
with open('index.html', 'w', encoding='utf-8') as f:\
    f.write(html_content)\
\
