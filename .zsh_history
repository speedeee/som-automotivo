<!DOCTYPE html>\
<html lang="pt-BR">\
<head>\
    <meta charset="UTF-8">\
    <meta name="viewport" content="width=device-width, initial-scale=1.0">\
    <title>‚É∫ÉÅ SPEED R√ÅDIO - PARED√É£O EDITION</title>\
    <script src="/socket.io/socket.io.js"></script>\
    <style>\
        :root { \
            --bg-color: #0a0b0e; \
            --bg-image: none;\
            --pioneer-frame-bg: linear-gradient(145deg, #1f232a, #0d0e12);\
            --pioneer-border: #2a2e38;\
            --pioneer-blue: #00d4ff; \
            --pioneer-glow: #00d4ff66;\
            --speaker-sub-color: #00d4ff;\
            --speaker-horn-color: #00d4ff;\
            --speaker-tweet-color: #00d4ff;\
            --btn-bg: #00d4ff;\
            --btn-text: #000000;\
            --text-color: #00d4ff;\
        }\
\
        body { \
            background-color: var(--bg-color); \
            background-image: var(--bg-image);\
            background-size: cover;\
            background-position: center;\
            background-attachment: fixed;\
            color: #fff; \
            font-family: 'Courier New', Courier, monospace; \
            text-align: center; \
            padding: 15px; \
            margin: 0; \
            transition: background 0.3s ease;\
        }\
\
        body.glitter-bg {\
            background-image: radial-gradient(circle, #ffffff 1px, transparent 1px), radial-gradient(circle, #ff007f 1px, transparent 1px), radial-gradient(circle, #00d4ff 1px, transparent 1px);\
            background-size: 20px 20px, 30px 30px, 15px 15px;\
            background-position: 0 0, 10px 10px, 5px 5px;\
            animation: glitterAnim 2s infinite linear;\
        }\
        @keyframes glitterAnim {\
            0% { background-position: 0 0, 10px 10px, 5px 5px; }\
            50% { background-position: 10px 20px, 20px 0px, 15px 10px; }\
            100% { background-position: 0 0, 10px 10px, 5px 5px; }\
        }\
\
        .gear-container { position: absolute; top: 15px; right: 15px; z-index: 1000; }\
        .gear-btn { background: #1f232a; border: 2px solid var(--pioneer-blue); color: #fff; padding: 8px 12px; border-radius: 50%; cursor: pointer; font-size: 18px; box-shadow: 0 0 10px var(--pioneer-glow); }\
        .gear-menu { display: none; position: absolute; right: 0; top: 45px; background: #111318; border: 2px solid var(--pioneer-blue); padding: 10px; border-radius: 10px; width: 220px; box-shadow: 0 8px 20px rgba(0,0,0,0.8); text-align: left; }\
        .gear-menu button { width: 100%; margin: 4px 0; text-align: left; font-size: 11px; padding: 8px; }\
\
        .pioneer-frame { background: var(--pioneer-frame-bg); border: 4px solid var(--pioneer-border); border-radius: 18px; padding: 20px; max-width: 650px; margin: 40px auto 15px auto; box-shadow: 0 10px 30px rgba(0,0,0,0.9); position: relative; }\
        .lcd-display { background: #00121a; border: 3px solid #002b3d; border-radius: 8px; padding: 12px; box-shadow: inset 0 0 15px var(--pioneer-glow), 0 0 10px var(--pioneer-glow); color: var(--text-color); margin-bottom: 15px; }\
\
        .wall-container-saveiro { \
            background: #08090c; \
            border: 3px solid #1f232a; \
            border-radius: 12px; \
            padding: 12px 8px; \
            margin: 15px 0; \
            display: flex;\
            flex-direction: column;\
            gap: 12px;\
            box-shadow: inset 0 0 20px #000;\
        }\
\
        .rack-top { display: flex; justify-content: space-around; align-items: center; background: #111318; padding: 8px; border-radius: 8px; border: 1px solid #222; }\
        .rack-bottom { display: flex; justify-content: space-around; align-items: center; background: #0d0e12; padding: 12px 5px; border-radius: 8px; border: 1px solid #222; }\
\
        .subwoofer-saveiro { \
            width: 85px; height: 85px; \
            background: radial-gradient(circle, #222 10%, #111 50%, #000 100%); \
            border: 4px solid #333; border-radius: 50%; \
            display: flex; justify-content: center; align-items: center; \
            box-shadow: 0 0 10px rgba(0,0,0,0.8);\
        }\
        .subwoofer-saveiro::before { \
            content: 'SDS'; font-size: 10px; font-weight: bold; color: #aaa;\
            width: 50px; height: 50px; \
            background: radial-gradient(circle, var(--speaker-sub-color) 15%, #111 90%); \
            border-radius: 50%; border: 2px solid #000; \
            box-shadow: inset 0 0 8px #000, 0 0 10px var(--speaker-sub-color); \
            display: flex; align-items: center; justify-content: center;\
        }\
\
        .horn-saveiro { width: 50px; height: 50px; background: #15171c; border: 2px solid #333; border-radius: 50%; display: flex; justify-content: center; align-items: center; }\
        .horn-saveiro-inner { width: 34px; height: 34px; background: radial-gradient(circle, var(--speaker-horn-color) 10%, #000 80%); border-radius: 50%; border: 1px solid #444; box-shadow: 0 0 8px var(--speaker-horn-color); }\
        .tweeter-saveiro { width: 32px; height: 32px; background: #1a1a1a; border: 2px solid #444; border-radius: 6px; display: flex; justify-content: center; align-items: center; }\
        .tweeter-saveiro-core { width: 12px; height: 12px; background: var(--speaker-tweet-color); border-radius: 50%; box-shadow: 0 0 6px var(--speaker-tweet-color); }\
\
        .box-link { background: rgba(0, 212, 255, 0.05); border: 1px dashed var(--pioneer-blue); border-radius: 6px; padding: 8px; margin: 10px 0; }\
        .box-link input { width: 90%; text-align: center; font-size: 11px; background: #000; color: var(--text-color); border: 1px solid #005577; padding: 6px; }\
        \
        input[type="text"], input[type="email"], input[type="password"], select { width: 85%; padding: 8px; border-radius: 5px; border: 1px solid #005577; background: #00121a; color: #fff; margin-bottom: 8px; }\
        button { padding: 8px 12px; border-radius: 6px; border: none; background: var(--btn-bg); color: var(--btn-text); font-weight: bold; cursor: pointer; margin: 2px; }\
        .btn-danger { background: #e74c3c !important; color: #fff !important; }\
\
        .eq-panel { background: linear-gradient(180deg, #181b22, #0d0f14); padding: 12px; border-radius: 8px; border: 2px solid #2a2e3d; margin: 12px 0; text-align: left; }\
        .component-header { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #2a2e3d; padding-bottom: 6px; margin-bottom: 10px; }\
        .component-title { color: var(--pioneer-blue); font-weight: bold; font-size: 13px; margin: 0; }\
        .component-badge { background: #000; border: 1px solid var(--pioneer-blue); color: #fff; font-size: 9px; padding: 2px 6px; border-radius: 4px; }\
        .eq-slider { display: flex; justify-content: space-between; align-items: center; margin: 10px 0; font-size: 11px; }\
\
        ol, ul { text-align: left; background: rgba(0, 212, 255, 0.05); padding: 10px; border-radius: 5px; max-height: 220px; overflow-y: auto; border: 1px solid #003344; color: var(--text-color); font-size: 12px; list-style: none; }\
        li { margin-bottom: 6px; border-bottom: 1px solid #002b3d; padding-bottom: 4px; display: flex; justify-content: space-between; align-items: center; }\
        .color-group { display: flex; align-items: center; justify-content: space-between; margin: 8px 0; font-size: 11px; }\
        .color-group input[type="color"] { border: none; width: 40px; height: 30px; cursor: pointer; background: none; }\
    </style>\
</head>\
<body>\
\
    <div class="gear-container">\
        <button class="gear-btn" onclick="toggleGearMenu()">‚É∫ÉπÔ∏ÉØ</button>\
        <div id="gearMenu" class="gear-menu">\
            <button onclick="verAba('ouvinte'); toggleGearMenu();">ÉøÉ≥ª Display Pioneer (P√∫blico)</button>\
            <button onclick="verAba('adm'); toggleGearMenu();">ÉøÉÆÉªÔ∏ÉØ Mesa de DJ / ADM</button>\
            <button onclick="verAba('custom'); toggleGearMenu();">ÉøÉÆ® Processador & Customiza√ß√£o</button>\
        </div>\
    </div>\
\
    <!-- ABA 1: OUVINTE -->\
    <div id="abaOuvinte" class="pioneer-frame">\
        <div class="lcd-display">\
            <h1 style="margin: 5px 0; font-size: 18px;">‚É∫ÉÅ SPEED R√ÅDIO</h1>\
            <p id="status" style="margin: 5px 0; font-size: 11px;">[READY] SELECIONE OU ADICIONE M√É∫SICAS</p>\
        </div>\
        \
        <div class="box-link">\
            <input type="text" id="urlRadio" readonly>\
            <button onclick="copiarLink()">ÉøÉ≥É´ Copiar Link</button>\
        </div>\
\
        <audio id="audioElement" controls crossorigin="anonymous" style="width:100%; margin: 10px 0;"></audio>\
\
        <div class="wall-container-saveiro">\
            <div class="rack-top">\
                <div class="tweeter-saveiro"><div class="tweeter-saveiro-core"></div></div>\
                <div class="horn-saveiro"><div class="horn-saveiro-inner"></div></div>\
                <div class="horn-saveiro"><div class="horn-saveiro-inner"></div></div>\
                <div class="horn-saveiro"><div class="horn-saveiro-inner"></div></div>\
                <div class="horn-saveiro"><div class="horn-saveiro-inner"></div></div>\
                <div class="tweeter-saveiro"><div class="tweeter-saveiro-core"></div></div>\
            </div>\
            <div class="rack-bottom">\
                <div class="subwoofer-saveiro"></div>\
                <div class="subwoofer-saveiro"></div>\
                <div class="subwoofer-saveiro"></div>\
            </div>\
        </div>\
\
        <h3>ÉøÉÆµ Pedir M√∫sica</h3>\
        <input type="text" id="linkMusicaOuvinte" placeholder="Cole o link MP3...">\
        <button onclick="alert('Pedido enviado!')">‚ÉæÉµ Enviar para Aprova√ß√£o</button>\
\
        <h3>ÉøÉ≥Éº Fila Principal</h3>\
        <ol id="filaOuvinte"><li>M√∫sica Atual - Speed R√ÉÅdio</li></ol>\
    </div>\
\
    <!-- ABA 2: ADM -->\
    <div id="abaAdm" class="pioneer-frame" style="display: none;">\
        <h2>ÉøÉÆÉªÔ∏ÉØ Mesa de Som & Transmiss√£o DJ</h2>\
        <div style="margin: 15px 0;">\
            <button>‚ÉØÆÔ∏ÉØ Voltar</button>\
            <button>‚ÉØØÔ∏ÉØ Play/Pause</button>\
            <button>‚ÉØ≠Ô∏ÉØ Avan√ßar</button>\
        </div>\
        <div class="eq-panel">\
            <div class="component-header"><h4 class="component-title">ÉøÉ≥Å Entrada de √Åudio</h4></div>\
            <input type="file" id="fileInput" accept="audio/*" multiple>\
        </div>\
        <div class="eq-panel">\
            <div class="component-header"><h4 class="component-title">ÉøÉ≥• Pedidos do P√∫blico</h4></div>\
            <ul id="listaEspera"></ul>\
        </div>\
    </div>\
\
    <!-- ABA 3: CUSTOMIZA√Éß√É£O -->\
    <div id="abaCustom" class="pioneer-frame" style="display: none;">\
        <h2>ÉøÉÆÉªÔ∏ÉØ RACK DE PROCESSAMENTO E CUSTOMIZA√Éß√É£O</h2>\
        <div class="eq-panel">\
            <div class="component-header"><h4 class="component-title">ÉøÉÆÉ∫Ô∏ÉØ Processador Crossover STX2448</h4></div>\
            <div class="eq-slider"><span>ÉøÉ¥É™ Subwoofer / Grave:</span><input type="range" min="-10" max="30" value="0"></div>\
            <div class="eq-slider"><span>ÉøÉ≥ÉÇ Corneta / M√©dio:</span><input type="range" min="-10" max="20" value="0"></div>\
            <div class="eq-slider"><span>‚É∫ÉÅ Tweeter / Agudo:</span><input type="range" min="-10" max="20" value="0"></div>\
        </div>\
        <div class="eq-panel">\
            <div class="component-header"><h4 class="component-title">‚É∫ÉÅ M√≥dulos & Cores</h4></div>\
            <div class="color-group"><span>Cor Grave:</span><input type="color" value="#00d4ff" onchange="document.documentElement.style.setProperty('--speaker-sub-color', this.value)"></div>\
            <div class="color-group"><span>Cor M√©dio:</span><input type="color" value="#00d4ff" onchange="document.documentElement.style.setProperty('--speaker-horn-color', this.value)"></div>\
            <div class="color-group"><span>Cor Agudo:</span><input type="color" value="#00d4ff" onchange="document.documentElement.style.setProperty('--speaker-tweet-color', this.value)"></div>\
        </div>\
    </div>\
\
    <script>\
        document.getElementById('urlRadio').value = window.location.href;\
\
        function toggleGearMenu() {\
            const menu = document.getElementById('gearMenu');\
            menu.style.display = menu.style.display === 'block' ? 'none' : 'block';\
        }\
\
        function verAba(aba) {\
            document.getElementById('abaOuvinte').style.display = 'none';\
            document.getElementById('abaAdm').style.display = 'none';\
            document.getElementById('abaCustom').style.display = 'none';\
\
            if(aba === 'ouvinte') document.getElementById('abaOuvinte').style.display = 'block';\
            if(aba === 'adm') document.getElementById('abaAdm').style.display = 'block';\
            if(aba === 'custom') document.getElementById('abaCustom').style.display = 'block';\
        }\
\
        function copiarLink() {\
            navigator.clipboard.writeText(document.getElementById('urlRadio').value);\
            alert('Link Copiado!');\
        }\
    </script>\
</body>\
</html>\
EOF\
