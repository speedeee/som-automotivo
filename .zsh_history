        </div>\
    </div>\
\
    <script>\
        const socket = io();\
        let ytPlayer;\
        let playlistLocal = [];\
        let indexAtual = -1;\
        let corAtual = '#00d4ff';\
        const audioLocal = document.getElementById('audioLocal');\
\
        document.getElementById('urlRadio').value = window.location.href;\
\
        function extrairIdYoutube(url) {\
            if (!url) return null;\
            let regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|\&v=)([^#\&\?]*).*/;\
            let match = url.match(regExp);\
            return (match && match[2].length === 11) ? match[2] : url;\
        }\
\
        function onYouTubeIframeAPIReady() {\
            ytPlayer = new YT.Player('player', {\
                height: '100%', width: '100%',\
                playerVars: { 'autoplay': 1, 'controls': 1, 'origin': window.location.origin },\
                events: { 'onStateChange': (e) => { if (e.data === 0) proximaMusica(); } }\
            });\
        }\
\
        audioLocal.onended = () => { proximaMusica(); };\
\
        function tocarRadioOuvinte() {\
            if (indexAtual >= 0 && playlistLocal[indexAtual]) {\
                tocarItem(playlistLocal[indexAtual]);\
            } else if (playlistLocal.length > 0) {\
                indexAtual = 0;\
                tocarItem(playlistLocal[0]);\
            } else {\
                alert('Nenhuma m√∫sica na fila no momento!');\
            }\
        }\
\
        function carregarMp3Locais() {\
            const files = document.getElementById('fileInput').files;\
            if (files.length > 0) {\
                for (let i = 0; i < files.length; i++) {\
                    let file = files[i];\
                    playlistLocal.push({\
                        tipo: 'local',\
                        nome: file.name,\
                        url: URL.createObjectURL(file)\
                    });\
                }\
                atualizarExibicaoFila();\
                if (indexAtual === -1) proximaMusica();\
            }\
        }\
\
        function adicionarMusicaWeb() {\
            const input = document.getElementById('linkMusicaOuvinte');\
            if (input.value) {\
                playlistLocal.push({\
                    tipo: 'web',\
                    nome: input.value,\
                    url: input.value\
                });\
                input.value = '';\
                atualizarExibicaoFila();\
                if (indexAtual === -1) proximaMusica();\
            }\
        }\
\
        function tocarItem(item) {\
            if (!item) return;\
            document.getElementById('status').innerText = 'TOCANDO: ' + item.nome.toUpperCase();\
\
            if (item.tipo === 'local') {\
                if (ytPlayer?.stopVideo) ytPlayer.stopVideo();\
                document.getElementById('ytPlayerContainer').querySelector('iframe').style.display = 'none';\
                audioLocal.style.display = 'block';\
                audioLocal.src = item.url;\
                audioLocal.play();\
            } else {\
                audioLocal.pause();\
                audioLocal.style.display = 'none';\
                document.getElementById('ytPlayerContainer').querySelector('iframe').style.display = 'block';\
                let id = extrairIdYoutube(item.url);\
                if (ytPlayer?.loadVideoById) ytPlayer.loadVideoById(id);\
            }\
        }\
\
        function proximaMusica() {\
            if (indexAtual < playlistLocal.length - 1) {\
                indexAtual++;\
                tocarItem(playlistLocal[indexAtual]);\
                atualizarExibicaoFila();\
            }\
        }\
\
        function voltarMusica() {\
            if (indexAtual > 0) {\
                indexAtual--;\
                tocarItem(playlistLocal[indexAtual]);\
                atualizarExibicaoFila();\
            }\
        }\
\
        function pausarEPlay() {\
            const item = playlistLocal[indexAtual];\
            if (!item) return;\
            if (item.tipo === 'local') {\
                audioLocal.paused ? audioLocal.play() : audioLocal.pause();\
            } else if (ytPlayer) {\
                let state = ytPlayer.getPlayerState();\
                state === 1 ? ytPlayer.pauseVideo() : ytPlayer.playVideo();\
            }\
        }\
\
        function atualizarExibicaoFila() {\
            const htmlFila = playlistLocal.map((m, i) => {\
                let estilo = i === indexAtual ? 'style="color: #fff; font-weight: bold; text-shadow: 0 0 8px var(--pioneer-blue);"' : '';\
                return `<li ${estilo}>${m.nome} ${i === indexAtual ? '‚É∂∂' : ''}</li>`;\
            }).join('');\
            \
            document.getElementById('filaOuvinte').innerHTML = htmlFila;\
            document.getElementById('filaAdm').innerHTML = htmlFila;\
        }\
\
        function limparFila() {\
            playlistLocal = [];\
            indexAtual = -1;\
            audioLocal.pause();\
            if (ytPlayer?.stopVideo) ytPlayer.stopVideo();\
            document.getElementById('status').innerText = '[READY] AGUARDANDO COMANDO';\
            atualizarExibicaoFila();\
        }\
\
        setInterval(() => {\
            const bars = document.querySelectorAll('.vu-bar');\
            const tocando = !audioLocal.paused || (ytPlayer && ytPlayer.getPlayerState && ytPlayer.getPlayerState() === 1);\
            bars.forEach((bar) => {\
                if (tocando) {\
                    let lvl = Math.floor(Math.random() * 85) + 15;\
                    bar.style.height = lvl + '%';\
                    bar.style.background = lvl > 75 ? '#ff0055' : corAtual;\
                } else {\
                    bar.style.height = '10%';\
                    bar.style.background = '#003344';\
                }\
            });\
        }, 120);\
\
        function tocarEfeito(tipo) {\
            let ctx = new (window.AudioContext || window.webkitAudioContext)();\
            let osc = ctx.createOscillator();\
            let gain = ctx.createGain();\
            osc.connect(gain);\
            gain.connect(ctx.destination);\
            \
            if (tipo === 'airhorn') {\
                osc.frequency.setValueAtTime(400, ctx.currentTime);\
                osc.frequency.exponentialRampToValueAtTime(800, ctx.currentTime + 0.3);\
            } else if (tipo === 'scratch') {\
                osc.type = 'sawtooth';\
                osc.frequency.setValueAtTime(1200, ctx.currentTime);\
                osc.frequency.linearRampToValueAtTime(200, ctx.currentTime + 0.15);\
            } else {\
                osc.type = 'triangle';\
                osc.frequency.setValueAtTime(150, ctx.currentTime);\
                osc.frequency.exponentialRampToValueAtTime(30, ctx.currentTime + 0.5);\
            }\
            osc.start();\
            osc.stop(ctx.currentTime + 0.4);\
        }\
\
        function mudarCor(cor) {\
            corAtual = cor;\
            document.documentElement.style.setProperty('--pioneer-blue', cor);\
            document.documentElement.style.setProperty('--pioneer-glow', cor + '66');\
            document.documentElement.style.setProperty('--stage-light', cor);\
            document.documentElement.style.setProperty('--primary-color', cor);\
        }\
\
        function verAba(aba) {\
            document.getElementById('abaOuvinte').style.display = aba === 'ouvinte' ? 'block' : 'none';\
            document.getElementById('abaAdm').style.display = aba === 'adm' ? 'block' : 'none';\
        }\
\
        function copiarLink() {\
            navigator.clipboard.writeText(document.getElementById('urlRadio').value);\
            alert('Link copiado!');\
        }\
\
        function fazerLogin() {\
            const email = document.getElementById('loginEmail').value;\
            const pass = document.getElementById('loginPass').value;\
            if (email === 'fabiojr073@gmail.com' && pass === 'Deus777') {\
                document.getElementById('areaLogin').style.display = 'none';\
                document.getElementById('areaDj').style.display = 'block';\
            } else {\
                alert('E-mail ou senha incorretos!');\
            }\
        }\
\
        function logout() { location.reload(); }\
    </script>\
</body>\
</html>\
EOF\

