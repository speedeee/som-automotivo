      </div>\
    </div>\
\
    <button onclick="gerarProjeto()">‚É∫ÉπÔ∏ÉØ CALCULAR FIA√Éß√É£O, BATERIA E DSP</button>\
\
    <div class="section">\
      <h2>3. Script de Montagem e Regulagem</h2>\
      <div class="output-box" id="relatorioOutput">Clique no bot√£o para calcular...</div>\
    </div>\
  </div>\
\
  <script>\
    document.getElementById('neonColor').addEventListener('input', (e) => {\
      document.getElementById('neonPreview').style.borderColor = e.target.value;\
      document.getElementById('previewText').style.color = e.target.value;\
    });\
\
    function gerarProjeto() {\
      const p = document.getElementById('player').value;\
      const size = document.getElementById('wooferSize').value;\
      const qty = parseInt(document.getElementById('wooferQty').value) || 2;\
      const rms = parseInt(document.getElementById('wooferRms').value) || 1500;\
      const fmt = document.getElementById('hornFormat').value;\
      const mat = document.getElementById('hornMaterial').value;\
\
      const totalRms = (qty * rms) + 800;\
      const batAh = Math.round(totalRms / 20);\
      const cabo = totalRms <= 3000 ? "35mm¬≤" : "50mm¬≤";\
      const disj = totalRms <= 3000 ? "150A" : "200A";\
\
      document.getElementById('relatorioOutput').textContent = \
`=======================================================\
ÉøÉªÉÄÔ∏ÉØ PROJETO DE SOM AUTOMOTIVO - RELAT√É≥RIO\
=======================================================\
\
ÉøÉ≥ª PLAYER: ${p}\
ÉøÉ¥É™ PARED√É£O: ${qty}x Woofers ${size}" (${rms}W RMS) + Drivers em Corneta ${fmt} de ${mat}\
\
ÉøÉÆÉªÔ∏ÉØ REGULAGEM DO PROCESSADOR (DSP):\
  ‚ÄÉÇ CANAL 1 (Woofers ${size}"): HPF 40Hz (BT24) | LPF 200Hz (BT24)\
  ‚ÄÉÇ CANAL 2 (M√©dio 8"/10"): HPF 200Hz (BT24) | LPF 1200Hz (BT24)\
  ‚ÄÉÇ CANAL 3 (Cornetas ${mat}): HPF 1200Hz (BT24) | LPF 5000Hz (BT24)\
  ‚ÄÉÇ CANAL 4 (Super Tweeters): HPF 5000Hz (BT24) | LPF 20000Hz (BT24)\
\
‚É∫ÉÅ EL√É©TRICA & FIA√Éß√É£O (~${totalRms}W RMS Total):\
  ‚ÄÉÇ Bateria Auxiliar M√≠nima: ${batAh} Ah (AGM/Gel)\
  ‚ÄÉÇ Fonte Automotiva: Fonte de ${Math.round(batAh * 0.8)}A a ${batAh}A\
  ‚ÄÉÇ Cabos de Energia: ${cabo} (100% Cobre)\
  ‚ÄÉÇ Disjuntor no Cofre: ${disj}\
  ‚ÄÉÇ Distribui√ß√£o: Barramento de Cobre Maci√ßo (+ e -)`;\
    }\
  </script>\
</body>\
</html>'''\
\
with open('index.html', 'w', encoding='utf-8') as f:\
    f.write(html_content)\
\
print("\n" + "="*50)\
print(" ÉøÉ∫Ä SERVIDOR RODANDO NO SEU CELULAR!")\
print(" ÉøÉ¥É∑ ACESSE O SITE NO SEU NAVEGADOR COM O LINK ABAIXO:")\
print(" ÉøÉ±É© http://localhost:8080")\
print("="*50 + "\n")\
\
