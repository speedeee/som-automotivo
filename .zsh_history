            <button onclick="copiarPix()" style="background-color: #00cc66;">COPIAR C√É≥DIGO PIX</button>\
            <button onclick="fecharModal()" style="background-color: #555; margin-top: 10px;">Fechar</button>\
        </div>\
    </div>\
\
    <script>\
        let tempo = 10700;\
        setInterval(() => {\
            let h = Math.floor(tempo / 3600);\
            let m = Math.floor((tempo % 3600) / 60);\
            let s = tempo % 60;\
            document.getElementById('countdown').innerText = String(h).padStart(2,'0') + ":" + String(m).padStart(2,'0') + ":" + String(s).padStart(2,'0');\
            if(tempo > 0) tempo--;\
        }, 1000);\
\
        let produtos = JSON.parse(localStorage.getItem('speed_produtos')) || [\
            { nome: "Produto Exemplo", preco: 50.00, imagem: "https://via.placeholder.com/300x180?text=SPEED+STORE" },\
            { nome: "Camisa", preco: 29.90, imagem: "https://via.placeholder.com/300x180?text=Camisa" }\
        ];\
\
        let logadoAdmin = false;\
\
        function salvarProdutos() {\
            localStorage.setItem('speed_produtos', JSON.stringify(produtos));\
            carregarLoja();\
        }\
\
        function carregarLoja() {\
            const container = document.getElementById('container');\
            container.innerHTML = '';\
            produtos.forEach((p) => {\
                let imgSrc = p.imagem && p.imagem.trim() !== "" ? p.imagem : "https://via.placeholder.com/300x180?text=SPEED+STORE";\
                container.innerHTML += \`<div class="produto-card">\
                        <img src="\${imgSrc}" alt="\${p.nome}">\
                        <h3>\${p.nome}</h3>\
                        <p style="color: #00ff00; font-weight: bold;">R$ \${Number(p.preco).toFixed(2)}</p>\
                        <button onclick="abrirPix('\${p.nome}', \${p.preco})">COMPRAR VIA PIX</button>\
                    </div>\`;\
            });\
        }\
\
        function abrirAdminModal() {\
            document.getElementById('modal-admin').style.display = 'flex';\
            if (!logadoAdmin) {\
                document.getElementById('admin-conteudo-modal').innerHTML = \`<h3>ÉøÉ¥É∞ Login Admin</h3><input type="email" id="loginEmail" placeholder="E-mail"><input type="password" id="loginSenha" placeholder="Senha"><button onclick="fazerLogin()">Entrar</button><button onclick="fecharAdminModal()" style="background-color: #555; margin-top: 10px;">Cancelar</button>\`;\
            } else {\
                renderizarPainelAdminLogado();\
            }\
        }\
\
        function fazerLogin() {\
            if (document.getElementById('loginEmail').value === 'fabiojr074@gmail.com' && document.getElementById('loginSenha').value === 'Deus777') {\
                logadoAdmin = true;\
                renderizarPainelAdminLogado();\
            } else { alert('E-mail ou senha incorretos!'); }\
        }\
\
        function renderizarPainelAdminLogado() {\
            let listaHtml = '';\
            produtos.forEach((p, index) => {\
                listaHtml += \`<div style="display: flex; justify-content: space-between; align-items: center; background: #2a2a2a; padding: 8px; margin-bottom: 5px; border-radius: 4px;">\
                        <span>\${p.nome} - <b>R$ \${Number(p.preco).toFixed(2)}</b></span>\
                        <button onclick="excluirProduto(\${index})" style="background: #ff3333; width: auto; padding: 4px 8px; margin: 0; font-size: 11px;">Excluir</button>\
                    </div>\`;\
            });\
            document.getElementById('admin-conteudo-modal').innerHTML = \`<h3>‚É∫ÉπÔ∏ÉØ Painel Admin Profissional</h3>\
                <input type="text" id="nomeProd" placeholder="Nome do Produto">\
                <input type="number" id="precoProd" placeholder="Pre√ßo (Ex: 89.90)">\
                <input type="text" id="imagemProd" placeholder="Link da Imagem (Opcional)">\
                <button onclick="adicionarProdutoAdmin()">Cadastrar Produto</button>\
                <h4 style="margin-top: 15px; text-align: left;">Produtos Cadastrados:</h4>\
                <div style="max-height: 200px; overflow-y: auto; margin-bottom: 10px;" id="admin-lista-modal">\${listaHtml}</div>\
                <button onclick="fecharAdminModal()" style="background-color: #555;">Fechar Painel</button>\`;\
        }\
\
        function adicionarProdutoAdmin() {\
            const nome = document.getElementById('nomeProd').value;\
            const preco = document.getElementById('precoProd').value;\
            const imagem = document.getElementById('imagemProd').value;\
            if(nome && preco) {\
                produtos.push({ nome, preco: parseFloat(preco), imagem });\
                salvarProdutos();\
                renderizarPainelAdminLogado();\
            } else { alert('Preencha os campos!'); }\
        }\
\
        function excluirProduto(index) {\
            produtos.splice(index, 1);\
            salvarProdutos();\
            renderizarPainelAdminLogado();\
        }\
\
        function fecharAdminModal() { document.getElementById('modal-admin').style.display = 'none'; }\
        function abrirPix(nome, preco) {\
            document.getElementById('pix-detalhe').innerText = \`\${nome} - R$ \${Number(preco).toFixed(2)}\`;\
            document.getElementById('modal-pix').style.display = 'flex';\
        }\
        function copiarPix() { document.getElementById('copia-cola-pix').select(); document.execCommand('copy'); alert('Copiado!'); }\
        function fecharModal() { document.getElementById('modal-pix').style.display = 'none'; }\
\
        carregarLoja();\
    </script>\
</body>\
</html>\
EOF\

