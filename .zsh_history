: 1786099075:0;rm index.html && cat << 'EOF' > index.html\
<!DOCTYPE html>\
<html lang="pt-BR">\
<head>\
    <meta charset="UTF-8">\
    <meta name="viewport" content="width=device-width, initial-scale=1.0">\
    <title id="page-title">SPEED STORE</title>\
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>\
    <style>\
        :root { --cor-principal: #ff4500; }\
        body { background-color: #121212; color: #ffffff; font-family: Arial, sans-serif; margin: 0; padding: 20px; }\
        header { text-align: center; margin-bottom: 20px; border-bottom: 1px solid #222; padding-bottom: 15px; }\
        h1 { color: var(--cor-principal); margin: 0 0 5px 0; font-size: 28px; }\
        .admin-btn-wrapper { margin-top: 10px; display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }\
        .admin-link { background: #222; color: var(--cor-principal); padding: 8px 16px; border-radius: 4px; text-decoration: none; font-size: 14px; font-weight: bold; border: 1px solid var(--cor-principal); cursor: pointer; display: inline-block; }\
        .promo-banner { background: linear-gradient(135deg, var(--cor-principal), #ff8c00); padding: 15px; border-radius: 8px; margin-bottom: 20px; text-align: center; }\
        .timer { font-size: 18px; font-weight: bold; background: rgba(0,0,0,0.3); display: inline-block; padding: 5px 15px; border-radius: 4px; margin-top: 8px; color: #fff; }\
        .produto-card, .depoimentos-box, .security-box { background: #1e1e1e; padding: 15px; border-radius: 8px; margin-bottom: 15px; border-left: 4px solid var(--cor-principal); }\
        .produto-card img { width: 100%; height: 160px; object-fit: cover; border-radius: 4px; margin-bottom: 10px; background: #2a2a2a; }\
        input, select { width: 100%; background: #2a2a2a; color: #fff; border: 1px solid #444; padding: 10px; border-radius: 4px; margin-bottom: 10px; box-sizing: border-box; }\
        button { background-color: var(--cor-principal); color: white; border: none; padding: 10px 15px; border-radius: 5px; cursor: pointer; font-weight: bold; width: 100%; margin-top: 5px; }\
        button:hover { opacity: 0.9; }\
        #modal-pix, #modal-admin { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.85); justify-content: center; align-items: center; z-index: 999; overflow-y: auto; padding: 20px; }\
        .modal-content { background: #1e1e1e; padding: 25px; border-radius: 8px; width: 100%; max-width: 500px; text-align: center; border: 1px solid var(--cor-principal); box-sizing: border-box; }\
        textarea { width: 100%; height: 80px; background: #2a2a2a; color: #00ff00; border: 1px solid #444; padding: 8px; border-radius: 4px; resize: none; box-sizing: border-box; }\
    </style>\
</head>\
<body>\
\
    <header>\
        <h1 id="store-name">SPEED STORE</h1>\
        <p id="store-slogan" style="margin: 0; color: #aaa; font-size: 14px;">Onde a velocidade encontra o game</p>\
        <div class="admin-btn-wrapper">\
            <button onclick="abrirAdminModal()" class="admin-link">‚É∫ÉπÔ∏ÉØ Painel Admin</button>\
        </div>\
    </header>\
\
    <div class="promo-banner">\
        <h3 style="margin: 0;">ÉøÉ¥• PROMO√Éß√É£O REL√ÇMPAGO</h3>\
        <p style="margin: 5px 0 0 0;">Descontos exclusivos por tempo limitado!</p>\
        <div class="timer" id="countdown">02:59:45</div>\
    </div>\
\
    <div class="security-box" style="display: flex; justify-content: space-around; text-align: center; font-size: 13px; border-left-color: #00cc66; padding: 10px;">\
        <div>ÉøÉ¥É≤ <b>Compra Segura</b></div>\
        <div>‚É∫ÉÅ <b>Envio R√ÉÅpido</b></div>\
        <div>ÉøÉ≤¨ <b>Suporte Direto</b></div>\
    </div>\
\
    <div id="container"></div>\
\
    <div class="depoimentos-box" style="border-left-color: #00cc66; margin-top: 30px;">\
        <h3 style="color: #fff; margin-top: 0; text-align: center;">‚≠É∞ O que dizem nossos clientes</h3>\
        <div style="background: #2a2a2a; padding: 12px; border-radius: 6px; margin-bottom: 10px;">\
            <p style="margin: 0; font-style: italic; font-size: 14px;">"Chegou super r√ÉÅpido aqui em Minas e a qualidade √© braba demais! Recomendo muito."</p>\
        </div>\
    </div>\
\
    <div style="text-align: center; margin-top: 30px; margin-bottom: 30px;">\
        <p>D√∫vidas? Entre em contato:</p>\
        <a href="https://wa.me/5538998842504?text=Ol√ÉÅ! Vim pelo site da Speed Store e preciso de suporte." target="_blank" style="color: #00cc66; text-decoration: none; font-weight: bold;">ÉøÉ≤¨ Falar no WhatsApp da Loja</a>\
    </div>\
\
    <div id="modal-admin">\
        <div class="modal-content" id="admin-conteudo-modal">\
            <h3>ÉøÉ¥É∞ Login Admin</h3>\
            <input type="email" id="loginEmail" placeholder="E-mail">\
            <input type="password" id="loginSenha" placeholder="Senha">\
            <button onclick="fazerLogin()">Entrar</button>\
            <button onclick="fecharAdminModal()" style="background-color: #555; margin-top: 10px;">Cancelar</button>\
        </div>\
    </div>\
\
    <div id="modal-pix">\
        <div class="modal-content">\
            <h3>Pagamento via Pix</h3>\
            <p id="pix-detalhe" style="margin: 10px 0;"></p>\
            <textarea id="copia-cola-pix" readonly></textarea>\
            <button onclick="copiarPix()" style="background-color: #00cc66;">COPIAR C√É≥DIGO PIX</button>\
            <button onclick="fecharModal()" style="background-color: #555; margin-top: 10px;">Fechar</button>\
        </div>\
    </div>\
\
    <script>\
        function gerarPDF() {\
            const elemento = document.body;\
            const opt = {\
                margin: 10,\
                filename: 'catalogo_speed_store.pdf',\
                image: { type: 'jpeg', quality: 0.98 },\
                html2canvas: { scale: 2 },\
                jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' }\
            };\
            html2pdf().set(opt).from(elemento).save();\
        }\
\
        let tempo = 10700;\
        setInterval(() => {\
            let h = Math.floor(tempo / 3600);\
            let m = Math.floor((tempo % 3600) / 60);\
            let s = tempo % 60;\
            document.getElementById('countdown').innerText = String(h).padStart(2,'0') + ":" + String(m).padStart(2,'0') + ":" + String(s).padStart(2,'0');\
            if(tempo > 0) tempo--;\
        }, 1000);\
\
        let configuracoes = JSON.parse(localStorage.getItem('speed_config')) || {\
            nome: "SPEED STORE",\
            slogan: "Onde a velocidade encontra o game",\
            cor: "#ff4500",\
            pix: "00020126580014br.gov.bcb.pix0136speedstore-pay-4-uuid5204000053039865802BR5909SPEEDSTORE6009MINAS GERAIS62070503***6304"\
        };\
\
        let produtosPadrao = [\
            { nome: "Suporte Garra X Para Celular Moto", preco: 39.90, imagem: "https://images.unsplash.com/photo-1599643478518-a854e5da47f7?w=500" },\
            { nome: "Headset Gamer RGB Profissional", preco: 89.90, imagem: "https://images.unsplash.com/photo-1546435770-a3e426bf472b?w=500" },\
            { nome: "Fone Bluetooth para Capacete Intercom", preco: 79.90, imagem: "https://images.unsplash.com/photo-1558981403-c5f9899a28bc?w=500" }\
        ];\
\
        let produtos = JSON.parse(localStorage.getItem('speed_produtos')) || produtosPadrao;\
        let logadoAdmin = false;\
\
        function aplicarConfiguracoes() {\
            document.getElementById('store-name').innerText = configuracoes.nome;\
            document.getElementById('page-title').innerText = configuracoes.nome;\
            document.getElementById('store-slogan').innerText = configuracoes.slogan;\
            document.documentElement.style.setProperty('--cor-principal', configuracoes.cor);\
            document.getElementById('copia-cola-pix').value = configuracoes.pix;\
        }\
\
        function salvarTudo() {\
            localStorage.setItem('speed_produtos', JSON.stringify(produtos));\
            localStorage.setItem('speed_config', JSON.stringify(configuracoes));\
            aplicarConfiguracoes();\
            carregarLoja();\
        }\
\
        function carregarLoja() {\
            aplicarConfiguracoes();\
            const container = document.getElementById('container');\
            container.innerHTML = '';\
            produtos.forEach((p, index) => {\
                let imgSrc = p.imagem && p.imagem.trim() !== "" ? p.imagem : "https://via.placeholder.com/300x180?text=SPEED+STORE";\
                container.innerHTML += `<div class="produto-card">\
                        <img src="${imgSrc}" alt="${p.nome}">\
                        <h3>${p.nome}</h3>\
                        <p style="color: #00ff00; font-weight: bold; font-size: 16px;">R$ ${Number(p.preco).toFixed(2)}</p>\
                        <button onclick="abrirPix('${p.nome}', ${p.preco})">COMPRAR VIA PIX</button>\
                    </div>`;\
            });\
        }\
\
        function abrirAdminModal() {\
            document.getElementById('modal-admin').style.display = 'flex';\
            if (logadoAdmin) renderizarPainelAdminLogado();\
        }\
\
        function fazerLogin() {\
            if (document.getElementById('loginEmail').value === 'fabiojr074@gmail.com' && document.getElementById('loginSenha').value === 'Deus777') {\
                logadoAdmin = true;\
                renderizarPainelAdminLogado();\
            } else { alert('E-mail ou senha incorretos!'); }\
        }\
\
        function renderizarPainelAdminLogado() {\
            let listaHtml = '';\
            produtos.forEach((p, index) => {\
                listaHtml += `<div style="display: flex; justify-content: space-between; align-items: center; background: #2a2a2a; padding: 8px; margin-bottom: 5px; border-radius: 4px;">\
                        <span style="font-size: 12px; width: 60%;">${p.nome}</span>\
                        <button onclick="excluirProduto(${index})" style="background: #ff3333; width: auto; padding: 4px 8px; font-size: 10px;">Excluir</button>\
                    </div>`;\
            });\
            document.getElementById('admin-conteudo-modal').innerHTML = `\
                <h3>‚É∫ÉπÔ∏ÉØ Painel Admin</h3>\
                <div style="background: #252525; padding: 10px; border-radius: 6px; text-align: left;">\
                    <h4 style="color: #ff8c00;">Configura√ß√µes</h4>\
                    <label>Chave PIX (Copia e Cola):</label>\
                    <textarea id="editPix">${configuracoes.pix}</textarea>\
                    <button onclick="salvarConfiguracoesAdmin()" style="background-color: #00cc66;">Salvar Configura√ß√µes</button>\
                    <button onclick="gerarPDF()" style="background-color: #0088cc; margin-top:5px;">ÉøÉ≥É§ Baixar Cat√ÉÅlogo PDF</button>\
                </div>\
                <h4 style="text-align: left;">Gerenciar Produtos:</h4>\
                <div style="max-height: 150px; overflow-y: auto;" id="admin-lista-modal">${listaHtml}</div>\
                <button onclick="fecharAdminModal()" style="background-color: #555; margin-top: 10px;">Fechar Painel</button>`;\
        }\
\
        function salvarConfiguracoesAdmin() {\
            configuracoes.pix = document.getElementById('editPix').value.trim();\
            salvarTudo();\
            alert('Configura√ß√µes salvas!');\
            renderizarPainelAdminLogado();\
        }\
\
        function excluirProduto(index) { produtos.splice(index, 1); salvarTudo(); renderizarPainelAdminLogado(); }\
        \
        function abrirPix(nome, preco) {\
            document.getElementById('pix-detalhe').innerText = `${nome} - R$ ${Number(preco).toFixed(2)}`;\
            document.getElementById('modal-pix').style.display = 'flex';\
        }\
        \
        function copiarPix() { \
            navigator.clipboard.writeText(document.getElementById('copia-cola-pix').value);\
            alert('C√≥digo Pix copiado!');\
        }\
        \
        function fecharModal() { document.getElementById('modal-pix').style.display = 'none'; }\
        function fecharAdminModal() { document.getElementById('modal-admin').style.display = 'none'; }\
\
        carregarLoja();\
    </script>\
</body>\
</html>\
EOF\

