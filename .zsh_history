: 1786159455:0;body {\
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\
    background-color: #2c3e50;\
    color: white;\
    display: flex;\
    justify-content: center;\
    align-items: center;\
    height: 100vh;\
    margin: 0;\
}\
\
.container {\
    text-align: center;\
}\
\
h1 {\
    margin-bottom: 10px;\
    color: #2ecc71;\
}\
\
.placar {\
    font-size: 24px;\
    margin-bottom: 20px;\
    background: rgba(0,0,0,0.2);\
    padding: 10px;\
    border-radius: 8px;\
}\
\
canvas {\
    background-color: #34495e;\
    border: 4px solid #fff;\
    border-radius: 8px;\
    box-shadow: 0 10px 20px rgba(0,0,0,0.5);\
    display: block; /* Garante que margens autom√ÉÅticas funcionem */\
    margin: 0 auto;\
}\
\
button {\
    margin-top: 20px;\
    padding: 10px 20px;\
    font-size: 18px;\
    background-color: #2ecc71;\
