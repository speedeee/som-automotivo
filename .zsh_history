\
        .subwoofer-saveiro { width: 85px; height: 85px; background: radial-gradient(circle, #222 10%, #111 50%, #000 100%); border: 4px solid #333; border-radius: 50%; display: flex; justify-content: center; align-items: center; }\
        .subwoofer-saveiro::before { content: 'SDS'; font-size: 10px; font-weight: bold; color: #aaa; width: 50px; height: 50px; background: radial-gradient(circle, var(--speaker-sub-color) 15%, #111 90%); border-radius: 50%; display: flex; align-items: center; justify-content: center; }\
        .horn-saveiro { width: 50px; height: 50px; background: #15171c; border: 2px solid #333; border-radius: 50%; display: flex; justify-content: center; align-items: center; }\
        .horn-saveiro-inner { width: 34px; height: 34px; background: radial-gradient(circle, var(--speaker-horn-color) 10%, #000 80%); border-radius: 50%; }\
        .tweeter-saveiro { width: 32px; height: 32px; background: #1a1a1a; border: 2px solid #444; border-radius: 6px; display: flex; justify-content: center; align-items: center; }\
        .tweeter-saveiro-core { width: 12px; height: 12px; background: var(--speaker-tweet-color); border-radius: 50%; }\
\
        .box-link { background: rgba(0, 212, 255, 0.08); border: 1px dashed var(--pioneer-blue); border-radius: 8px; padding: 10px; margin: 12px 0; }\
        .box-link input { width: 80%; text-align: center; font-size: 12px; background: #000; color: var(--text-color); border: 1px solid #005577; padding: 8px; border-radius: 4px; }\
\
        input[type="text"], input[type="file"] { width: 85%; padding: 8px; border-radius: 5px; border: 1px solid #005577; background: #00121a; color: #fff; margin-bottom: 8px; }\
        button { padding: 8px 12px; border-radius: 6px; border: none; background: var(--btn-bg); color: var(--btn-text); font-weight: bold; cursor: pointer; margin: 2px; }\
        ol, ul { text-align: left; background: rgba(0, 212, 255, 0.05); padding: 10px; border-radius: 5px; max-height: 150px; overflow-y: auto; border: 1px solid #003344; color: var(--text-color); font-size: 12px; }\
    </style>\
</head>\
<body onclick="desbloquearAudio()">\
\
    <div class="gear-container">\
        <button class="gear-btn" onclick="toggleGearMenu(event)">‚É∫ÉπÔ∏ÉØ</button>\
        <div id="gearMenu" class="gear-menu">\
            <button onclick="verAba('abaOuvinte')">ÉøÉ≥ª Display Pioneer (P√∫blico)</button>\
            <button onclick="verAba('abaAdm')">ÉøÉÆÉªÔ∏ÉØ Mesa de DJ / ADM</button>\
            <button onclick="verAba('abaCustom')">ÉøÉÆ® Edi√ß√£o de Display & Som</button>\
        </div>\
    </div>\
\
    <!-- ABA 1: OUVINTE -->\
    <div id="abaOuvinte" class="pioneer-frame">\
        <div class="lcd-display">\
            <h1 style="margin: 5px 0; font-size: 18px;">‚É∫ÉÅ SPEED R√ÅDIO</h1>\
            <p id="status" style="margin: 5px 0; font-size: 11px;">[ONLINE] CLIQUE NA TELA PARA TOCAR</p>\
        </div>\
        \
        <div class="box-link">\
            <span style="font-size: 11px; display: block; margin-bottom: 5px; color: var(--pioneer-blue);">ÉøÉ¥É∑ LINK P√É∫BLICO DA R√ÅDIO:</span>\
            <input type="text" id="urlRadio" readonly>\
            <button onclick="copiarLink()">ÉøÉ≥É´ Copiar Link</button>\
        </div>\
\
        <audio id="audioElement" controls crossorigin="anonymous" style="width:100%; margin: 10px 0;"></audio>\
\
        <div class="wall-container-saveiro">\
            <div class="rack-top">\
                <div class="tweeter-saveiro"><div class="tweeter-saveiro-core"></div></div>\
                <div class="horn-saveiro"><div class="horn-saveiro-inner"></div></div>\
                <div class="horn-saveiro"><div class="horn-saveiro-inner"></div></div>\
                <div class="horn-saveiro"><div class="horn-saveiro-inner"></div></div>\
                <div class="horn-saveiro"><div class="horn-saveiro-inner"></div></div>\
                <div class="tweeter-saveiro"><div class="tweeter-saveiro-core"></div></div>\
            </div>\
            <div class="rack-bottom">\
                <div class="subwoofer-saveiro"></div>\
                <div class="subwoofer-saveiro"></div>\
                <div class="subwoofer-saveiro"></div>\
            </div>\
        </div>\
\
        <h3>ÉøÉÆµ Pedir M√∫sica</h3>\
        <input type="text" id="linkMusicaOuvinte" placeholder="Cole o link MP3...">\
        <button onclick="alert('Pedido enviado!')">‚ÉæÉµ Enviar para Aprova√ß√£o</button>\
\
        <h3>ÉøÉ≥Éº Fila Principal (Numerada)</h3>\
        <ol id="filaOuvinte"><li>1. R√ÉÅdio Ligada - Aguardando √ÉÅudio</li></ol>\
    </div>\
\
    <!-- ABA 2: ADM -->\
    <div id="abaAdm" class="pioneer-frame" style="display: none;">\
        <h2>ÉøÉÆÉªÔ∏ÉØ Mesa de DJ / ADM</h2>\
        <input type="file" id="fileInput" accept="audio/*" multiple>\
        <button onclick="alert('M√∫sicas carregadas!')">‚ÉæÉµ Carregar M√∫sicas</button>\
    </div>\
\
    <!-- ABA 3: CUSTOM -->\
    <div id="abaCustom" class="pioneer-frame" style="display: none;">\
        <h2>ÉøÉÆ® Edi√ß√£o de Display</h2>\
        <p>Ajustes visuais ativados.</p>\
    </div>\
\
    <script>\
        const audio = document.getElementById('audioElement');\
        const urlInput = document.getElementById('urlRadio');\
\
        window.onload = () => {\
            urlInput.value = window.location.href;\
        };\
\
        function toggleGearMenu(e) {\
            e.stopPropagation();\
            const menu = document.getElementById('gearMenu');\
            menu.style.display = (menu.style.display === 'block') ? 'none' : 'block';\
        }\
\
        function verAba(abaId) {\
            document.getElementById('abaOuvinte').style.display = 'none';\
            document.getElementById('abaAdm').style.display = 'none';\
            document.getElementById('abaCustom').style.display = 'none';\
            document.getElementById(abaId).style.display = 'block';\
            document.getElementById('gearMenu').style.display = 'none';\
        }\
\
        function copiarLink() {\
            urlInput.select();\
            document.execCommand('copy');\
            alert('Link copiado!');\
        }\
\
        function desbloquearAudio() {\
            const audioCtx = new (window.AudioContext || window.webkitAudioContext)();\
            if (audioCtx.state === 'suspended') {\
                audioCtx.resume();\
            }\
        }\
    </script>\
</body>\
</html>\
EOF\

: 1786141087:0;cat << 'EOF' > $PREFIX/bin/radio\
#!/bin/bash\
clear\
pkill -9 -f node > /dev/null 2>&1\
pkill -9 -f cloudflared > /dev/null 2>&1\
sleep 1\
\
cd ~/minha-radio\
node server.js > /dev/null 2>&1 &\
sleep 2\
\
cloudflared tunnel --url http://127.0.0.1:3000 2>&1 | tee ~/.tunnel.log | grep --line-buffered -o 'https://[a-zA-Z0-9-]*\.trycloudflare\.com' | while read -r LINK; do\
    clear\
    echo "=================================================="\
    echo "         ‚É∫ÉÅ SPEED R√ÅDIO - ONLINE ‚É∫ÉÅ               "\
    echo "=================================================="\
    echo "ÉøÉ±É© LINK DIRETO:"\
    echo "   $LINK"\
    echo ""\
    echo "ÉøÉ±É© QR CODE PARA ESCANEAR:"\
    echo ""\
    qrencode -t UTF8 "$LINK" 2>/dev/null || echo "   (Instale o qrencode com: pkg install qrencode -y)"\
    echo "=================================================="\
    echo "Pressione CTRL + C para desligar."\
done\
EOF\
chmod +x $PREFIX/bin/radio\

: 1786141117:0;pkg install qrencode -y\

