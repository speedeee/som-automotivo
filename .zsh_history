        <div>\
          <label>Status do Sinal:</label>\
          <button class="btn-hw" style="margin-top:4px; height:32px;" onclick="alert('ÉøÉ≥ÉÅ Sinal do Controle OK (Alcance: 500 Metros)!')">ÉøÉ≥∂ TESTAR FREQU√É™NCIA</button>\
        </div>\
      </div>\
    </div>\
\
