        function excluirProduto(index) {\
            produtos.splice(index, 1);\
            salvarProdutos();\
            renderizarPainelAdminLogado();\
        }\
\
        function fecharAdminModal() { document.getElementById('modal-admin').style.display = 'none'; }\
        \
        function abrirPix(nome, preco) {\
            document.getElementById('pix-detalhe').innerText = `${nome} - R$ ${Number(preco).toFixed(2)}`;\
            document.getElementById('modal-pix').style.display = 'flex';\
        }\
        \
        function copiarPix() { \
            const campoPix = document.getElementById('copia-cola-pix');\
            campoPix.select(); \
            campoPix.setSelectionRange(0, 99999);\
            navigator.clipboard.writeText(campoPix.value).then(() => {\
                alert('C√≥digo Pix copiado com sucesso!');\
            });\
        }\
        \
        function fecharModal() { document.getElementById('modal-pix').style.display = 'none'; }\
\
        carregarLoja();\
    </script>\
</body>\
</html>\
EOF\

