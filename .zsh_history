        <input type="file" id="audioFile" accept="audio/*" multiple>\
        \
        <button onclick="carregarMusicasSelecionadas()" style="background:#00d2ff; color:#000; margin-top:8px; font-weight:bold;">‚ÉæÉµ ADICIONAR √Ä PLAYLIST</button>\
\
        <div style="margin-top: 10px;">\
          <p id="currentTrackDisplay" style="font-size:0.85rem; color:#00d2ff; font-weight:bold;">Nenhuma m√∫sica tocando</p>\
        </div>\
\
        <audio id="mainAudio" style="width:100%; margin-top:8px;" controls></audio>\
\
        <div class="controls-btn-group">\
          <button onclick="prevTrack()" style="background:#334155;">‚ÉØÆÔ∏ÉØ Anterior</button>\
          <button onclick="togglePlay()" style="background:#00d2ff; color:#000;">‚ÉØØÔ∏ÉØ Play/Pausa</button>\
          <button onclick="nextTrack()" style="background:#334155;">Pr√≥xima ‚ÉØ≠Ô∏ÉØ</button>\
        </div>\
\
        <div class="playlist-box">\
          <p style="font-size:0.75rem; color:#00d2ff; margin-bottom:5px; font-weight:bold;">ÉøÉ≥É´ PLAYLIST (CLIQUE NA M√É∫SICA PARA TOCAR):</p>\
          <ol id="playlistList"><li style="background:transparent; color:#666;">Sua lista aparecer√ÉÅ aqui...</li></ol>\
        </div>\
\
        <div style="margin-top:12px;">\
          <label>ÉøÉ¥• Regulagem de Grave Xtreme no Player (Bass Boost):</label>\
          <input type="range" class="vol-slider" id="bassBoost" min="0" max="20" value="5" oninput="ajustarBass(this.value)">\
          <span id="bassValue">N√≠vel Grave Xtreme: +5 dB</span>\
