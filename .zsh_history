<!DOCTYPE html>\
<html lang="pt-BR">\
<head>\
    <meta charset="UTF-8">\
    <meta name="viewport" content="width=device-width, initial-scale=1.0">\
    <title>ÉøÉ≥ª R√ÉÅdio Web - AO VIVO</title>\
    <script src="/socket.io/socket.io.js"></script>\
    <style>\
        body { background: #121212; color: #fff; font-family: sans-serif; text-align: center; padding: 20px; margin: 0; }\
        .card { background: #1e1e1e; padding: 20px; border-radius: 10px; max-width: 500px; margin: 0 auto 20px auto; }\
        .box-link { background: #282828; border: 2px dashed #1db954; border-radius: 8px; padding: 15px; margin: 15px 0; }\
        .box-link p { margin: 0 0 8px 0; font-weight: bold; color: #1db954; }\
        .box-link input { width: 90%; text-align: center; font-size: 12px; background: #121212; color: #fff; border: 1px solid #444; padding: 8px; border-radius: 5px; }\
        input[type="text"], input[type="email"], input[type="password"] { width: 85%; padding: 10px; border-radius: 5px; border: 1px solid #444; background: #222; color: #fff; margin-bottom: 10px; }\
        button { padding: 10px 15px; border-radius: 5px; border: none; background: #1db954; color: #fff; font-weight: bold; cursor: pointer; margin: 3px; }\
        .btn-danger { background: #e74c3c; }\
        .btn-mic { background: #ff9800; font-size: 16px; padding: 12px 20px; }\
        .btn-mic.recording { background: #f44336; animation: pulse 1s infinite; }\
        audio { width: 100%; margin-top: 15px; }\
        ul { text-align: left; background: #2a2a2a; padding: 15px 30px; border-radius: 5px; list-style: none; }\
        li { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; font-size: 14px; word-break: break-all; }\
        @keyframes pulse { 0% { opacity: 1; } 50% { opacity: 0.5; } 100% { opacity: 1; } }\
        .tab-btn { background: #333; margin-bottom: 15px; }\
        .active-tab { background: #1db954; }\
    </style>\
</head>\
<body>\
\
    <div>\
        <button class="tab-btn active-tab" id="btnTabOuvinte" onclick="verAba('ouvinte')">ÉøÉ≥ª Player Ouvinte</button>\
        <button class="tab-btn" id="btnTabAdm" onclick="verAba('adm')">ÉøÉÆÉπÔ∏ÉØ Painel DJ / ADM</button>\
    </div>\
\
    <!-- VIS√É£O DO OUVINTE -->\
    <div id="abaOuvinte" class="card">\
        <h1>ÉøÉ≥ª R√ÉÅdio Web</h1>\
\
        <div class="box-link">\
            <p>ÉøÉ≥ÉÇ LINK OFICIAL DA R√ÅDIO</p>\
            <input type="text" id="urlRadio" readonly>\
            <br><br>\
            <button onclick="copiarLink()">ÉøÉ≥É´ Copiar Link da R√ÉÅdio</button>\
        </div>\
\
        <div id="statusAoVivo" style="display:none; color: #ff9800; font-weight: bold;">ÉøÉ¥¥ LOCUTOR AO VIVO NO MICROFONE</div>\
        <p id="status">Tocando: Nenhuma m√∫sica na fila</p>\
        <audio id="player" controls autoplay></audio>\
\
        <h3>ÉøÉ≥Éº Pr√≥ximas M√∫sicas</h3>\
        <ul id="filaOuvinte"></ul>\
    </div>\
\
    <!-- VIS√É£O DO PAINEL ADM/DJ -->\
    <div id="abaAdm" class="card" style="display: none;">\
        \
        <!-- LOGIN -->\
        <div id="areaLogin">\
            <h2>ÉøÉ¥É∞ Login do DJ / ADM</h2>\
            <input type="email" id="loginEmail" placeholder="E-mail (fabiojr074@gmail.com)">\
            <input type="password" id="loginPass" placeholder="Senha">\
            <br>\
            <button onclick="fazerLogin()">Entrar no Painel</button>\
        </div>\
\
        <!-- CONTROLES DJ (EXIBIDO AP√É≥S LOGIN) -->\
        <div id="areaDj" style="display: none;">\
            <h2>ÉøÉÆÉπÔ∏ÉØ Mesa de Mixagem e Transmiss√£o</h2>\
            \
            <div style="background: #282828; padding: 15px; border-radius: 8px; margin-bottom: 15px;">\
                <h3>ÉøÉÆ§ Transmiss√£o ao Vivo (Microfone)</h3>\
                <button id="btnMicrofone" class="btn-mic" onclick="toggleMicrofone()">ÉøÉÆÉπÔ∏ÉØ Ligar Microfone</button>\
                <p id="statusMic" style="font-size: 12px; color: #aaa; margin-top: 5px;">Microfone Desligado</p>\
            </div>\
\
            <div style="background: #282828; padding: 15px; border-radius: 8px;">\
                <h3>ÉøÉÆÉªÔ∏ÉØ Gerenciador da Fila e Mixagem</h3>\
                <input type="text" id="linkMusica" placeholder="Link direto da m√∫sica (.mp3)">\
                <br>\
                <button onclick="adicionar()">‚ÉæÉµ Adicionar √ÉÄ Fila</button>\
                <button onclick="pular()" class="btn-danger">‚ÉØ≠Ô∏ÉØ Pular M√∫sica</button>\
                <button onclick="limparFila()" class="btn-danger">ÉøÉ∑É±Ô∏ÉØ Limpar Fila</button>\
\
                <h4>ÉøÉ≥Éº M√∫sicas na Fila:</h4>\
                <ul id="filaAdm"></ul>\
            </div>\
            <br>\
            <button onclick="logout()" style="background: #555;">Sair do Painel</button>\
        </div>\
\
    </div>\
\
    <script>\
        const socket = io();\
        const player = document.getElementById('player');\
        const status = document.getElementById('status');\
        const filaOuvinte = document.getElementById('filaOuvinte');\
        const filaAdm = document.getElementById('filaAdm');\
        \
        document.getElementById('urlRadio').value = window.location.href;\
\
        function copiarLink() {\
            const input = document.getElementById('urlRadio');\
            input.select();\
            navigator.clipboard.writeText(input.value);\
            alert('Link da r√ÉÅdio copiado!');\
        }\
\
        function verAba(aba) {\
            document.getElementById('abaOuvinte').style.display = aba === 'ouvinte' ? 'block' : 'none';\
            document.getElementById('abaAdm').style.display = aba === 'adm' ? 'block' : 'none';\
            document.getElementById('btnTabOuvinte').classList.toggle('active-tab', aba === 'ouvinte');\
            document.getElementById('btnTabAdm').classList.toggle('active-tab', aba === 'adm');\
        }\
\
        // --- AUTENTICA√Éß√É£O ---\
        function fazerLogin() {\
            const email = document.getElementById('loginEmail').value;\
            const password = document.getElementById('loginPass').value;\
\
            fetch('/api/login', {\
                method: 'POST',\
                headers: { 'Content-Type': 'json' },\
                headers: { 'Content-Type': 'application/json' },\
                body: JSON.stringify({ email, password })\
            })\
            .then(res => res.json())\
            .then(data => {\
                if(data.success) {\
                    localStorage.setItem('adm_token', data.token);\
                    carregarPainel();\
                } else {\
                    alert(data.message);\
                }\
            });\
        }\
\
        function carregarPainel() {\
            if(localStorage.getItem('adm_token')) {\
                document.getElementById('areaLogin').style.display = 'none';\
                document.getElementById('areaDj').style.display = 'block';\
            }\
        }\
\
        function logout() {\
            localStorage.removeItem('adm_token');\
            document.getElementById('areaLogin').style.display = 'block';\
            document.getElementById('areaDj').style.display = 'none';\
        }\
\
        // --- SOCKET / PLAYER ---\
        socket.on('novaMusica', (data) => {\
            if (data && data.musica) {\
                status.innerText = 'Tocando: ' + data.musica;\
                player.src = data.musica;\
                player.currentTime = data.tempoDecorrido;\
                player.play().catch(() => {});\
            } else {\
                status.innerText = 'Tocando: Nenhuma m√∫sica na fila';\
                player.src = '';\
            }\
        });\
\
        socket.on('atualizarFila', (lista) => {\
            filaOuvinte.innerHTML = '';\
            filaAdm.innerHTML = '';\
            lista.forEach((item, index) => {\
                filaOuvinte.innerHTML += `<li>${index + 1}. ${item}</li>`;\
                filaAdm.innerHTML += `<li>${index + 1}. ${item} <button class="btn-danger" style="padding:2px 8px;" onclick="remover(${index})">X</button></li>`;\
            });\
        });\
\
        // --- CONTROLES DE DJ ---\
        function adicionar() {\
            const input = document.getElementById('linkMusica');\
            if (input.value.trim() !== '') {\
                socket.emit('adicionarMusica', input.value.trim());\
                input.value = '';\
            }\
        }\
        function pular() { socket.emit('proximaMusica'); }\
        function remover(index) { socket.emit('removerMusica', index); }\
        function limparFila() { socket.emit('limparFila'); }\
\
        // --- TRANSMISS√É£O DE MICROFONE (VOICE OVER SOCKET) ---\
        let mediaRecorder;\
        let isRecording = false;\
\
        async function toggleMicrofone() {\
            const btn = document.getElementById('btnMicrofone');\
            const statusMic = document.getElementById('statusMic');\
\
            if (!isRecording) {\
                try {\
                    const stream = await navigator.mediaDevices.getUserMedia({ audio: true });\
                    mediaRecorder = new MediaRecorder(stream, { mimeType: 'audio/webm' });\
                    \
                    mediaRecorder.ondataavailable = (event) => {\
                        if (event.data.size > 0) {\
                            socket.emit('streamAudio', event.data);\
                        }\
                    };\
\
                    mediaRecorder.start(250); // Envia blocos de √ÉÅudio a cada 250ms\
                    isRecording = true;\
                    btn.classList.add('recording');\
                    btn.innerText = 'ÉøÉªÉ± Desligar Microfone';\
                    statusMic.innerText = 'ÉøÉ¥¥ AO VIVO NO MICROFONE';\
                } catch (err) {\
                    alert('Erro ao acessar o microfone: ' + err.message);\
                }\
            } else {\
                mediaRecorder.stop();\
                socket.emit('pararStream');\
                isRecording = false;\
                btn.classList.remove('recording');\
                btn.innerText = 'ÉøÉÆÉπÔ∏ÉØ Ligar Microfone';\
                statusMic.innerText = 'Microfone Desligado';\
            }\
        }\
\
        // Recebimento de √ÉÅudio ao vivo nos ouvintes\
        let sourceBuffer;\
        let mediaSource;\
        let audioQueue = [];\
\
        socket.on('receberAudioLive', (data) => {\
            document.getElementById('statusAoVivo').style.display = 'block';\
            player.pause(); // Pausa a m√∫sica para dar prioridade √ÉÄ voz do DJ\
            \
            let blob = new Blob([data], { type: 'audio/webm' });\
            let audioURL = URL.createObjectURL(blob);\
            let liveAudio = new Audio(audioURL);\
            liveAudio.play().catch(() => {});\
        });\
\
        socket.on('fimAudioLive', () => {\
            document.getElementById('statusAoVivo').style.display = 'none';\
            player.play().catch(() => {}); // Retoma a m√∫sica\
        });\
\
        // Tentar auto-login se token existir\
        carregarPainel();\
    </script>\
</body>\
</html>\
EOF\

