    <script>\
        const socket = io();\
        let ytPlayer, audioCtx, analyser, dataArray;\
        let corAtual = '#00e5ff';\
        const audioLocal = document.getElementById('audioLocal');\
\
        document.getElementById('urlRadio').value = window.location.href;\
\
        // SANITIZADOR DE LINKS (YMUSIC, YOUTUBE, APP SHARE)\
        function extrairIdYoutube(url) {\
            if (!url) return null;\
            let regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|\&v=)([^#\&\?]*).*/;\
            let match = url.match(regExp);\
            return (match && match[2].length === 11) ? match[2] : url;\
        }\
\
        function onYouTubeIframeAPIReady() {\
            ytPlayer = new YT.Player('player', {\
                height: '100%', width: '100%',\
                playerVars: { 'autoplay': 1, 'controls': 1, 'origin': window.location.origin },\
                events: { 'onStateChange': (e) => { if (e.data === 0) socket.emit('proximaMusicaAuto'); } }\
            });\
        }\
\
        // SIMULADOR DE BATIDA / VU METER\
        setInterval(() => {\
            const bars = document.querySelectorAll('.vu-bar');\
            const isPlaying = (ytPlayer && ytPlayer.getPlayerState && ytPlayer.getPlayerState() === 1) || !audioLocal.paused;\
            \
            bars.forEach((bar) => {\
                if (isPlaying) {\
                    let level = Math.floor(Math.random() * 90) + 10;\
                    bar.style.height = level + '%';\
                    bar.style.background = level > 75 ? '#ff0055' : corAtual;\
                    if(level > 80) document.body.style.background = '#1a1a2e';\
                    else document.body.style.background = '#121212';\
                } else {\
                    bar.style.height = '10%';\
                    bar.style.background = '#333';\
                    document.body.style.background = '#121212';\
                }\
            });\
        }, 120);\
\
        socket.on('novaMusica', (data) => {\
            if (data?.musica) {\
                audioLocal.style.display = 'none';\
                document.getElementById('ytPlayerContainer').querySelector('iframe').style.display = 'block';\
                let id = extrairIdYoutube(data.musica);\
                if (ytPlayer?.loadVideoById) ytPlayer.loadVideoById(id);\
                document.getElementById('status').innerText = 'Tocando agora!';\
            }\
        });\
\
        socket.on('atualizarFila', (lista) => {\
            document.getElementById('filaOuvinte').innerHTML = lista.map((m, i) => `<li>${i + 1}. ${m}</li>`).join('');\
        });\
\
        function adicionarMusica(origem) {\
            const input = document.getElementById(origem === 'ouvinte' ? 'linkMusicaOuvinte' : 'linkMusicaAdm');\
            if (input.value) {\
                socket.emit('adicionarMusica', input.value);\
                input.value = '';\
            }\
        }\
\
        function carregarMp3Local() {\
            const file = document.getElementById('fileInput').files[0];\
            if (file) {\
                const url = URL.createObjectURL(file);\
                if(ytPlayer?.stopVideo) ytPlayer.stopVideo();\
                document.getElementById('ytPlayerContainer').querySelector('iframe').style.display = 'none';\
                audioLocal.style.display = 'block';\
                audioLocal.src = url;\
                audioLocal.play();\
                document.getElementById('status').innerText = 'Tocando MP3 Local: ' + file.name;\
            }\
        }\
\
        function tocarEfeito(tipo) {\
            let ctx = new (window.AudioContext || window.webkitAudioContext)();\
            let osc = ctx.createOscillator();\
            let gain = ctx.createGain();\
            osc.connect(gain);\
            gain.connect(ctx.destination);\
            \
            if (tipo === 'airhorn') {\
                osc.frequency.setValueAtTime(400, ctx.currentTime);\
                osc.frequency.exponentialRampToValueAtTime(800, ctx.currentTime + 0.3);\
            } else if (tipo === 'scratch') {\
                osc.type = 'sawtooth';\
                osc.frequency.setValueAtTime(1200, ctx.currentTime);\
                osc.frequency.linearRampToValueAtTime(200, ctx.currentTime + 0.15);\
            } else {\
                osc.type = 'triangle';\
                osc.frequency.setValueAtTime(150, ctx.currentTime);\
                osc.frequency.exponentialRampToValueAtTime(30, ctx.currentTime + 0.5);\
            }\
            osc.start();\
            osc.stop(ctx.currentTime + 0.4);\
        }\
\
        function mudarCor(cor) {\
            corAtual = cor;\
            document.documentElement.style.setProperty('--stage-light', cor);\
            document.documentElement.style.setProperty('--primary-color', cor);\
        }\
\
        function verAba(aba) {\
            document.getElementById('abaOuvinte').style.display = aba === 'ouvinte' ? 'block' : 'none';\
            document.getElementById('abaAdm').style.display = aba === 'adm' ? 'block' : 'none';\
        }\
\
        function copiarLink() {\
            navigator.clipboard.writeText(document.getElementById('urlRadio').value);\
            alert('Link copiado!');\
        }\
\
        function fazerLogin() {\
            const email = document.getElementById('loginEmail').value;\
            const pass = document.getElementById('loginPass').value;\
            fetch('/api/login', {\
                method: 'POST',\
                headers: { 'Content-Type': 'application/json' },\
                body: JSON.stringify({ email, pass })\
            }).then(r => r.json()).then(d => {\
                if (d.success) {\
                    document.getElementById('areaLogin').style.display = 'none';\
                    document.getElementById('areaDj').style.display = 'block';\
                } else alert('E-mail ou senha incorretos!');\
            });\
        }\
\
        function logout() { location.reload(); }\
        function comandoDJ(cmd) { socket.emit('comandoDJ', cmd); }\
        function limparFila() { socket.emit('limparFila'); }\
    </script>\
</body>\
</html>\
EOF\

