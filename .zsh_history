<!DOCTYPE html>\
<html lang="pt-BR">\
<head>\
    <meta charset="UTF-8">\
    <meta name="viewport" content="width=device-width, initial-scale=1.0">\
    <title id="pageTitle">‚É∫ÉÅ SPEED R√ÅDIO</title>\
    <script src="/socket.io/socket.io.js"></script>\
    <script src="https://www.youtube.com/iframe_api"></script>\
    <style id="dynamicStyles">\
        :root { --bg-color: #121212; --card-color: #1e1e1e; --primary-color: #1db954; --text-color: #ffffff; }\
        body { background: var(--bg-color); color: var(--text-color); font-family: sans-serif; text-align: center; padding: 20px; margin: 0; }\
        .card { background: var(--card-color); padding: 20px; border-radius: 10px; max-width: 500px; margin: 0 auto 20px auto; border-top: 4px solid var(--primary-color); }\
        \
        /* PLAYER INVIS√É≠VEL MAS FUNCIONAL */\
        #ytPlayerContainer { position: fixed; top: -9999px; left: -9999px; opacity: 0; }\
        \
        button { padding: 10px 15px; border-radius: 5px; border: none; background: var(--primary-color); color: #fff; font-weight: bold; cursor: pointer; margin: 5px; }\
        input { width: 85%; padding: 10px; border-radius: 5px; border: 1px solid #444; background: #222; color: #fff; margin-bottom: 10px; }\
        ul { text-align: left; background: rgba(255,255,255,0.05); padding: 15px; border-radius: 5px; list-style: none; }\
        li { margin-bottom: 5px; font-size: 13px; border-bottom: 1px solid #333; padding: 5px; }\
    </style>\
</head>\
<body>\
\
    <div>\
        <button onclick="verAba('ouvinte')">ÉøÉ≥ª Player</button>\
        <button onclick="verAba('adm')">ÉøÉÆÉªÔ∏ÉØ Painel DJ</button>\
    </div>\
\
    <!-- OUVINTE -->\
    <div id="abaOuvinte" class="card">\
        <h1 id="displayNomeRadio">‚É∫ÉÅ SPEED R√ÅDIO</h1>\
        <p id="status">Conectando...</p>\
        \
        <!-- Player Invis√≠vel -->\
        <div id="ytPlayerContainer"><div id="player"></div></div>\
\
        <h3>ÉøÉÆµ Pedir M√∫sica</h3>\
        <input type="text" id="linkMusicaOuvinte" placeholder="Cole o link do YouTube...">\
        <button onclick="adicionarOuvinte()">‚ÉæÉµ Enviar</button>\
\
        <h3>ÉøÉ≥Éº Fila de Reprodu√ß√£o</h3>\
        <ul id="filaOuvinte"></ul>\
    </div>\
\
    <!-- PAINEL DJ -->\
    <div id="abaAdm" class="card" style="display: none;">\
        <div id="areaLogin">\
            <h2>ÉøÉ¥É∞ Login do DJ</h2>\
            <input type="email" id="loginEmail" placeholder="E-mail">\
            <input type="password" id="loginPass" placeholder="Senha">\
            <button onclick="fazerLogin()">Entrar</button>\
        </div>\
        <div id="areaDj" style="display: none;">\
            <h2>ÉøÉÆÉªÔ∏ÉØ Painel de Controle</h2>\
            <button onclick="comandoDJ('togglePlay')">‚ÉØØÔ∏ÉØ Play/Pause</button>\
            <button onclick="comandoDJ('skip')">‚ÉØ≠Ô∏ÉØ Pular</button>\
            <button onclick="limparFila()">ÉøÉ∑É±Ô∏ÉØ Limpar Fila</button>\
            <br><br>\
            <button onclick="logout()" style="background: #555;">Sair</button>\
        </div>\
    </div>\
\
    <script>\
        const socket = io();\
        let ytPlayer;\
\
        function onYouTubeIframeAPIReady() {\
            ytPlayer = new YT.Player('player', {\
                height: '360', width: '640',\
                playerVars: { 'autoplay': 1, 'playsinline': 1, 'origin': window.location.origin },\
                events: { 'onStateChange': (e) => { if(e.data === 0) socket.emit('proximaMusicaAuto'); } }\
            });\
        }\
\
        socket.on('novaMusica', (data) => {\
            if (data?.musica) {\
                let id = data.musica.split('v=')[1]?.substring(0,11) || data.musica;\
                ytPlayer.loadVideoById(id);\
                document.getElementById('status').innerText = 'Tocando agora...';\
            }\
        });\
\
        socket.on('atualizarFila', (lista) => {\
            const listaEl = document.getElementById('filaOuvinte');\
            listaEl.innerHTML = lista.map((m, i) => `<li>${i+1}. ${m}</li>`).join('');\
        });\
\
        function adicionarOuvinte() {\
            const input = document.getElementById('linkMusicaOuvinte');\
            if(input.value) socket.emit('adicionarMusica', input.value);\
            input.value = '';\
        }\
\
        function verAba(aba) {\
            document.getElementById('abaOuvinte').style.display = aba === 'ouvinte' ? 'block' : 'none';\
            document.getElementById('abaAdm').style.display = aba === 'adm' ? 'block' : 'none';\
        }\
\
        function fazerLogin() {\
            const email = document.getElementById('loginEmail').value;\
            const pass = document.getElementById('loginPass').value;\
            fetch('/api/login', { \
                method: 'POST', \
                headers: { 'Content-Type': 'application/json' },\
                body: JSON.stringify({ email, pass })\
            }).then(r => r.json()).then(d => {\
                if(d.success) { \
                    document.getElementById('areaLogin').style.display = 'none'; \
                    document.getElementById('areaDj').style.display = 'block'; \
                } else alert('Login inv√ÉÅlido');\
            });\
        }\
\
        function logout() { location.reload(); }\
        function comandoDJ(cmd) { socket.emit('comandoDJ', cmd); }\
        function limparFila() { socket.emit('limparFila'); }\
    </script>\
</body>\
</html>\
EOF\

