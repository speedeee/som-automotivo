\
    <!-- Lista de Produtos da Loja -->\
    <div id="container"></div>\
\
    <!-- Se√ß√£o de Depoimentos / Prova Social -->\
    <div class="depoimentos-box" style="border-left-color: #00cc66; margin-top: 30px;">\
        <h3 style="color: #fff; margin-top: 0; text-align: center;">‚≠É∞ O que dizem nossos clientes</h3>\
        \
        <div style="background: #2a2a2a; padding: 12px; border-radius: 6px; margin-bottom: 10px;">\
            <p style="margin: 0; font-style: italic; font-size: 14px;">"Chegou super r√ÉÅpido aqui em Minas e a qualidade √© braba demais! Recomendo muito."</p>\
            <span style="color: #ff4500; font-size: 12px; font-weight: bold; display: block; margin-top: 5px;">‚ÄÉ¥ Lucas M. (Comprador Verificado)</span>\
        </div>\
\
        <div style="background: #2a2a2a; padding: 12px; border-radius: 6px;">\
            <p style="margin: 0; font-style: italic; font-size: 14px;">"Loja confi√ÉÅvel, atendimento nota 10 e o produto veio perfeito."</p>\
            <span style="color: #ff4500; font-size: 12px; font-weight: bold; display: block; margin-top: 5px;">‚ÄÉ¥ Gabriel S. (Comprador Verificado)</span>\
        </div>\
    </div>\
\
    <!-- Painel Admin Profissional -->\
    <div id="admin-section" class="admin-box" style="margin-top: 30px;">\
        <h3>‚É∫ÉπÔ∏ÉØ Painel de Gerenciamento Profissional</h3>\
        <p style="font-size: 13px; color: #aaa; margin-bottom: 15px;">Adicione novos produtos com imagem e pre√ßo em tempo real.</p>\
        \
        <input type="text" id="nomeProd" placeholder="Nome do Produto">\
        <input type="number" id="precoProd" placeholder="Pre√ßo (Ex: 89.90)">\
        <input type="text" id="imagemProd" placeholder="Link da Imagem (Opcional)">\
        <button onclick="adicionarProduto()">Cadastrar Produto</button>\
        \
        <h4 style="margin-top: 25px; border-top: 1px solid #333; padding-top: 15px;">Produtos Cadastrados:</h4>\
        <div id="admin-lista"></div>\
    </div>\
\
    <div style="text-align: center; margin-top: 30px;">\
        <p>D√∫vidas? Entre em contato:</p>\
        <a href="https://www.tiktok.com" target="_blank" style="color: #ff4500; text-decoration: none; font-weight: bold;">Nosso TikTok</a>\
    </div>\
\
    <!-- Modal do Pix -->\
    <div id="modal-pix">\
        <div class="modal-content">\
            <h3>Pagamento via Pix</h3>\
            <p id="pix-detalhe" style="margin: 10px 0;"></p>\
            <textarea id="copia-cola-pix" readonly>00020126580014br.gov.bcb.pix0136speedstore-pay-4-uuid5204000053039865802BR5909SPEEDSTORE6009MINAS GERAIS62070503***6304</textarea>\
            <button onclick="copiarPix()" style="background-color: #00cc66;">COPIAR C√É≥DIGO PIX</button>\
            <button onclick="fecharModal()" style="background-color: #555; margin-top: 10px;">Fechar</button>\
        </div>\
    </div>\
\
    <script>\
        // Contador Regressivo\
        let tempo = 10700; // segundos\
        setInterval(() => {\
            let h = Math.floor(tempo / 3600);\
            let m = Math.floor((tempo % 3600) / 60);\
            let s = tempo % 60;\
            document.getElementById('countdown').innerText = \
                String(h).padStart(2,'0') + ":" + String(m).padStart(2,'0') + ":" + String(s).padStart(2,'0');\
            if(tempo > 0) tempo--;\
        }, 1000);\
\
        let produtos = JSON.parse(localStorage.getItem('speed_produtos')) || [\
            { nome: "Produto Exemplo", preco: 50.00, imagem: "https://via.placeholder.com/300x180?text=SPEED+STORE" },\
            { nome: "Camisa", preco: 29.90, imagem: "https://via.placeholder.com/300x180?text=Camisa" }\
        ];\
\
        function salvarProdutos() {\
            localStorage.setItem('speed_produtos', JSON.stringify(produtos));\
            carregarLoja();\
        }\
\
        function carregarLoja() {\
            const container = document.getElementById('container');\
            const adminLista = document.getElementById('admin-lista');\
            \
            container.innerHTML = '';\
            adminLista.innerHTML = '';\
            \
            produtos.forEach((p, index) => {\
                let imgSrc = p.imagem && p.imagem.trim() !== "" ? p.imagem : "https://via.placeholder.com/300x180?text=SPEED+STORE";\
                \
                container.innerHTML += `\
                    <div class="produto-card">\
                        <img src="${imgSrc}" alt="${p.nome}">\
                        <h3>${p.nome}</h3>\
                        <p style="color: #00ff00; font-weight: bold;">R$ ${Number(p.preco).toFixed(2)}</p>\
                        <button onclick="abrirPix('${p.nome}', ${p.preco})">COMPRAR VIA PIX</button>\
                    </div>\
                `;\
\
                adminLista.innerHTML += `\
                    <div style="display: flex; justify-content: space-between; align-items: center; background: #2a2a2a; padding: 10px; margin-bottom: 8px; border-radius: 4px;">\
                        <span style="font-size: 14px;">${p.nome} - <b>R$ ${Number(p.preco).toFixed(2)}</b></span>\
                        <button onclick="excluirProduto(${index})" style="background: #ff3333; width: auto; padding: 6px 12px; margin: 0; font-size: 12px;">Excluir</button>\
                    </div>\
                `;\
            });\
        }\
\
        function adicionarProduto() {\
            const nome = document.getElementById('nomeProd').value;\
            const preco = document.getElementById('precoProd').value;\
            const imagem = document.getElementById('imagemProd').value;\
            \
            if(nome && preco) {\
                produtos.push({ nome, preco: parseFloat(preco), imagem });\
                document.getElementById('nomeProd').value = '';\
                document.getElementById('precoProd').value = '';\
                document.getElementById('imagemProd').value = '';\
                salvarProdutos();\
            } else {\
                alert('Preencha pelo menos o nome e o pre√ßo do produto!');\
            }\
        }\
\
        function excluirProduto(index) {\
            produtos.splice(index, 1);\
            salvarProdutos();\
        }\
\
        function abrirPix(nome, preco) {\
            document.getElementById('pix-detalhe').innerText = `${nome} - R$ ${Number(preco).toFixed(2)}`;\
            document.getElementById('modal-pix').style.display = 'flex';\
        }\
\
        function copiarPix() {\
            const txt = document.getElementById('copia-cola-pix');\
            txt.select();\
            document.execCommand('copy');\
            alert('C√≥digo Pix copiado com sucesso!');\
        }\
\
        function fecharModal() {\
            document.getElementById('modal-pix').style.display = 'none';\
        }\
\
        carregarLoja();\
    </script>\
</body>\
</html>\
EOF\

