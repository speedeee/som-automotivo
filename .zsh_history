: 1786204694:0;cat << 'EOF' > index.html\
<!DOCTYPE html>\
<html lang="pt-BR">\
<head>\
  <meta charset="UTF-8">\
  <meta name="viewport" content="width=device-width, initial-scale=1.0">\
  <title>Simulador de Som Automotivo Master PRO</title>\
  <style>\
    :root {\
      --bg-dark: #050811;\
      --card-bg: #0d1527;\
      --border-color: #1e293b;\
      --accent-red: #ff0055;\
      --neon-cyan: #00f0ff;\
      --neon-yellow: #ffcc00;\
      --neon-green: #00ff66;\
      --text-main: #f8fafc;\
    }\
\
    body {\
      background-color: var(--bg-dark);\
      color: var(--text-main);\
      font-family: 'Segoe UI', Roboto, sans-serif;\
      margin: 0;\
      padding: 12px;\
      padding-bottom: 40px;\
    }\
\
    h1 {\
      text-align: center;\
      color: var(--accent-red);\
      font-size: 22px;\
      margin-bottom: 15px;\
      text-transform: uppercase;\
      letter-spacing: 1.5px;\
      text-shadow: 0 0 12px rgba(255, 0, 85, 0.6);\
    }\
\
    .card {\
      background: var(--card-bg);\
      border: 1px solid var(--border-color);\
      border-left: 4px solid var(--accent-red);\
      border-radius: 8px;\
      padding: 12px;\
      margin-bottom: 14px;\
      box-shadow: 0 4px 15px rgba(0,0,0,0.5);\
    }\
\
    .card h3 {\
      margin-top: 0;\
      font-size: 14px;\
      color: var(--neon-cyan);\
      text-transform: uppercase;\
      border-bottom: 1px solid var(--border-color);\
      padding-bottom: 6px;\
      display: flex;\
      justify-content: space-between;\
      align-items: center;\
    }\
\
    /* VOLT√É≠METRO E RECURSOS DE BATERIA */\
    .voltimetro-card {\
      background: #000;\
      border: 2px solid var(--accent-red);\
      text-align: center;\
      border-radius: 10px;\
      padding: 15px;\
      margin-bottom: 14px;\
      box-shadow: inset 0 0 15px rgba(255,0,0,0.2);\
    }\
\
    .voltimetro-valor {\
      font-size: 42px;\
      font-weight: 900;\
      color: #ff2a2a;\
      text-shadow: 0 0 20px #ff0000;\
      font-family: monospace;\
      margin: 5px 0;\
    }\
\
    .alerta-bass {\
      color: var(--neon-yellow);\
      font-size: 11px;\
      font-weight: bold;\
      text-transform: uppercase;\
    }\
\
    label {\
      display: block;\
      font-size: 11px;\
      color: #94a3b8;\
      margin-top: 8px;\
      text-transform: uppercase;\
      font-weight: 600;\
    }\
\
    select, input[type="text"], input[type="number"], input[type="range"] {\
      width: 100%;\
      padding: 8px;\
      margin-top: 4px;\
      background: #020617;\
      border: 1px solid #334155;\
      color: #fff;\
      border-radius: 6px;\
      box-sizing: border-box;\
      font-size: 12px;\
    }\
\
    .grid-2 { display: flex; gap: 8px; }\
    .grid-2 > div { flex: 1; }\
\
    /* PALCO VIRTUAL E VISUALIZA√Éß√É£O */\
    .palco {\
      background: #020617;\
      border: 1px solid var(--neon-cyan);\
      border-radius: 8px;\
      padding: 15px;\
      text-align: center;\
      min-height: 150px;\
      display: flex;\
      flex-wrap: wrap;\
      justify-content: center;\
      align-items: center;\
      gap: 12px;\
      position: relative;\
      transition: box-shadow 0.2s;\
    }\
\
    .palco.led-active {\
      box-shadow: 0 0 25px var(--accent-red);\
    }\
\
    /* √É≠CONES PERSONALIZADOS POR EQUIPAMENTO */\
    .equip-box {\
      border: 1px solid #334155;\
      border-radius: 6px;\
      padding: 8px;\
      background: #0f172a;\
      display: flex;\
      flex-direction: column;\
      align-items: center;\
      min-width: 80px;\
    }\
\
    .woofer-icon {\
      width: 60px;\
      height: 60px;\
      border-radius: 50%;\
      background: radial-gradient(circle, #111 30%, #333 70%, #000 100%);\
      border: 4px solid #222;\
      box-shadow: 0 0 8px #000;\
      transition: transform 0.05s ease-in-out;\
    }\
\
    .woofer-icon.vibrando {\
      animation: pulso 0.1s infinite alternate;\
    }\
\
    .woofer-icon.xtreme-pulse {\
      animation: pulsoXtreme 0.08s infinite alternate;\
    }\
\
    @keyframes pulso {\
      0% { transform: scale(1); }\
      100% { transform: scale(1.15); box-shadow: 0 0 15px var(--neon-cyan); }\
    }\
\
    @keyframes pulsoXtreme {\
      0% { transform: scale(1.02); }\
      100% { transform: scale(1.3); box-shadow: 0 0 25px var(--accent-red); }\
    }\
\
    .driver-icon {\
      width: 45px;\
      height: 45px;\
      background: #1e293b;\
      border: 2px solid var(--neon-cyan);\
      color: #fff;\
      font-size: 9px;\
      display: flex;\
      align-items: center;\
      justify-content: center;\
      font-weight: bold;\
      text-align: center;\
    }\
\
    .driver-quadrada { border-radius: 4px; }\
    .driver-redonda { border-radius: 50%; }\
\
    /* CONTROLES DE EQUALIZA√Éß√É£O REAL */\
    .eq-container {\
      display: flex;\
      justify-content: space-around;\
      gap: 10px;\
      margin-top: 12px;\
      background: #020617;\
      padding: 12px;\
      border-radius: 6px;\
    }\
\
    .eq-slider {\
      display: flex;\
      flex-direction: column;\
      align-items: center;\
      font-size: 10px;\
      color: #94a3b8;\
    }\
\
    .eq-slider input[type="range"] {\
      writing-mode: bt-lr;\
      -webkit-appearance: slider-vertical;\
      width: 12px;\
      height: 90px;\
      padding: 0;\
      margin: 8px 0;\
    }\
\
    .btn-xtreme {\
      width: 100%;\
      background: #1e293b;\
      color: #888;\
      border: 2px solid #334155;\
      padding: 10px;\
      font-weight: 900;\
      border-radius: 6px;\
      font-size: 13px;\
      cursor: pointer;\
      margin-top: 10px;\
      text-transform: uppercase;\
      letter-spacing: 1px;\
      transition: all 0.2s;\
    }\
\
    .btn-xtreme.active {\
      background: linear-gradient(90deg, #ff0055, #ff5500);\
      color: #fff;\
      border-color: #ff0055;\
      box-shadow: 0 0 20px rgba(255, 0, 85, 0.8);\
    }\
\
    button.btn-main {\
      width: 100%;\
      background: linear-gradient(90deg, var(--accent-red), #ff5500);\
      color: white;\
      border: none;\
      padding: 14px;\
      font-weight: bold;\
      border-radius: 8px;\
      font-size: 14px;\
      cursor: pointer;\
      margin-top: 10px;\
      text-transform: uppercase;\
      letter-spacing: 1px;\
      box-shadow: 0 4px 15px rgba(255, 0, 85, 0.4);\
    }\
\
    .playlist-box {\
      background: #020617;\
      border: 1px solid #1e293b;\
      border-radius: 6px;\
      padding: 8px;\
      max-height: 120px;\
      overflow-y: auto;\
      font-size: 11px;\
      margin-top: 8px;\
    }\
\
    .playlist-item {\
      padding: 6px;\
      border-bottom: 1px solid #0f172a;\
      cursor: pointer;\
      color: #94a3b8;\
    }\
\
    .playlist-item.ativo {\
      color: #fff;\
      background: var(--accent-red);\
      font-weight: bold;\
      border-radius: 4px;\
    }\
\
    .controls-row {\
      display: flex;\
      gap: 6px;\
      margin-top: 8px;\
    }\
\
    .controls-row button {\
      flex: 1;\
      padding: 10px;\
      background: #0f172a;\
      border: 1px solid var(--neon-cyan);\
      color: #fff;\
      border-radius: 6px;\
      font-weight: bold;\
      font-size: 11px;\
      cursor: pointer;\
    }\
\
    textarea {\
      width: 100%;\
      height: 220px;\
      background: #020617;\
      color: #00ffcc;\
      border: 1px solid var(--neon-cyan);\
      border-radius: 6px;\
      padding: 10px;\
      font-family: monospace;\
      font-size: 11px;\
      box-sizing: border-box;\
      margin-top: 8px;\
    }\
  </style>\
</head>\
<body>\
\
  <h1>ÉøÉ¥É™ SIMULADOR DE SOM AUTOMOTIVO PRO</h1>\
\
  <div class="voltimetro-card">\
    <div style="font-size: 10px; color: #aaa;">‚É∫ÉÅ VOLT√É≠METRO / BARRAMENTO DE COBRE</div>\
    <div class="voltimetro-valor" id="voltsDisplay">12.6 V</div>\
    <div class="alerta-bass" id="alertaDisplay">SISTEMA EM REPOUSO / EST√ÅVEL</div>\
  </div>\
\
  <div class="card">\
    <h3>ÉøÉ≥± Visualizador do Rack de Som & Caixas</h3>\
    <div class="palco" id="palcoVirtual"></div>\
  </div>\
\
  <div class="card">\
    <h3>1. Central, DSP & Processador</h3>\
    <label>Processador de √Åudio (DSP):</label>\
    <select id="dspModel">\
      <option value="Stetsom STX2448 / STX2848 Digital">Stetsom STX2448 / STX2848 Digital (EQ 15 Bandas)</option>\
      <option value="Expert Electronics PX-1 / PX-2 PRO Bluetooth">Expert Electronics PX-1 / PX-2 PRO (App Control)</option>\
      <option value="JFA X5 / Crossover Anal√≥gico">JFA X5 / Crossover 4 Vias</option>\
      <option value="Taramps Pro 2.4S DSP">Taramps Pro 2.4S DSP</option>\
    </select>\
\
    <label>Player Central:</label>\
    <select id="playerModel">\
      <option value="Pioneer MVH-X3000BR / Golfinho">Pioneer MVH-X3000BR / Bluetooth Golfinho</option>\
      <option value="Central Multim√≠dia Android PRO">Central Multim√≠dia Android PRO</option>\
      <option value="Expert Central Controle Longa Dist√ÉÇncia">Expert Central + Controle Longa Dist√ÉÇncia</option>\
    </select>\
  </div>\
\
  <div class="card">\
    <h3>2. Grave / Woofers / Subwoofers</h3>\
    <label>Marca e Modelo do Falante:</label>\
    <select id="wooferBrand">\
      <option value="Eros Target Bass 3.0K / 4.5K">Eros Target Bass 3.0K / 4.5K</option>\
      <option value="Eros Hammer 5.2K (Grave Seco)">Eros Hammer 5.2K (Grave Seco)</option>\
      <option value="Triton Shocker / Vulcano 3.8K">Triton Shocker / Vulcano 3.8K</option>\
      <option value="Hard Power HP 1850 / 2500">Hard Power HP 1850 / 2500</option>\
      <option value="JBL Vulcano 3.8 / Tornado 5600">JBL Vulcano 3.8 / Tornado 5600</option>\
      <option value="7Driver Bass 3K0 / Thunder">7Driver Bass 3K0 / Thunder</option>\
    </select>\
\
    <div class="grid-2">\
      <div>\
        <label>Tamanho:</label>\
        <select id="wooferSize" onchange="atualizarPalco()">\
          <option value="12">12 Inches (Seco)</option>\
          <option value="15" selected>15 Inches (Misto)</option>\
          <option value="18">18 Inches (Subgrave)</option>\
        </select>\
      </div>\
      <div>\
        <label>Qtd Woofers:</label>\
        <input type="number" id="wooferQty" value="2" min="1" max="12" onchange="atualizarPalco()">\
      </div>\
    </div>\
\
    <div class="grid-2">\
      <div>\
        <label>RMS por Unidade:</label>\
        <input type="number" id="wooferRms" value="1500">\
      </div>\
      <div>\
        <label>M√≥dulo de Grave:</label>\
        <select id="ampWoofer">\
          <option value="Taramps MD 3000.1 / Smart 3">Taramps MD 3000.1 / Smart 3</option>\
          <option value="Taramps HD 8000 / MD 5000">Taramps HD 8000 / MD 5000</option>\
          <option value="Stetsom Vulcan 3000 / 5000">Stetsom Vulcan 3000 / 5000</option>\
          <option value="Soundigital 3000.1 EVO">Soundigital 3000.1 EVO</option>\
          <option value="Banda Viking 5000">Banda Viking 5000</option>\
        </select>\
      </div>\
    </div>\
  </div>\
\
  <div class="card">\
    <h3>3. M√©dio Grave, Drivers & Cornetas</h3>\
    <div class="grid-2">\
      <div>\
        <label>Qtd Drivers:</label>\
        <input type="number" id="driverQty" value="2" min="0" max="8" onchange="atualizarPalco()">\
      </div>\
      <div>\
        <label>Modelo Driver:</label>\
        <select id="driverModel">\
          <option value="JBL Selenium D250X / D250 Trio">JBL D250X / D250 Trio</option>\
          <option value="JBL D405 / D305 Fen√≥lico">JBL D405 / D305 (Fen√≥lico Grande)</option>\
          <option value="Eros ETD 7200 Tit√ÉÇnio">Eros ETD 7200 Tit√ÉÇnio</option>\
          <option value="Snake SD 145 / SD 110">Snake SD 145 / SD 110</option>\
        </select>\
      </div>\
    </div>\
\
    <div class="grid-2">\
      <div>\
        <label>Formato Corneta:</label>\
        <select id="hornFormat" onchange="atualizarPalco()">\
          <option value="square">Jararaca / Quadrada</option>\
          <option value="round">Oval / Redonda</option>\
          <option value="guia">Guia de Onda Trio</option>\
        </select>\
      </div>\
      <div>\
        <label>Material Corneta:</label>\
        <select id="hornMaterial">\
          <option value="Alum√≠nio Fundido">Alum√≠nio Fundido</option>\
          <option value="Pl√ÉÅstico ABS Injetado">Pl√ÉÅstico ABS Injetado</option>\
        </select>\
      </div>\
    </div>\
\
    <div class="grid-2">\
      <div>\
        <label>Qtd Super Tweeters:</label>\
        <input type="number" id="tweeterQty" value="2" min="0" max="8">\
      </div>\
      <div>\
        <label>Modelo Tweeter:</label>\
        <select id="tweeterModel">\
          <option value="JBL Selenium ST200 / ST400">JBL ST200 / ST400 Trio</option>\
          <option value="Eros EBT 300">Eros EBT 300</option>\
          <option value="Trinyty ST 300">Trinyty / Stetsom ST</option>\
        </select>\
      </div>\
    </div>\
  </div>\
\
  <div class="card">\
    <h3>ÉøÉÆÉª Processamento de √Åudio & EQ em Tempo Real</h3>\
    <label>Volume Master:</label>\
    <input type="range" id="volumeControl" min="0" max="1" step="0.01" value="0.8" oninput="alterarVolume(this.value)">\
\
    <label>Equalizador Real (Web Audio API Filter):</label>\
    <div class="eq-container">\
      <div class="eq-slider">\
        <span>GRAVE</span>\
        <input type="range" min="-20" max="20" value="0" id="eqBass" oninput="atualizarFiltrosAudio()">\
        <span id="txtBass">0 dB</span>\
      </div>\
      <div class="eq-slider">\
        <span>M√É©DIO</span>\
        <input type="range" min="-20" max="20" value="0" id="eqMid" oninput="atualizarFiltrosAudio()">\
        <span id="txtMid">0 dB</span>\
      </div>\
      <div class="eq-slider">\
        <span>AGUDO</span>\
        <input type="range" min="-20" max="20" value="0" id="eqHigh" oninput="atualizarFiltrosAudio()">\
        <span id="txtHigh">0 dB</span>\
      </div>\
    </div>\
\
    <button class="btn-xtreme" id="btnXtreme" onclick="toggleBassXtreme()">ÉøÉ¥• BASS XTREME: DESATIVADO</button>\
  </div>\
\
  <div class="card">\
    <h3>ÉøÉ≥ª Player de M√∫sicas (Selecione seus √ÉÅudios)</h3>\
    <label>Selecionar M√∫sicas (.mp3 / .wav):</label>\
    <input type="file" id="audioFiles" multiple accept="audio/*" onchange="carregarPlaylist(event)">\
\
    <div style="margin-top: 8px; font-size: 11px; color: var(--neon-cyan);" id="tocandoAgora">Nenhum √ÉÅudio em reprodu√ß√£o</div>\
    \
    <audio id="audioPlayer" style="width: 100%; margin-top: 8px;" controls crossorigin="anonymous"></audio>\
\
    <div class="controls-row">\
      <button onclick="musicaAnterior()">‚ÉØÆ Voltar</button>\
      <button onclick="togglePlay()">‚ÉØØ Play / Pausa</button>\
      <button onclick="proximaMusica()">Avan√ßar ‚ÉØ≠</button>\
    </div>\
\
    <div class="playlist-box" id="playlistContainer">\
      <div style="color: #64748b;">A playlist aparecer√ÉÅ aqui...</div>\
    </div>\
  </div>\
\
  <button class="btn-main" onclick="gerarProjeto()">‚É∫ÉÅ GERAR RELAT√É≥RIO COMPLETO E CALCULADO</button>\
\
  <div class="card" style="margin-top: 14px;">\
    <h3>ÉøÉ≥É™ Relat√≥rio T√©cnico, DSP & El√©trica</h3>\
    <textarea id="relatorioOutput" readonly placeholder="Clique no bot√£o acima para compilar o relat√≥rio completo do som..."></textarea>\
  </div>\
\
  <script>\
    let playlist = [];\
    let currentIndex = 0;\
    let isXtremeActive = false;\
\
    // WEB AUDIO API ENGINE\
    const audio = document.getElementById('audioPlayer');\
    let audioCtx, source, bassFilter, midFilter, highFilter, gainNode;\
    let isAudioSetup = false;\
\
    function initWebAudio() {\
      if (isAudioSetup) return;\
      \
      const AudioContext = window.AudioContext || window.webkitAudioContext;\
      audioCtx = new AudioContext();\
\
      source = audioCtx.createMediaElementSource(audio);\
\
      // Filtro de Grave (Lowshelf 80Hz)\
      bassFilter = audioCtx.createBiquadFilter();\
      bassFilter.type = 'lowshelf';\
      bassFilter.frequency.value = 80;\
\
      // Filtro de M√©dio (Peaking 1000Hz)\
      midFilter = audioCtx.createBiquadFilter();\
      midFilter.type = 'peaking';\
      midFilter.frequency.value = 1000;\
      midFilter.Q.value = 1.0;\
\
      // Filtro de Agudo (Highshelf 6000Hz)\
      highFilter = audioCtx.createBiquadFilter();\
      highFilter.type = 'highshelf';\
      highFilter.frequency.value = 6000;\
\
      // Ganho Geral\
      gainNode = audioCtx.createGain();\
\
      // Cadeia de Conex√£o: Audio -> Bass -> Mid -> High -> Gain -> Speakers\
      source.connect(bassFilter);\
      bassFilter.connect(midFilter);\
      midFilter.connect(highFilter);\
      highFilter.connect(gainNode);\
      gainNode.connect(audioCtx.destination);\
\
      isAudioSetup = true;\
    }\
\
    function atualizarFiltrosAudio() {\
      if (!isAudioSetup) initWebAudio();\
\
      const valBass = parseFloat(document.getElementById('eqBass').value);\
      const valMid = parseFloat(document.getElementById('eqMid').value);\
      const valHigh = parseFloat(document.getElementById('eqHigh').value);\
\
      document.getElementById('txtBass').innerText = `${valBass} dB`;\
      document.getElementById('txtMid').innerText = `${valMid} dB`;\
      document.getElementById('txtHigh').innerText = `${valHigh} dB`;\
\
      // Aplica o ganho extra do Xtreme caso ativado\
      const xtremeExtra = isXtremeActive ? 14 : 0;\
      bassFilter.gain.value = valBass + xtremeExtra;\
      midFilter.gain.value = valMid;\
      highFilter.gain.value = valHigh;\
    }\
\
    function toggleBassXtreme() {\
      isXtremeActive = !isXtremeActive;\
      const btn = document.getElementById('btnXtreme');\
      if (isXtremeActive) {\
        btn.classList.add('active');\
        btn.innerText = 'ÉøÉ¥• BASS XTREME: ATIVADO (+14dB SUBGUTURAL)';\
      } else {\
        btn.classList.remove('active');\
        btn.innerText = 'ÉøÉ¥• BASS XTREME: DESATIVADO';\
      }\
      atualizarFiltrosAudio();\
      atualizarEfeitosVisuais();\
    }\
\
    function alterarVolume(val) {\
      audio.volume = val;\
    }\
\
    function carregarPlaylist(event) {\
      const files = event.target.files;\
      if (!files.length) return;\
      \
      playlist = Array.from(files);\
      currentIndex = 0;\
      renderPlaylist();\
      tocarMusica(currentIndex);\
    }\
\
    function renderPlaylist() {\
      const container = document.getElementById('playlistContainer');\
      container.innerHTML = '';\
      playlist.forEach((file, index) => {\
        const item = document.createElement('div');\
        item.className = 'playlist-item' + (index === currentIndex ? ' ativo' : '');\
        item.innerText = `${index + 1}. ${file.name}`;\
        item.onclick = () => tocarMusica(index);\
        container.appendChild(item);\
      });\
    }\
\
    function tocarMusica(index) {\
      if (index < 0 || index >= playlist.length) return;\
      currentIndex = index;\
      const file = playlist[currentIndex];\
      audio.src = URL.createObjectURL(file);\
      \
      if (audioCtx && audioCtx.state === 'suspended') {\
        audioCtx.resume();\
      }\
\
      audio.play();\
      document.getElementById('tocandoAgora').innerText = `Tocando (${currentIndex + 1}/${playlist.length}): ${file.name}`;\
      renderPlaylist();\
    }\
\
    function togglePlay() {\
      if (!isAudioSetup) initWebAudio();\
      if (audioCtx && audioCtx.state === 'suspended') audioCtx.resume();\
\
      if (audio.paused) audio.play();\
      else audio.pause();\
    }\
\
    function proximaMusica() {\
      if (currentIndex + 1 < playlist.length) tocarMusica(currentIndex + 1);\
    }\
\
    function musicaAnterior() {\
      if (currentIndex - 1 >= 0) tocarMusica(currentIndex - 1);\
    }\
\
    function atualizarEfeitosVisuais() {\
      const woofers = document.querySelectorAll('.woofer-icon');\
      const palco = document.getElementById('palcoVirtual');\
      const volts = document.getElementById('voltsDisplay');\
      const alerta = document.getElementById('alertaDisplay');\
\
      if (!audio.paused) {\
        palco.classList.add('led-active');\
        woofers.forEach(w => {\
          w.classList.remove('vibrando', 'xtreme-pulse');\
          if (isXtremeActive) w.classList.add('xtreme-pulse');\
          else w.classList.add('vibrando');\
        });\
\
        if (isXtremeActive) {\
          volts.innerText = '9.8 V';\
          volts.style.color = '#ff0055';\
          alerta.innerText = 'ÉøÉ∫® ALERTA MAX: BASS XTREME DRENANDO BARRAMENTO!';\
        } else {\
          volts.innerText = '10.8 V';\
          volts.style.color = '#ffcc00';\
          alerta.innerText = '‚É∫ÉÄÔ∏ÉØ BASS DROP: QUEDA DE VOLTAGEM NORMAL EM PICO';\
        }\
      } else {\
        palco.classList.remove('led-active');\
        woofers.forEach(w => w.classList.remove('vibrando', 'xtreme-pulse'));\
        volts.innerText = '12.6 V';\
        volts.style.color = '#00f0ff';\
        alerta.innerText = 'SISTEMA EM REPOUSO / EST√ÅVEL';\
      }\
    }\
\
    audio.onplay = () => {\
      if (!isAudioSetup) initWebAudio();\
      atualizarEfeitosVisuais();\
    };\
\
    audio.onpause = () => atualizarEfeitosVisuais();\
    audio.onended = () => proximaMusica();\
\
    function atualizarPalco() {\
      const qty = parseInt(document.getElementById('wooferQty').value) || 2;\
      const driverQty = parseInt(document.getElementById('driverQty').value) || 2;\
      const format = document.getElementById('hornFormat').value;\
      const palco = document.getElementById('palcoVirtual');\
      palco.innerHTML = '';\
\
      for(let i = 0; i < driverQty; i++) {\
        const box = document.createElement('div');\
        box.className = 'equip-box';\
        const driver = document.createElement('div');\
        driver.className = `driver-icon driver-${format === 'square' ? 'quadrada' : 'redonda'}`;\
        driver.innerText = 'DRIVER';\
        box.appendChild(driver);\
        palco.appendChild(box);\
      }\
\
      for(let i = 0; i < qty; i++) {\
        const box = document.createElement('div');\
        box.className = 'equip-box';\
        const woofer = document.createElement('div');\
        woofer.className = 'woofer-icon';\
        box.appendChild(woofer);\
        palco.appendChild(box);\
      }\
      atualizarEfeitosVisuais();\
    }\
\
    function gerarProjeto() {\
      const dsp = document.getElementById('dspModel').value;\
      const player = document.getElementById('playerModel').value;\
      const wooferBrand = document.getElementById('wooferBrand').value;\
      const size = document.getElementById('wooferSize').value;\
      const qty = parseInt(document.getElementById('wooferQty').value) || 2;\
      const rms = parseInt(document.getElementById('wooferRms').value) || 1500;\
      const ampWoofer = document.getElementById('ampWoofer').value;\
      \
      const driverQty = parseInt(document.getElementById('driverQty').value) || 0;\
      const driverModel = document.getElementById('driverModel').value;\
      const fmt = document.getElementById('hornFormat').value;\
      const mat = document.getElementById('hornMaterial').value;\
      const tweeterQty = parseInt(document.getElementById('tweeterQty').value) || 0;\
      const tweeterModel = document.getElementById('tweeterModel').value;\
\
      const totalRmsGrave = qty * rms;\
      const totalRmsGeral = totalRmsGrave + (driverQty * 160) + (tweeterQty * 100);\
\
      const batAh = Math.round(totalRmsGeral / 18);\
      const fonteAmperes = Math.round(batAh * 0.85);\
      const cabo = totalRmsGeral <= 3500 ? '35mm¬≤' : '50mm¬≤ ou 70mm¬≤';\
      const disjuntor = totalRmsGeral <= 3500 ? '150A' : '250A a 300A';\
\
      const eqBass = document.getElementById('eqBass').value;\
      const eqMid = document.getElementById('eqMid').value;\
      const eqHigh = document.getElementById('eqHigh').value;\
\
      document.getElementById('relatorioOutput').value = \
`======================================================\
ÉøÉ¥É™ RELAT√É≥RIO COMPLETO DE MONTAGEM, REGULAGEM & EL√É©TRICA\
======================================================\
\
ÉøÉÆÉª 1. UNIDADE CENTRAL & PROCESSAMENTO DSP:\
‚ÄÉÇ Processador Principal: ${dsp}\
‚ÄÉÇ Central Multim√≠dia / Player: ${player}\
‚ÄÉÇ Ajuste de EQ Real Aplicado: Grave: ${eqBass}dB | M√©dio: ${eqMid}dB | Agudo: ${eqHigh}dB\
‚ÄÉÇ Modo Bass Xtreme: ${isXtremeActive ? 'ATIVADO (+14dB Subgutural)' : 'DESATIVADO'}\
\
ÉøÉ¥É™ 2. BASS / SUBWOOFERS & AMPLIFICA√Éß√É£O:\
‚ÄÉÇ Falantes: ${qty}x ${wooferBrand} de ${size}" (${rms}W RMS por unidade)\
‚ÄÉÇ Pot√™ncia Nominal do Set de Grave: ${totalRmsGrave}W RMS\
‚ÄÉÇ Amplificador Dedicado: ${ampWoofer}\
\
ÉøÉ≥ÉÇ 3. VOZ, CORNETAS & ALTAS FREQU√É™NCIAS:\
‚ÄÉÇ Drivers de Compress√£o: ${driverQty}x ${driverModel}\
‚ÄÉÇ Acoplamento das Cornetas: Formato ${fmt} fabricado em ${mat}\
‚ÄÉÇ Agudos Extremos: ${tweeterQty}x ${tweeterModel}\
\
ÉøÉÆÉª 4. ALINHAMENTO DE CORTES DSP (CROSSOVER):\
‚ÄÉÇ VIA 1 - Grave/Sub (${size}"): HPF 40Hz (BT24) | LPF 160Hz (BT24)\
‚ÄÉÇ VIA 2 - M√©dio Grave (MG/8"/10"): HPF 160Hz (BT24) | LPF 1200Hz (BT24)\
‚ÄÉÇ VIA 3 - Drivers Cornetas: HPF 1200Hz (BT24) | LPF 6000Hz (BT24)\
‚ÄÉÇ VIA 4 - Super Tweeters: HPF 6000Hz (BT24) | LPF 20000Hz (BT24)\
\
‚É∫ÉÅ 5. DIMENSIONAMENTO EL√É©TRICO & BARRAMENTO COBRE (~${totalRmsGeral}W RMS):\
‚ÄÉÇ Bateria Auxiliar M√≠nima: ${batAh} Ah (Moura Clean / AGM / L√≠tio)\
‚ÄÉÇ Fonte Carregadora Indicada: ${fonteAmperes}A (Usina / JFA / Stetsom)\
‚ÄÉÇ Cabeamento de Alimenta√ß√£o: ${cabo} Cobre Puro\
‚ÄÉÇ Prote√ß√£o de Barramento: Disjuntor Din Reinicializ√ÉÅvel de ${disjuntor}`;\
    }\
\
    // Inicializa√ß√£o da interface\
    atualizarPalco();\
  </script>\
</body>\
</html>\
EOF\

: 1786204702:0;python -m http.server 8080\

: 1786205149:0;cat << 'EOF' > index.html\
<!DOCTYPE html>\
<html lang="pt-BR">\
<head>\
  <meta charset="UTF-8">\
  <meta name="viewport" content="width=device-width, initial-scale=1.0">\
  <title>Simulador de Som Automotivo Master PRO - Ultra Realista</title>\
  <style>\
    :root {\
      --bg-dark: #050811;\
      --card-bg: #0d1527;\
      --border-color: #1e293b;\
      --accent-red: #ff0055;\
      --neon-cyan: #00f0ff;\
      --neon-yellow: #ffcc00;\
      --neon-green: #00ff66;\
      --led-color: #00f0ff;\
      --text-main: #f8fafc;\
    }\
\
    body {\
      background-color: var(--bg-dark);\
      color: var(--text-main);\
      font-family: 'Segoe UI', Roboto, sans-serif;\
      margin: 0;\
      padding: 12px;\
      padding-bottom: 50px;\
      transition: background 0.3s;\
    }\
\
    /* TEMAS DE LUZES / BACKGROUND */\
    body.theme-cyber { --bg-dark: #030014; --led-color: #ff0055; }\
    body.theme-neon { --bg-dark: #00120b; --led-color: #00ff66; }\
    body.theme-electro { --bg-dark: #000c18; --led-color: #00f0ff; }\
    body.theme-gold { --bg-dark: #140d00; --led-color: #ffcc00; }\
\
    h1 {\
      text-align: center;\
      color: var(--accent-red);\
      font-size: 20px;\
      margin-bottom: 12px;\
      text-transform: uppercase;\
      letter-spacing: 1.5px;\
      text-shadow: 0 0 12px var(--led-color);\
    }\
\
    .card {\
      background: var(--card-bg);\
      border: 1px solid var(--border-color);\
      border-left: 4px solid var(--accent-red);\
      border-radius: 8px;\
      padding: 12px;\
      margin-bottom: 14px;\
      box-shadow: 0 4px 15px rgba(0,0,0,0.6);\
    }\
\
    .card h3 {\
      margin-top: 0;\
      font-size: 13px;\
      color: var(--neon-cyan);\
      text-transform: uppercase;\
      border-bottom: 1px solid var(--border-color);\
      padding-bottom: 6px;\
    }\
\
    /* VOLT√É≠METRO REALISTA */\
    .voltimetro-card {\
      background: radial-gradient(circle, #111 0%, #000 100%);\
      border: 2px solid var(--accent-red);\
      text-align: center;\
      border-radius: 10px;\
      padding: 12px;\
      margin-bottom: 14px;\
      box-shadow: 0 0 20px rgba(255, 0, 85, 0.2);\
    }\
\
    .voltimetro-valor {\
      font-size: 40px;\
      font-weight: 900;\
      color: #ff2a2a;\
      text-shadow: 0 0 20px #ff0000;\
      font-family: monospace;\
      margin: 4px 0;\
    }\
\
    .alerta-bass {\
      color: var(--neon-yellow);\
      font-size: 11px;\
      font-weight: bold;\
    }\
\
    label {\
      display: block;\
      font-size: 11px;\
      color: #94a3b8;\
      margin-top: 8px;\
      text-transform: uppercase;\
      font-weight: 600;\
    }\
\
    select, input[type="text"], input[type="number"], input[type="range"] {\
      width: 100%;\
      padding: 8px;\
      margin-top: 4px;\
      background: #020617;\
      border: 1px solid #334155;\
      color: #fff;\
      border-radius: 6px;\
      box-sizing: border-box;\
      font-size: 12px;\
    }\
\
    .grid-2 { display: flex; gap: 8px; }\
    .grid-2 > div { flex: 1; }\
\
    /* PALCO REALISTA COM CAIXA DE SOM & DUTOS */\
    .palco {\
      background: #000;\
      border: 3px solid var(--led-color);\
      border-radius: 12px;\
      padding: 15px;\
      text-align: center;\
      min-height: 220px;\
      display: flex;\
      flex-direction: column;\
      align-items: center;\
      justify-content: center;\
      gap: 15px;\
      position: relative;\
      box-shadow: 0 0 15px var(--led-color);\
      transition: box-shadow 0.2s;\
    }\
\
    .caixa-acustica {\
      background: linear-gradient(135deg, #18181b 0%, #09090b 100%);\
      border: 3px solid #27272a;\
      border-radius: 10px;\
      padding: 15px;\
      width: 95%;\
      box-sizing: border-box;\
      display: flex;\
      flex-direction: column;\
      align-items: center;\
      gap: 12px;\
      box-shadow: inset 0 0 20px #000, 0 8px 25px rgba(0,0,0,0.8);\
    }\
\
    .painel-cornetas {\
      display: flex;\
      flex-wrap: wrap;\
      justify-content: center;\
      gap: 10px;\
      width: 100%;\
    }\
\
    .painel-woofers {\
      display: flex;\
      flex-wrap: wrap;\
      justify-content: center;\
      gap: 12px;\
      width: 100%;\
    }\
\
    /* DUTOS DA CAIXA */\
    .painel-dutos {\
      display: flex;\
      justify-content: center;\
      gap: 15px;\
      width: 100%;\
      margin-top: 5px;\
    }\
\
    .duto-redondo {\
      width: 35px;\
      height: 35px;\
      border-radius: 50%;\
      background: radial-gradient(circle, #000 40%, #18181b 80%, #3f3f46 100%);\
      border: 3px solid #09090b;\
      box-shadow: inset 0 0 8px #000;\
    }\
\
    .duto-quadrado {\
      width: 80%;\
      height: 18px;\
      background: linear-gradient(180deg, #000 0%, #18181b 100%);\
      border: 2px solid #27272a;\
      border-radius: 3px;\
      box-shadow: inset 0 0 10px #000;\
    }\
\
    /* VISUAL REALISTA DOS FALANTES */\
    .real-woofer {\
      width: 75px;\
      height: 75px;\
      border-radius: 50%;\
      background: radial-gradient(circle, #18181b 20%, #09090b 50%, #27272a 90%, #000 100%);\
      border: 5px solid #3f3f46;\
      box-shadow: inset 0 0 12px #000, 0 4px 10px #000;\
      position: relative;\
      display: flex;\
      align-items: center;\
      justify-content: center;\
      font-size: 8px;\
      font-weight: 900;\
      color: #a1a1aa;\
      text-transform: uppercase;\
      transition: transform 0.05s ease-in-out;\
    }\
\
    .real-woofer::after {\
      content: '';\
      width: 25px;\
      height: 25px;\
      border-radius: 50%;\
      background: radial-gradient(circle, #3f3f46 0%, #18181b 100%);\
      border: 1px solid #52525b;\
    }\
\
    .real-driver {\
      width: 50px;\
      height: 50px;\
      background: linear-gradient(145deg, #27272a, #09090b);\
      border: 2px solid #a1a1aa;\
      color: var(--neon-cyan);\
      font-size: 8px;\
      font-weight: bold;\
      display: flex;\
      align-items: center;\
      justify-content: center;\
      text-align: center;\
      box-shadow: 0 3px 8px #000;\
    }\
\
    .driver-square { border-radius: 4px; }\
    .driver-round { border-radius: 50%; }\
    .driver-guia { width: 90px; height: 35px; border-radius: 4px; }\
\
    /* ANIMA√Éß√É£O DE PULSO E BASS XTREME */\
    .real-woofer.vibrando { animation: pulsoReal 0.1s infinite alternate; }\
    .real-woofer.xtreme-pulse { animation: pulsoXtremeReal 0.07s infinite alternate; }\
\
    @keyframes pulsoReal {\
      0% { transform: scale(1); }\
      100% { transform: scale(1.12); box-shadow: 0 0 15px var(--neon-cyan); }\
    }\
\
    @keyframes pulsoXtremeReal {\
      0% { transform: scale(1.02); }\
      100% { transform: scale(1.25); box-shadow: 0 0 25px var(--accent-red); }\
    }\
\
    /* RACK DE APARELHOS VISUAL */\
    .rack-aparelhos {\
      width: 100%;\
      display: flex;\
      flex-direction: column;\
      gap: 8px;\
      margin-top: 10px;\
    }\
\
    .aparelho-item {\
      background: #09090b;\
      border: 1px solid #27272a;\
      border-radius: 6px;\
      padding: 8px 12px;\
      display: flex;\
      justify-content: space-between;\
      align-items: center;\
      box-shadow: inset 0 0 10px #000;\
    }\
\
    .aparelho-nome {\
      font-size: 11px;\
      font-weight: bold;\
      color: #f4f4f5;\
    }\
\
    .aparelho-tela {\
      background: #000;\
      border: 1px solid var(--neon-cyan);\
      color: var(--neon-cyan);\
      font-family: monospace;\
      font-size: 9px;\
      padding: 3px 8px;\
      border-radius: 3px;\
      box-shadow: 0 0 5px var(--neon-cyan);\
    }\
\
    /* EQUALIZADOR E CONTROLES */\
    .eq-container {\
      display: flex;\
      justify-content: space-around;\
      gap: 10px;\
      margin-top: 12px;\
      background: #020617;\
      padding: 12px;\
      border-radius: 6px;\
    }\
\
    .eq-slider {\
      display: flex;\
      flex-direction: column;\
      align-items: center;\
      font-size: 10px;\
      color: #94a3b8;\
    }\
\
    .eq-slider input[type="range"] {\
      writing-mode: bt-lr;\
      -webkit-appearance: slider-vertical;\
      width: 12px;\
      height: 90px;\
      padding: 0;\
      margin: 8px 0;\
    }\
\
    .btn-xtreme {\
      width: 100%;\
      background: #1e293b;\
      color: #888;\
      border: 2px solid #334155;\
      padding: 10px;\
      font-weight: 900;\
      border-radius: 6px;\
      font-size: 13px;\
      cursor: pointer;\
      margin-top: 10px;\
      text-transform: uppercase;\
      letter-spacing: 1px;\
      transition: all 0.2s;\
    }\
\
    .btn-xtreme.active {\
      background: linear-gradient(90deg, #ff0055, #ff5500);\
      color: #fff;\
      border-color: #ff0055;\
      box-shadow: 0 0 20px rgba(255, 0, 85, 0.8);\
    }\
\
    button.btn-main {\
      width: 100%;\
      background: linear-gradient(90deg, var(--accent-red), #ff5500);\
      color: white;\
      border: none;\
      padding: 14px;\
      font-weight: bold;\
      border-radius: 8px;\
      font-size: 14px;\
      cursor: pointer;\
      margin-top: 10px;\
      text-transform: uppercase;\
      letter-spacing: 1px;\
      box-shadow: 0 4px 15px rgba(255, 0, 85, 0.4);\
    }\
\
    .playlist-box {\
      background: #020617;\
      border: 1px solid #1e293b;\
      border-radius: 6px;\
      padding: 8px;\
      max-height: 120px;\
      overflow-y: auto;\
      font-size: 11px;\
      margin-top: 8px;\
    }\
\
    .playlist-item {\
      padding: 6px;\
      border-bottom: 1px solid #0f172a;\
      cursor: pointer;\
      color: #94a3b8;\
    }\
\
    .playlist-item.ativo {\
      color: #fff;\
      background: var(--accent-red);\
      font-weight: bold;\
      border-radius: 4px;\
    }\
\
    .controls-row {\
      display: flex;\
      gap: 6px;\
      margin-top: 8px;\
    }\
\
    .controls-row button {\
      flex: 1;\
      padding: 10px;\
      background: #0f172a;\
      border: 1px solid var(--neon-cyan);\
      color: #fff;\
      border-radius: 6px;\
      font-weight: bold;\
      font-size: 11px;\
      cursor: pointer;\
    }\
\
    textarea {\
      width: 100%;\
      height: 220px;\
      background: #020617;\
      color: #00ffcc;\
      border: 1px solid var(--neon-cyan);\
      border-radius: 6px;\
      padding: 10px;\
      font-family: monospace;\
      font-size: 11px;\
      box-sizing: border-box;\
      margin-top: 8px;\
    }\
  </style>\
</head>\
<body class="theme-electro">\
\
  <h1>ÉøÉ¥É™ SIMULADOR MASTER PRO REALISTA</h1>\
\
  <div class="voltimetro-card">\
    <div style="font-size: 10px; color: #aaa;">‚É∫ÉÅ MONITORA√Éß√É£O DE TENS√É£O DO BARRAMENTO</div>\
    <div class="voltimetro-valor" id="voltsDisplay">12.6 V</div>\
    <div class="alerta-bass" id="alertaDisplay">SISTEMA EM REPOUSO / EST√ÅVEL</div>\
  </div>\
\
  <div class="card">\
    <h3>ÉøÉÆ® Estilo do Rack & Ilumina√ß√£o LED</h3>\
    <label>Tema de Luzes:</label>\
    <select id="themeSelect" onchange="mudarTema(this.value)">\
      <option value="theme-electro" selected>Cyan Neon / Electro</option>\
      <option value="theme-cyber">Cyberpunk Red / Pink</option>\
      <option value="theme-neon">Green Acid / Trio</option>\
      <option value="theme-gold">Gold Power / Amarelo</option>\
    </select>\
  </div>\
\
  <div class="card">\
    <h3>ÉøÉ≥± Visualizador da Caixa Ac√∫stica & Rack de Aparelhos</h3>\
    <div class="palco" id="palcoVirtual">\
      <div class="caixa-acustica" id="caixaAcustica">\
        <div class="painel-cornetas" id="painelCornetas"></div>\
        <div class="painel-woofers" id="painelWoofers"></div>\
        <div class="painel-dutos" id="painelDutos"></div>\
      </div>\
    </div>\
    \
    <label style="margin-top: 12px;">Rack do Processador & Players Realistas:</label>\
    <div class="rack-aparelhos" id="rackAparelhos"></div>\
  </div>\
\
  <div class="card">\
    <h3>ÉøÉ≥¶ Projeto da Caixa Ac√∫stica & Dutos</h3>\
    <div class="grid-2">\
      <div>\
        <label>Tipo de Duto:</label>\
        <select id="dutoType" onchange="atualizarPalco()">\
          <option value="quadrado">R√©gua / Retangular</option>\
          <option value="redondo" selected>Redondo (4 Polegadas)</option>\
        </select>\
      </div>\
      <div>\
        <label>Quantidade Dutos Redondos:</label>\
        <input type="number" id="dutoQty" value="2" min="1" max="6" onchange="atualizarPalco()">\
      </div>\
    </div>\
  </div>\
\
  <div class="card">\
    <h3>1. Central, DSP & Processador</h3>\
    <label>Processador de √Åudio (DSP):</label>\
    <select id="dspModel" onchange="atualizarRack()">\
      <option value="Stetsom STX2448 Digital">Stetsom STX2448 / STX2848 Digital</option>\
      <option value="Expert PX-2 PRO Bluetooth">Expert Electronics PX-1 / PX-2 PRO</option>\
      <option value="JFA X5 Crossover 4 Vias">JFA X5 Crossover Anal√≥gico</option>\
      <option value="Taramps Pro 2.4S DSP">Taramps Pro 2.4S DSP</option>\
    </select>\
\
    <label>Player Central:</label>\
    <select id="playerModel" onchange="atualizarRack()">\
      <option value="Pioneer Golfinho MVH-X3000BR">Pioneer MVH-X3000BR / Golfinho</option>\
      <option value="Central Multim√≠dia Android PRO">Central Multim√≠dia Android PRO</option>\
      <option value="Expert Central + Controle Longa">Expert Central + Controle Longa Dist√ÉÇncia</option>\
    </select>\
  </div>\
\
  <div class="card">\
    <h3>2. Grave / Woofers / Subwoofers</h3>\
    <label>Marca e Modelo do Falante:</label>\
    <select id="wooferBrand" onchange="atualizarPalco()">\
      <option value="Eros Target Bass">Eros Target Bass 3.0K / 4.5K</option>\
      <option value="Eros Hammer">Eros Hammer 5.2K (Grave Seco)</option>\
      <option value="Triton Shocker">Triton Shocker / Vulcano 3.8K</option>\
      <option value="Hard Power HP">Hard Power HP 1850 / 2500</option>\
      <option value="JBL Vulcano/Tornado">JBL Vulcano 3.8 / Tornado 5600</option>\
      <option value="7Driver Bass">7Driver Bass 3K0 / Thunder</option>\
    </select>\
\
    <div class="grid-2">\
      <div>\
        <label>Tamanho:</label>\
        <select id="wooferSize" onchange="atualizarPalco()">\
          <option value="12">12 Inches (Seco)</option>\
          <option value="15" selected>15 Inches (Misto)</option>\
          <option value="18">18 Inches (Subgrave)</option>\
        </select>\
      </div>\
      <div>\
        <label>Qtd Woofers:</label>\
        <input type="number" id="wooferQty" value="2" min="1" max="8" onchange="atualizarPalco()">\
      </div>\
    </div>\
\
    <div class="grid-2">\
      <div>\
        <label>RMS por Unidade:</label>\
        <input type="number" id="wooferRms" value="1500">\
      </div>\
      <div>\
        <label>M√≥dulo de Grave:</label>\
        <select id="ampWoofer">\
          <option value="Taramps MD 3000.1 / Smart 3">Taramps MD 3000.1 / Smart 3</option>\
          <option value="Taramps HD 8000 / MD 5000">Taramps HD 8000 / MD 5000</option>\
          <option value="Stetsom Vulcan 3000 / 5000">Stetsom Vulcan 3000 / 5000</option>\
          <option value="Soundigital 3000.1 EVO">Soundigital 3000.1 EVO</option>\
          <option value="Banda Viking 5000">Banda Viking 5000</option>\
        </select>\
      </div>\
    </div>\
  </div>\
\
  <div class="card">\
    <h3>3. M√©dio Grave, Drivers & Cornetas</h3>\
    <div class="grid-2">\
      <div>\
        <label>Qtd Drivers:</label>\
        <input type="number" id="driverQty" value="2" min="0" max="8" onchange="atualizarPalco()">\
      </div>\
      <div>\
        <label>Modelo Driver:</label>\
        <select id="driverModel" onchange="atualizarPalco()">\
          <option value="JBL D250X / D250 Trio">JBL D250X / D250 Trio</option>\
          <option value="JBL D405 / D305 Fen√≥lico">JBL D405 / D305 (Fen√≥lico Grande)</option>\
          <option value="Eros ETD 7200 Tit√ÉÇnio">Eros ETD 7200 Tit√ÉÇnio</option>\
          <option value="Snake SD 145 / SD 110">Snake SD 145 / SD 110</option>\
        </select>\
      </div>\
    </div>\
\
    <div class="grid-2">\
      <div>\
        <label>Formato Corneta:</label>\
        <select id="hornFormat" onchange="atualizarPalco()">\
          <option value="square">Jararaca / Quadrada</option>\
          <option value="round">Redonda / Oval</option>\
          <option value="guia">Guia de Onda Trio</option>\
        </select>\
      </div>\
      <div>\
        <label>Material Corneta:</label>\
        <select id="hornMaterial">\
          <option value="Alum√≠nio Fundido">Alum√≠nio Fundido</option>\
          <option value="Pl√ÉÅstico ABS Injetado">Pl√ÉÅstico ABS Injetado</option>\
        </select>\
      </div>\
    </div>\
  </div>\
\
  <div class="card">\
    <h3>ÉøÉÆÉª Processamento de √Åudio & EQ Real</h3>\
    <label>Volume Master:</label>\
    <input type="range" id="volumeControl" min="0" max="1" step="0.01" value="0.8" oninput="alterarVolume(this.value)">\
\
    <label>Equalizador Gr√ÉÅfico (Web Audio API):</label>\
    <div class="eq-container">\
      <div class="eq-slider">\
        <span>GRAVE</span>\
        <input type="range" min="-20" max="20" value="0" id="eqBass" oninput="atualizarFiltrosAudio()">\
        <span id="txtBass">0 dB</span>\
      </div>\
      <div class="eq-slider">\
        <span>M√É©DIO</span>\
        <input type="range" min="-20" max="20" value="0" id="eqMid" oninput="atualizarFiltrosAudio()">\
        <span id="txtMid">0 dB</span>\
      </div>\
      <div class="eq-slider">\
        <span>AGUDO</span>\
        <input type="range" min="-20" max="20" value="0" id="eqHigh" oninput="atualizarFiltrosAudio()">\
        <span id="txtHigh">0 dB</span>\
      </div>\
    </div>\
\
    <button class="btn-xtreme" id="btnXtreme" onclick="toggleBassXtreme()">ÉøÉ¥• BASS XTREME: DESATIVADO</button>\
  </div>\
\
  <div class="card">\
    <h3>ÉøÉ≥ª M√∫sicas do Seu Celular</h3>\
    <label>Selecionar M√∫sicas (.mp3 / .wav):</label>\
    <input type="file" id="audioFiles" multiple accept="audio/*" onchange="carregarPlaylist(event)">\
\
    <div style="margin-top: 8px; font-size: 11px; color: var(--neon-cyan);" id="tocandoAgora">Nenhum √ÉÅudio em reprodu√ß√£o</div>\
    \
    <audio id="audioPlayer" style="width: 100%; margin-top: 8px;" controls crossorigin="anonymous"></audio>\
\
    <div class="controls-row">\
      <button onclick="musicaAnterior()">‚ÉØÆ Voltar</button>\
      <button onclick="togglePlay()">‚ÉØØ Play / Pausa</button>\
      <button onclick="proximaMusica()">Avan√ßar ‚ÉØ≠</button>\
    </div>\
\
    <div class="playlist-box" id="playlistContainer">\
      <div style="color: #64748b;">A playlist aparecer√ÉÅ aqui...</div>\
    </div>\
  </div>\
\
  <button class="btn-main" onclick="gerarProjeto()">‚É∫ÉÅ GERAR RELAT√É≥RIO COMPLETO E CALCULADO</button>\
\
  <div class="card" style="margin-top: 14px;">\
    <h3>ÉøÉ≥É™ Relat√≥rio T√©cnico, DSP & El√©trica</h3>\
    <textarea id="relatorioOutput" readonly placeholder="Clique no bot√£o acima para compilar o relat√≥rio completo..."></textarea>\
  </div>\
\
  <script>\
    let playlist = [];\
    let currentIndex = 0;\
    let isXtremeActive = false;\
\
    // AUDIO API ENGINE\
    const audio = document.getElementById('audioPlayer');\
    let audioCtx, source, bassFilter, midFilter, highFilter, gainNode;\
    let isAudioSetup = false;\
\
    function initWebAudio() {\
      if (isAudioSetup) return;\
      const AudioContext = window.AudioContext || window.webkitAudioContext;\
      audioCtx = new AudioContext();\
\
      source = audioCtx.createMediaElementSource(audio);\
\
      bassFilter = audioCtx.createBiquadFilter();\
      bassFilter.type = 'lowshelf';\
      bassFilter.frequency.value = 80;\
\
      midFilter = audioCtx.createBiquadFilter();\
      midFilter.type = 'peaking';\
      midFilter.frequency.value = 1000;\
      midFilter.Q.value = 1.0;\
\
      highFilter = audioCtx.createBiquadFilter();\
      highFilter.type = 'highshelf';\
      highFilter.frequency.value = 6000;\
\
      gainNode = audioCtx.createGain();\
\
      source.connect(bassFilter);\
      bassFilter.connect(midFilter);\
      midFilter.connect(highFilter);\
      highFilter.connect(gainNode);\
      gainNode.connect(audioCtx.destination);\
\
      isAudioSetup = true;\
    }\
\
    function mudarTema(tema) {\
      document.body.className = tema;\
    }\
\
    function atualizarFiltrosAudio() {\
      if (!isAudioSetup) initWebAudio();\
\
      const valBass = parseFloat(document.getElementById('eqBass').value);\
      const valMid = parseFloat(document.getElementById('eqMid').value);\
      const valHigh = parseFloat(document.getElementById('eqHigh').value);\
\
      document.getElementById('txtBass').innerText = `${valBass} dB`;\
      document.getElementById('txtMid').innerText = `${valMid} dB`;\
      document.getElementById('txtHigh').innerText = `${valHigh} dB`;\
\
      const xtremeExtra = isXtremeActive ? 15 : 0;\
      bassFilter.gain.value = valBass + xtremeExtra;\
      midFilter.gain.value = valMid;\
      highFilter.gain.value = valHigh;\
    }\
\
    function toggleBassXtreme() {\
      isXtremeActive = !isXtremeActive;\
      const btn = document.getElementById('btnXtreme');\
      if (isXtremeActive) {\
        btn.classList.add('active');\
        btn.innerText = 'ÉøÉ¥• BASS XTREME: ATIVADO (+15dB SUBGUTURAL)';\
      } else {\
        btn.classList.remove('active');\
        btn.innerText = 'ÉøÉ¥• BASS XTREME: DESATIVADO';\
      }\
      atualizarFiltrosAudio();\
      atualizarEfeitosVisuais();\
    }\
\
    function alterarVolume(val) { audio.volume = val; }\
\
    function carregarPlaylist(event) {\
      const files = event.target.files;\
      if (!files.length) return;\
      playlist = Array.from(files);\
      currentIndex = 0;\
      renderPlaylist();\
      tocarMusica(currentIndex);\
    }\
\
    function renderPlaylist() {\
      const container = document.getElementById('playlistContainer');\
      container.innerHTML = '';\
      playlist.forEach((file, index) => {\
        const item = document.createElement('div');\
        item.className = 'playlist-item' + (index === currentIndex ? ' ativo' : '');\
        item.innerText = `${index + 1}. ${file.name}`;\
        item.onclick = () => tocarMusica(index);\
        container.appendChild(item);\
      });\
    }\
\
    function tocarMusica(index) {\
      if (index < 0 || index >= playlist.length) return;\
      currentIndex = index;\
      const file = playlist[currentIndex];\
      audio.src = URL.createObjectURL(file);\
      if (audioCtx && audioCtx.state === 'suspended') audioCtx.resume();\
      audio.play();\
      document.getElementById('tocandoAgora').innerText = `Tocando (${currentIndex + 1}/${playlist.length}): ${file.name}`;\
      renderPlaylist();\
    }\
\
    function togglePlay() {\
      if (!isAudioSetup) initWebAudio();\
      if (audioCtx && audioCtx.state === 'suspended') audioCtx.resume();\
      if (audio.paused) audio.play();\
      else audio.pause();\
    }\
\
    function proximaMusica() { if (currentIndex + 1 < playlist.length) tocarMusica(currentIndex + 1); }\
    function musicaAnterior() { if (currentIndex - 1 >= 0) tocarMusica(currentIndex - 1); }\
\
    function atualizarEfeitosVisuais() {\
      const woofers = document.querySelectorAll('.real-woofer');\
      const volts = document.getElementById('voltsDisplay');\
      const alerta = document.getElementById('alertaDisplay');\
\
      if (!audio.paused) {\
        woofers.forEach(w => {\
          w.classList.remove('vibrando', 'xtreme-pulse');\
          if (isXtremeActive) w.classList.add('xtreme-pulse');\
          else w.classList.add('vibrando');\
        });\
\
        if (isXtremeActive) {\
          volts.innerText = '9.8 V';\
          volts.style.color = '#ff0055';\
          alerta.innerText = 'ÉøÉ∫® ALERTA MAX: BASS XTREME DRENANDO BARRAMENTO!';\
        } else {\
          volts.innerText = '10.8 V';\
          volts.style.color = '#ffcc00';\
          alerta.innerText = '‚É∫ÉÄÔ∏ÉØ BASS DROP: QUEDA DE VOLTAGEM NORMAL EM PICO';\
        }\
      } else {\
        woofers.forEach(w => w.classList.remove('vibrando', 'xtreme-pulse'));\
        volts.innerText = '12.6 V';\
        volts.style.color = '#00f0ff';\
        alerta.innerText = 'SISTEMA EM REPOUSO / EST√ÅVEL';\
      }\
    }\
\
    audio.onplay = () => {\
      if (!isAudioSetup) initWebAudio();\
      atualizarEfeitosVisuais();\
    };\
    audio.onpause = () => atualizarEfeitosVisuais();\
    audio.onended = () => proximaMusica();\
\
    function atualizarPalco() {\
      const wooferQty = parseInt(document.getElementById('wooferQty').value) || 2;\
      const wooferBrand = document.getElementById('wooferBrand').value;\
      const driverQty = parseInt(document.getElementById('driverQty').value) || 2;\
      const hornFormat = document.getElementById('hornFormat').value;\
      const dutoType = document.getElementById('dutoType').value;\
      const dutoQty = parseInt(document.getElementById('dutoQty').value) || 2;\
\
      const pCornetas = document.getElementById('painelCornetas');\
      const pWoofers = document.getElementById('painelWoofers');\
      const pDutos = document.getElementById('painelDutos');\
\
      pCornetas.innerHTML = '';\
      pWoofers.innerHTML = '';\
      pDutos.innerHTML = '';\
\
      // Renderizar Cornetas\
      for(let i = 0; i < driverQty; i++) {\
        const driver = document.createElement('div');\
        let shapeClass = 'driver-square';\
        if (hornFormat === 'round') shapeClass = 'driver-round';\
        if (hornFormat === 'guia') shapeClass = 'driver-guia';\
\
        driver.className = `real-driver ${shapeClass}`;\
        driver.innerText = 'DRIVER';\
        pCornetas.appendChild(driver);\
      }\
\
      // Renderizar Woofers Realistas\
      for(let i = 0; i < wooferQty; i++) {\
        const woofer = document.createElement('div');\
        woofer.className = 'real-woofer';\
        woofer.innerText = wooferBrand.split(' ')[0];\
        pWoofers.appendChild(woofer);\
      }\
\
      // Renderizar Dutos\
      if (dutoType === 'quadrado') {\
        const duto = document.createElement('div');\
        duto.className = 'duto-quadrado';\
        pDutos.appendChild(duto);\
      } else {\
        for(let i = 0; i < dutoQty; i++) {\
          const duto = document.createElement('div');\
          duto.className = 'duto-redondo';\
          pDutos.appendChild(duto);\
        }\
      }\
\
      atualizarRack();\
      atualizarEfeitosVisuais();\
    }\
\
    function atualizarRack() {\
      const dsp = document.getElementById('dspModel').value;\
      const player = document.getElementById('playerModel').value;\
      const rack = document.getElementById('rackAparelhos');\
\
      rack.innerHTML = `\
        <div class="aparelho-item">\
          <span class="aparelho-nome">ÉøÉÆÉª ${dsp}</span>\
          <span class="aparelho-tela">DSP 2448 OK</span>\
        </div>\
        <div class="aparelho-item">\
          <span class="aparelho-nome">ÉøÉ≥ª ${player}</span>\
          <span class="aparelho-tela">BT AUDIO</span>\
        </div>\
      `;\
    }\
\
    function gerarProjeto() {\
      const dsp = document.getElementById('dspModel').value;\
      const player = document.getElementById('playerModel').value;\
      const wooferBrand = document.getElementById('wooferBrand').value;\
      const size = document.getElementById('wooferSize').value;\
      const qty = parseInt(document.getElementById('wooferQty').value) || 2;\
      const rms = parseInt(document.getElementById('wooferRms').value) || 1500;\
      const ampWoofer = document.getElementById('ampWoofer').value;\
      const dutoType = document.getElementById('dutoType').value;\
      \
      const driverQty = parseInt(document.getElementById('driverQty').value) || 0;\
      const driverModel = document.getElementById('driverModel').value;\
      const fmt = document.getElementById('hornFormat').value;\
\
      const totalRmsGrave = qty * rms;\
      const totalRmsGeral = totalRmsGrave + (driverQty * 160);\
\
      const batAh = Math.round(totalRmsGeral / 18);\
      const fonteAmperes = Math.round(batAh * 0.85);\
\
      document.getElementById('relatorioOutput').value = \
`======================================================\
ÉøÉ¥É™ RELAT√É≥RIO COMPLETO DE MONTAGEM & EL√É©TRICA MASTER PRO\
======================================================\
\
ÉøÉ≥¶ 1. CAIXA AC√É∫STICA & DUTOS:\
‚ÄÉÇ Configura√ß√£o: ${qty}x Woofers de ${size}" (${wooferBrand})\
‚ÄÉÇ Dutos: ${dutoType === 'quadrado' ? 'Duto R√©gua / Retangular Integrado' : 'Dutos Redondos de 4"'}\
\
ÉøÉÆÉª 2. RACK DE PROCESSAMENTO & PLAYER:\
‚ÄÉÇ DSP Digital: ${dsp}\
‚ÄÉÇ Unidade Central: ${player}\
‚ÄÉÇ Modo Bass Xtreme: ${isXtremeActive ? 'ATIVADO (+15dB Subgutural)' : 'DESATIVADO'}\
\
ÉøÉ≥ÉÇ 3. CORNETAS, DRIVERS & ALTAS FREQU√É™NCIAS:\
‚ÄÉÇ Drivers: ${driverQty}x ${driverModel}\
‚ÄÉÇ Formato Corneta: ${fmt}\
\
‚É∫ÉÅ 4. EL√É©TRICA & BARRAMENTO (~${totalRmsGeral}W RMS):\
‚ÄÉÇ Bateria Auxiliar M√≠nima: ${batAh} Ah (Moura Clean / AGM / L√≠tio)\
‚ÄÉÇ Fonte Carregadora Indicada: ${fonteAmperes}A (Usina / JFA / Stetsom)`;\
    }\
\
    // Inicializa√ß√£o\
    atualizarPalco();\
  </script>\
</body>\
</html>\
EOF\

