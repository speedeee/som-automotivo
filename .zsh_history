\
    <script>\
        let tempo = 10700;\
        setInterval(() => {\
            let h = Math.floor(tempo / 3600);\
            let m = Math.floor((tempo % 3600) / 60);\
            let s = tempo % 60;\
            document.getElementById('countdown').innerText = String(h).padStart(2,'0') + ":" + String(m).padStart(2,'0') + ":" + String(s).padStart(2,'0');\
            if(tempo > 0) tempo--;\
        }, 1000);\
\
        let configuracoes = JSON.parse(localStorage.getItem('speed_config')) || {\
            nome: "SPEED STORE",\
