from rich.table import Table\
\
app = typer.Typer(help="Sua CLI Multi-ferramenta para Desenvolvedor com Log Autom√ÉÅtico")\
console = Console()\
LOG_FILE = "devbox_activity.log"\
\
def salvar_log(comando: str, conteudo: str):\
    """Escreve a sa√≠da do comando em um arquivo de log com data e hora."""\
    data_hora = datetime.now().strftime("%Y-%m-%d %H:%M:%S")\
    comentario_log = f"\n=== [LOG: {comando.upper()} | {data_hora}] ===\n{conteudo}\n"\
    \
    with open(LOG_FILE, "a", encoding="utf-8") as f:\
        f.write(comentario_log)\
    \
    console.print(f"[dim grey]‚ÉºÉ≥ Resultado salvo em '{LOG_FILE}'[/dim grey]")\
\
@app.command()\
def ip(log: bool = typer.Option(False, "--log", "-l", help="Salva o resultado no arquivo de log.")):\
    """Exibe seu IP local e p√∫blico."""\
    hostname = socket.gethostname()\
    local_ip = socket.gethostbyname(hostname)\
    \
    try:\
        public_ip = requests.get('https://api.ipify.org', timeout=5).text\
    except requests.RequestException:\
        public_ip = "N√£o foi poss√≠vel obter"\
\
    table = Table(title="Informa√ß√µes de Rede", show_header=True)\
    table.add_column("Tipo", style="cyan")\
    table.add_column("Endere√ßo IP", style="green")\
    \
    table.add_row("Local", local_ip)\
    table.add_row("P√∫blico", public_ip)\
    \
    console.print(table)\
\
    if log:\
        texto_log = f"IP Local: {local_ip}\nIP P√∫blico: {public_ip}"\
        salvar_log("ip", texto_log)\
\
@app.command()\
def port(\
    porta: int,\
    log: bool = typer.Option(False, "--log", "-l", help="Salva o resultado no arquivo de log.")\
):\
    """Verifica se uma porta espec√≠fica est√ÉÅ em uso."""\
    em_uso = False\
    resultado_texto = ""\
\
    for conn in psutil.net_connections():\
        if conn.laddr.port == porta:\
            em_uso = True\
            processo = psutil.Process(conn.pid).name() if conn.pid else "Desconhecido"\
            resultado_texto = f"Porta {porta} em USO pelo processo {processo} (PID: {conn.pid})"\
            console.print(Panel(f"Porta [bold red]{porta}[/bold red] est√ÉÅ em USO pelo processo [bold yellow]{processo}[/bold yellow] (PID: {conn.pid})"))\
            break\
    \
    if not em_uso:\
        resultado_texto = f"Porta {porta} est√ÉÅ LIVRE."\
        console.print(Panel(f"Porta [bold green]{porta}[/bold green] est√ÉÅ LIVRE!"))\
\
    if log:\
        salvar_log("port", resultado_texto)\
\
@app.command()\
def speed(log: bool = typer.Option(False, "--log", "-l", help="Salva o resultado no arquivo de log.")):\
    """Testa a velocidade da sua conex√£o com a internet."""\
    console.print("[yellow]Iniciando teste de velocidade... aguarde alguns segundos.[/yellow]")\
    st = speedtest.Speedtest()\
    st.get_best_server()\
    \
    down = st.download() / 1_000_000\
    up = st.upload() / 1_000_000\
    ping = st.results.ping\
\
    console.print(f"Download: [bold green]{down:.2f} Mbps[/bold green]")\
    console.print(f"Upload: [bold blue]{up:.2f} Mbps[/bold blue]")\
    console.print(f"Ping: [bold yellow]{ping} ms[/bold yellow]")\
\
    if log:\
        texto_log = f"Download: {down:.2f} Mbps\nUpload: {up:.2f} Mbps\nPing: {ping} ms"\
        salvar_log("speed", texto_log)\
\
if __name__ == "__main__":\
    app()\

