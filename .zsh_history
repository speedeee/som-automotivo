<!DOCTYPE html>\
<html lang="pt-BR">\
<head>\
    <meta charset="UTF-8">\
    <meta name="viewport" content="width=device-width, initial-scale=1.0">\
    <title id="pageTitle">‚É∫ÉÅ SPEED R√ÅDIO - MESA DE DJ</title>\
    <script src="/socket.io/socket.io.js"></script>\
    <script src="https://www.youtube.com/iframe_api"></script>\
    <style id="dynamicStyles">\
        :root {\
            --bg-color: #121212;\
            --card-color: #1e1e1e;\
            --primary-color: #1db954;\
            --text-color: #ffffff;\
            --font-family: sans-serif;\
        }\
        body { background: var(--bg-color); color: var(--text-color); font-family: var(--font-family); text-align: center; padding: 20px; margin: 0; transition: all 0.3s ease; }\
        .card { background: var(--card-color); color: var(--text-color); padding: 20px; border-radius: 10px; max-width: 500px; margin: 0 auto 20px auto; border-top: 4px solid var(--primary-color); }\
        .brand-header h1 { margin: 5px 0; font-size: 28px; color: var(--primary-color); text-transform: uppercase; letter-spacing: 1.5px; }\
        .box-link { background: rgba(255,255,255,0.05); border: 2px dashed var(--primary-color); border-radius: 8px; padding: 15px; margin: 15px 0; }\
        .box-link p { margin: 0 0 8px 0; font-weight: bold; color: var(--primary-color); }\
        .box-link input { width: 90%; text-align: center; font-size: 12px; background: #000; color: #fff; border: 1px solid #444; padding: 8px; border-radius: 5px; }\
        input[type="text"], input[type="email"], input[type="password"], select { width: 85%; padding: 10px; border-radius: 5px; border: 1px solid #444; background: #222; color: #fff; margin-bottom: 10px; box-sizing: border-box; }\
        button { padding: 10px 15px; border-radius: 5px; border: none; background: var(--primary-color); color: #fff; font-weight: bold; cursor: pointer; margin: 3px; }\
        .btn-danger { background: #e74c3c; }\
        .btn-warning { background: #f39c12; }\
        .btn-fx { background: #9b59b6; font-size: 12px; padding: 8px; }\
        .btn-mic { background: #ff9800; font-size: 16px; padding: 12px 20px; }\
        .btn-mic.recording { background: #f44336; animation: pulse 1s infinite; }\
        ul { text-align: left; background: rgba(255,255,255,0.05); padding: 15px 25px; border-radius: 5px; list-style: none; }\
        li { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; font-size: 13px; word-break: break-all; }\
        @keyframes pulse { 0% { opacity: 1; } 50% { opacity: 0.5; } 100% { opacity: 1; } }\
        .tab-btn { background: #333; margin-bottom: 15px; border: 1px solid #444; }\
        .active-tab { background: var(--primary-color); }\
        #ytPlayerContainer { position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; border-radius: 8px; margin-top: 15px; background: #000; }\
        #ytPlayerContainer iframe { position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 0; }\
        .fx-grid { display: flex; justify-content: center; gap: 5px; margin-top: 10px; }\
        .color-picker-group { display: flex; justify-content: space-around; align-items: center; margin: 10px 0; }\
        .color-picker-group label { font-size: 12px; }\
    </style>\
</head>\
<body>\
\
    <div>\
        <button class="tab-btn active-tab" id="btnTabOuvinte" onclick="verAba('ouvinte')">ÉøÉ≥ª Player Ouvinte</button>\
        <button class="tab-btn" id="btnTabAdm" onclick="verAba('adm')">ÉøÉÆÉªÔ∏ÉØ Mesa de DJ / ADM</button>\
    </div>\
\
    <!-- OUVINTE -->\
    <div id="abaOuvinte" class="card">\
        <div class="brand-header">\
            <h1 id="displayNomeRadio">‚É∫ÉÅ SPEED R√ÅDIO</h1>\
            <p id="displaySloganRadio">A r√ÉÅdio ao vivo com √ÉÅudio sincronizado!</p>\
        </div>\
\
        <div class="box-link">\
            <p>ÉøÉ≥ÉÇ LINK OFICIAL DA R√ÅDIO</p>\
            <input type="text" id="urlRadio" readonly>\
            <br><br>\
            <button onclick="copiarLink()">ÉøÉ≥É´ Copiar Link da R√ÉÅdio</button>\
        </div>\
\
        <div id="statusAoVivo" style="display:none; color: #ff9800; font-weight: bold; margin-bottom: 10px;">ÉøÉ¥¥ LOCUTOR AO VIVO NO MICROFONE</div>\
        <p id="status">Status: Conectando...</p>\
\
        <div id="ytPlayerContainer">\
            <div id="player"></div>\
        </div>\
\
        <hr style="margin: 20px 0; border-color: #333;">\
\
        <div style="background: rgba(255,255,255,0.05); padding: 15px; border-radius: 8px;">\
            <h3>ÉøÉÆµ Pedir M√∫sica na R√ÉÅdio</h3>\
            <input type="text" id="linkMusicaOuvinte" placeholder="Cole o link do YouTube aqui...">\
            <br>\
            <button onclick="adicionarOuvinte()">‚ÉæÉµ Enviar para Fila</button>\
        </div>\
\
        <h3>ÉøÉ≥Éº Pr√≥ximas M√∫sicas na Fila</h3>\
        <ul id="filaOuvinte"></ul>\
    </div>\
\
    <!-- PAINEL DJ / ADM -->\
    <div id="abaAdm" class="card" style="display: none;">\
        <div id="areaLogin">\
            <h2>ÉøÉ¥É∞ Login do DJ / ADM</h2>\
            <input type="email" id="loginEmail" placeholder="Digite seu e-mail">\
            <input type="password" id="loginPass" placeholder="Digite sua senha">\
            <br>\
            <button onclick="fazerLogin()">Entrar no Painel</button>\
        </div>\
\
        <div id="areaDj" style="display: none;">\
            <h2>ÉøÉÆÉªÔ∏ÉØ Mesa de Som & Painel ADM</h2>\
\
            <!-- PERSONALIZA√Éß√É£O DE APAR√É™NCIA -->\
            <div style="background: #282828; padding: 15px; border-radius: 8px; margin-bottom: 15px;">\
                <h3>ÉøÉÆ® Personaliza√ß√£o da R√ÉÅdio</h3>\
                <input type="text" id="inputNomeRadio" placeholder="Nome da R√ÉÅdio (ex: SPEED R√ÅDIO)">\
                <input type="text" id="inputSloganRadio" placeholder="Slogan / Subt√≠tulo">\
                \
                <div class="color-picker-group">\
                    <div>\
                        <label>Fundo:</label><br>\
                        <input type="color" id="pickerBg" value="#121212">\
                    </div>\
                    <div>\
                        <label>Destaque/Bot√µes:</label><br>\
                        <input type="color" id="pickerPrimary" value="#1db954">\
                    </div>\
                    <div>\
                        <label>Texto:</label><br>\
                        <input type="color" id="pickerText" value="#ffffff">\
                    </div>\
                </div>\
\
                <label style="font-size: 12px;">Estilo da Fonte:</label><br>\
                <select id="selectFonte">\
                    <option value="sans-serif">Sans-Serif (Padr√£o)</option>\
                    <option value="serif">Serif (Cl√ÉÅssica)</option>\
                    <option value="monospace">Monospace (Retro/C√≥digo)</option>\
                    <option value="cursive">Cursive (Manuscrita)</option>\
                    <option value="Impact, fantasy">Impact (Forte/Sci-Fi)</option>\
                </select>\
                <br>\
                <button onclick="salvarPersonalizacao()">ÉøÉ≤æ Aplicar Apar√™ncia</button>\
            </div>\
\
            <!-- CONTROLES DE PLAYER / DJ -->\
            <div style="background: #282828; padding: 15px; border-radius: 8px; margin-bottom: 15px;">\
                <h3>ÉøÉÆÉ∫Ô∏ÉØ Controles de Reprodu√ß√£o & Mixer</h3>\
                <button onclick="comandoDJ('rewind')" class="btn-warning">‚ÉØÆÔ∏ÉØ Voltar do In√≠cio</button>\
                <button onclick="comandoDJ('togglePlay')" class="btn-warning">‚ÉØØÔ∏ÉØ Play / Pause Global</button>\
                <button onclick="comandoDJ('skip')" class="btn-danger">‚ÉØ≠Ô∏ÉØ Pular M√∫sica</button>\
                \
                <h4 style="margin-top: 15px;">ÉøÉ¥É™ Efeitos de DJ (Sons Instant√ÉÇneos)</h4>\
                <div class="fx-grid">\
                    <button onclick="tocarEfeito('airhorn')" class="btn-fx">ÉøÉ≥ÉÇ Buzina Airhorn</button>\
                    <button onclick="tocarEfeito('applause')" class="btn-fx">ÉøÉ±ÉØ Palmas</button>\
                    <button onclick="tocarEfeito('vinheta')" class="btn-fx">‚É∫ÉÅ Vinheta Speed</button>\
                </div>\
            </div>\
\
            <div style="background: #282828; padding: 15px; border-radius: 8px; margin-bottom: 15px;">\
                <h3>ÉøÉÆ§ Microfone Ao Vivo</h3>\
                <button id="btnMicrofone" class="btn-mic" onclick="toggleMicrofone()">ÉøÉÆÉπÔ∏ÉØ Ligar Microfone</button>\
                <p id="statusMic" style="font-size: 12px; color: #aaa; margin-top: 5px;">Microfone Desligado</p>\
            </div>\
\
            <div style="background: #282828; padding: 15px; border-radius: 8px;">\
                <h3>‚ÉæÉµ Adicionar √ÉÄ Fila</h3>\
                <input type="text" id="linkMusicaAdm" placeholder="Link do YouTube...">\
                <br>\
                <button onclick="adicionarAdm()">Adicionar</button>\
                <button onclick="limparFila()" class="btn-danger">ÉøÉ∑É±Ô∏ÉØ Limpar Fila</button>\
\
                <h4>ÉøÉ≥Éº Fila Atual:</h4>\
                <ul id="filaAdm"></ul>\
            </div>\
            <br>\
            <button onclick="logout()" style="background: #555;">Sair do Painel</button>\
        </div>\
    </div>\
\
    <script>\
        const socket = io();\
        let ytPlayer;\
        let isPlayerReady = false;\
\
        document.getElementById('urlRadio').value = window.location.href;\
\
        function onYouTubeIframeAPIReady() {\
            ytPlayer = new YT.Player('player', {\
                height: '100%',\
                width: '100%',\
                playerVars: { 'autoplay': 1, 'controls': 1, 'origin': window.location.origin },\
                events: {\
                    'onReady': () => { isPlayerReady = true; },\
                    'onStateChange': onPlayerStateChange\
                }\
            });\
        }\
\
        function onPlayerStateChange(event) {\
            if (event.data === YT.PlayerState.ENDED) {\
                socket.emit('proximaMusicaAuto');\
            }\
        }\
\
        function extrairVideoId(url) {\
            let ytMatch = url.match(/(?:youtu\.be\/|youtube\.com\/(?:embed\/|v\/|watch\?v=|watch\?.+&v=))([\w-]{11})/);\
            return (ytMatch && ytMatch[1]) ? ytMatch[1] : url;\
        }\
\
        socket.on('atualizarAparencia', (config) => {\
            if(!config) return;\
            document.documentElement.style.setProperty('--bg-color', config.bgColor || '#121212');\
            document.documentElement.style.setProperty('--primary-color', config.primaryColor || '#1db954');\
            document.documentElement.style.setProperty('--text-color', config.textColor || '#ffffff');\
            document.documentElement.style.setProperty('--font-family', config.fontFamily || 'sans-serif');\
\
            if(config.nomeRadio) {\
                document.getElementById('displayNomeRadio').innerText = config.nomeRadio;\
                document.getElementById('pageTitle').innerText = config.nomeRadio + ' - AO VIVO';\
            }\
            if(config.slogan) {\
                document.getElementById('displaySloganRadio').innerText = config.slogan;\
            }\
        });\
\
        function salvarPersonalizacao() {\
            const config = {\
                nomeRadio: document.getElementById('inputNomeRadio').value.trim() || '‚É∫ÉÅ SPEED R√ÅDIO',\
                slogan: document.getElementById('inputSloganRadio').value.trim() || 'A r√ÉÅdio ao vivo com √ÉÅudio sincronizado!',\
                bgColor: document.getElementById('pickerBg').value,\
                primaryColor: document.getElementById('pickerPrimary').value,\
                textColor: document.getElementById('pickerText').value,\
                fontFamily: document.getElementById('selectFonte').value\
            };\
            socket.emit('alterarAparencia', config);\
            alert('Apar√™ncia atualizada para todos os ouvintes!');\
        }\
\
        socket.on('novaMusica', (data) => {\
            const status = document.getElementById('status');\
            if (data && data.musica) {\
                status.innerText = 'Tocando agora na r√ÉÅdio!';\
                const videoId = extrairVideoId(data.musica);\
                if (isPlayerReady && ytPlayer) {\
                    ytPlayer.loadVideoById(videoId, data.tempoDecorrido || 0);\
                }\
            } else {\
                status.innerText = 'Status: Nenhuma m√∫sica na fila';\
                if (isPlayerReady && ytPlayer) ytPlayer.stopVideo();\
            }\
        });\
\
        socket.on('executarComandoDJ', (cmd) => {\
            if (!isPlayerReady || !ytPlayer) return;\
            if (cmd === 'rewind') ytPlayer.seekTo(0);\
            if (cmd === 'togglePlay') {\
                let state = ytPlayer.getPlayerState();\
                if (state === YT.PlayerState.PLAYING) ytPlayer.pauseVideo();\
                else ytPlayer.playVideo();\
            }\
        });\
\
        socket.on('atualizarFila', (lista) => {\
            const filaOuvinte = document.getElementById('filaOuvinte');\
            const filaAdm = document.getElementById('filaAdm');\
            filaOuvinte.innerHTML = '';\
            filaAdm.innerHTML = '';\
            lista.forEach((item, index) => {\
                filaOuvinte.innerHTML += `<li>${index + 1}. ${item}</li>`;\
                filaAdm.innerHTML += `<li>${index + 1}. ${item} <button class="btn-danger" style="padding:2px 8px;" onclick="remover(${index})">X</button></li>`;\
            });\
        });\
\
        function comandoDJ(cmd) {\
            if (cmd === 'skip') socket.emit('proximaMusica');\
            else socket.emit('comandoDJ', cmd);\
        }\
\
        function tocarEfeito(tipo) {\
            let audioUrl = '';\
            if (tipo === 'airhorn') audioUrl = 'https://www.myinstants.com/media/sounds/airhorn.mp3';\
            if (tipo === 'applause') audioUrl = 'https://www.myinstants.com/media/sounds/applause.mp3';\
            if (tipo === 'vinheta') audioUrl = 'https://www.myinstants.com/media/sounds/level-up-sound-effect.mp3';\
            \
            if (audioUrl) {\
                let fx = new Audio(audioUrl);\
                fx.play();\
            }\
        }\
\
        function copiarLink() {\
            const input = document.getElementById('urlRadio');\
            input.select();\
            navigator.clipboard.writeText(input.value);\
            alert('Link copiado!');\
        }\
\
        function verAba(aba) {\
            document.getElementById('abaOuvinte').style.display = aba === 'ouvinte' ? 'block' : 'none';\
            document.getElementById('abaAdm').style.display = aba === 'adm' ? 'block' : 'none';\
            document.getElementById('btnTabOuvinte').classList.toggle('active-tab', aba === 'ouvinte');\
            document.getElementById('btnTabAdm').classList.toggle('active-tab', aba === 'adm');\
        }\
\
        function fazerLogin() {\
            const email = document.getElementById('loginEmail').value;\
            const password = document.getElementById('loginPass').value;\
            fetch('/api/login', {\
                method: 'POST',\
                headers: { 'Content-Type': 'application/json' },\
                body: JSON.stringify({ email, password })\
            }).then(res => res.json()).then(data => {\
                if(data.success) { localStorage.setItem('adm_token', data.token); carregarPainel(); }\
                else alert(data.message);\
            });\
        }\
\
        function carregarPainel() {\
            if(localStorage.getItem('adm_token')) {\
                document.getElementById('areaLogin').style.display = 'none';\
                document.getElementById('areaDj').style.display = 'block';\
            }\
        }\
\
        function logout() {\
            localStorage.removeItem('adm_token');\
            document.getElementById('areaLogin').style.display = 'block';\
            document.getElementById('areaDj').style.display = 'none';\
        }\
\
        function adicionarOuvinte() {\
            const input = document.getElementById('linkMusicaOuvinte');\
            if (input.value.trim() !== '') {\
                socket.emit('adicionarMusica', input.value.trim());\
                input.value = '';\
                alert('M√∫sica enviada para a r√ÉÅdio!');\
            }\
        }\
\
        function adicionarAdm() {\
            const input = document.getElementById('linkMusicaAdm');\
            if (input.value.trim() !== '') {\
                socket.emit('adicionarMusica', input.value.trim());\
                input.value = '';\
            }\
        }\
\
        function remover(index) { socket.emit('removerMusica', index); }\
        function limparFila() { socket.emit('limparFila'); }\
\
        let mediaRecorder, isRecording = false;\
        async function toggleMicrofone() {\
            const btn = document.getElementById('btnMicrofone');\
            const statusMic = document.getElementById('statusMic');\
            if (!isRecording) {\
                try {\
                    const stream = await navigator.mediaDevices.getUserMedia({ audio: true });\
                    mediaRecorder = new MediaRecorder(stream, { mimeType: 'audio/webm' });\
                    mediaRecorder.ondataavailable = (e) => { if (e.data.size > 0) socket.emit('streamAudio', e.data); };\
                    mediaRecorder.start(250);\
                    isRecording = true;\
                    btn.classList.add('recording');\
                    btn.innerText = 'ÉøÉªÉ± Desligar Microfone';\
                    statusMic.innerText = 'ÉøÉ¥¥ AO VIVO NO MICROFONE';\
                } catch (err) { alert('Erro no microfone: ' + err.message); }\
            } else {\
                mediaRecorder.stop();\
                socket.emit('pararStream');\
                isRecording = false;\
                btn.classList.remove('recording');\
                btn.innerText = 'ÉøÉÆÉπÔ∏ÉØ Ligar Microfone';\
                statusMic.innerText = 'Microfone Desligado';\
            }\
        }\
\
        socket.on('receberAudioLive', (data) => {\
            document.getElementById('statusAoVivo').style.display = 'block';\
            let blob = new Blob([data], { type: 'audio/webm' });\
            let liveAudio = new Audio(URL.createObjectURL(blob));\
            liveAudio.play().catch(() => {});\
        });\
\
        socket.on('fimAudioLive', () => { document.getElementById('statusAoVivo').style.display = 'none'; });\
\
        carregarPainel();\
    </script>\
</body>\
</html>\
EOF\

