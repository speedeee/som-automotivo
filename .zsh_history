: 1786099429:0;printf '%s\n' '<!DOCTYPE html>' '<html lang="pt-BR">' '<head>' '<meta charset="UTF-8">' '<meta name="viewport" content="width=device-width, initial-scale=1.0">' '<title id="page-title">SPEED STORE</title>' '<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>' '<style>' ':root { --cor-principal: #ff4500; }' 'body { background-color: #121212; color: #ffffff; font-family: Arial, sans-serif; margin: 0; padding: 20px; }' 'header { text-align: center; margin-bottom: 20px; border-bottom: 1px solid #222; padding-bottom: 15px; }' 'h1 { color: var(--cor-principal); margin: 0 0 5px 0; font-size: 28px; }' '.admin-btn-wrapper { margin-top: 10px; display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }' '.admin-link { background: #222; color: var(--cor-principal); padding: 8px 16px; border-radius: 4px; text-decoration: none; font-size: 14px; font-weight: bold; border: 1px solid var(--cor-principal); cursor: pointer; display: inline-block; }' '.promo-banner { background: linear-gradient(135deg, var(--cor-principal), #ff8c00); padding: 15px; border-radius: 8px; margin-bottom: 20px; text-align: center; }' '.timer { font-size: 18px; font-weight: bold; background: rgba(0,0,0,0.3); display: inline-block; padding: 5px 15px; border-radius: 4px; margin-top: 8px; color: #fff; }' '.produto-card, .depoimentos-box, .security-box { background: #1e1e1e; padding: 15px; border-radius: 8px; margin-bottom: 15px; border-left: 4px solid var(--cor-principal); }' '.produto-card img { width: 100%; height: 160px; object-fit: cover; border-radius: 4px; margin-bottom: 10px; background: #2a2a2a; }' 'input, select { width: 100%; background: #2a2a2a; color: #fff; border: 1px solid #444; padding: 10px; border-radius: 4px; margin-bottom: 10px; box-sizing: border-box; }' 'button { background-color: var(--cor-principal); color: white; border: none; padding: 10px 15px; border-radius: 5px; cursor: pointer; font-weight: bold; width: 100%; margin-top: 5px; }' 'button:hover { opacity: 0.9; }' '#modal-pix, #modal-admin { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.85); justify-content: center; align-items: center; z-index: 999; overflow-y: auto; padding: 20px; }' '.modal-content { background: #1e1e1e; padding: 25px; border-radius: 8px; width: 100%; max-width: 500px; text-align: center; border: 1px solid var(--cor-principal); box-sizing: border-box; }' 'textarea { width: 100%; height: 80px; background: #2a2a2a; color: #00ff00; border: 1px solid #444; padding: 8px; border-radius: 4px; resize: none; box-sizing: border-box; }' '</style>' '</head>' '<body>' '<header>' '<h1 id="store-name">SPEED STORE</h1>' '<p id="store-slogan" style="margin: 0; color: #aaa; font-size: 14px;">Onde a velocidade encontra o game</p>' '<div class="admin-btn-wrapper">' '<button onclick="abrirAdminModal()" class="admin-link">‚É∫ÉπÔ∏ÉØ Painel Admin</button>' '</div>' '</header>' '<div class="promo-banner">' '<h3 style="margin: 0;">ÉøÉ¥• PROMO√Éß√É£O REL√ÇMPAGO</h3>' '<p style="margin: 5px 0 0 0;">Descontos exclusivos por tempo limitado!</p>' '<div class="timer" id="countdown">02:59:45</div>' '</div>' '<div class="security-box" style="display: flex; justify-content: space-around; text-align: center; font-size: 13px; border-left-color: #00cc66; padding: 10px;">' '<div>ÉøÉ¥É≤ <b>Compra Segura</b></div>' '<div>‚É∫ÉÅ <b>Envio R√ÉÅpido</b></div>' '<div>ÉøÉ≤¨ <b>Suporte Direto</b></div>' '</div>' '<div id="container"></div>' '<div class="depoimentos-box" style="border-left-color: #00cc66; margin-top: 30px;">' '<h3 style="color: #fff; margin-top: 0; text-align: center;">‚≠É∞ O que dizem nossos clientes</h3>' '<div style="background: #2a2a2a; padding: 12px; border-radius: 6px; margin-bottom: 10px;">' '<p style="margin: 0; font-style: italic; font-size: 14px;">"Chegou super r√ÉÅpido aqui em Minas e a qualidade √© braba demais! Recomendo muito."</p>' '</div>' '</div>' '<div style="text-align: center; margin-top: 30px; margin-bottom: 30px;">' '<p>D√∫vidas? Entre em contato:</p>' '<a href="https://wa.me/5538998842504?text=Ol√ÉÅ! Vim pelo site da Speed Store e preciso de suporte." target="_blank" style="color: #00cc66; text-decoration: none; font-weight: bold;">ÉøÉ≤¨ Falar no WhatsApp da Loja</a>' '</div>' '<div id="modal-admin">' '<div class="modal-content" id="admin-conteudo-modal">' '<h3>ÉøÉ¥É∞ Login Admin</h3>' '<input type="email" id="loginEmail" placeholder="E-mail">' '<input type="password" id="loginSenha" placeholder="Senha">' '<button onclick="fazerLogin()">Entrar</button>' '<button onclick="fecharAdminModal()" style="background-color: #555; margin-top: 10px;">Cancelar</button>' '</div>' '</div>' '<div id="modal-pix">' '<div class="modal-content">' '<h3>Pagamento via Pix</h3>' '<p id="pix-detalhe" style="margin: 10px 0;"></p>' '<textarea id="copia-cola-pix" readonly></textarea>' '<button onclick="copiarPix()" style="background-color: #00cc66;">COPIAR C√É≥DIGO PIX</button>' '<button onclick="fecharModal()" style="background-color: #555; margin-top: 10px;">Fechar</button>' '</div>' '</div>' '<script>' 'function gerarPDF() {' 'const elemento = document.body;' 'const opt = { margin: 10, filename: "catalogo_speed_store.pdf", image: { type: "jpeg", quality: 0.98 }, html2canvas: { scale: 2 }, jsPDF: { unit: "mm", format: "a4", orientation: "portrait" } };' 'html2pdf().set(opt).from(elemento).save();' '}' 'let tempo = 10700;' 'setInterval(() => {' 'let h = Math.floor(tempo / 3600);' 'let m = Math.floor((tempo % 3600) / 60);' 'let s = tempo % 60;' 'document.getElementById("countdown").innerText = String(h).padStart(2,"0") + ":" + String(m).padStart(2,"0") + ":" + String(s).padStart(2,"0");' 'if(tempo > 0) tempo--;' '}, 1000);' 'let configuracoes = JSON.parse(localStorage.getItem("speed_config")) || { nome: "SPEED STORE", slogan: "Onde a velocidade encontra o game", cor: "#ff4500", pix: "00020126580014br.gov.bcb.pix0136speedstore-pay-4-uuid5204000053039865802BR5909SPEEDSTORE6009MINAS GERAIS62070503***6304" };' 'let produtosPadrao = [' '{ nome: "Suporte Garra X Para Celular Moto", preco: 39.90, imagem: "https://images.unsplash.com/photo-1599643478518-a854e5da47f7?w=500" },' '{ nome: "Headset Gamer RGB Profissional", preco: 89.90, imagem: "https://images.unsplash.com/photo-1546435770-a3e426bf472b?w=500" },' '{ nome: "Fone Bluetooth para Capacete Intercom", preco: 79.90, imagem: "https://images.unsplash.com/photo-1558981403-c5f9899a28bc?w=500" }' '];' 'let produtos = JSON.parse(localStorage.getItem("speed_produtos")) || produtosPadrao;' 'let logadoAdmin = false;' 'function aplicarConfiguracoes() {' 'document.getElementById("store-name").innerText = configuracoes.nome;' 'document.getElementById("page-title").innerText = configuracoes.nome;' 'document.getElementById("store-slogan").innerText = configuracoes.slogan;' 'document.documentElement.style.setProperty("--cor-principal", configuracoes.cor);' 'document.getElementById("copia-cola-pix").value = configuracoes.pix;' '}' 'function salvarTudo() {' 'localStorage.setItem("speed_produtos", JSON.stringify(produtos));' 'localStorage.setItem("speed_config", JSON.stringify(configuracoes));' 'aplicarConfiguracoes();' 'carregarLoja();' '}' 'function carregarLoja() {' 'aplicarConfiguracoes();' 'const container = document.getElementById("container");' 'container.innerHTML = "";' 'produtos.forEach((p, index) => {' 'let imgSrc = p.imagem && p.imagem.trim() !== "" ? p.imagem : "https://via.placeholder.com/300x180?text=SPEED+STORE";' 'container.innerHTML += `<div class="produto-card"><img src="${imgSrc}" alt="${p.nome}"><h3>${p.nome}</h3><p style="color: #00ff00; font-weight: bold; font-size: 16px;">R$ ${Number(p.preco).toFixed(2)}</p><button onclick="abrirPix(\x27${p.nome}\x27, ${p.preco})">COMPRAR VIA PIX</button></div>`;' '});' '}' 'function abrirAdminModal() {' 'document.getElementById("modal-admin").style.display = "flex";' 'if (logadoAdmin) renderizarPainelAdminLogado();' '}' 'function fazerLogin() {' 'if (document.getElementById("loginEmail").value === "fabiojr074@gmail.com" && document.getElementById("loginSenha").value === "Deus777") {' 'logadoAdmin = true;' 'renderizarPainelAdminLogado();' '} else { alert("E-mail ou senha incorretos!"); }' '}' 'function renderizarPainelAdminLogado() {' 'let listaHtml = "";' 'produtos.forEach((p, index) => {' 'listaHtml += `<div style="display: flex; justify-content: space-between; align-items: center; background: #2a2a2a; padding: 8px; margin-bottom: 5px; border-radius: 4px;"><span style="font-size: 12px; width: 60%;">${p.nome}</span><button onclick="excluirProduto(${index})" style="background: #ff3333; width: auto; padding: 4px 8px; font-size: 10px;">Excluir</button></div>`;' '});' 'document.getElementById("admin-conteudo-modal").innerHTML = `<h3>‚É∫ÉπÔ∏ÉØ Painel Admin</h3><div style="background: #252525; padding: 10px; border-radius: 6px; text-align: left;"><h4 style="color: #ff8c00; margin-top:0;">Configura√ß√µes</h4><label style="font-size:12px;">Nome da Loja:</label><input type="text" id="editNome" value="${configuracoes.nome}"><label style="font-size:12px;">Cor Principal:</label><input type="color" id="editCor" value="${configuracoes.cor}" style="height:35px; padding:2px;"><label style="font-size:12px;">Chave PIX:</label><textarea id="editPix">${configuracoes.pix}</textarea><button onclick="salvarConfiguracoesAdmin()" style="background-color: #00cc66;">Salvar Configura√ß√µes</button><button onclick="gerarPDF()" style="background-color: #0088cc; margin-top:5px;">ÉøÉ≥É§ Baixar Cat√ÉÅlogo PDF</button></div><h4 style="text-align: left; margin-bottom: 5px;">Gerenciar Produtos:</h4><div style="max-height: 120px; overflow-y: auto;" id="admin-lista-modal">${listaHtml}</div><button onclick="fecharAdminModal()" style="background-color: #555; margin-top: 10px;">Fechar Painel</button>`;' '}' 'function salvarConfiguracoesAdmin() {' 'configuracoes.nome = document.getElementById("editNome").value.trim();' 'configuracoes.cor = document.getElementById("editCor").value;' 'configuracoes.pix = document.getElementById("editPix").value.trim();' 'salvarTudo();' 'alert("Configura√ß√µes salvas!");' 'renderizarPainelAdminLogado();' '}' 'function excluirProduto(index) { produtos.splice(index, 1); salvarTudo(); renderizarPainelAdminLogado(); }' 'function abrirPix(nome, preco) {' 'document.getElementById("pix-detalhe").innerText = `${nome} - R$ ${Number(preco).toFixed(2)}`;' 'document.getElementById("modal-pix").style.display = "flex";' '}' 'function copiarPix() {' 'navigator.clipboard.writeText(document.getElementById("copia-cola-pix").value);' 'alert("C√≥digo Pix copiado!");' '}' 'function fecharModal() { document.getElementById("modal-pix").style.display = "none"; }' 'function fecharAdminModal() { document.getElementById("modal-admin").style.display = "none"; }' 'carregarLoja();' '</script>' '</body>' '</html>' > index.html\

: 1786099442:0;ssh -R 80:localhost:8000 serveo.net
: 1786099773:0;printf '%s\n' '<!DOCTYPE html>' '<html lang="pt-BR">' '<head>' '<meta charset="UTF-8">' '<meta name="viewport" content="width=device-width, initial-scale=1.0">' '<title id="page-title">SPEED STORE</title>' '<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>' '<style>' ':root { --cor-principal: #ff4500; }' 'body { background-color: #121212; color: #ffffff; font-family: Arial, sans-serif; margin: 0; padding: 20px; }' 'header { text-align: center; margin-bottom: 20px; border-bottom: 1px solid #222; padding-bottom: 15px; }' 'h1 { color: var(--cor-principal); margin: 0 0 5px 0; font-size: 28px; }' '.admin-btn-wrapper { margin-top: 10px; display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }' '.admin-link { background: #222; color: var(--cor-principal); padding: 8px 16px; border-radius: 4px; text-decoration: none; font-size: 14px; font-weight: bold; border: 1px solid var(--cor-principal); cursor: pointer; display: inline-block; }' '.promo-banner { background: linear-gradient(135deg, var(--cor-principal), #ff8c00); padding: 15px; border-radius: 8px; margin-bottom: 20px; text-align: center; }' '.timer { font-size: 18px; font-weight: bold; background: rgba(0,0,0,0.3); display: inline-block; padding: 5px 15px; border-radius: 4px; margin-top: 8px; color: #fff; }' '.produto-card, .depoimentos-box, .security-box { background: #1e1e1e; padding: 15px; border-radius: 8px; margin-bottom: 15px; border-left: 4px solid var(--cor-principal); }' '.produto-card img { width: 100%; height: 160px; object-fit: cover; border-radius: 4px; margin-bottom: 10px; background: #2a2a2a; }' 'input, select { width: 100%; background: #2a2a2a; color: #fff; border: 1px solid #444; padding: 10px; border-radius: 4px; margin-bottom: 10px; box-sizing: border-box; }' 'button { background-color: var(--cor-principal); color: white; border: none; padding: 10px 15px; border-radius: 5px; cursor: pointer; font-weight: bold; width: 100%; margin-top: 5px; }' 'button:hover { opacity: 0.9; }' '#modal-pix, #modal-admin { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.85); justify-content: center; align-items: center; z-index: 999; overflow-y: auto; padding: 20px; }' '.modal-content { background: #1e1e1e; padding: 25px; border-radius: 8px; width: 100%; max-width: 500px; text-align: center; border: 1px solid var(--cor-principal); box-sizing: border-box; }' 'textarea { width: 100%; height: 70px; background: #2a2a2a; color: #00ff00; border: 1px solid #444; padding: 8px; border-radius: 4px; resize: none; box-sizing: border-box; }' '</style>' '</head>' '<body>' '<header>' '<h1 id="store-name">SPEED STORE</h1>' '<p id="store-slogan" style="margin: 0; color: #aaa; font-size: 14px;">Onde a velocidade encontra o game</p>' '<div class="admin-btn-wrapper">' '<button onclick="abrirAdminModal()" class="admin-link">‚É∫ÉπÔ∏ÉØ Painel Admin</button>' '</div>' '</header>' '<div class="promo-banner">' '<h3 style="margin: 0;">ÉøÉ¥• PROMO√Éß√É£O REL√ÇMPAGO</h3>' '<p style="margin: 5px 0 0 0;">Descontos exclusivos por tempo limitado!</p>' '<div class="timer" id="countdown">02:59:45</div>' '</div>' '<div class="security-box" style="display: flex; justify-content: space-around; text-align: center; font-size: 13px; border-left-color: #00cc66; padding: 10px;">' '<div>ÉøÉ¥É≤ <b>Compra Segura</b></div>' '<div>‚É∫ÉÅ <b>Envio R√ÉÅpido</b></div>' '<div>ÉøÉ≤¨ <b>Suporte Direto</b></div>' '</div>' '<div id="container"></div>' '<div class="depoimentos-box" style="border-left-color: #00cc66; margin-top: 30px;">' '<h3 style="color: #fff; margin-top: 0; text-align: center;">‚≠É∞ O que dizem nossos clientes</h3>' '<div style="background: #2a2a2a; padding: 12px; border-radius: 6px; margin-bottom: 10px;">' '<p style="margin: 0; font-style: italic; font-size: 14px;">"Chegou super r√ÉÅpido aqui em Minas e a qualidade √© braba demais! Recomendo muito."</p>' '</div>' '</div>' '<div style="text-align: center; margin-top: 30px; margin-bottom: 30px;">' '<p>D√∫vidas? Entre em contato:</p>' '<a href="https://wa.me/5538998842504?text=Ol√ÉÅ! Vim pelo site da Speed Store e preciso de suporte." target="_blank" style="color: #00cc66; text-decoration: none; font-weight: bold;">ÉøÉ≤¨ Falar no WhatsApp da Loja</a>' '</div>' '<div id="modal-admin">' '<div class="modal-content" id="admin-conteudo-modal">' '<h3>ÉøÉ¥É∞ Login Admin</h3>' '<input type="email" id="loginEmail" placeholder="E-mail">' '<input type="password" id="loginSenha" placeholder="Senha">' '<button onclick="fazerLogin()">Entrar</button>' '<button onclick="fecharAdminModal()" style="background-color: #555; margin-top: 10px;">Cancelar</button>' '</div>' '</div>' '<div id="modal-pix">' '<div class="modal-content">' '<h3>Pagamento via Pix</h3>' '<p id="pix-detalhe" style="margin: 10px 0;"></p>' '<textarea id="copia-cola-pix" readonly></textarea>' '<button onclick="copiarPix()" style="background-color: #00cc66;">COPIAR C√É≥DIGO PIX</button>' '<button onclick="fecharModal()" style="background-color: #555; margin-top: 10px;">Fechar</button>' '</div>' '</div>' '<script>' 'function gerarPDF() {' 'const elemento = document.body;' 'const opt = { margin: 10, filename: "catalogo_speed_store.pdf", image: { type: "jpeg", quality: 0.98 }, html2canvas: { scale: 2 }, jsPDF: { unit: "mm", format: "a4", orientation: "portrait" } };' 'html2pdf().set(opt).from(elemento).save();' '}' 'let tempo = 10700;' 'setInterval(() => {' 'let h = Math.floor(tempo / 3600);' 'let m = Math.floor((tempo % 3600) / 60);' 'let s = tempo % 60;' 'document.getElementById("countdown").innerText = String(h).padStart(2,"0") + ":" + String(m).padStart(2,"0") + ":" + String(s).padStart(2,"0");' 'if(tempo > 0) tempo--;' '}, 1000);' 'let configuracoes = JSON.parse(localStorage.getItem("speed_config")) || { nome: "SPEED STORE", slogan: "Onde a velocidade encontra o game", cor: "#ff4500", pix: "00020126580014br.gov.bcb.pix0136speedstore-pay-4-uuid5204000053039865802BR5909SPEEDSTORE6009MINAS GERAIS62070503***6304" };' 'let produtosPadrao = [' '{ nome: "Suporte Garra X Para Celular Moto", preco: 39.90, imagem: "https://images.unsplash.com/photo-1599643478518-a854e5da47f7?w=500" },' '{ nome: "Headset Gamer RGB Profissional", preco: 89.90, imagem: "https://images.unsplash.com/photo-1546435770-a3e426bf472b?w=500" },' '{ nome: "Fone Bluetooth para Capacete Intercom", preco: 79.90, imagem: "https://images.unsplash.com/photo-1558981403-c5f9899a28bc?w=500" }' '];' 'let produtos = JSON.parse(localStorage.getItem("speed_produtos")) || produtosPadrao;' 'let logadoAdmin = false;' 'function aplicarConfiguracoes() {' 'document.getElementById("store-name").innerText = configuracoes.nome;' 'document.getElementById("page-title").innerText = configuracoes.nome;' 'document.getElementById("store-slogan").innerText = configuracoes.slogan;' 'document.documentElement.style.setProperty("--cor-principal", configuracoes.cor);' 'document.getElementById("copia-cola-pix").value = configuracoes.pix;' '}' 'function salvarTudo() {' 'localStorage.setItem("speed_produtos", JSON.stringify(produtos));' 'localStorage.setItem("speed_config", JSON.stringify(configuracoes));' 'aplicarConfiguracoes();' 'carregarLoja();' '}' 'function carregarLoja() {' 'aplicarConfiguracoes();' 'const container = document.getElementById("container");' 'container.innerHTML = "";' 'produtos.forEach((p, index) => {' 'let imgSrc = p.imagem && p.imagem.trim() !== "" ? p.imagem : "https://via.placeholder.com/300x180?text=SPEED+STORE";' 'let msgWp = encodeURIComponent(`Ol√ÉÅ! Tenho interesse no produto: ${p.nome} por R$ ${Number(p.preco).toFixed(2)}. Poderia me ajudar?`);' 'container.innerHTML += `<div class="produto-card"><img src="${imgSrc}" alt="${p.nome}"><h3>${p.nome}</h3><p style="color: #00ff00; font-weight: bold; font-size: 16px;">R$ ${Number(p.preco).toFixed(2)}</p><button onclick="abrirPix(\x27${p.nome}\x27, ${p.preco})">COMPRAR VIA PIX</button><a href="https://wa.me/5538998842504?text=${msgWp}" target="_blank"><button style="background-color: #25d366; margin-top: 5px;">COMPRAR VIA WHATSAPP</button></a></div>`;' '});' '}' 'function abrirAdminModal() {' 'document.getElementById("modal-admin").style.display = "flex";' 'if (logadoAdmin) renderizarPainelAdminLogado();' '}' 'function fazerLogin() {' 'if (document.getElementById("loginEmail").value === "fabiojr074@gmail.com" && document.getElementById("loginSenha").value === "Deus777") {' 'logadoAdmin = true;' 'renderizarPainelAdminLogado();' '} else { alert("E-mail ou senha incorretos!"); }' '}' 'function renderizarPainelAdminLogado() {' 'let listaHtml = "";' 'produtos.forEach((p, index) => {' 'listaHtml += `<div style="display: flex; justify-content: space-between; align-items: center; background: #2a2a2a; padding: 6px 8px; margin-bottom: 4px; border-radius: 4px;"><span style="font-size: 11px; width: 65%; text-align: left;">${p.nome} - R$ ${Number(p.preco).toFixed(2)}</span><button onclick="excluirProduto(${index})" style="background: #ff3333; width: auto; padding: 3px 6px; font-size: 10px; margin:0;">Excluir</button></div>`;' '});' 'document.getElementById("admin-conteudo-modal").innerHTML = `<h3>‚É∫ÉπÔ∏ÉØ Painel de Controle</h3>' '<div style="background: #252525; padding: 10px; border-radius: 6px; text-align: left; margin-bottom: 10px;">' '<h4 style="color: #ff8c00; margin: 0 0 8px 0; font-size: 14px;">Personalizar Loja</h4>' '<label style="font-size:11px;">Nome da Loja:</label><input type="text" id="editNome" value="${configuracoes.nome}" style="padding:6px; margin-bottom:6px;">' '<label style="font-size:11px;">Slogan:</label><input type="text" id="editSlogan" value="${configuracoes.slogan}" style="padding:6px; margin-bottom:6px;">' '<label style="font-size:11px;">Cor Principal:</label><input type="color" id="editCor" value="${configuracoes.cor}" style="height:32px; padding:2px; margin-bottom:6px;">' '<label style="font-size:11px;">Chave PIX (Copia e Cola):</label><textarea id="editPix" style="height:50px; margin-bottom:6px;">${configuracoes.pix}</textarea>' '<button onclick="salvarConfiguracoesAdmin()" style="background-color: #00cc66; padding:8px;">Salvar Altera√ß√µes</button>' '<button onclick="gerarPDF()" style="background-color: #0088cc; padding:8px; margin-top:5px;">ÉøÉ≥É§ Baixar Cat√ÉÅlogo PDF</button>' '</div>' '<div style="background: #252525; padding: 10px; border-radius: 6px; text-align: left; margin-bottom: 10px;">' '<h4 style="color: #ff8c00; margin: 0 0 8px 0; font-size: 14px;">Cadastrar Novo Produto</h4>' '<input type="text" id="novoNome" placeholder="Nome do Produto" style="padding:6px; margin-bottom:6px;">' '<input type="number" step="0.01" id="novoPreco" placeholder="Pre√ßo (Ex: 89.90)" style="padding:6px; margin-bottom:6px;">' '<input type="text" id="novoImagem" placeholder="Link da Imagem (Opcional)" style="padding:6px; margin-bottom:6px;">' '<button onclick="adicionarProdutoAdmin()" style="background-color: #ff4500; padding:8px;">Adicionar Produto</button>' '</div>' '<h4 style="text-align: left; margin: 5px 0; font-size: 13px;">Gerenciar Produtos:</h4>' '<div style="max-height: 110px; overflow-y: auto; margin-bottom: 10px;" id="admin-lista-modal">${listaHtml}</div>' '<button onclick="fecharAdminModal()" style="background-color: #555; padding: 8px;">Fechar Painel</button>`;' '}' 'function salvarConfiguracoesAdmin() {' 'configuracoes.nome = document.getElementById("editNome").value.trim();' 'configuracoes.slogan = document.getElementById("editSlogan").value.trim();' 'configuracoes.cor = document.getElementById("editCor").value;' 'configuracoes.pix = document.getElementById("editPix").value.trim();' 'salvarTudo();' 'alert("Altera√ß√µes salvas com sucesso!");' 'renderizarPainelAdminLogado();' '}' 'function adicionarProdutoAdmin() {' 'let nome = document.getElementById("novoNome").value.trim();' 'let preco = parseFloat(document.getElementById("novoPreco").value);' 'let imagem = document.getElementById("novoImagem").value.trim();' 'if(!nome || isNaN(preco)) { alert("Preencha o nome e o pre√ßo corretamente!"); return; }' 'produtos.push({ nome: nome, preco: preco, imagem: imagem });' 'salvarTudo();' 'alert("Produto cadastrado com sucesso!");' 'renderizarPainelAdminLogado();' '}' 'function excluirProduto(index) { produtos.splice(index, 1); salvarTudo(); renderizarPainelAdminLogado(); }' 'function abrirPix(nome, preco) {' 'document.getElementById("pix-detalhe").innerText = `${nome} - R$ ${Number(preco).toFixed(2)}`;' 'document.getElementById("modal-pix").style.display = "flex";' '}' 'function copiarPix() {' 'navigator.clipboard.writeText(document.getElementById("copia-cola-pix").value);' 'alert("C√≥digo Pix copiado!");' '}' 'function fecharModal() { document.getElementById("modal-pix").style.display = "none"; }' 'function fecharAdminModal() { document.getElementById("modal-admin").style.display = "none"; }' 'carregarLoja();' '</script>' '</body>' '</html>' > index.html\

