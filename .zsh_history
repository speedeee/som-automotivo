                <div class="tweeter-saveiro"><div class="tweeter-saveiro-core"></div></div>\
            </div>\
            <div class="rack-bottom">\
                <div class="subwoofer-saveiro subElem"></div>\
                <div class="subwoofer-saveiro subElem"></div>\
                <div class="subwoofer-saveiro subElem"></div>\
            </div>\
        </div>\
\
        <div class="box-link">\
            <input type="text" id="urlRadio" readonly>\
            <button onclick="copiarLink()">ÉøÉ≥É´ Copiar Link da R√ÉÅdio</button>\
            <div id="qrcodeCanvas"></div>\
        </div>\
\
        <h4>ÉøÉÆµ Enviar M√∫sica ou V√≠deo (Link / YouTube / MP3)</h4>\
        <input type="text" id="linkMusicaOuvinte" placeholder="Cole o link do YouTube, MP3 ou Web...">\
        <button onclick="enviarPedidoPublico()">‚ÉæÉµ Enviar para o DJ</button>\
\
        <h4>ÉøÉ≥Éº Fila Tocado Agora</h4>\
        <ol id="filaOuvinte"></ol>\
    </div>\
\
    <!-- ABA ADM: MESA DJ & M√É≠DIA -->\
    <div id="abaAdm" class="pioneer-frame" style="display: none;">\
        <h2>ÉøÉÆÉªÔ∏ÉØ Transmiss√£o & Controle DJ</h2>\
        <button id="btnPowerRadio" class="btn-power on" onclick="toggleLigarRadio()">‚É∫ÉÅ DESLIGAR R√ÅDIO PARED√É£O</button>\
\
        <div style="margin: 10px 0;">\
            <button onclick="voltarMusica()">‚ÉØÆÔ∏ÉØ Voltar</button>\
            <button onclick="pausarEPlay()">‚ÉØØÔ∏ÉØ Play/Pause</button>\
            <button onclick="proximaMusica()">‚ÉØ≠Ô∏ÉØ Avan√ßar</button>\
        </div>\
\
        <div class="eq-panel">\
            <h4>ÉøÉ¥ÉÆ Pesquisar M√∫sica / V√≠deo Direto</h4>\
            <input type="text" id="inputBusca" placeholder="Nome da m√∫sica ou artista...">\
            <button onclick="buscarEAdicionar()">ÉøÉ¥É≠ Pesquisar e Inserir</button>\
        </div>\
\
        <div class="eq-panel">\
            <h4>ÉøÉ¥É∑ Adicionar por Link / Web (Qualquer formato)</h4>\
            <input type="text" id="inputLinkDj" placeholder="Link de √ÉÅudio, v√≠deo ou YouTube...">\
            <button onclick="adicionarLinkDj()">‚ÉæÉµ Adicionar √ÉÄ Fila</button>\
        </div>\
\
        <div class="eq-panel">\
            <h4>ÉøÉ≥Å Adicionar Arquivos Locais (MP3, WAV, M4A)</h4>\
            <input type="file" id="fileInput" accept="audio/*,video/*" multiple style="font-size: 11px;">\
            <button onclick="carregarArquivosLocais()">‚ÉæÉµ Inserir M√∫sicas</button>\
        </div>\
\
        <h4>ÉøÉ≥Éº Fila da R√ÉÅdio (Reordenar / Excluir)</h4>\
        <ol id="filaAdm"></ol>\
        <button onclick="limparFila()" class="btn-danger">ÉøÉ∑É±Ô∏ÉØ Limpar Fila</button>\
    </div>\
\
    <!-- ABA ADM: PEDIDOS -->\
    <div id="abaPedidos" class="pioneer-frame" style="display: none;">\
        <h2 style="color: #ffcc00;">ÉøÉ≥• Fila de Pedidos do P√∫blico</h2>\
        <p style="font-size: 11px;">Aprove ou recuse os links enviados pelos ouvintes:</p>\
        <ul id="listaEspera"></ul>\
    </div>\
\
    <!-- ABA ADM: MICROFONE & VOZ -->\
    <div id="abaMic" class="pioneer-frame" style="display: none;">\
        <h2>ÉøÉÆÉπÔ∏ÉØ Controle de Microfone & Efeitos de Voz</h2>\
        <button id="btnMicPower" onclick="toggleMicrofone()" style="width:100%; padding: 10px; background:#e74c3c; color:#fff; font-weight:bold;">ÉøÉÆÉπÔ∏ÉØ LIGAR MICROFONE</button>\
\
        <div class="eq-panel" style="margin-top: 15px;">\
            <div class="eq-slider"><span>ÉøÉ¥É™ Volume do Mic:</span><input type="range" id="micVol" min="0" max="2" step="0.1" value="1" oninput="ajustarMic()"></div>\
            <div class="eq-slider"><span>‚Éº® Qualidade / Ganho:</span><input type="range" id="micGain" min="0" max="10" value="5" oninput="ajustarMic()"></div>\
            <div class="eq-slider"><span>ÉøÉÆ≠ Tom de Voz (PITCH):</span><input type="range" id="micPitch" min="300" max="3000" value="1000" oninput="ajustarMic()"></div>\
            <p style="font-size: 10px; color: #888;">Arraste para a esquerda para engrossar a voz e para a direita para afinar.</p>\
        </div>\
    </div>\
\
    <!-- ABA ADM: VISUAL & EFEITOS -->\
    <div id="abaCustom" class="pioneer-frame" style="display: none;">\
        <h2>ÉøÉÆ® Edi√ß√£o de Som & Visual</h2>\
\
        <div class="eq-panel">\
            <h4>ÉøÉ≥É™ Visualizador de √Åudio (11 Modos)</h4>\
            <select id="selectVisualizer" onchange="mudarEstiloVisualizer(this.value)">\
                <option value="bars">1. Barras LED (Pioneer Cl√ÉÅssico)</option>\
                <option value="wave">2. Onda Oscilosc√≥pio</option>\
                <option value="radial">3. Espectro Radial Neon</option>\
                <option value="vumeter">4. VU Meter Anal√≥gico</option>\
                <option value="bars3d">5. Espectro 3D Gradiente</option>\
                <option value="freqcircle">6. Freq√º√™ncia Circular</option>\
                <option value="tunnel">7. T√∫nel Neon Hipn√≥tico</option>\
                <option value="particles">8. Part√≠culas de Grave</option>\
                <option value="floating">9. Picos Flutuantes</option>\
                <option value="matrixcube">10. Matriz C√∫bica</option>\
                <option value="laser">11. Linha Laser Pulsante</option>\
            </select>\
        </div>\
\
        <div class="eq-panel">\
            <h4>ÉøÉÆÉ∫Ô∏ÉØ Regulagem de √Åudio</h4>\
            <div class="eq-slider"><span>ÉøÉ¥É™ Subwoofer / Grave:</span><input type="range" id="bassRange" min="-10" max="30" value="0" oninput="atualizarEqualizador()"></div>\
            <div class="eq-slider"><span>ÉøÉ≥ÉÇ Corneta / M√©dio:</span><input type="range" id="midRange" min="-10" max="20" value="0" oninput="atualizarEqualizador()"></div>\
            <div class="eq-slider"><span>‚É∫ÉÅ Tweeter / Agudo:</span><input type="range" id="trebleRange" min="-10" max="20" value="0" oninput="atualizarEqualizador()"></div>\
            <button id="btnGraveExtreme" class="btn-extreme" onclick="toggleGraveExtreme()">ÉøÉ¥É™ LIGAR GRAVE EXTREME</button>\
        </div>\
\
        <div class="eq-panel">\
            <h4>ÉøÉÆ® Cores & Conjugador RGB</h4>\
            <div class="color-group"><span>Borda Display:</span><input type="color" value="#00d4ff" onchange="mudarCor('--pioneer-border', this.value); mudarCor('--pioneer-blue', this.value)"></div>\
            <div class="color-group"><span>Subwoofer:</span><input type="color" value="#00ff88" onchange="mudarCor('--speaker-sub-color', this.value)"></div>\
            <div class="color-group"><span>Corneta:</span><input type="color" value="#0044ff" onchange="mudarCor('--speaker-horn-color', this.value)"></div>\
            <div class="color-group"><span>Tweeter:</span><input type="color" value="#ff0055" onchange="mudarCor('--speaker-tweet-color', this.value)"></div>\
            <button onclick="toggleConjugadorCores()" id="btnConjugador" style="width:100%; margin-top:5px; background:#9b59b6; color:#fff;">ÉøÉ¨É® LIGAR CONJUGADOR RGB AUTOM√ÅTICO</button>\
        </div>\
\
        <div class="eq-panel">\
            <h4>‚É∫ÉÅ Efeitos de Strobo & Flash</h4>\
            <div class="color-group"><span>Cor do Flash:</span><input type="color" value="#ffffff" onchange="mudarCor('--flash-color', this.value)"></div>\
            <div class="eq-slider"><span>Velocidade Flash (ms):</span><input type="range" id="flashSpeed" min="50" max="1000" value="200"></div>\
            <button onclick="toggleStroboritmo()" id="btnStroboritmo" style="width:100%; margin-bottom:5px;">ÉøÉÆÉ¶ Strobo no Ritmo do Grave</button>\
            <button onclick="toggleFlashManual()" id="btnFlashManual" style="width:100%; background:#e67e22; color:#fff;">ÉøÉ≤ÉÅ Flash Manual Cont√≠nuo</button>\
        </div>\
\
        <div class="eq-panel">\
            <h4>ÉøÉ∂ºÔ∏ÉØ Personaliza√ß√£o de Fundo (GIFs & Fotos)</h4>\
            <select id="tipoFundo" onchange="alterarTipoFundo(this.value)">\
                <option value="solido">1. Cor S√≥lida Customizada</option>\
                <option value="glitter">2. Glitter Animado Neon</option>\
                <option value="gif_fogo">3. Fogo do Pared√£o</option>\
                <option value="gif_matrix">4. Matrix LED Green</option>\
                <option value="gif_galaxy">5. Gal√ÉÅxia Espacial</option>\
                <option value="gif_stars">6. Chuva de Estrelas</option>\
                <option value="gif_cyberpunk">7. Neon Cyberpunk</option>\
                <option value="gif_fogoblue">8. Fogo Azul Veloce</option>\
                <option value="gif_waves">9. Ondas √Åudio Neon</option>\
                <option value="gif_eqdigital">10. Equalizador Digital</option>\
                <option value="gif_lights">11. Chuva de Luzes DJ</option>\
                <option value="foto">12. Foto ou GIF por URL</option>\
            </select>\
            <div class="color-group" id="groupCorFundo">\
                <span>Cor de Fundo:</span><input type="color" value="#0a0b0e" onchange="mudarCor('--bg-color', this.value)">\
            </div>\
            <div id="groupFotoFundo" style="display: none; margin-top: 5px;">\
                <input type="text" id="urlFotoFundo" placeholder="Cole a URL da Foto/GIF...">\
                <button onclick="aplicarFotoFundo()">Aplicar Fundo</button>\
            </div>\
        </div>\
    </div>\
\
    <script>\
        const socket = io();\
        let filaMusicas = [];\
        let listaEspera = [];\
        let indexAtual = 0;\
        let admAutenticado = false;\
        let abaPendente = '';\
        let visualizerMode = 'bars';\
        let radioLigada = true;\
        let conjugadorAtivo = false, conjugadorTimer = null;\
        let stroboRitmoAtivo = false, flashManualAtivo = false, flashInterval = null;\
\
        const audio = document.getElementById('audioElement');\
        const ytPlayer = document.getElementById('ytPlayer');\
        const canvas = document.getElementById('visualizerCanvas');\
        const ctx = canvas.getContext('2d');\
\
        window.onload = () => {\
            const currentUrl = window.location.href;\
            document.getElementById('urlRadio').value = currentUrl;\
            new QRCode(document.getElementById("qrcodeCanvas"), { text: currentUrl, width: 100, height: 100 });\
        };\
\
        let audioCtx, source, analyser, bassNode, midNode, trebleNode, extremeBassNode;\
        let micStream, micSource, micGainNode, micFilterNode;\
        let micAtivo = false;\
        let graveExtremeAtivo = false;\
\
        function toggleLigarRadio() {\
            radioLigada = !radioLigada;\
            const btn = document.getElementById('btnPowerRadio');\
            const status = document.getElementById('status');\
            if (radioLigada) {\
                btn.innerText = "‚É∫ÉÅ DESLIGAR R√ÅDIO PARED√É£O"; btn.classList.add('on');\
                status.innerText = "[ONLINE] R√ÅDIO PARED√É£O NO AR";\
                desbloquearAudio();\
                if (filaMusicas.length > 0) tocarMusica(indexAtual);\
            } else {\
                btn.innerText = "ÉøÉªÉ± LIGAR R√ÅDIO PARED√É£O"; btn.classList.remove('on');\
                status.innerText = "[DESLIGADO] R√ÅDIO PARED√É£O DESLIGADA";\
                audio.pause(); ytPlayer.src = "";\
            }\
        }\
\
        function toggleGearMenu(e) { e.stopPropagation(); const menu = document.getElementById('gearMenu'); menu.style.display = (menu.style.display === 'block') ? 'none' : 'block'; }\
        function solicitarAcesso(aba) {\
            if (admAutenticado) verAba(aba);\
            else { abaPendente = aba; document.getElementById('modalLogin').style.display = 'block'; document.getElementById('gearMenu').style.display = 'none'; }\
        }\
        function validarLogin() {\
            if (document.getElementById('loginEmail').value === "admin@speed.com" && document.getElementById('loginPass').value === "1234") {\
                admAutenticado = true; document.getElementById('modalLogin').style.display = 'none'; verAba(abaPendente);\
            } else alert("Acesso Incorreto!");\
        }\
        function cancelarLogin() { document.getElementById('modalLogin').style.display = 'none'; }\
        function verAba(abaId) {\
            ['abaOuvinte', 'abaAdm', 'abaPedidos', 'abaMic', 'abaCustom'].forEach(id => document.getElementById(id).style.display = 'none');\
            document.getElementById(abaId).style.display = 'block'; document.getElementById('gearMenu').style.display = 'none';\
        }\
\
        function copiarLink() {\
            const input = document.getElementById('urlRadio'); input.select(); document.execCommand('copy'); alert('Link copiado!');\
        }\
\
        function desbloquearAudio() {\
            if (!audioCtx) initAudioContext();\
            else if (audioCtx.state === 'suspended') audioCtx.resume();\
        }\
\
        function initAudioContext() {\
            try {\
                audioCtx = new (window.AudioContext || window.webkitAudioContext)();\
                source = audioCtx.createMediaElementSource(audio);\
                analyser = audioCtx.createAnalyser(); analyser.fftSize = 256;\
\
                bassNode = audioCtx.createBiquadFilter(); bassNode.type = 'lowshelf'; bassNode.frequency.value = 180;\
                midNode = audioCtx.createBiquadFilter(); midNode.type = 'peaking'; midNode.frequency.value = 1000;\
                trebleNode = audioCtx.createBiquadFilter(); trebleNode.type = 'highshelf'; trebleNode.frequency.value = 3500;\
                extremeBassNode = audioCtx.createBiquadFilter(); extremeBassNode.type = 'lowshelf'; extremeBassNode.frequency.value = 70;\
\
                source.connect(bassNode); bassNode.connect(midNode); midNode.connect(trebleNode);\
                trebleNode.connect(extremeBassNode); extremeBassNode.connect(analyser); analyser.connect(audioCtx.destination);\
                renderFrame();\
            } catch(e) {}\
        }\
\
        /* MICROFONE E AFINA√Éß√É£O / PITCH */\
        async function toggleMicrofone() {\
            desbloquearAudio();\
            const btn = document.getElementById('btnMicPower');\
            if (!micAtivo) {\
                try {\
                    micStream = await navigator.mediaDevices.getUserMedia({ audio: true });\
                    micSource = audioCtx.createMediaStreamSource(micStream);\
                    micGainNode = audioCtx.createGain();\
                    micFilterNode = audioCtx.createBiquadFilter();\
                    micFilterNode.type = 'lowpass';\
\
                    micSource.connect(micGainNode);\
                    micGainNode.connect(micFilterNode);\
                    micFilterNode.connect(audioCtx.destination);\
\
                    ajustarMic();\
                    micAtivo = true;\
                    btn.innerText = "ÉøÉÆÉπÔ∏ÉØ DESLIGAR MICROFONE"; btn.style.background = "#2ecc71";\
                } catch (e) { alert("Permiss√£o de Microfone Recusada!"); }\
            } else {\
                if (micStream) micStream.getTracks().forEach(t => t.stop());\
                micAtivo = false;\
                btn.innerText = "ÉøÉÆÉπÔ∏ÉØ LIGAR MICROFONE"; btn.style.background = "#e74c3c";\
            }\
        }\
\
        function ajustarMic() {\
            if (!micAtivo) return;\
            const vol = parseFloat(document.getElementById('micVol').value);\
            const gain = parseFloat(document.getElementById('micGain').value);\
            const pitch = parseFloat(document.getElementById('micPitch').value);\
\
            micGainNode.gain.value = vol * gain;\
            micFilterNode.frequency.value = pitch;\
        }\
\
        function extrairYoutubeId(url) {\
            const regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|\&v=)([^#\&\?]*).*/;\
            const match = url.match(regExp);\
            return (match && match[2].length === 11) ? match[2] : null;\
        }\
\
        function tocarMusica(index) {\
            if (index >= 0 && index < filaMusicas.length) {\
                indexAtual = index;\
                const m = filaMusicas[indexAtual];\
                document.getElementById('status').innerText = "TOCANDO: " + m.nome;\
\
                const ytId = extrairYoutubeId(m.url);\
                if (ytId) {\
                    audio.pause(); audio.style.display = "none";\
                    document.getElementById('ytContainer').style.display = "block";\
                    ytPlayer.src = `https://www.youtube.com/embed/${ytId}?autoplay=1`;\
                } else {\
                    ytPlayer.src = ""; document.getElementById('ytContainer').style.display = "none";\
                    audio.style.display = "block"; audio.src = m.url;\
                    if (radioLigada) audio.play();\
                }\
                atualizarFila();\
            }\
        }\
\
        function carregarArquivosLocais() {\
            const fileInput = document.getElementById('fileInput');\
            if (fileInput.files.length > 0) {\
                for (let i = 0; i < fileInput.files.length; i++) {\
                    const file = fileInput.files[i];\
                    filaMusicas.push({ nome: file.name, url: URL.createObjectURL(file) });\
                }\
                atualizarFila();\
                if (audio.paused && filaMusicas.length > 0) tocarMusica(indexAtual);\
            }\
        }\
\
        function adicionarLinkDj() {\
            const val = document.getElementById('inputLinkDj').value.trim();\
            if (val) {\
                filaMusicas.push({ nome: "Link/V√≠deo Importado", url: val });\
                document.getElementById('inputLinkDj').value = '';\
                atualizarFila();\
                if (audio.paused && filaMusicas.length === 1) tocarMusica(0);\
            }\
        }\
\
        function buscarEAdicionar() {\
            const query = document.getElementById('inputBusca').value.trim();\
            if (query) {\
                const searchUrl = `https://www.youtube.com/results?search_query=${encodeURIComponent(query)}`;\
                filaMusicas.push({ nome: `Busca: ${query}`, url: searchUrl });\
                alert(`Busca registrada! Para tocar, cole o link direto gerado.`);\
                document.getElementById('inputBusca').value = '';\
                atualizarFila();\
            }\
        }\
\
        function enviarPedidoPublico() {\
            const val = document.getElementById('linkMusicaOuvinte').value.trim();\
            if (val) {\
                socket.emit('novoPedido', val);\
                alert('M√∫sica enviada ao DJ!');\
                document.getElementById('linkMusicaOuvinte').value = '';\
            }\
        }\
\
        socket.on('receberPedido', (url) => { listaEspera.push(url); atualizarListaEspera(); });\
\
        function atualizarListaEspera() {\
            const ul = document.getElementById('listaEspera'); ul.innerHTML = '';\
            listaEspera.forEach((url, i) => {\
                ul.innerHTML += `<li><span class="song-title">${url}</span><div><button class="btn-small" onclick="aprovarPedido(${i})">‚ÉºÉ•</button><button class="btn-small btn-danger" onclick="recusarPedido(${i})">‚ÉΩÉ¨</button></div></li>`;\
            });\
        }\
\
        function aprovarPedido(i) {\
            filaMusicas.push({ nome: "Pedido Aprovado", url: listaEspera[i] });\
            listaEspera.splice(i, 1); atualizarListaEspera(); atualizarFila();\
            if (audio.paused && filaMusicas.length === 1) tocarMusica(0);\
        }\
        function recusarPedido(i) { listaEspera.splice(i, 1); atualizarListaEspera(); }\
\
        function pausarEPlay() { if (audio.paused) audio.play(); else audio.pause(); }\
        function proximaMusica() { if (indexAtual + 1 < filaMusicas.length) tocarMusica(indexAtual + 1); }\
        function voltarMusica() { if (indexAtual - 1 >= 0) tocarMusica(indexAtual - 1); }\
        function moverParaCima(i) { if(i>0) { let t=filaMusicas[i]; filaMusicas[i]=filaMusicas[i-1]; filaMusicas[i-1]=t; atualizarFila(); } }\
        function moverParaBaixo(i) { if(i<filaMusicas.length-1) { let t=filaMusicas[i]; filaMusicas[i]=filaMusicas[i+1]; filaMusicas[i+1]=t; atualizarFila(); } }\
        function removerMusica(i) { filaMusicas.splice(i, 1); atualizarFila(); }\
        function limparFila() { filaMusicas = []; audio.pause(); audio.src = ""; ytPlayer.src = ""; atualizarFila(); }\
\
        function atualizarFila() {\
            const lOuv = document.getElementById('filaOuvinte');\
            const lAdm = document.getElementById('filaAdm');\
            lOuv.innerHTML = ''; lAdm.innerHTML = '';\
            filaMusicas.forEach((m, i) => {\
                const st = (i === indexAtual) ? 'style="color:#00ff88; font-weight:bold;"' : '';\
                lOuv.innerHTML += `<li ${st}><span class="song-title">${i + 1}. ${m.nome}</span></li>`;\
                lAdm.innerHTML += `<li ${st}><span class="song-title">${i + 1}. ${m.nome}</span><div><button class="btn-small" onclick="tocarMusica(${i})">‚É∂∂Ô∏ÉØ</button><button class="btn-small" onclick="moverParaCima(${i})">‚¨É¶Ô∏ÉØ</button><button class="btn-small" onclick="moverParaBaixo(${i})">‚¨ÉßÔ∏ÉØ</button><button class="btn-small btn-danger" onclick="removerMusica(${i})">‚ÉΩÉ¨</button></div></li>`;\
            });\
        }\
\
        function renderFrame() {\
            requestAnimationFrame(renderFrame);\
            if (!analyser || !radioLigada) return;\
            const bufferLength = analyser.frequencyBinCount;\
            const dataArray = new Uint8Array(bufferLength);\
            analyser.getByteFrequencyData(dataArray);\
\
            let bassSum = 0; for (let i = 0; i < 10; i++) bassSum += dataArray[i];\
            let bassAvg = bassSum / 10;\
            const subScale = 1 + (bassAvg / 255) * 0.28;\
            document.querySelectorAll('.subElem').forEach(el => el.style.transform = `scale(${subScale})`);\
\
            const paredao = document.getElementById('paredaoContainer');\
            if (bassAvg > 180) {\
                paredao.classList.add('shake-effect');\
                if (stroboRitmoAtivo) {\
                    document.body.style.backgroundColor = getComputedStyle(document.documentElement).getPropertyValue('--flash-color').trim() || '#ffffff';\
                    setTimeout(() => { document.body.style.backgroundColor = getComputedStyle(document.documentElement).getPropertyValue('--bg-color').trim(); }, 40);\
                }\
            } else paredao.classList.remove('shake-effect');\
\
            ctx.clearRect(0, 0, canvas.width, canvas.height);\
            const lineColor = getComputedStyle(document.documentElement).getPropertyValue('--pioneer-blue').trim() || '#00d4ff';\
\
            if (visualizerMode === 'bars') {\
                const barWidth = (canvas.width / bufferLength) * 2.5; let x = 0;\
                for (let i = 0; i < bufferLength; i++) {\
                    const barHeight = dataArray[i] / 3.5;\
                    ctx.fillStyle = lineColor; ctx.fillRect(x, canvas.height - barHeight, barWidth, barHeight);\
                    x += barWidth + 1;\
                }\
            } else if (visualizerMode === 'wave') {\
                ctx.beginPath(); ctx.lineWidth = 2; ctx.strokeStyle = lineColor;\
                const sliceWidth = canvas.width / bufferLength; let x = 0;\
                for (let i = 0; i < bufferLength; i++) {\
                    const v = dataArray[i] / 128.0; const y = (v * canvas.height) / 2;\
                    if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);\
                    x += sliceWidth;\
                }\
                ctx.stroke();\
            } else {\
                const barWidth = (canvas.width / bufferLength) * 2.5; let x = 0;\
                for (let i = 0; i < bufferLength; i++) {\
                    ctx.fillStyle = lineColor; ctx.fillRect(x, canvas.height - (dataArray[i]/3), barWidth, dataArray[i]/3);\
                    x += barWidth + 1;\
                }\
            }\
        }\
\
        function mudarEstiloVisualizer(v) { visualizerMode = v; }\
        function atualizarEqualizador() {\
            if (!audioCtx) return;\
            bassNode.gain.value = parseFloat(document.getElementById('bassRange').value);\
            midNode.gain.value = parseFloat(document.getElementById('midRange').value);\
            trebleNode.gain.value = parseFloat(document.getElementById('trebleRange').value);\
        }\
        function toggleGraveExtreme() {\
            if (!audioCtx) return;\
            graveExtremeAtivo = !graveExtremeAtivo;\
            const btn = document.getElementById('btnGraveExtreme');\
            extremeBassNode.gain.value = graveExtremeAtivo ? 25 : 0;\
            btn.innerText = graveExtremeAtivo ? "ÉøÉ≤• GRAVE EXTREME ATIVADO" : "ÉøÉ¥É™ LIGAR GRAVE EXTREME";\
        }\
        function mudarCor(variable, value) { document.documentElement.style.setProperty(variable, value); }\
\
        function toggleConjugadorCores() {\
            conjugadorAtivo = !conjugadorAtivo;\
            const btn = document.getElementById('btnConjugador');\
            if(conjugadorAtivo) {\
                btn.innerText = "ÉøÉ¨É® DESLIGAR CONJUGADOR RGB";\
                let hue = 0;\
                conjugadorTimer = setInterval(() => {\
                    hue = (hue + 10) % 360;\
                    mudarCor('--speaker-sub-color', `hsl(${hue}, 100%, 50%)`);\
                    mudarCor('--speaker-horn-color', `hsl(${(hue+120)%360}, 100%, 50%)`);\
                    mudarCor('--speaker-tweet-color', `hsl(${(hue+240)%360}, 100%, 50%)`);\
                }, 150);\
            } else { btn.innerText = "ÉøÉ¨É® LIGAR CONJUGADOR RGB AUTOM√ÅTICO"; clearInterval(conjugadorTimer); }\
        }\
\
        function toggleStroboritmo() {\
            stroboRitmoAtivo = !stroboRitmoAtivo;\
            document.getElementById('btnStroboritmo').innerText = stroboRitmoAtivo ? "ÉøÉÆÉ¶ Desligar Strobo Grave" : "ÉøÉÆÉ¶ Strobo no Ritmo do Grave";\
        }\
\
        function toggleFlashManual() {\
            flashManualAtivo = !flashManualAtivo;\
            const btn = document.getElementById('btnFlashManual');\
            if(flashManualAtivo) {\
                btn.innerText = "ÉøÉ≤ÉÅ Desligar Flash Manual";\
                let flag = false;\
                flashInterval = setInterval(() => {\
                    document.body.style.backgroundColor = flag ? getComputedStyle(document.documentElement).getPropertyValue('--flash-color').trim() : getComputedStyle(document.documentElement).getPropertyValue('--bg-color').trim();\
                    flag = !flag;\
                }, parseInt(document.getElementById('flashSpeed').value));\
            } else {\
                btn.innerText = "ÉøÉ≤ÉÅ Flash Manual Cont√≠nuo"; clearInterval(flashInterval);\
                document.body.style.backgroundColor = getComputedStyle(document.documentElement).getPropertyValue('--bg-color').trim();\
            }\
        }\
\
        function alterarTipoFundo(val) {\
            document.body.className = ''; document.body.style.backgroundImage = 'none';\
            document.getElementById('groupCorFundo').style.display = 'none';\
            document.getElementById('groupFotoFundo').style.display = 'none';\
            if (val === 'solido') document.getElementById('groupCorFundo').style.display = 'flex';\
            else if (val === 'foto') document.getElementById('groupFotoFundo').style.display = 'block';\
            else document.body.classList.add(val);\
        }\
\
        function aplicarFotoFundo() {\
            const url = document.getElementById('urlFotoFundo').value;\
            if (url) { document.body.className = ''; document.body.style.backgroundImage = `url('${url}')`; }\
        }\
    </script>\
</body>\
</html>\
EOF\

