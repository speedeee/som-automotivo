<!DOCTYPE html>\
<html lang="pt-BR">\
<head>\
    <meta charset="UTF-8">\
    <meta name="viewport" content="width=device-width, initial-scale=1.0">\
    <title>‚É∫ÉÅ SPEED R√ÅDIO - SAVEIRO PARED√É£O PRO</title>\
    <script src="/socket.io/socket.io.js"></script>\
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>\
    <style>\
        *, *::before, *::after { box-sizing: border-box; }\
        :root { \
            --bg-color: #0a0b0e; \
            --pioneer-frame-bg: linear-gradient(145deg, #1f232a, #0d0e12);\
            --pioneer-border: #00d4ff;\
            --pioneer-blue: #00d4ff; \
            --pioneer-glow: rgba(0, 212, 255, 0.4);\
            --speaker-sub-color: #00ff88;\
            --speaker-horn-color: #0044ff;\
            --speaker-tweet-color: #ff0055;\
            --btn-bg: #00d4ff;\
            --btn-text: #000000;\
            --text-color: #00d4ff;\
            --flash-color: #ffffff;\
        }\
\
        html, body { width: 100%; min-height: 100vh; margin: 0; padding: 0; }\
        body { \
            background-color: var(--bg-color); \
            background-size: cover; background-position: center; background-repeat: no-repeat; background-attachment: fixed;\
            color: #fff; font-family: 'Courier New', Courier, monospace; text-align: center; padding: 10px; transition: background 0.2s ease;\
        }\
\
        /* GIFS & ANIMATIONS */\
        body.glitter-bg {\
            background-image: radial-gradient(circle, #ffffff 1px, transparent 1px), radial-gradient(circle, #ff007f 1px, transparent 1px);\
            background-size: 25px 25px, 35px 35px; animation: glitterAnim 1.2s infinite linear;\
        }\
        @keyframes glitterAnim { 0% { background-position: 0 0, 10px 10px; } 50% { background-position: 15px 25px, 25px 5px; } 100% { background-position: 0 0, 10px 10px; } }\
        body.gif-fogo { background-image: url('https://i.gifer.com/13i.gif') !important; }\
        body.gif-matrix { background-image: url('https://i.gifer.com/7S8E.gif') !important; }\
        body.gif-galaxy { background-image: url('https://i.gifer.com/S2mP.gif') !important; }\
        body.gif-stars { background-image: url('https://i.gifer.com/4S0.gif') !important; }\
        body.gif-cyberpunk { background-image: url('https://i.gifer.com/9C.gif') !important; }\
        body.gif-fogoblue { background-image: url('https://i.gifer.com/71d.gif') !important; }\
        body.gif-waves { background-image: url('https://i.gifer.com/7Scq.gif') !important; }\
        body.gif-eqdigital { background-image: url('https://i.gifer.com/U8.gif') !important; }\
        body.gif-lights { background-image: url('https://i.gifer.com/39G.gif') !important; }\
\
        .gear-container { position: fixed; top: 10px; right: 10px; z-index: 1000; }\
        .gear-btn { background: #1f232a; border: 2px solid var(--pioneer-border); color: #fff; padding: 10px 14px; border-radius: 50%; cursor: pointer; font-size: 18px; box-shadow: 0 0 10px var(--pioneer-glow); }\
        .gear-menu { display: none; position: absolute; right: 0; top: 45px; background: #111318; border: 2px solid var(--pioneer-border); padding: 10px; border-radius: 10px; width: 230px; box-shadow: 0 8px 20px rgba(0,0,0,0.9); text-align: left; }\
        .gear-menu button { width: 100%; margin: 4px 0; font-size: 11px; padding: 8px; background: var(--btn-bg); color: var(--btn-text); border: none; border-radius: 5px; font-weight: bold; cursor: pointer; }\
\
        .pioneer-frame { background: var(--pioneer-frame-bg); border: 4px solid var(--pioneer-border); border-radius: 18px; padding: 15px; max-width: 650px; margin: 35px auto 15px auto; box-shadow: 0 10px 30px rgba(0,0,0,0.9), 0 0 15px var(--pioneer-glow); position: relative; }\
        .lcd-display { background: #00121a; border: 3px solid #002b3d; border-radius: 8px; padding: 10px; color: var(--text-color); margin-bottom: 12px; }\
\
        .wall-container-saveiro { background: #08090c; border: 3px solid #1f232a; border-radius: 12px; padding: 10px 5px; margin: 10px 0; display: flex; flex-direction: column; gap: 8px; }\
        .rack-top, .rack-bottom { display: flex; justify-content: space-around; align-items: center; background: #111318; padding: 6px; border-radius: 8px; }\
\
        .shake-effect { animation: tremor 0.05s infinite alternate; }\
        @keyframes tremor { 0% { transform: translate(2px, 1px); } 100% { transform: translate(-2px, -1px); } }\
\
        .subwoofer-saveiro { width: 75px; height: 75px; background: radial-gradient(circle, #222 10%, #111 50%, #000 100%); border: 4px solid #333; border-radius: 50%; display: flex; justify-content: center; align-items: center; transition: transform 0.03s ease; }\
        .subwoofer-saveiro::before { content: 'SDS'; font-size: 9px; font-weight: bold; color: #fff; width: 42px; height: 42px; background: radial-gradient(circle, var(--speaker-sub-color) 15%, #111 90%); border-radius: 50%; border: 2px solid #000; display: flex; align-items: center; justify-content: center; }\
\
        .horn-saveiro { width: 42px; height: 42px; background: #15171c; border: 2px solid #333; border-radius: 50%; display: flex; justify-content: center; align-items: center; }\
        .horn-saveiro-inner { width: 28px; height: 28px; background: radial-gradient(circle, var(--speaker-horn-color) 10%, #000 80%); border-radius: 50%; }\
\
        .tweeter-saveiro { width: 28px; height: 28px; background: #1a1a1a; border: 2px solid #444; border-radius: 4px; display: flex; justify-content: center; align-items: center; }\
        .tweeter-saveiro-core { width: 10px; height: 10px; background: var(--speaker-tweet-color); border-radius: 50%; }\
\
        .box-link { background: rgba(0, 212, 255, 0.05); border: 1px dashed var(--pioneer-blue); border-radius: 6px; padding: 8px; margin: 10px 0; display: flex; flex-direction: column; align-items: center; gap: 5px; }\
        .box-link input { width: 90%; text-align: center; font-size: 11px; background: #000; color: var(--text-color); border: 1px solid #005577; padding: 5px; }\
\
        input[type="text"], input[type="email"], input[type="password"], select { width: 90%; padding: 8px; border-radius: 5px; border: 1px solid #005577; background: #00121a; color: #fff; margin-bottom: 8px; font-size: 12px; }\
        button { padding: 8px 12px; border-radius: 6px; border: none; background: var(--btn-bg); color: var(--btn-text); font-weight: bold; cursor: pointer; margin: 2px; }\
        .btn-power { background: #e74c3c; color: #fff; font-size: 13px; padding: 8px; border-radius: 8px; font-weight: bold; width: 100%; margin-bottom: 8px; }\
        .btn-power.on { background: #2ecc71 !important; }\
        .btn-danger { background: #e74c3c !important; color: #fff !important; }\
        .btn-extreme { background: #ff0055 !important; color: #fff !important; width: 100%; padding: 8px; }\
        .btn-small { padding: 3px 6px; font-size: 10px; margin: 0 1px; }\
\
        canvas { width: 100%; height: 65px; display: block; }\
        .eq-panel { background: rgba(0,0,0,0.6); padding: 10px; border-radius: 8px; border: 1px solid #003344; margin: 8px 0; text-align: left; }\
        .eq-slider { display: flex; justify-content: space-between; align-items: center; margin: 6px 0; font-size: 11px; }\
        .eq-slider input { width: 50%; }\
\
        ol, ul { text-align: left; background: rgba(0, 212, 255, 0.05); padding: 8px; border-radius: 5px; max-height: 180px; overflow-y: auto; border: 1px solid #003344; color: var(--text-color); font-size: 11px; list-style: none; }\
        li { margin-bottom: 4px; border-bottom: 1px solid #002b3d; padding-bottom: 3px; display: flex; justify-content: space-between; align-items: center; gap: 5px; }\
        .song-title { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\
        .color-group { display: flex; align-items: center; justify-content: space-between; margin: 6px 0; font-size: 11px; }\
        .color-group input[type="color"] { border: none; width: 35px; height: 25px; cursor: pointer; background: none; }\
        iframe { width: 100%; height: 180px; border: none; border-radius: 8px; margin-top: 5px; }\
    </style>\
</head>\
<body onclick="desbloquearAudio()">\
\
    <div class="gear-container">\
        <button class="gear-btn" onclick="toggleGearMenu(event)">‚É∫ÉπÔ∏ÉØ MENU</button>\
        <div id="gearMenu" class="gear-menu">\
            <button onclick="verAba('abaOuvinte')">ÉøÉ≥ª Display Pioneer (P√∫blico)</button>\
            <button onclick="solicitarAcesso('abaAdm')">ÉøÉÆÉªÔ∏ÉØ Mesa DJ & M√≠dia</button>\
            <button onclick="solicitarAcesso('abaPedidos')">ÉøÉ≥• Pedidos da Galera</button>\
            <button onclick="solicitarAcesso('abaMic')">ÉøÉÆÉπÔ∏ÉØ Microfone & Efeitos</button>\
