<!DOCTYPE html>\
<html lang="pt-BR">\
<head>\
  <meta charset="UTF-8">\
  <meta name="viewport" content="width=device-width, initial-scale=1.0">\
  <title>Simulador & Configurador de Som Automotivo Pro</title>\
  <style>\
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, sans-serif; }\
    body { background-color: #0b0d12; color: #e1e7ef; padding: 15px; display: flex; justify-content: center; }\
    .container { max-width: 850px; width: 100%; background: #131722; padding: 20px; border-radius: 12px; border: 1px solid #232838; box-shadow: 0 10px 25px rgba(0,0,0,0.6); }\
    h1 { text-align: center; color: #ff3366; margin-bottom: 20px; font-size: 1.4rem; text-transform: uppercase; }\
    \
    .section { background: #1a1f2c; padding: 15px; border-radius: 8px; margin-bottom: 15px; border-left: 4px solid #ff3366; }\
    .section h2 { color: #00d2ff; font-size: 1rem; margin-bottom: 10px; }\
    .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 10px; }\
    label { display: block; font-size: 0.8rem; color: #94a3b8; margin-bottom: 4px; }\
    select, input, textarea { width: 100%; padding: 8px; border-radius: 6px; border: 1px solid #334155; background: #0f121a; color: #fff; font-size: 0.85rem; }\
\
    /* VOLT√É≠METRO DIGITAL REALTIME */\
    .voltmeter-card { background: #080a0f; border: 2px solid #ff3366; border-radius: 10px; padding: 12px; text-align: center; margin-bottom: 15px; box-shadow: 0 0 15px rgba(255, 51, 102, 0.2); }\
    .voltmeter-display { font-size: 2.2rem; font-weight: bold; font-family: monospace; color: #00ffcc; text-shadow: 0 0 10px rgba(0, 255, 204, 0.6); letter-spacing: 2px; }\
    .voltmeter-status { font-size: 0.8rem; font-weight: bold; margin-top: 4px; text-transform: uppercase; }\
\
    /* PALCO VIRTUAL */\
    .sound-stage { background: #08090d; border-radius: 10px; padding: 20px; text-align: center; margin: 15px 0; border: 2px solid #00d2ff; }\
    .speakers-container { display: flex; justify-content: center; align-items: center; gap: 15px; margin-top: 10px; flex-wrap: wrap; min-height: 120px; }\
    .woofer { width: 90px; height: 90px; border-radius: 50%; background: radial-gradient(circle, #222 30%, #111 70%, #444 100%); border: 5px solid #333; display: flex; justify-content: center; align-items: center; transition: transform 0.03s ease; }\
    .woofer-inner { width: 35px; height: 35px; border-radius: 50%; background: #050505; border: 2px solid #555; }\
    .horn { width: 40px; height: 40px; background: #222; border: 2px solid #888; display: flex; justify-content: center; align-items: center; color: #aaa; font-size: 0.65rem; font-weight: bold; }\
    .horn.square { border-radius: 4px; }\
    .horn.round { border-radius: 50%; }\
\
    /* PLAYER DE M√É∫SICA */\
    .player-controls { background: #111520; padding: 12px; border-radius: 8px; border: 1px solid #00d2ff; }\
    .controls-btn-group { display: flex; gap: 8px; margin-top: 10px; }\
    .controls-btn-group button { margin-top: 0; }\
    \
    .playlist-box { margin-top: 12px; background: #0a0c10; border: 1px solid #232838; border-radius: 6px; padding: 10px; max-height: 180px; overflow-y: auto; }\
    .playlist-box ol { padding-left: 20px; }\
    .playlist-box li { font-size: 0.82rem; color: #94a3b8; padding: 6px 10px; border-radius: 4px; cursor: pointer; margin-bottom: 4px; background: #131722; word-break: break-all; }\
    .playlist-box li.active { background: #ff3366; color: #fff; font-weight: bold; }\
\
    /* REGULADORES DSP / EQUALIZADOR */\
    .dsp-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px; margin-top: 10px; }\
    .dsp-card { background: #0f121a; border: 1px solid #334155; padding: 10px; border-radius: 6px; text-align: center; }\
    .dsp-card span { font-size: 0.8rem; font-weight: bold; color: #00d2ff; display: block; margin-top: 4px; }\
    .dsp-slider { width: 100%; margin-top: 6px; cursor: pointer; }\
\
    button { width: 100%; padding: 10px; background: linear-gradient(45deg, #ff3366, #ff6533); border: none; border-radius: 6px; color: #fff; font-weight: bold; cursor: pointer; margin-top: 8px; font-size: 0.9rem; }\
    .output-box { background: #0f121a; border: 1px solid #00d2ff; border-radius: 8px; padding: 15px; white-space: pre-wrap; font-family: monospace; font-size: 0.8rem; color: #00ffcc; margin-top: 10px; }\
  </style>\
</head>\
<body>\
  <div class="container">\
    <h1>ÉøÉ¥É™ SIMULADOR & CONFIGURADOR DE SOM PRO</h1>\
\
    <div class="voltmeter-card">\
      <label style="color:#aaa; font-weight:bold;">‚É∫ÉÅ VOLT√É≠METRO AUTOMOTIVO DIGITAL (BARRAMENTO)</label>\
      <div class="voltmeter-display" id="voltmeterDisplay">12.6 V</div>\
      <div class="voltmeter-status" id="voltmeterStatus" style="color: #00ffcc;">SISTEMA EM STANDBY</div>\
    </div>\
\
    <div class="sound-stage" id="stage">\
      <p style="font-size:0.75rem; color:#aaa;">PALCO VIRTUAL DO SOM AUTOMOTIVO</p>\
      <div class="speakers-container" id="speakersBox"></div>\
    </div>\
\
    <div class="section">\
      <h2>1. Componentes e Pot√™ncia</h2>\
      <div class="grid">\
        <div>\
          <label>Player Central:</label>\
          <select id="player">\
            <option>Pioneer MVH-X3000BR (Graves Xtreme)</option>\
            <option>Stetsom Player Bluetooth</option>\
            <option>Expert Electronics Central</option>\
          </select>\
        </div>\
        <div>\
          <label>Tamanho do Woofer:</label>\
          <select id="wooferSize" onchange="atualizarPalco()">\
            <option value="12">12" (Grave Seco)</option>\
            <option value="15" selected>15" (Grave Misto / Pared√£o)</option>\
            <option value="18">18" (Subgrave Profundo)</option>\
          </select>\
        </div>\
        <div>\
          <label>Qtd de Woofers:</label>\
          <input type="number" id="wooferQty" value="2" min="1" max="6" onchange="atualizarPalco()">\
        </div>\
        <div>\
          <label>Pot√™ncia RMS por Falante:</label>\
          <input type="number" id="wooferRms" value="1500">\
        </div>\
      </div>\
    </div>\
\
    <div class="section">\
      <h2>2. Drivers e Cornetas</h2>\
      <div class="grid">\
        <div>\
          <label>Formato Corneta:</label>\
          <select id="hornFormat" onchange="atualizarPalco()"><option value="round">Redonda</option><option value="square">Quadrada</option></select>\
        </div>\
        <div>\
          <label>Material Corneta:</label>\
          <select id="hornMaterial"><option>Alum√≠nio</option><option>Pl√ÉÅstico ABS</option></select>\
        </div>\
      </div>\
    </div>\
\
    <div class="section">\
      <h2>ÉøÉ≥ª Player de M√∫sica</h2>\
      <div class="player-controls">\
        <label>ÉøÉ≥Å Selecionar M√∫sicas do Celular (.mp3 / .wav):</label>\
        <input type="file" id="audioFile" accept="audio/*" multiple>\
\
        <div style="margin-top: 10px;">\
          <p id="currentTrackDisplay" style="font-size:0.85rem; color:#00d2ff; font-weight:bold;">Nenhuma m√∫sica tocando</p>\
        </div>\
\
        <audio id="mainAudio" style="width:100%; margin-top:8px;" controls></audio>\
\
        <div class="controls-btn-group">\
          <button onclick="prevTrack()" style="background:#334155;">‚ÉØÆÔ∏ÉØ Anterior</button>\
          <button onclick="togglePlay()" style="background:#00d2ff; color:#000;">‚ÉØØÔ∏ÉØ Play/Pausa</button>\
          <button onclick="nextTrack()" style="background:#334155;">Pr√≥xima ‚ÉØ≠Ô∏ÉØ</button>\
        </div>\
\
        <div class="playlist-box">\
          <p style="font-size:0.75rem; color:#00d2ff; margin-bottom:6px; font-weight:bold;">ÉøÉ≥É´ LISTA DE M√É∫SICAS:</p>\
          <ol id="playlistList">\
            <li style="background:transparent; color:#666; list-style:none;">Nenhuma m√∫sica selecionada.</li>\
          </ol>\
        </div>\
      </div>\
    </div>\
\
    <div class="section">\
      <h2>ÉøÉÆÉªÔ∏ÉØ Processador de √Åudio DSP / Equalizador (Ajuste o Som em Tempo Real)</h2>\
      <div class="dsp-grid">\
        <div class="dsp-card">\
          <label>ÉøÉ¥É™ Grave / Subwoofer</label>\
          <input type="range" class="dsp-slider" id="bassGain" min="-12" max="15" value="6" oninput="updateBass(this.value)">\
          <span id="bassValDisplay">+6 dB</span>\
        </div>\
        <div class="dsp-card">\
          <label>ÉøÉÆÉªÔ∏ÉØ M√©dio-Grave</label>\
          <input type="range" class="dsp-slider" id="midGain" min="-12" max="15" value="0" oninput="updateMid(this.value)">\
          <span id="midValDisplay">0 dB</span>\
        </div>\
        <div class="dsp-card">\
          <label>ÉøÉ≥ÉÇ Cornetas / Drivers</label>\
          <input type="range" class="dsp-slider" id="driverGain" min="-12" max="15" value="2" oninput="updateDriver(this.value)">\
          <span id="driverValDisplay">+2 dB</span>\
        </div>\
        <div class="dsp-card">\
          <label>‚Éº® Tweeters / Agudos</label>\
          <input type="range" class="dsp-slider" id="tweeterGain" min="-12" max="15" value="3" oninput="updateTweeter(this.value)">\
          <span id="tweeterValDisplay">+3 dB</span>\
        </div>\
      </div>\
    </div>\
\
    <button onclick="gerarProjeto()">‚É∫ÉÅ CALCULAR TUDO & GERAR SCRIPT COMPLETO</button>\
\
    <div class="section" style="margin-top:15px;">\
      <h2>ÉøÉ≥É™ Script de Montagem, El√©trica e DSP</h2>\
      <div class="output-box" id="relatorioOutput">Clique no bot√£o acima para gerar a configura√ß√£o...</div>\
    </div>\
  </div>\
\
  <script>\
    let audioCtx, source, bassFilter, midFilter, driverFilter, tweeterFilter, analyser;\
    let playlist = [];\
    let currentIndex = 0;\
\
    const audio = document.getElementById('mainAudio');\
    const fileInput = document.getElementById('audioFile');\
\
    fileInput.addEventListener('change', function(e) {\
      const files = Array.from(e.target.files);\
      if (files.length === 0) return;\
\
      playlist = files.map(file => ({\
        name: file.name,\
        url: URL.createObjectURL(file)\
      }));\
\
      renderPlaylist();\
      playTrack(0);\
    });\
\
    function initAudioEngine() {\
      if (!audioCtx) {\
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();\
        source = audioCtx.createMediaElementSource(audio);\
\
        // 1. Filtro de Grave / Subwoofer (80Hz Lowshelf)\
        bassFilter = audioCtx.createBiquadFilter();\
        bassFilter.type = 'lowshelf';\
        bassFilter.frequency.value = 80;\
        bassFilter.gain.value = parseFloat(document.getElementById('bassGain').value);\
\
        // 2. Filtro de M√©dios (800Hz Peaking)\
        midFilter = audioCtx.createBiquadFilter();\
        midFilter.type = 'peaking';\
        midFilter.frequency.value = 800;\
        midFilter.gain.value = parseFloat(document.getElementById('midGain').value);\
\
        // 3. Filtro de Cornetas / Drivers (3000Hz Peaking)\
        driverFilter = audioCtx.createBiquadFilter();\
        driverFilter.type = 'peaking';\
        driverFilter.frequency.value = 3000;\
        driverFilter.gain.value = parseFloat(document.getElementById('driverGain').value);\
\
        // 4. Filtro de Tweeters / Agudos (9000Hz Highshelf)\
        tweeterFilter = audioCtx.createBiquadFilter();\
        tweeterFilter.type = 'highshelf';\
        tweeterFilter.frequency.value = 9000;\
        tweeterFilter.gain.value = parseFloat(document.getElementById('tweeterGain').value);\
\
        // Analisador para o Volt√≠metro\
        analyser = audioCtx.createAnalyser();\
        analyser.fftSize = 256;\
\
        // Conectar Cadeia de √Åudio\
        source.connect(bassFilter);\
        bassFilter.connect(midFilter);\
        midFilter.connect(driverFilter);\
        driverFilter.connect(tweeterFilter);\
        tweeterFilter.connect(analyser);\
        analyser.connect(audioCtx.destination);\
\
        monitorVoltmeterRealtime();\
      } else if (audioCtx.state === 'suspended') {\
        audioCtx.resume();\
      }\
    }\
\
    function monitorVoltmeterRealtime() {\
      const bufferLength = analyser.frequencyBinCount;\
      const dataArray = new Uint8Array(bufferLength);\
\
      function update() {\
        requestAnimationFrame(update);\
\
        if (audio.paused) {\
          document.getElementById('voltmeterDisplay').innerText = "12.6 V";\
          document.getElementById('voltmeterStatus').innerText = "SISTEMA EM STANDBY";\
          document.getElementById('voltmeterStatus').style.color = "#00ffcc";\
          document.querySelectorAll('.woofer').forEach(w => w.style.transform = 'scale(1)');\
          return;\
        }\
\
        analyser.getByteFrequencyData(dataArray);\
\
        // Somar energia das frequ√™ncias graves (bins 0 a 8)\
        let bassSum = 0;\
        for(let i = 0; i < 8; i++) bassSum += dataArray[i];\
        let bassAvg = bassSum / 8; // Range 0 - 255\
\
        // Pega par√ÉÇmetros do som do usu√ÉÅrio\
        let rmsVal = parseFloat(document.getElementById('wooferRms').value) || 1500;\
        let qty = parseInt(document.getElementById('wooferQty').value) || 2;\
        let totalWatts = rmsVal * qty;\
        let bassGainBoost = parseFloat(document.getElementById('bassGain').value) || 0;\
\
        // C√ÉÅlculo din√ÉÇmico da queda de tens√£o (Volt√≠metro)\
        let loadFactor = (bassAvg / 255) * (1 + bassGainBoost / 12) * (totalWatts / 3000);\
        let voltageDrop = loadFactor * 1.8;\
        let currentVoltage = 12.6 - voltageDrop - (Math.random() * 0.08);\
\
        if (currentVoltage < 10.5) currentVoltage = 10.5;\
\
        const voltElem = document.getElementById('voltmeterDisplay');\
        const statusElem = document.getElementById('voltmeterStatus');\
\
        voltElem.innerText = currentVoltage.toFixed(1) + " V";\
\
        if (currentVoltage < 11.4) {\
          voltElem.style.color = "#ff3333";\
          statusElem.innerText = "‚É∫ÉÄÔ∏ÉØ BASS DROP! QUEDA CR√É≠TICA NO BARRAMENTO";\
          statusElem.style.color = "#ff3333";\
        } else if (currentVoltage < 12.1) {\
          voltElem.style.color = "#ffcc00";\
          statusElem.innerText = "‚É∫ÉÅ CONSUMINDO BATERIA (GRAVE FORTE)";\
          statusElem.style.color = "#ffcc00";\
        } else {\
          voltElem.style.color = "#00ffcc";\
          statusElem.innerText = "‚ÉºÉ• TENS√É£O EST√ÅVEL (BARRAMENTO OK)";\
          statusElem.style.color = "#00ffcc";\
        }\
\
        // Anima√ß√£o Woofers pulsando no Grave\
        let scale = 1 + (bassAvg / 255) * 0.22;\
        document.querySelectorAll('.woofer').forEach(w => {\
          w.style.transform = `scale(${scale})`;\
        });\
      }\
\
      update();\
    }\
\
    // Fun√ß√µes do DSP (Ajustes de Ganho)\
    function updateBass(val) {\
      document.getElementById('bassValDisplay').innerText = (val > 0 ? '+' : '') + val + ' dB';\
      if (bassFilter) bassFilter.gain.value = parseFloat(val);\
    }\
    function updateMid(val) {\
      document.getElementById('midValDisplay').innerText = (val > 0 ? '+' : '') + val + ' dB';\
      if (midFilter) midFilter.gain.value = parseFloat(val);\
    }\
    function updateDriver(val) {\
      document.getElementById('driverValDisplay').innerText = (val > 0 ? '+' : '') + val + ' dB';\
      if (driverFilter) driverFilter.gain.value = parseFloat(val);\
    }\
    function updateTweeter(val) {\
      document.getElementById('tweeterValDisplay').innerText = (val > 0 ? '+' : '') + val + ' dB';\
      if (tweeterFilter) tweeterFilter.gain.value = parseFloat(val);\
    }\
\
    function renderPlaylist() {\
      const list = document.getElementById('playlistList');\
      list.innerHTML = '';\
      playlist.forEach((item, index) => {\
        const li = document.createElement('li');\
        li.innerText = (index + 1) + ". " + item.name;\
        if (index === currentIndex) li.className = 'active';\
        li.onclick = () => playTrack(index);\
        list.appendChild(li);\
      });\
    }\
\
    function playTrack(index) {\
      if (playlist.length === 0) return;\
      currentIndex = index;\
      audio.src = playlist[currentIndex].url;\
      document.getElementById('currentTrackDisplay').innerText = "Tocando (" + (currentIndex + 1) + "/" + playlist.length + "): " + playlist[currentIndex].name;\
\
      initAudioEngine();\
      audio.play().catch(e => console.log("Aguardando interacao"));\
      renderPlaylist();\
    }\
\
    function togglePlay() {\
      if (!audio.src && playlist.length > 0) playTrack(0);\
      else if (audio.paused) {\
        initAudioEngine();\
        audio.play();\
      } else {\
        audio.pause();\
      }\
    }\
\
    function nextTrack() {\
      if (playlist.length === 0) return;\
      currentIndex = (currentIndex + 1) % playlist.length;\
      playTrack(currentIndex);\
    }\
\
    function prevTrack() {\
      if (playlist.length === 0) return;\
      currentIndex = (currentIndex - 1 + playlist.length) % playlist.length;\
      playTrack(currentIndex);\
    }\
\
    audio.onended = nextTrack;\
\
    function atualizarPalco() {\
      const qty = parseInt(document.getElementById('wooferQty').value) || 2;\
      const size = document.getElementById('wooferSize').value;\
      const format = document.getElementById('hornFormat').value;\
      const container = document.getElementById('speakersBox');\
\
      container.innerHTML = '';\
\
      for(let i=0; i<2; i++) {\
        const horn = document.createElement('div');\
        horn.className = 'horn ' + format;\
        horn.innerText = 'DRIVER';\
        container.appendChild(horn);\
      }\
\
      for(let i=0; i<qty; i++) {\
        const w = document.createElement('div');\
        w.className = 'woofer';\
        w.style.width = size == '18' ? '110px' : (size == '15' ? '90px' : '75px');\
        w.style.height = w.style.width;\
        w.innerHTML = '<div class="woofer-inner"></div>';\
        container.appendChild(w);\
      }\
    }\
\
    function gerarProjeto() {\
      const p = document.getElementById('player').value;\
      const size = document.getElementById('wooferSize').value;\
      const qty = parseInt(document.getElementById('wooferQty').value) || 2;\
      const rms = parseInt(document.getElementById('wooferRms').value) || 1500;\
      const fmt = document.getElementById('hornFormat').value;\
      const mat = document.getElementById('hornMaterial').value;\
\
      const totalRms = (qty * rms) + 800;\
      const batAh = Math.round(totalRms / 20);\
      const cabo = totalRms <= 3000 ? "35mm¬≤" : "50mm¬≤";\
      const disj = totalRms <= 3000 ? "150A" : "200A";\
\
      document.getElementById('relatorioOutput').textContent = \
"=======================================================\n" +\
"ÉøÉªÉÄÔ∏ÉØ RELAT√É≥RIO DO SISTEMA AUTOMOTIVO PRO\n" +\
"=======================================================\n\n" +\
"ÉøÉ≥ª PLAYER CENTRAL:\n  ‚ÄÉÇ modelo: " + p + "\n\n" +\
"ÉøÉ¥É™ CAIXA & FALANTES:\n" +\
"  ‚ÄÉÇ " + qty + "x Woofers de " + size + '" (' + rms + "W RMS cada)\n" +\
"  ‚ÄÉÇ 2x Cornetas " + (fmt === 'square' ? 'Quadradas' : 'Redondas') + " de " + mat + "\n\n" +\
"‚É∫ÉÅ EL√É©TRICA E BARRAMENTO (~" + totalRms + "W RMS Total):\n" +\
"  ‚ÄÉÇ Bateria Auxiliar M√≠nima: " + batAh + " Ah\n" +\
"  ‚ÄÉÇ Cabo de Energia: " + cabo + " (100% Cobre)\n" +\
"  ‚ÄÉÇ Prote√ß√£o: Disjuntor " + disj + "\n" +\
"  ‚ÄÉÇ Volt√≠metro: Leitura instant√ÉÇnea no barramento ativa.";\
    }\
\
    atualizarPalco();\
  </script>\
</body>\
</html>\
EOF\
