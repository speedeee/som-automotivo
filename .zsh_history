: 1786158761:0;import json\
import socket\
import requests\
import typer\
import psutil\
import speedtest\
from rich.console import Console\
from rich.panel import Panel\
from rich.table import Table\
\
app = typer.Typer(help="Sua CLI Multi-ferramenta para Desenvolvedor")\
console = Console()\
\
@app.command()\
def ip():\
    """Exibe seu IP local e p√∫blico."""\
    hostname = socket.gethostname()\
    local_ip = socket.gethostbyname(hostname)\
    \
    try:\
        public_ip = requests.get('https://api.ipify.org', timeout=5).text\
    except requests.RequestException:\
        public_ip = "N√£o foi poss√≠vel obter"\
\
    table = Table(title="Informa√ß√µes de Rede", show_header=True)\
    table.add_column("Tipo", style="cyan")\
    table.add_column("Endere√ßo IP", style="green")\
    \
    table.add_row("Local", local_ip)\
    table.add_row("P√∫blico", public_ip)\
    \
    console.print(table)\
\
@app.command()\
def port(porta: int):\
    """Verifica se uma porta espec√≠fica est√ÉÅ em uso."""\
    em_uso = False\
    for conn in psutil.net_connections():\
        if conn.laddr.port == porta:\
            em_uso = True\
            processo = psutil.Process(conn.pid).name() if conn.pid else "Desconhecido"\
            console.print(Panel(f"Porta [bold red]{porta}[/bold red] est√ÉÅ em USO pelo processo [bold yellow]{processo}[/bold yellow] (PID: {conn.pid})"))\
            break\
    \
    if not em_uso:\
        console.print(Panel(f"Porta [bold green]{porta}[/bold green] est√ÉÅ LIVRE!"))\
\
@app.command()\
def json_fmt(caminho_arquivo: str):\
    """L√™, valida e formata um arquivo JSON."""\
    try:\
        with open(caminho_arquivo, 'r') as f:\
            dados = json.load(f)\
        json_formatado = json.dumps(dados, indent=4, ensure_ascii=False)\
        console.print_json(json_formatado)\
    except FileNotFoundError:\
        console.print("[red]Erro:[/red] Arquivo n√£o encontrado.")\
    except json.JSONDecodeError:\
        console.print("[red]Erro:[/red] Arquivo cont√©m um JSON inv√ÉÅlido.")\
\
@app.command()\
def speed():\
    """Testa a velocidade da sua conex√£o com a internet."""\
    console.print("[yellow]Iniciando teste de velocidade... aguarde alguns segundos.[/yellow]")\
    st = speedtest.Speedtest()\
    st.get_best_server()\
    \
    down = st.download() / 1_000_000\
    up = st.upload() / 1_000_000\
    ping = st.results.ping\
\
    console.print(f"Download: [bold green]{down:.2f} Mbps[/bold green]")\
    console.print(f"Upload: [bold blue]{up:.2f} Mbps[/bold blue]")\
    console.print(f"Ping: [bold yellow]{ping} ms[/bold yellow]")\
\
if __name__ == "__main__":\
    app()\

