      color: #aaa;\
      font-size: 8px;\
      display: flex;\
      align-items: center;\
      justify-content: center;\
      font-weight: bold;\
    }\
    .driver-quadrada { border-radius: 4px; }\
    .driver-redonda { border-radius: 50%; }\
\
    .eq-container {\
      display: flex;\
      justify-content: space-between;\
