                let imgSrc = p.imagem && p.imagem.trim() !== "" ? p.imagem : "https://via.placeholder.com/300x180?text=SPEED+STORE";\
                container.innerHTML += `<div class="produto-card">\
                        <img src="${imgSrc}" alt="${p.nome}" onerror="this.src='https://via.placeholder.com/300x180?text=SPEED+STORE'">\
