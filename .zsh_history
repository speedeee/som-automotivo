        @keyframes glitterAnim {\
            0% { background-position: 0 0, 10px 10px, 5px 5px; }\
            50% { background-position: 10px 20px, 20px 0px, 15px 10px; }\
            100% { background-position: 0 0, 10px 10px, 5px 5px; }\
        }\
\
        .gear-container { position: absolute; top: 15px; right: 15px; z-index: 1000; }\
        .gear-btn { background: #1f232a; border: 2px solid var(--pioneer-blue); color: #fff; padding: 8px 12px; border-radius: 50%; cursor: pointer; font-size: 18px; box-shadow: 0 0 10px var(--pioneer-glow); }\
        .gear-menu { display: none; position: absolute; right: 0; top: 45px; background: #111318; border: 2px solid var(--pioneer-blue); padding: 10px; border-radius: 10px; width: 220px; box-shadow: 0 8px 20px rgba(0,0,0,0.8); text-align: left; }\
        .gear-menu button { width: 100%; margin: 4px 0; text-align: left; font-size: 11px; padding: 8px; }\
\
        .pioneer-frame { background: var(--pioneer-frame-bg); border: 4px solid var(--pioneer-border); border-radius: 18px; padding: 20px; max-width: 650px; margin: 40px auto 15px auto; box-shadow: 0 10px 30px rgba(0,0,0,0.9); position: relative; }\
        .lcd-display { background: #00121a; border: 3px solid #002b3d; border-radius: 8px; padding: 12px; box-shadow: inset 0 0 15px var(--pioneer-glow), 0 0 10px var(--pioneer-glow); color: var(--text-color); margin-bottom: 15px; }\
\
        /* PARED√É£O TIPO SAVEIRO */\
        .wall-container-saveiro { \
            background: #08090c; \
            border: 3px solid #1f232a; \
            border-radius: 12px; \
            padding: 12px 8px; \
            margin: 15px 0; \
            display: flex;\
            flex-direction: column;\
            gap: 12px;\
            box-shadow: inset 0 0 20px #000;\
        }\
\
        .rack-top { \
            display: flex; \
            justify-content: space-around; \
            align-items: center; \
            background: #111318; \
            padding: 8px; \
            border-radius: 8px; \
            border: 1px solid #222;\
        }\
\
        .rack-bottom { \
            display: flex; \
            justify-content: space-around; \
            align-items: center; \
            background: #0d0e12; \
            padding: 12px 5px; \
            border-radius: 8px; \
            border: 1px solid #222;\
        }\
\
        /* EFEITO DE TREMOR DO PARED√É£O */\
        .shake-effect {\
            animation: tremor 0.05s infinite alternate;\
        }\
        @keyframes tremor {\
            0% { transform: translate(1px, 1px) rotate(0deg); }\
            100% { transform: translate(-1px, -1px) rotate(-0.5deg); }\
        }\
\
        /* SUBWOOFERS GRANDES (Grave SDS) */\
        .subwoofer-saveiro { \
            width: 85px; \
            height: 85px; \
            background: radial-gradient(circle, #222 10%, #111 50%, #000 100%); \
            border: 4px solid #333; \
            border-radius: 50%; \
            display: flex; \
            justify-content: center; \
            align-items: center; \
            transition: transform 0.03s ease; \
            box-shadow: 0 0 10px rgba(0,0,0,0.8);\
        }\
        .subwoofer-saveiro::before { \
            content: 'SDS'; \
            font-size: 10px;\
            font-weight: bold;\
            color: #aaa;\
            width: 50px; \
            height: 50px; \
            background: radial-gradient(circle, var(--speaker-sub-color) 15%, #111 90%); \
            border-radius: 50%; \
            border: 2px solid #000; \
            box-shadow: inset 0 0 8px #000, 0 0 10px var(--speaker-sub-color); \
            display: flex;\
            align-items: center;\
            justify-content: center;\
        }\
\
        /* CORNETAS JARR√É£O */\
        .horn-saveiro { \
            width: 50px; \
            height: 50px; \
            background: #15171c; \
            border: 2px solid #333; \
            border-radius: 50%; \
            display: flex; \
            justify-content: center; \
            align-items: center; \
            transition: transform 0.03s ease; \
        }\
        .horn-saveiro-inner { \
            width: 34px; \
            height: 34px; \
            background: radial-gradient(circle, var(--speaker-horn-color) 10%, #000 80%); \
            border-radius: 50%; \
            border: 1px solid #444; \
            box-shadow: 0 0 8px var(--speaker-horn-color); \
        }\
\
        /* TWEETERS */\
        .tweeter-saveiro { \
            width: 32px; \
            height: 32px; \
            background: #1a1a1a; \
            border: 2px solid #444; \
            border-radius: 6px; \
            display: flex; \
            justify-content: center; \
            align-items: center; \
            transition: transform 0.03s ease; \
        }\
        .tweeter-saveiro-core { \
            width: 12px; \
            height: 12px; \
            background: var(--speaker-tweet-color); \
            border-radius: 50%; \
            box-shadow: 0 0 6px var(--speaker-tweet-color); \
        }\
\
        .box-link { background: rgba(0, 212, 255, 0.05); border: 1px dashed var(--pioneer-blue); border-radius: 6px; padding: 8px; margin: 10px 0; }\
        .box-link input { width: 90%; text-align: center; font-size: 11px; background: #000; color: var(--text-color); border: 1px solid #005577; padding: 6px; }\
        \
        input[type="text"], input[type="email"], input[type="password"], select { width: 85%; padding: 8px; border-radius: 5px; border: 1px solid #005577; background: #00121a; color: #fff; margin-bottom: 8px; }\
        button { padding: 8px 12px; border-radius: 6px; border: none; background: var(--btn-bg); color: var(--btn-text); font-weight: bold; cursor: pointer; margin: 2px; }\
        .btn-danger { background: #e74c3c !important; color: #fff !important; }\
        .btn-extreme { background: #ff0055 !important; color: #fff !important; font-weight: bold; width: 100%; padding: 10px; }\
        .btn-extreme.active { background: #ff2a00 !important; box-shadow: 0 0 15px #ff2a00; }\
        .btn-small { padding: 4px 8px; font-size: 10px; margin: 0 2px; }\
\
        /* VISUALIZADOR DE √ÅUDIO CANVAS */\
        .visualizer-box { background: #00080d; border-radius: 5px; margin: 10px 0; border: 1px solid #003344; padding: 5px; }\
        canvas { width: 100%; height: 50px; display: block; }\
\
        .eq-panel { background: rgba(0,0,0,0.6); padding: 12px; border-radius: 8px; border: 1px solid #003344; margin: 10px 0; text-align: left; }\
        .eq-slider { display: flex; justify-content: space-between; align-items: center; margin: 10px 0; font-size: 12px; }\
        .eq-slider input { width: 55%; }\
\
        ol, ul { text-align: left; background: rgba(0, 212, 255, 0.05); padding: 10px; border-radius: 5px; max-height: 220px; overflow-y: auto; border: 1px solid #003344; color: var(--text-color); font-size: 12px; list-style: none; }\
        li { margin-bottom: 6px; border-bottom: 1px solid #002b3d; padding-bottom: 4px; display: flex !important; justify-content: space-between !important; align-items: center !important; gap: 8px !important; }\
        .song-title { flex: 1 !important; min-width: 0 !important; overflow: hidden !important; text-overflow: ellipsis !important; white-space: nowrap !important; margin-right: 8px; }\
        li > div { display: flex !important; gap: 4px !important; flex-shrink: 0 !important; align-items: center !important; }\
        .color-group { display: flex; align-items: center; justify-content: space-between; margin: 8px 0; font-size: 12px; }\
        .color-group input[type="color"] { border: none; width: 40px; height: 30px; cursor: pointer; background: none; }\
    </style>\
</head>\
<body>\
\
    <!-- ENGRENAGEM -->\
    <div class="gear-container">\
        <button class="gear-btn" onclick="toggleGearMenu()">‚É∫ÉπÔ∏ÉØ</button>\
        <div id="gearMenu" class="gear-menu">\
            <button onclick="verAba('ouvinte'); toggleGearMenu();">ÉøÉ≥ª Display Pioneer (P√∫blico)</button>\
            <button onclick="solicitarAcesso('adm'); toggleGearMenu();">ÉøÉÆÉªÔ∏ÉØ Mesa de DJ / ADM</button>\
            <button onclick="solicitarAcesso('custom'); toggleGearMenu();">ÉøÉÆ® Edi√ß√£o de Display & Som</button>\
        </div>\
    </div>\
\
    <!-- LOGIN ADM -->\
    <div id="modalLogin" class="pioneer-frame" style="display:none; border-color: #ffcc00;">\
        <h3 style="color:#ffcc00;">ÉøÉ¥É≤ √Årea Restrita ADM</h3>\
        <input type="email" id="loginEmail" placeholder="E-mail ADM">\
        <input type="password" id="loginPass" placeholder="Senha ADM">\
        <br>\
        <button onclick="validarLogin()">Acessar Painel</button>\
        <button onclick="cancelarLogin()" class="btn-danger">Cancelar</button>\
    </div>\
\
    <!-- ABA 1: OUVINTE -->\
    <div id="abaOuvinte" class="pioneer-frame">\
        <div class="lcd-display">\
            <h1 style="margin: 5px 0; font-size: 18px;">‚É∫ÉÅ SPEED R√ÅDIO</h1>\
            <p id="status" style="margin: 5px 0; font-size: 11px;">[READY] SELECIONE OU ADICIONE M√É∫SICAS</p>\
            \
            <div class="visualizer-box">\
                <canvas id="visualizerCanvas"></canvas>\
            </div>\
        </div>\
        \
        <div class="box-link">\
            <input type="text" id="urlRadio" readonly>\
            <button onclick="copiarLink()">ÉøÉ≥É´ Copiar Link</button>\
        </div>\
\
        <audio id="audioElement" controls crossorigin="anonymous" style="width:100%; margin: 10px 0;"></audio>\
\
        <!-- PARED√É£O ESTILO SAVEIRO PRO -->\
        <div class="wall-container-saveiro" id="paredaoContainer">\
            <!-- RACK SUPERIOR: 2 TWEETERS + 4 CORNETAS -->\
            <div class="rack-top">\
                <div class="tweeter-saveiro tweetElem"><div class="tweeter-saveiro-core"></div></div>\
                <div class="horn-saveiro hornElem"><div class="horn-saveiro-inner"></div></div>\
                <div class="horn-saveiro hornElem"><div class="horn-saveiro-inner"></div></div>\
                <div class="horn-saveiro hornElem"><div class="horn-saveiro-inner"></div></div>\
                <div class="horn-saveiro hornElem"><div class="horn-saveiro-inner"></div></div>\
                <div class="tweeter-saveiro tweetElem"><div class="tweeter-saveiro-core"></div></div>\
            </div>\
\
            <!-- RACK INFERIOR: 3 SUBWOOFERS GRANDES (SDS) -->\
            <div class="rack-bottom">\
                <div class="subwoofer-saveiro subElem"></div>\
                <div class="subwoofer-saveiro subElem"></div>\
                <div class="subwoofer-saveiro subElem"></div>\
            </div>\
        </div>\
\
        <h3>ÉøÉÆµ Pedir M√∫sica</h3>\
        <input type="text" id="linkMusicaOuvinte" placeholder="Cole o link MP3...">\
        <button onclick="enviarPedidoPublico()">‚ÉæÉµ Enviar para Aprova√ß√£o</button>\
\
        <h3>ÉøÉ≥Éº Fila Principal (Numerada)</h3>\
        <ol id="filaOuvinte"></ol>\
    </div>\
\
    <!-- ABA 2: MESA DE DJ / ADM -->\
    <div id="abaAdm" class="pioneer-frame" style="display: none;">\
        <h2>ÉøÉÆÉªÔ∏ÉØ Mesa de Som & Transmiss√£o DJ</h2>\
\
        <div style="margin: 15px 0;">\
            <button onclick="voltarMusica()">‚ÉØÆÔ∏ÉØ Voltar</button>\
            <button onclick="pausarEPlay()">‚ÉØØÔ∏ÉØ Play/Pause</button>\
            <button onclick="proximaMusica()">‚ÉØ≠Ô∏ÉØ Avan√ßar</button>\
        </div>\
\
        <div class="eq-panel">\
            <h4>ÉøÉ≥Å Adicionar √Åudios do Celular (Sem Limite)</h4>\
            <input type="file" id="fileInput" accept="audio/*" multiple style="font-size: 11px;">\
            <button onclick="carregarMp3Locais()">‚ÉæÉµ Inserir M√∫sicas</button>\
        </div>\
\
        <div class="eq-panel" style="border-color: #ffcc00;">\
            <h4 style="color: #ffcc00;">ÉøÉ≥• Pedidos do P√∫blico</h4>\
            <ul id="listaEspera"></ul>\
        </div>\
\
        <h4>ÉøÉ≥Éº Fila ADM (Organizar e Reordenar)</h4>\
        <ol id="filaAdm"></ol>\
\
        <button onclick="limparFila()" class="btn-danger">ÉøÉ∑É±Ô∏ÉØ Limpar Fila</button>\
        <br><br>\
        <button onclick="logout()" style="background: #444; color: #fff;">Sair do Painel</button>\
    </div>\
\
    <!-- ABA 3: EDI√Éß√É£O DE DISPLAY & SOM -->\
    <div id="abaCustom" class="pioneer-frame" style="display: none;">\
        <h2>ÉøÉÆ® Edi√ß√£o de Display & Som</h2>\
\
        <!-- ESTILO DO VISUALIZADOR -->\
        <div class="eq-panel">\
            <h4>ÉøÉ≥É™ Estilo do Visualizador de √Åudio</h4>\
            <div class="eq-slider">\
                <span>Modo de Display:</span>\
                <select id="selectVisualizer" onchange="mudarEstiloVisualizer(this.value)">\
                    <option value="bars">Barras LED (Pioneer Cl√ÉÅssico)</option>\
                    <option value="wave">Onda Oscilosc√≥pio</option>\
                    <option value="radial">Espectro Radial Neon</option>\
                </select>\
            </div>\
        </div>\
\
        <!-- AJUSTES DE SOM -->\
        <div class="eq-panel">\
            <h4>ÉøÉÆÉ∫Ô∏ÉØ Ajuste de Som do Pared√£o (Frequ√™ncias)</h4>\
            <div class="eq-slider">\
                <span>ÉøÉ¥É™ Subwoofer / Grave:</span>\
                <input type="range" id="bassRange" min="-10" max="30" value="0" oninput="atualizarEqualizador()">\
            </div>\
            <div class="eq-slider">\
                <span>ÉøÉ≥ÉÇ Corneta / M√©dio:</span>\
                <input type="range" id="midRange" min="-10" max="20" value="0" oninput="atualizarEqualizador()">\
            </div>\
            <div class="eq-slider">\
                <span>‚É∫ÉÅ Tweeter / Agudo:</span>\
                <input type="range" id="trebleRange" min="-10" max="20" value="0" oninput="atualizarEqualizador()">\
            </div>\
            <div style="margin-top: 15px;">\
                <button id="btnGraveExtreme" class="btn-extreme" onclick="toggleGraveExtreme()">ÉøÉ¥É™ LIGAR GRAVE EXTREME</button>\
            </div>\
        </div>\
\
        <!-- CORES DOS ALTO-FALANTES -->\
        <div class="eq-panel">\
            <h4>ÉøÉ≥ÉÇ Cores dos Alto-Falantes / Pared√£o</h4>\
            <div class="color-group"><span>Cor do Subwoofer:</span><input type="color" value="#00d4ff" onchange="mudarCor('--speaker-sub-color', this.value)"></div>\
            <div class="color-group"><span>Cor da Corneta:</span><input type="color" value="#00d4ff" onchange="mudarCor('--speaker-horn-color', this.value)"></div>\
            <div class="color-group"><span>Cor do Tweeter:</span><input type="color" value="#00d4ff" onchange="mudarCor('--speaker-tweet-color', this.value)"></div>\
        </div>\
\
        <!-- TIPO DE FUNDO -->\
        <div class="eq-panel">\
            <h4>ÉøÉ∂ºÔ∏ÉØ Personaliza√ß√£o do Fundo</h4>\
            <div class="eq-slider">\
                <span>Estilo do Fundo:</span>\
                <select id="tipoFundo" onchange="alterarTipoFundo(this.value)">\
                    <option value="solido">Cor S√≥lida</option>\
                    <option value="glitter">Glitter Animado</option>\
                    <option value="foto">Foto / URL de Imagem</option>\
                </select>\
            </div>\
            <div class="color-group" id="groupCorFundo">\
                <span>Cor do Fundo:</span>\
                <input type="color" value="#0a0b0e" onchange="mudarCor('--bg-color', this.value)">\
            </div>\
            <div id="groupFotoFundo" style="display: none; margin-top: 8px;">\
                <input type="text" id="urlFotoFundo" placeholder="Cole a URL da Foto de Fundo..." style="width:100%;">\
                <button onclick="aplicarFotoFundo()">Aplicar Foto</button>\
            </div>\
        </div>\
\
        <!-- CORES DO PIONEER -->\
        <div class="eq-panel">\
            <h4>ÉøÉÆ® Mudar Cores e Glow Pioneer</h4>\
            <div class="color-group"><span>Glow Pioneer (Brilho Neon):</span><input type="color" value="#00d4ff" onchange="mudarGlowDisplay(this.value)"></div>\
            <div class="color-group"><span>Cor dos Bot√µes:</span><input type="color" value="#00d4ff" onchange="mudarCor('--btn-bg', this.value)"></div>\
            <div class="color-group"><span>Cor do Texto / Display:</span><input type="color" value="#00d4ff" onchange="mudarCor('--text-color', this.value); mudarCor('--pioneer-blue', this.value)"></div>\
        </div>\
\
        <button onclick="logout()" style="background: #444; color: #fff;">Sair do Painel</button>\
    </div>\
\
    <script>\
        const socket = io();\
        let filaMusicas = [];\
        let listaEspera = [];\
        let indexAtual = 0;\
        let admAutenticado = false;\
        let abaPendente = '';\
        let visualizerMode = 'bars';\
\
        const audio = document.getElementById('audioElement');\
        const canvas = document.getElementById('visualizerCanvas');\
        const ctx = canvas.getContext('2d');\
        document.getElementById('urlRadio').value = window.location.href;\
\
        // REALTIME WEB AUDIO API + ANALYSER\
        let audioCtx, source, analyser, bassNode, midNode, trebleNode, extremeBassNode;\
        let graveExtremeAtivo = false;\
\
        function initAudioContext() {\
            if (!audioCtx) {\
                audioCtx = new (window.AudioContext || window.webkitAudioContext)();\
                source = audioCtx.createMediaElementSource(audio);\
                analyser = audioCtx.createAnalyser();\
                analyser.fftSize = 256;\
\
                bassNode = audioCtx.createBiquadFilter();\
                bassNode.type = 'lowshelf';\
                bassNode.frequency.value = 180;\
\
                midNode = audioCtx.createBiquadFilter();\
                midNode.type = 'peaking';\
                midNode.frequency.value = 1000;\
\
                trebleNode = audioCtx.createBiquadFilter();\
                trebleNode.type = 'highshelf';\
                trebleNode.frequency.value = 3500;\
\
                extremeBassNode = audioCtx.createBiquadFilter();\
                extremeBassNode.type = 'lowshelf';\
                extremeBassNode.frequency.value = 70;\
\
                source.connect(bassNode);\
                bassNode.connect(midNode);\
                midNode.connect(trebleNode);\
                trebleNode.connect(extremeBassNode);\
                extremeBassNode.connect(analyser);\
                analyser.connect(audioCtx.destination);\
\
                renderFrame();\
            }\
            if (audioCtx.state === 'suspended') {\
                audioCtx.resume();\
            }\
        }\
\
        // ANIMA√Éß√É£O REALTIME DOS ALTO-FALANTES E CANVAS\
        function renderFrame() {\
            requestAnimationFrame(renderFrame);\
\
            if (!analyser) return;\
\
            const bufferLength = analyser.frequencyBinCount;\
            const dataArray = new Uint8Array(bufferLength);\
            analyser.getByteFrequencyData(dataArray);\
\
            // DESENHAR VISUALIZADOR\
            ctx.clearRect(0, 0, canvas.width, canvas.height);\
\
            if (visualizerMode === 'bars') {\
                const barWidth = (canvas.width / bufferLength) * 2.5;\
                let x = 0;\
                for (let i = 0; i < bufferLength; i++) {\
                    const barHeight = (dataArray[i] / 255) * canvas.height;\
                    ctx.fillStyle = getComputedStyle(document.documentElement).getPropertyValue('--pioneer-blue') || '#00d4ff';\
                    ctx.fillRect(x, canvas.height - barHeight, barWidth, barHeight);\
                    x += barWidth + 1;\
                }\
            } else if (visualizerMode === 'wave') {\
                ctx.lineWidth = 2;\
                ctx.strokeStyle = getComputedStyle(document.documentElement).getPropertyValue('--pioneer-blue') || '#00d4ff';\
                ctx.beginPath();\
                const sliceWidth = canvas.width * 1.0 / bufferLength;\
                let x = 0;\
                for (let i = 0; i < bufferLength; i++) {\
                    const v = dataArray[i] / 128.0;\
                    const y = v * canvas.height / 2;\
                    if (i === 0) ctx.moveTo(x, y);\
                    else ctx.lineTo(x, y);\
                    x += sliceWidth;\
                }\
                ctx.lineTo(canvas.width, canvas.height / 2);\
                ctx.stroke();\
            } else if (visualizerMode === 'radial') {\
                const centerX = canvas.width / 2;\
                const centerY = canvas.height / 2;\
                const radius = Math.min(centerX, centerY) - 5;\
                ctx.beginPath();\
                ctx.arc(centerX, centerY, radius, 0, 2 * Math.PI);\
                ctx.strokeStyle = getComputedStyle(document.documentElement).getPropertyValue('--pioneer-blue') || '#00d4ff';\
                ctx.stroke();\
\
                for (let i = 0; i < bufferLength; i += 4) {\
                    const angle = (i / bufferLength) * 2 * Math.PI;\
                    const amp = (dataArray[i] / 255) * 15;\
                    const x1 = centerX + Math.cos(angle) * radius;\
                    const y1 = centerY + Math.sin(angle) * radius;\
                    const x2 = centerX + Math.cos(angle) * (radius + amp);\
                    const y2 = centerY + Math.sin(angle) * (radius + amp);\
                    ctx.beginPath();\
                    ctx.moveTo(x1, y1);\
                    ctx.lineTo(x2, y2);\
                    ctx.strokeStyle = '#ff0055';\
                    ctx.stroke();\
                }\
            }\
\
            // PULSA√Éß√É£O DOS ALTO-FALANTES\
            let sumBass = 0, sumMid = 0, sumTreble = 0;\
            for (let i = 0; i < 10; i++) sumBass += dataArray[i];\
            for (let i = 10; i < 40; i++) sumMid += dataArray[i];\
            for (let i = 40; i < 100; i++) sumTreble += dataArray[i];\
\
            const avgBass = sumBass / 10;\
            const avgMid = sumMid / 30;\
            const avgTreble = sumTreble / 60;\
\
            const scaleSub = 1 + (avgBass / 255) * 0.25;\
            const scaleHorn = 1 + (avgMid / 255) * 0.15;\
            const scaleTweet = 1 + (avgTreble / 255) * 0.1;\
\
            document.querySelectorAll('.subElem').forEach(el => el.style.transform = `scale(${scaleSub})`);\
            document.querySelectorAll('.hornElem').forEach(el => el.style.transform = `scale(${scaleHorn})`);\
            document.querySelectorAll('.tweetElem').forEach(el => el.style.transform = `scale(${scaleTweet})`);\
\
            const paredao = document.getElementById('paredaoContainer');\
            if (avgBass > 180 || graveExtremeAtivo) {\
                paredao.classList.add('shake-effect');\
            } else {\
                paredao.classList.remove('shake-effect');\
            }\
        }\
\
        // INICIALIZA√Éß√É£O E SOCKETS\
        audio.addEventListener('play', () => initAudioContext());\
\
        socket.on('syncRadio', (data) => {\
            filaMusicas = data.fila || [];\
            listaEspera = data.pedidos || [];\
            indexAtual = data.indexAtual || 0;\
            atualizarFilasUI();\
            if (data.tocarAgora && audio.src !== data.tocarAgora) {\
                audio.src = data.tocarAgora;\
                audio.play().catch(() => {});\
            }\
        });\
\
        // NAVEGA√Éß√É£O E AUTENTICA√Éß√É£O\
        function toggleGearMenu() {\
            const menu = document.getElementById('gearMenu');\
            menu.style.display = menu.style.display === 'block' ? 'none' : 'block';\
        }\
\
        function verAba(aba) {\
            document.getElementById('abaOuvinte').style.display = 'none';\
            document.getElementById('abaAdm').style.display = 'none';\
            document.getElementById('abaCustom').style.display = 'none';\
            document.getElementById('modalLogin').style.display = 'none';\
\
            if (aba === 'ouvinte') document.getElementById('abaOuvinte').style.display = 'block';\
            if (aba === 'adm') document.getElementById('abaAdm').style.display = 'block';\
            if (aba === 'custom') document.getElementById('abaCustom').style.display = 'block';\
        }\
\
        function solicitarAcesso(aba) {\
            if (admAutenticado) {\
                verAba(aba);\
            } else {\
                abaPendente = aba;\
                document.getElementById('modalLogin').style.display = 'block';\
            }\
        }\
\
        function validarLogin() {\
            const email = document.getElementById('loginEmail').value;\
            const pass = document.getElementById('loginPass').value;\
            if (email && pass) {\
                admAutenticado = true;\
                verAba(abaPendente);\
            } else {\
                alert('Preencha os dados do ADM!');\
            }\
        }\
\
        function cancelarLogin() {\
            document.getElementById('modalLogin').style.display = 'none';\
        }\
\
        function logout() {\
            admAutenticado = false;\
            verAba('ouvinte');\
        }\
\
        function copiarLink() {\
            navigator.clipboard.writeText(document.getElementById('urlRadio').value);\
            alert('Link da r√ÉÅdio copiado!');\
        }\
\
        // CONTROLES DE M√É∫SICA E FILAS\
        function enviarPedidoPublico() {\
            const input = document.getElementById('linkMusicaOuvinte');\
            if (input.value.trim()) {\
                socket.emit('novoPedido', { url: input.value.trim(), nome: 'Ouvinte' });\
                input.value = '';\
                alert('Pedido enviado para o DJ!');\
            }\
        }\
\
        function carregarMp3Locais() {\
            const files = document.getElementById('fileInput').files;\
            for (let file of files) {\
                const url = URL.createObjectURL(file);\
                filaMusicas.push({ nome: file.name, url: url });\
            }\
            socket.emit('atualizarFila', filaMusicas);\
            atualizarFilasUI();\
        }\
\
        function atualizarFilasUI() {\
            const filaOuvinte = document.getElementById('filaOuvinte');\
            const filaAdm = document.getElementById('filaAdm');\
            const listaEsperaUI = document.getElementById('listaEspera');\
\
            filaOuvinte.innerHTML = '';\
            filaAdm.innerHTML = '';\
            listaEsperaUI.innerHTML = '';\
\
            filaMusicas.forEach((m, idx) => {\
                const isCurrent = idx === indexAtual;\
                const liOuvinte = document.createElement('li');\
                liOuvinte.innerHTML = `<span class="song-title">${idx + 1}. ${m.nome} ${isCurrent ? '‚É∂∂Ô∏ÉØ' : ''}</span>`;\
                filaOuvinte.appendChild(liOuvinte);\
\
                const liAdm = document.createElement('li');\
                liAdm.innerHTML = `<span class="song-title">${idx + 1}. ${m.nome}</span>\
                    <div>\
                        <button class="btn-small" onclick="tocarDireto(${idx})">‚É∂∂Ô∏ÉØ</button>\
                        <button class="btn-small btn-danger" onclick="removerFila(${idx})">‚ÉΩÉ¨</button>\
                    </div>`;\
                filaAdm.appendChild(liAdm);\
            });\
\
            listaEspera.forEach((p, idx) => {\
                const li = document.createElement('li');\
                li.innerHTML = `<span class="song-title">${p.nome || 'Pedido'}</span>\
                    <div>\
                        <button class="btn-small" onclick="aprovarPedido(${idx})">‚ÉºÉ¥Ô∏ÉØ</button>\
                        <button class="btn-small btn-danger" onclick="recusarPedido(${idx})">‚ÉΩÉ¨</button>\
                    </div>`;\
                listaEsperaUI.appendChild(li);\
            });\
        }\
\
        function tocarDireto(idx) {\
            indexAtual = idx;\
            socket.emit('tocarMusica', indexAtual);\
        }\
\
        function removerFila(idx) {\
            filaMusicas.splice(idx, 1);\
            socket.emit('atualizarFila', filaMusicas);\
        }\
\
        function aprovarPedido(idx) {\
            const ped = listaEspera.splice(idx, 1)[0];\
            filaMusicas.push({ nome: 'Pedido Ouvinte', url: ped.url });\
            socket.emit('atualizarFila', filaMusicas);\
            socket.emit('atualizarPedidos', listaEspera);\
        }\
\
        function recusarPedido(idx) {\
            listaEspera.splice(idx, 1);\
            socket.emit('atualizarPedidos', listaEspera);\
        }\
\
        function voltarMusica() {\
            if (indexAtual > 0) {\
                indexAtual--;\
                socket.emit('tocarMusica', indexAtual);\
            }\
        }\
\
        function pausarEPlay() {\
            if (audio.paused) audio.play();\
            else audio.pause();\
        }\
\
        function proximaMusica() {\
            if (indexAtual < filaMusicas.length - 1) {\
                indexAtual++;\
                socket.emit('tocarMusica', indexAtual);\
            }\
        }\
\
        function limparFila() {\
            filaMusicas = [];\
            socket.emit('atualizarFila', filaMusicas);\
        }\
\
        // EDI√Éß√É£O & CUSTOMIZA√Éß√É£O\
        function mudarEstiloVisualizer(val) {\
            visualizerMode = val;\
        }\
\
        function atualizarEqualizador() {\
            initAudioContext();\
            if (bassNode) bassNode.gain.value = parseFloat(document.getElementById('bassRange').value);\
            if (midNode) midNode.gain.value = parseFloat(document.getElementById('midRange').value);\
            if (trebleNode) trebleNode.gain.value = parseFloat(document.getElementById('trebleRange').value);\
        }\
\
        function toggleGraveExtreme() {\
            initAudioContext();\
            graveExtremeAtivo = !graveExtremeAtivo;\
            const btn = document.getElementById('btnGraveExtreme');\
            if (graveExtremeAtivo) {\
                btn.classList.add('active');\
                btn.innerText = 'ÉøÉ¥• GRAVE EXTREME: LIGADO ÉøÉ¥•';\
                if (extremeBassNode) extremeBassNode.gain.value = 25;\
            } else {\
                btn.classList.remove('active');\
                btn.innerText = 'ÉøÉ¥É™ LIGAR GRAVE EXTREME';\
                if (extremeBassNode) extremeBassNode.gain.value = 0;\
            }\
        }\
\
        function mudarCor(variavel, cor) {\
            document.documentElement.style.setProperty(variavel, cor);\
        }\
\
        function mudarGlowDisplay(cor) {\
            document.documentElement.style.setProperty('--pioneer-blue', cor);\
            document.documentElement.style.setProperty('--pioneer-glow', cor + '88');\
        }\
\
        function alterarTipoFundo(val) {\
            document.body.className = '';\
            document.getElementById('groupCorFundo').style.display = 'none';\
            document.getElementById('groupFotoFundo').style.display = 'none';\
\
            if (val === 'solido') {\
                document.getElementById('groupCorFundo').style.display = 'flex';\
                document.documentElement.style.setProperty('--bg-image', 'none');\
            } else if (val === 'glitter') {\
                document.body.classList.add('glitter-bg');\
            } else if (val === 'foto') {\
                document.getElementById('groupFotoFundo').style.display = 'block';\
            }\
        }\
\
        function aplicarFotoFundo() {\
            const url = document.getElementById('urlFotoFundo').value;\
            if (url) {\
                document.documentElement.style.setProperty('--bg-image', `url('${url}')`);\
            }\
        }\
    </script>\
</body>\
</html>\
EOF\

