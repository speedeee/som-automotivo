<!DOCTYPE html>\
<html lang="pt-BR">\
<head>\
    <meta charset="UTF-8">\
    <meta name="viewport" content="width=device-width, initial-scale=1.0">\
    <title>‚É∫ÉÅ SPEED R√ÅDIO</title>\
    <style>\
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: sans-serif; }\
        body { background: #0a0a0c; color: #fff; padding: 15px; }\
        .container { max-width: 450px; margin: 0 auto; background: #121318; border: 1px solid #1f222e; border-radius: 12px; padding: 15px; }\
        .header { text-align: center; color: #00d2ff; margin-bottom: 15px; }\
        .now-playing { background: #08090c; border: 1px solid #1f222e; padding: 10px; border-radius: 8px; text-align: center; margin-bottom: 15px; color: #00d2ff; }\
        .link-box { display: flex; gap: 8px; margin-bottom: 15px; }\
        .link-box input { flex: 1; background: #08090c; border: 1px solid #1f222e; color: #888; padding: 8px; border-radius: 6px; }\
        .link-box button { background: #ffd700; color: #000; border: none; font-weight: bold; padding: 8px 12px; border-radius: 6px; cursor: pointer; }\
        audio { width: 100%; margin-bottom: 15px; }\
        .speakers { display: flex; justify-content: space-around; background: #08090c; padding: 10px; border-radius: 8px; margin-bottom: 15px; text-align: center; font-size: 0.7rem; color: #aaa; }\
        .speaker-circle { width: 35px; height: 35px; border-radius: 50%; background: #222; margin: 5px auto 0; border: 2px solid #444; }\
        .subwoofer .speaker-circle { border-color: #ffd700; background: #ffe600; }\
        .pedir-section { background: #08090c; padding: 10px; border-radius: 8px; margin-bottom: 15px; }\
        .pedir-section input { width: 100%; padding: 8px; background: #121318; border: 1px solid #1f222e; color: #fff; margin-bottom: 8px; border-radius: 4px; }\
        .pedir-section button { width: 100%; background: #ffd700; color: #000; border: none; padding: 8px; font-weight: bold; border-radius: 4px; cursor: pointer; }\
        \
        /* FILA CORRIGIDA E ALINHADA */\
        .queue-container { background: #08090c; border: 1px solid #1f222e; border-radius: 8px; padding: 10px; max-height: 250px; overflow-y: auto; }\
        .queue-item { display: flex !important; align-items: center !important; justify-content: space-between !important; gap: 8px !important; background: rgba(255,255,255,0.03); padding: 6px 8px; margin-bottom: 6px; border-radius: 4px; }\
        .queue-item-text { flex: 1 !important; min-width: 0 !important; color: #00d2ff; font-size: 0.85rem; white-space: nowrap !important; overflow: hidden !important; text-overflow: ellipsis !important; }\
        .btn-group { display: flex !important; gap: 4px !important; flex-shrink: 0 !important; }\
        .btn-group button { padding: 4px 6px; font-size: 0.75rem; border: none; border-radius: 3px; cursor: pointer; }\
        .btn-up, .btn-down { background: #ffd700; color: #000; }\
        .btn-del { background: #ff4444; color: #fff; }\
\
        .modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.8); justify-content: center; align-items: center; }\
        .modal-content { background: #121318; width: 90%; max-width: 400px; padding: 15px; border-radius: 10px; border: 1px solid #1f222e; }\
        .gear { position: absolute; top: 20px; right: 20px; cursor: pointer; font-size: 1.2rem; }\
    </style>\
</head>\
<body>\
    <div class="container">\
        <span class="gear" onclick="toggleModal(true)">‚É∫ÉπÔ∏ÉØ</span>\
        <div class="header"><h2>‚É∫ÉÅ SPEED R√ÅDIO</h2></div>\
        <div class="now-playing">TOCANDO: <span id="current">Nenhuma m√∫sica</span></div>\
        <div class="link-box">\
            <input type="text" id="link" readonly value="">\
            <button onclick="navigator.clipboard.writeText(document.getElementById('link').value); alert('Copiado!')">ÉøÉ≥É´ Copiar Link</button>\
        </div>\
        <audio id="player" controls autoplay></audio>\
        <div class="speakers">\
            <div class="subwoofer">SUBWOOFER<div class="speaker-circle"></div></div>\
            <div>CORNETA<div class="speaker-circle"></div></div>\
            <div>TWEETER<div class="speaker-circle"></div></div>\
        </div>\
        <div class="pedir-section">\
            <h3>ÉøÉÆµ Pedir M√∫sica</h3>\
            <input type="text" id="pedir" placeholder="Cole o link MP3...">\
            <button onclick="pedir()">‚ÉæÉµ Enviar para Aprova√ß√£o</button>\
        </div>\
        <h3>ÉøÉ≥Éº Fila Principal (Numerada)</h3>\
        <div class="queue-container">\
            <div id="publicQueue"></div>\
        </div>\
    </div>\
\
    <div class="modal" id="modal">\
        <div class="modal-content">\
            <h3>ÉøÉÆÉªÔ∏ÉØ Mesa de Som & Transmiss√£o DJ</h3>\
            <div style="display:flex; gap:5px; margin:10px 0;">\
                <button style="flex:1; background:#ffd700; border:none; padding:8px;" onclick="control('prev')">‚ÉØÆÔ∏ÉØ Voltar</button>\
                <button style="flex:1; background:#ffd700; border:none; padding:8px;" onclick="control('toggle')">‚ÉØØÔ∏ÉØ Play/Pause</button>\
                <button style="flex:1; background:#ffd700; border:none; padding:8px;" onclick="control('next')">‚ÉØ≠Ô∏ÉØ Avan√ßar</button>\
            </div>\
            <div style="margin:10px 0; text-align:center; border:1px dashed #444; padding:10px;">\
                <input type="file" id="files" multiple accept="audio/*">\
                <button style="background:#ffd700; border:none; padding:5px 10px; margin-top:5px;" onclick="upload()">‚ÉæÉµ Inserir M√∫sicas</button>\
            </div>\
            <h3>ÉøÉ≥Éº Fila ADM (Organizar e Reordenar)</h3>\
            <div class="queue-container" style="max-height:150px;">\
                <div id="admQueue"></div>\
            </div>\
            <button style="width:100%; margin-top:10px; padding:8px; background:#444; color:#fff; border:none;" onclick="toggleModal(false)">Sair do Painel</button>\
        </div>\
    </div>\
\
    <script>\
        document.getElementById('link').value = window.location.href;\
        function toggleModal(s){ document.getElementById('modal').style.display = s?'flex':'none'; }\
        \
        let queue = [];\
\
        async function fetchQueue() {\
            try {\
                const res = await fetch('/api/queue');\
                if(res.ok) queue = await res.json();\
            } catch(e){}\
            render();\
        }\
\
        function render() {\
            const pub = document.getElementById('publicQueue');\
            const adm = document.getElementById('admQueue');\
            pub.innerHTML = ''; adm.innerHTML = '';\
\
            queue.forEach((item, index) => {\
                const name = typeof item === 'string' ? item : item.name;\
                \
                // Fila P√∫blica\
                const d1 = document.createElement('div');\
                d1.className = 'queue-item';\
                d1.innerHTML = `<span class="queue-item-text">${index + 1}. ${name}</span>`;\
                pub.appendChild(d1);\
\
                // Fila ADM\
                const d2 = document.createElement('div');\
                d2.className = 'queue-item';\
                d2.innerHTML = `\
                    <span class="queue-item-text">${index + 1}. ${name}</span>\
                    <div class="btn-group">\
                        <button class="btn-up" onclick="move(${index}, -1)">‚¨É¶Ô∏ÉØ</button>\
                        <button class="btn-down" onclick="move(${index}, 1)">‚¨ÉßÔ∏ÉØ</button>\
                        <button class="btn-del" onclick="del(${index})">‚ÉΩÉ¨</button>\
                    </div>\
                `;\
                adm.appendChild(d2);\
            });\
        }\
\
        async function move(index, dir) {\
            if(index + dir < 0 || index + dir >= queue.length) return;\
            const temp = queue[index];\
            queue[index] = queue[index + dir];\
            queue[index + dir] = temp;\
            render();\
            fetch('/api/queue/reorder', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({queue}) });\
        }\
\
        async function del(index) {\
            queue.splice(index, 1);\
            render();\
            fetch('/api/queue/delete', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({index}) });\
        }\
\
        async function pedir() {\
            const val = document.getElementById('pedir').value.trim();\
            if(!val) return;\
            fetch('/api/queue/add', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({url: val}) });\
            document.getElementById('pedir').value = '';\
            fetchQueue();\
        }\
\
        async function upload() {\
            const fi = document.getElementById('files');\
            if(!fi.files.length) return;\
            const formData = new FormData();\
            for(let f of fi.files) formData.append('files', f);\
            await fetch('/api/upload', { method:'POST', body: formData });\
            fi.value = '';\
            fetchQueue();\
        }\
\
        fetchQueue();\
        setInterval(fetchQueue, 5000);\
    </script>\
</body>\
</html>\
EOF\

