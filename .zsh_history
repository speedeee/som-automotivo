<!DOCTYPE html>\
<html lang="pt-BR">\
<head>\
    <meta charset="UTF-8">\
    <meta name="viewport" content="width=device-width, initial-scale=1.0">\
    <title>‚É∫ÉÅ SPEED R√ÅDIO - SAVEIRO PARED√É£O MASTER EDITION</title>\
    <script src="/socket.io/socket.io.js"></script>\
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>\
    <style>\
        *, *::before, *::after { box-sizing: border-box; }\
\
        :root { \
            --bg-color: #0a0b0e; \
            --pioneer-frame-bg: linear-gradient(145deg, #1f232a, #0d0e12);\
            --pioneer-border: #00d4ff;\
            --pioneer-blue: #00d4ff; \
            --pioneer-glow: rgba(0, 212, 255, 0.4);\
            --speaker-sub-color: #00ff88;\
            --speaker-horn-color: #0044ff;\
            --speaker-tweet-color: #ff0055;\
            --btn-bg: #00d4ff;\
            --btn-text: #000000;\
            --text-color: #00d4ff;\
            --flash-color: #ffffff;\
        }\
\
        html, body { width: 100%; min-height: 100vh; margin: 0; padding: 0; }\
\
        body { \
            background-color: var(--bg-color); \
            background-size: cover;\
            background-position: center;\
            background-repeat: no-repeat;\
            background-attachment: fixed;\
            color: #fff; \
            font-family: 'Courier New', Courier, monospace; \
            text-align: center; \
            padding: 15px; \
            transition: background 0.2s ease;\
        }\
\
        /* GIFs E ESTILOS DE FUNDO */\
        body.glitter-bg {\
            background-image: radial-gradient(circle, #ffffff 1px, transparent 1px), radial-gradient(circle, #ff007f 1px, transparent 1px), radial-gradient(circle, #00d4ff 1px, transparent 1px);\
            background-size: 25px 25px, 35px 35px, 20px 20px;\
            animation: glitterAnim 1.2s infinite linear;\
        }\
        @keyframes glitterAnim {\
            0% { background-position: 0 0, 10px 10px, 5px 5px; }\
            50% { background-position: 15px 25px, 25px 5px, 18px 12px; }\
            100% { background-position: 0 0, 10px 10px, 5px 5px; }\
        }\
\
        body.gif-fogo { background-image: url('https://media.giphy.com/media/3o72FfM5HJydzaM6B2/giphy.gif'); }\
        body.gif-matrix { background-image: url('https://media.giphy.com/media/v1.Y2lkPTc5MGI3NjExOHp1eHN3c3Jscmx0aWFoNnhvZ3Bxa3FiOGI1aG4xcWZndmQybzh6cSZlcD12MV9pbnRlcm5hbF9naWZfYnlfaWQmY3Q9Zw/L1R1tvI9svvIWwpVYz/giphy.gif'); }\
        body.gif-galaxy { background-image: url('https://media.giphy.com/media/13I6ny4f2w1P4k/giphy.gif'); }\
        body.gif-stars { background-image: url('https://media.giphy.com/media/uV22O8p39q9M0IakfB/giphy.gif'); }\
        body.gif-cyberpunk { background-image: url('https://media.giphy.com/media/l41YoV54ZT606B13a/giphy.gif'); }\
        body.gif-fogoblue { background-image: url('https://media.giphy.com/media/26P74H0qHIsA2TqDu/giphy.gif'); }\
        body.gif-waves { background-image: url('https://media.giphy.com/media/3oEhmHCcI0Z9E7A3x6/giphy.gif'); }\
        body.gif-eqdigital { background-image: url('https://media.giphy.com/media/xT9IgzoKnwFNmISR8I/giphy.gif'); }\
        body.gif-lights { background-image: url('https://media.giphy.com/media/l0HlOBZehRla8Gl2w/giphy.gif'); }\
\
        .gear-container { position: absolute; top: 15px; right: 15px; z-index: 1000; }\
        .gear-btn { background: #1f232a; border: 2px solid var(--pioneer-border); color: #fff; padding: 8px 12px; border-radius: 50%; cursor: pointer; font-size: 18px; box-shadow: 0 0 10px var(--pioneer-glow); }\
        .gear-menu { display: none; position: absolute; right: 0; top: 45px; background: #111318; border: 2px solid var(--pioneer-border); padding: 10px; border-radius: 10px; width: 220px; box-shadow: 0 8px 20px rgba(0,0,0,0.9); text-align: left; }\
        .gear-menu button { width: 100%; margin: 4px 0; text-align: left; font-size: 11px; padding: 8px; background: var(--btn-bg); color: var(--btn-text); border: none; border-radius: 5px; font-weight: bold; cursor: pointer; }\
\
        .pioneer-frame { background: var(--pioneer-frame-bg); border: 4px solid var(--pioneer-border); border-radius: 18px; padding: 20px; max-width: 650px; margin: 40px auto 15px auto; box-shadow: 0 10px 30px rgba(0,0,0,0.9), 0 0 15px var(--pioneer-glow); position: relative; }\
        .lcd-display { background: #00121a; border: 3px solid #002b3d; border-radius: 8px; padding: 12px; box-shadow: inset 0 0 15px var(--pioneer-glow), 0 0 10px var(--pioneer-glow); color: var(--text-color); margin-bottom: 15px; }\
\
        .wall-container-saveiro { background: #08090c; border: 3px solid #1f232a; border-radius: 12px; padding: 12px 8px; margin: 15px 0; display: flex; flex-direction: column; gap: 12px; box-shadow: inset 0 0 20px #000; }\
        .rack-top { display: flex; justify-content: space-around; align-items: center; background: #111318; padding: 8px; border-radius: 8px; border: 1px solid #222; }\
        .rack-bottom { display: flex; justify-content: space-around; align-items: center; background: #0d0e12; padding: 12px 5px; border-radius: 8px; border: 1px solid #222; }\
\
        .shake-effect { animation: tremor 0.05s infinite alternate; }\
        @keyframes tremor { 0% { transform: translate(2px, 1px); } 100% { transform: translate(-2px, -1px); } }\
\
        .subwoofer-saveiro { width: 85px; height: 85px; background: radial-gradient(circle, #222 10%, #111 50%, #000 100%); border: 4px solid #333; border-radius: 50%; display: flex; justify-content: center; align-items: center; transition: transform 0.03s ease; box-shadow: 0 0 10px rgba(0,0,0,0.8); }\
        .subwoofer-saveiro::before { content: 'SDS'; font-size: 10px; font-weight: bold; color: #fff; width: 50px; height: 50px; background: radial-gradient(circle, var(--speaker-sub-color) 15%, #111 90%); border-radius: 50%; border: 2px solid #000; box-shadow: inset 0 0 8px #000, 0 0 12px var(--speaker-sub-color); display: flex; align-items: center; justify-content: center; }\
\
        .horn-saveiro { width: 50px; height: 50px; background: #15171c; border: 2px solid #333; border-radius: 50%; display: flex; justify-content: center; align-items: center; }\
        .horn-saveiro-inner { width: 34px; height: 34px; background: radial-gradient(circle, var(--speaker-horn-color) 10%, #000 80%); border-radius: 50%; border: 1px solid #444; box-shadow: 0 0 10px var(--speaker-horn-color); }\
\
        .tweeter-saveiro { width: 32px; height: 32px; background: #1a1a1a; border: 2px solid #444; border-radius: 6px; display: flex; justify-content: center; align-items: center; }\
        .tweeter-saveiro-core { width: 12px; height: 12px; background: var(--speaker-tweet-color); border-radius: 50%; box-shadow: 0 0 8px var(--speaker-tweet-color); }\
\
        .box-link { background: rgba(0, 212, 255, 0.05); border: 1px dashed var(--pioneer-blue); border-radius: 6px; padding: 10px; margin: 10px 0; display: flex; flex-direction: column; align-items: center; gap: 8px; }\
        .box-link input { width: 90%; text-align: center; font-size: 11px; background: #000; color: var(--text-color); border: 1px solid #005577; padding: 6px; }\
        #qrcodeCanvas { background: #fff; padding: 8px; border-radius: 6px; margin-top: 5px; }\
\
        input[type="text"], input[type="email"], input[type="password"], select { width: 85%; padding: 8px; border-radius: 5px; border: 1px solid #005577; background: #00121a; color: #fff; margin-bottom: 8px; }\
        button { padding: 8px 12px; border-radius: 6px; border: none; background: var(--btn-bg); color: var(--btn-text); font-weight: bold; cursor: pointer; margin: 2px; }\
        .btn-power { background: #2ecc71; color: #fff; font-size: 14px; padding: 10px 20px; border-radius: 8px; font-weight: bold; width: 100%; margin-bottom: 10px; box-shadow: 0 0 10px #2ecc71; }\
        .btn-power.off { background: #e74c3c !important; box-shadow: 0 0 10px #e74c3c !important; }\
        .btn-danger { background: #e74c3c !important; color: #fff !important; }\
        .btn-extreme { background: #ff0055 !important; color: #fff !important; font-weight: bold; width: 100%; padding: 10px; }\
        .btn-extreme.active { background: #ff2a00 !important; box-shadow: 0 0 15px #ff2a00; }\
        .btn-small { padding: 4px 8px; font-size: 10px; margin: 0 2px; }\
\
        .visualizer-box { background: #00080d; border-radius: 5px; margin: 10px 0; border: 1px solid #003344; padding: 5px; }\
        canvas { width: 100%; height: 75px; display: block; }\
\
        .eq-panel { background: rgba(0,0,0,0.6); padding: 12px; border-radius: 8px; border: 1px solid #003344; margin: 10px 0; text-align: left; }\
        .eq-slider { display: flex; justify-content: space-between; align-items: center; margin: 10px 0; font-size: 12px; }\
        .eq-slider input { width: 55%; }\
\
        ol, ul { text-align: left; background: rgba(0, 212, 255, 0.05); padding: 10px; border-radius: 5px; max-height: 220px; overflow-y: auto; border: 1px solid #003344; color: var(--text-color); font-size: 12px; list-style: none; }\
        li { margin-bottom: 6px; border-bottom: 1px solid #002b3d; padding-bottom: 4px; display: flex; justify-content: space-between; align-items: center; gap: 8px; }\
        .song-title { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\
        .color-group { display: flex; align-items: center; justify-content: space-between; margin: 8px 0; font-size: 12px; }\
        .color-group input[type="color"] { border: none; width: 40px; height: 30px; cursor: pointer; background: none; }\
    </style>\
</head>\
<body onclick="desbloquearAudio()">\
\
    <div class="gear-container">\
        <button class="gear-btn" onclick="toggleGearMenu(event)">‚É∫ÉπÔ∏ÉØ</button>\
        <div id="gearMenu" class="gear-menu">\
            <button onclick="verAba('abaOuvinte')">ÉøÉ≥ª Display Pioneer (P√∫blico)</button>\
            <button onclick="solicitarAcesso('abaAdm')">ÉøÉÆÉªÔ∏ÉØ Mesa de DJ / ADM</button>\
            <button onclick="solicitarAcesso('abaCustom')">ÉøÉÆ® Edi√ß√£o de Display & Som</button>\
        </div>\
    </div>\
\
    <div id="modalLogin" class="pioneer-frame" style="display:none; border-color: #ffcc00;">\
        <h3 style="color:#ffcc00;">ÉøÉ¥É≤ √Årea Restrita ADM</h3>\
        <input type="email" id="loginEmail" placeholder="E-mail ADM">\
        <input type="password" id="loginPass" placeholder="Senha ADM">\
        <br>\
        <button onclick="validarLogin()">Acessar Painel</button>\
        <button onclick="cancelarLogin()" class="btn-danger">Cancelar</button>\
    </div>\
\
    <!-- ABA OUVINTE -->\
    <div id="abaOuvinte" class="pioneer-frame">\
        <div class="lcd-display">\
            <h1 style="margin: 5px 0; font-size: 18px;">‚É∫ÉÅ SPEED R√ÅDIO</h1>\
            <p id="status" style="margin: 5px 0; font-size: 11px;">[ONLINE] R√ÅDIO NO AR</p>\
            <div class="visualizer-box">\
                <canvas id="visualizerCanvas"></canvas>\
            </div>\
        </div>\
        \
        <div class="box-link">\
            <input type="text" id="urlRadio" readonly>\
            <button onclick="copiarLink()">ÉøÉ≥É´ Copiar Link da R√ÉÅdio</button>\
            <div id="qrcodeCanvas"></div>\
        </div>\
\
        <audio id="audioElement" controls crossorigin="anonymous" style="width:100%; margin: 10px 0;" onended="proximaMusica()"></audio>\
\
        <div class="wall-container-saveiro" id="paredaoContainer">\
            <div class="rack-top">\
                <div class="tweeter-saveiro"><div class="tweeter-saveiro-core"></div></div>\
                <div class="horn-saveiro"><div class="horn-saveiro-inner"></div></div>\
                <div class="horn-saveiro"><div class="horn-saveiro-inner"></div></div>\
                <div class="horn-saveiro"><div class="horn-saveiro-inner"></div></div>\
                <div class="horn-saveiro"><div class="horn-saveiro-inner"></div></div>\
                <div class="tweeter-saveiro"><div class="tweeter-saveiro-core"></div></div>\
            </div>\
            <div class="rack-bottom">\
                <div class="subwoofer-saveiro subElem"></div>\
                <div class="subwoofer-saveiro subElem"></div>\
                <div class="subwoofer-saveiro subElem"></div>\
            </div>\
        </div>\
\
        <h3>ÉøÉÆµ Pedir M√∫sica</h3>\
        <input type="text" id="linkMusicaOuvinte" placeholder="Cole o link MP3...">\
        <button onclick="enviarPedidoPublico()">‚ÉæÉµ Enviar para Aprova√ß√£o</button>\
\
        <h3>ÉøÉ≥Éº Fila Principal (Numerada)</h3>\
        <ol id="filaOuvinte"></ol>\
    </div>\
\
    <!-- ABA ADM -->\
    <div id="abaAdm" class="pioneer-frame" style="display: none;">\
        <h2>ÉøÉÆÉªÔ∏ÉØ Mesa de Som & Transmiss√£o DJ</h2>\
\
        <button id="btnPowerRadio" class="btn-power off" onclick="toggleLigarRadio()">ÉøÉªÉ± DESLIGAR R√ÅDIO PARED√É£O</button>\
\
        <div style="margin: 15px 0;">\
            <button onclick="voltarMusica()">‚ÉØÆÔ∏ÉØ Voltar</button>\
            <button onclick="pausarEPlay()">‚ÉØØÔ∏ÉØ Play/Pause</button>\
            <button onclick="proximaMusica()">‚ÉØ≠Ô∏ÉØ Avan√ßar</button>\
        </div>\
\
        <div class="eq-panel">\
            <h4>ÉøÉ≥Å Adicionar √Åudios do Celular</h4>\
            <input type="file" id="fileInput" accept="audio/*" multiple style="font-size: 11px;">\
            <button onclick="carregarMp3Locais()">‚ÉæÉµ Inserir M√∫sicas</button>\
        </div>\
\
        <div class="eq-panel" style="border-color: #ffcc00;">\
            <h4 style="color: #ffcc00;">ÉøÉ≥• Pedidos do P√∫blico</h4>\
            <ul id="listaEspera"></ul>\
        </div>\
\
        <h4>ÉøÉ≥Éº Fila ADM (Organizar e Reordenar)</h4>\
        <ol id="filaAdm"></ol>\
\
        <button onclick="limparFila()" class="btn-danger">ÉøÉ∑É±Ô∏ÉØ Limpar Fila</button>\
        <br><br>\
        <button onclick="logout()" style="background: #444; color: #fff;">Sair do Painel</button>\
    </div>\
\
    <!-- ABA EDI√Éß√É£O DE SOM & VISUAL -->\
    <div id="abaCustom" class="pioneer-frame" style="display: none;">\
        <h2>ÉøÉÆ® Edi√ß√£o de Display, Cores & Som</h2>\
\
        <div class="eq-panel">\
            <h4>ÉøÉ≥É™ Estilo do Visualizador de √Åudio (+10 Modos)</h4>\
            <div class="eq-slider">\
                <span>Modo de Display:</span>\
                <select id="selectVisualizer" onchange="mudarEstiloVisualizer(this.value)">\
                    <option value="bars">1. Barras LED (Pioneer Cl√ÉÅssico)</option>\
                    <option value="wave">2. Onda Oscilosc√≥pio</option>\
                    <option value="radial">3. Espectro Radial Neon</option>\
                    <option value="vumeter">4. VU Meter Anal√≥gico</option>\
                    <option value="bars3d">5. Espectro 3D Gradiente</option>\
                    <option value="freqcircle">6. Freq√º√™ncia Circular</option>\
                    <option value="tunnel">7. T√∫nel Neon Hipn√≥tico</option>\
                    <option value="particles">8. Part√≠culas de Grave</option>\
                    <option value="floating">9. Picos Flutuantes</option>\
                    <option value="matrixcube">10. Matriz C√∫bica</option>\
                    <option value="laser">11. Linha Laser Pulsante</option>\
                </select>\
            </div>\
        </div>\
\
        <div class="eq-panel">\
            <h4>ÉøÉÆÉ∫Ô∏ÉØ Regulagem Avan√ßada de Som</h4>\
            <div class="eq-slider"><span>ÉøÉ¥É™ Subwoofer / Grave:</span><input type="range" id="bassRange" min="-10" max="30" value="0" oninput="atualizarEqualizador()"></div>\
            <div class="eq-slider"><span>ÉøÉ≥ÉÇ Corneta / M√©dio:</span><input type="range" id="midRange" min="-10" max="20" value="0" oninput="atualizarEqualizador()"></div>\
            <div class="eq-slider"><span>‚É∫ÉÅ Tweeter / Agudo:</span><input type="range" id="trebleRange" min="-10" max="20" value="0" oninput="atualizarEqualizador()"></div>\
            <button id="btnGraveExtreme" class="btn-extreme" onclick="toggleGraveExtreme()">ÉøÉ¥É™ LIGAR GRAVE EXTREME</button>\
        </div>\
\
        <div class="eq-panel">\
            <h4>ÉøÉÆ® Cores do Pioneer & Conjuga√ß√£o de Luzes</h4>\
            <div class="color-group"><span>Borda do Display Pioneer:</span><input type="color" value="#00d4ff" onchange="mudarCor('--pioneer-border', this.value); mudarCor('--pioneer-blue', this.value)"></div>\
            <div class="color-group"><span>Cor do Subwoofer:</span><input type="color" id="subColorInput" value="#00ff88" onchange="mudarCor('--speaker-sub-color', this.value)"></div>\
            <div class="color-group"><span>Cor da Corneta:</span><input type="color" id="hornColorInput" value="#0044ff" onchange="mudarCor('--speaker-horn-color', this.value)"></div>\
            <div class="color-group"><span>Cor do Tweeter:</span><input type="color" id="tweetColorInput" value="#ff0055" onchange="mudarCor('--speaker-tweet-color', this.value)"></div>\
            <button onclick="toggleConjugadorCores()" id="btnConjugador" style="width:100%; margin-top:8px; background:#9b59b6; color:#fff;">ÉøÉ¨É® LIGAR CONJUGADOR RGB AUTOM√ÅTICO</button>\
        </div>\
\
        <div class="eq-panel">\
            <h4>‚É∫ÉÅ Efeito Strobo / Flash de Tela</h4>\
            <div class="color-group"><span>Cor do Flash:</span><input type="color" value="#ffffff" onchange="mudarCor('--flash-color', this.value)"></div>\
            <div class="eq-slider">\
                <span>Velocidade Pisca (ms):</span>\
                <input type="range" id="flashSpeed" min="50" max="1000" value="200">\
            </div>\
            <button onclick="toggleStroboritmo()" id="btnStroboritmo" style="width:100%; margin-bottom:5px;">ÉøÉÆÉ¶ Strobo no Ritmo do Grave</button>\
            <button onclick="toggleFlashManual()" id="btnFlashManual" style="width:100%; background:#e67e22; color:#fff;">ÉøÉ≤ÉÅ Flash Manual Cont√≠nuo</button>\
        </div>\
\
        <div class="eq-panel">\
            <h4>ÉøÉ∂ºÔ∏ÉØ Personaliza√ß√£o de Fundo (+10 GIFs)</h4>\
            <div class="eq-slider">\
                <span>Estilo do Fundo:</span>\
                <select id="tipoFundo" onchange="alterarTipoFundo(this.value)">\
                    <option value="solido">1. Cor S√≥lida Customizada</option>\
                    <option value="glitter">2. Glitter Animado Neon</option>\
                    <option value="gif_fogo">3. Fogo do Pared√£o</option>\
                    <option value="gif_matrix">4. Matrix LED Green</option>\
                    <option value="gif_galaxy">5. Gal√ÉÅxia Espacial</option>\
                    <option value="gif_stars">6. Chuva de Estrelas</option>\
                    <option value="gif_cyberpunk">7. Neon Cyberpunk</option>\
                    <option value="gif_fogoblue">8. Fogo Azul Veloce</option>\
                    <option value="gif_waves">9. Ondas √Åudio Neon</option>\
                    <option value="gif_eqdigital">10. Equalizador Digital</option>\
                    <option value="gif_lights">11. Chuva de Luzes DJ</option>\
                    <option value="foto">12. Foto ou GIF por URL</option>\
                </select>\
            </div>\
            <div class="color-group" id="groupCorFundo">\
                <span>Cor de Fundo S√≥lida:</span>\
                <input type="color" value="#0a0b0e" onchange="mudarCor('--bg-color', this.value)">\
            </div>\
            <div id="groupFotoFundo" style="display: none; margin-top: 8px;">\
                <input type="text" id="urlFotoFundo" placeholder="Cole a URL do GIF ou Foto..." style="width:100%;">\
                <button onclick="aplicarFotoFundo()">Aplicar Fundo</button>\
            </div>\
        </div>\
\
        <button onclick="logout()" style="background: #444; color: #fff;">Sair do Painel</button>\
    </div>\
\
    <script>\
        const socket = io();\
        let filaMusicas = [];\
        let listaEspera = [];\
        let indexAtual = 0;\
        let admAutenticado = false;\
        let abaPendente = '';\
        let visualizerMode = 'bars';\
        let radioLigada = true;\
        let conjugadorAtivo = false, conjugadorTimer = null;\
        let stroboRitmoAtivo = false, flashManualAtivo = false, flashInterval = null;\
\
        const audio = document.getElementById('audioElement');\
        const canvas = document.getElementById('visualizerCanvas');\
        const ctx = canvas.getContext('2d');\
\
        window.onload = () => {\
            const currentUrl = window.location.href;\
            document.getElementById('urlRadio').value = currentUrl;\
            new QRCode(document.getElementById("qrcodeCanvas"), {\
                text: currentUrl,\
                width: 120,\
                height: 120\
            });\
        };\
\
        let audioCtx, source, analyser, bassNode, midNode, trebleNode, extremeBassNode;\
        let graveExtremeAtivo = false;\
\
        function toggleLigarRadio() {\
            radioLigada = !radioLigada;\
            const btn = document.getElementById('btnPowerRadio');\
            const status = document.getElementById('status');\
\
            if (radioLigada) {\
                btn.innerText = "ÉøÉªÉ± DESLIGAR R√ÅDIO PARED√É£O";\
                btn.classList.add('off');\
                status.innerText = "[ONLINE] PARED√É£O TOCANDO";\
                desbloquearAudio();\
                if (filaMusicas.length > 0) audio.play();\
            } else {\
                btn.innerText = "‚É∫ÉÅ LIGAR R√ÅDIO PARED√É£O";\
                btn.classList.remove('off');\
                status.innerText = "[DESLIGADO] R√ÅDIO DESLIGADA PELO ADM";\
                audio.pause();\
            }\
        }\
\
        function toggleGearMenu(e) {\
            e.stopPropagation();\
            const menu = document.getElementById('gearMenu');\
            menu.style.display = (menu.style.display === 'block') ? 'none' : 'block';\
        }\
\
        function solicitarAcesso(aba) {\
            if (admAutenticado) {\
                verAba(aba);\
            } else {\
                abaPendente = aba;\
                document.getElementById('modalLogin').style.display = 'block';\
                document.getElementById('gearMenu').style.display = 'none';\
            }\
        }\
\
        function validarLogin() {\
            const email = document.getElementById('loginEmail').value;\
            const pass = document.getElementById('loginPass').value;\
            if (email === "admin@speed.com" && pass === "1234") {\
                admAutenticado = true;\
                document.getElementById('modalLogin').style.display = 'none';\
                verAba(abaPendente);\
            } else {\
                alert("E-mail ou Senha incorretos!");\
            }\
        }\
\
        function cancelarLogin() { document.getElementById('modalLogin').style.display = 'none'; }\
        function logout() { admAutenticado = false; verAba('abaOuvinte'); }\
\
        function verAba(abaId) {\
            document.getElementById('abaOuvinte').style.display = 'none';\
            document.getElementById('abaAdm').style.display = 'none';\
            document.getElementById('abaCustom').style.display = 'none';\
            document.getElementById(abaId).style.display = 'block';\
            document.getElementById('gearMenu').style.display = 'none';\
        }\
\
        function copiarLink() {\
            const input = document.getElementById('urlRadio');\
            input.select();\
            document.execCommand('copy');\
            alert('Link copiado!');\
        }\
\
        function desbloquearAudio() {\
            if (!audioCtx) {\
                initAudioContext();\
            } else if (audioCtx.state === 'suspended') {\
                audioCtx.resume();\
            }\
        }\
\
        function initAudioContext() {\
            try {\
                audioCtx = new (window.AudioContext || window.webkitAudioContext)();\
                source = audioCtx.createMediaElementSource(audio);\
                analyser = audioCtx.createAnalyser();\
                analyser.fftSize = 256;\
\
                bassNode = audioCtx.createBiquadFilter(); bassNode.type = 'lowshelf'; bassNode.frequency.value = 180;\
                midNode = audioCtx.createBiquadFilter(); midNode.type = 'peaking'; midNode.frequency.value = 1000;\
                trebleNode = audioCtx.createBiquadFilter(); trebleNode.type = 'highshelf'; trebleNode.frequency.value = 3500;\
                extremeBassNode = audioCtx.createBiquadFilter(); extremeBassNode.type = 'lowshelf'; extremeBassNode.frequency.value = 70;\
\
                source.connect(bassNode);\
                bassNode.connect(midNode);\
                midNode.connect(trebleNode);\
                trebleNode.connect(extremeBassNode);\
                extremeBassNode.connect(analyser);\
                analyser.connect(audioCtx.destination);\
\
                renderFrame();\
            } catch(e) { console.log(e); }\
        }\
\
        function renderFrame() {\
            requestAnimationFrame(renderFrame);\
            if (!analyser || !radioLigada) return;\
\
            const bufferLength = analyser.frequencyBinCount;\
            const dataArray = new Uint8Array(bufferLength);\
            analyser.getByteFrequencyData(dataArray);\
\
            let bassSum = 0;\
            for (let i = 0; i < 10; i++) bassSum += dataArray[i];\
            let bassAvg = bassSum / 10;\
\
            const subScale = 1 + (bassAvg / 255) * 0.28;\
            document.querySelectorAll('.subElem').forEach(el => {\
                el.style.transform = `scale(${subScale})`;\
            });\
\
            const paredao = document.getElementById('paredaoContainer');\
            if (bassAvg > 180) {\
                paredao.classList.add('shake-effect');\
                if (stroboRitmoAtivo) {\
                    document.body.style.backgroundColor = getComputedStyle(document.documentElement).getPropertyValue('--flash-color').trim() || '#ffffff';\
                    setTimeout(() => {\
                        document.body.style.backgroundColor = getComputedStyle(document.documentElement).getPropertyValue('--bg-color').trim();\
                    }, 40);\
                }\
            } else {\
                paredao.classList.remove('shake-effect');\
            }\
\
            ctx.clearRect(0, 0, canvas.width, canvas.height);\
            const lineColor = getComputedStyle(document.documentElement).getPropertyValue('--pioneer-blue').trim() || '#00d4ff';\
\
            /* DESENHO DOS 11 VISUALIZADORES */\
            if (visualizerMode === 'bars') {\
                const barWidth = (canvas.width / bufferLength) * 2.5;\
                let x = 0;\
                for (let i = 0; i < bufferLength; i++) {\
                    const barHeight = dataArray[i] / 3.5;\
                    ctx.fillStyle = lineColor;\
                    ctx.fillRect(x, canvas.height - barHeight, barWidth, barHeight);\
                    x += barWidth + 1;\
                }\
            } else if (visualizerMode === 'wave') {\
                ctx.beginPath(); ctx.lineWidth = 2; ctx.strokeStyle = lineColor;\
                const sliceWidth = canvas.width / bufferLength;\
                let x = 0;\
                for (let i = 0; i < bufferLength; i++) {\
                    const v = dataArray[i] / 128.0;\
                    const y = (v * canvas.height) / 2;\
                    if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);\
                    x += sliceWidth;\
                }\
                ctx.stroke();\
            } else if (visualizerMode === 'radial') {\
                const centerX = canvas.width / 2, centerY = canvas.height / 2, radius = 15;\
                for (let i = 0; i < bufferLength; i += 2) {\
                    const rad = (i * Math.PI) / (bufferLength / 2);\
                    const barLen = dataArray[i] / 6;\
                    ctx.strokeStyle = lineColor; ctx.beginPath();\
                    ctx.moveTo(centerX + Math.cos(rad) * radius, centerY + Math.sin(rad) * radius);\
                    ctx.lineTo(centerX + Math.cos(rad) * (radius + barLen), centerY + Math.sin(rad) * (radius + barLen));\
                    ctx.stroke();\
                }\
            } else if (visualizerMode === 'vumeter') {\
                const barW = canvas.width / 20;\
                for(let i=0; i<20; i++) {\
                    const val = dataArray[i*4]/255;\
                    ctx.fillStyle = val > 0.8 ? '#ff0055' : (val > 0.5 ? '#ffcc00' : '#00ff88');\
                    ctx.fillRect(i*barW + 2, canvas.height - (val * canvas.height), barW - 4, val * canvas.height);\
                }\
            } else if (visualizerMode === 'bars3d') {\
                let x = 0; const barWidth = (canvas.width / bufferLength) * 2;\
                for (let i = 0; i < bufferLength; i++) {\
                    let h = dataArray[i] / 3;\
                    let grad = ctx.createLinearGradient(0, canvas.height, 0, 0);\
                    grad.addColorStop(0, lineColor); grad.addColorStop(1, '#ffffff');\
                    ctx.fillStyle = grad; ctx.fillRect(x, canvas.height - h, barWidth, h);\
                    x += barWidth + 2;\
                }\
            } else if (visualizerMode === 'freqcircle') {\
                ctx.beginPath(); ctx.arc(canvas.width/2, canvas.height/2, bassAvg/4, 0, Math.PI*2);\
                ctx.strokeStyle = lineColor; ctx.lineWidth = 4; ctx.stroke();\
            } else if (visualizerMode === 'tunnel') {\
                for(let i=0; i<5; i++) {\
                    ctx.strokeStyle = lineColor;\
                    ctx.strokeRect(canvas.width/2 - (bassAvg*i)/6, canvas.height/2 - (bassAvg*i)/12, (bassAvg*i)/3, (bassAvg*i)/6);\
                }\
            } else if (visualizerMode === 'particles') {\
                for(let i=0; i<bufferLength; i+=4) {\
                    ctx.fillStyle = lineColor;\
                    ctx.beginPath();\
                    ctx.arc((i* canvas.width)/bufferLength, canvas.height - dataArray[i]/3, 3, 0, Math.PI*2);\
                    ctx.fill();\
                }\
            } else if (visualizerMode === 'floating') {\
                let x = 0; const w = canvas.width / bufferLength * 2;\
                for(let i=0; i<bufferLength; i++) {\
                    ctx.fillStyle = lineColor;\
                    ctx.fillRect(x, canvas.height - dataArray[i]/3 - 5, w, 4);\
                    x += w + 1;\
                }\
            } else if (visualizerMode === 'matrixcube') {\
                for(let i=0; i<15; i++) {\
                    for(let j=0; j<5; j++) {\
                        ctx.fillStyle = (dataArray[i*2] > j*40) ? lineColor : '#111';\
                        ctx.fillRect(i*20, canvas.height - (j*12) - 10, 16, 10);\
                    }\
                }\
            } else if (visualizerMode === 'laser') {\
                ctx.strokeStyle = '#ff0055'; ctx.lineWidth = 3; ctx.beginPath();\
                ctx.moveTo(0, canvas.height/2);\
                ctx.lineTo(canvas.width, canvas.height/2 - (bassAvg - 100));\
                ctx.stroke();\
            }\
        }\
\
        function carregarMp3Locais() {\
            const fileInput = document.getElementById('fileInput');\
            if (fileInput.files.length > 0) {\
                for (let i = 0; i < fileInput.files.length; i++) {\
                    const file = fileInput.files[i];\
                    filaMusicas.push({ nome: file.name, url: URL.createObjectURL(file) });\
                }\
                atualizarFila();\
                if (audio.paused && filaMusicas.length > 0 && radioLigada) tocarMusica(indexAtual);\
                alert('M√∫sicas carregadas!');\
            }\
        }\
\
        function tocarMusica(index) {\
            if (index >= 0 && index < filaMusicas.length) {\
                indexAtual = index;\
                audio.src = filaMusicas[indexAtual].url;\
                if (radioLigada) audio.play();\
                document.getElementById('status').innerText = "TOCANDO: " + filaMusicas[indexAtual].nome;\
                atualizarFila();\
            }\
        }\
\
        function pausarEPlay() { if (audio.paused && radioLigada) audio.play(); else audio.pause(); }\
        function proximaMusica() { if (indexAtual + 1 < filaMusicas.length) tocarMusica(indexAtual + 1); }\
        function voltarMusica() { if (indexAtual - 1 >= 0) tocarMusica(indexAtual - 1); }\
\
        function moverParaCima(i) { if(i>0) { let t=filaMusicas[i]; filaMusicas[i]=filaMusicas[i-1]; filaMusicas[i-1]=t; atualizarFila(); } }\
        function moverParaBaixo(i) { if(i<filaMusicas.length-1) { let t=filaMusicas[i]; filaMusicas[i]=filaMusicas[i+1]; filaMusicas[i+1]=t; atualizarFila(); } }\
        function removerMusica(i) { filaMusicas.splice(i, 1); atualizarFila(); }\
\
        function limparFila() {\
            filaMusicas = []; audio.pause(); audio.src = "";\
            document.getElementById('status').innerText = "[PRONTO] ADICIONE M√É∫SICAS";\
            atualizarFila();\
        }\
\
        function atualizarFila() {\
            const listaOuvinte = document.getElementById('filaOuvinte');\
            const listaAdm = document.getElementById('filaAdm');\
            listaOuvinte.innerHTML = ''; listaAdm.innerHTML = '';\
\
            filaMusicas.forEach((m, i) => {\
                const ativo = (i === indexAtual) ? 'style="color:#00ff88; font-weight:bold;"' : '';\
                listaOuvinte.innerHTML += `<li ${ativo}><span class="song-title">${i + 1}. ${m.nome}</span></li>`;\
                listaAdm.innerHTML += `\
                    <li ${ativo}>\
                        <span class="song-title">${i + 1}. ${m.nome}</span>\
                        <div>\
                            <button class="btn-small" onclick="tocarMusica(${i})">‚É∂∂Ô∏ÉØ</button>\
                            <button class="btn-small" onclick="moverParaCima(${i})">‚¨É¶Ô∏ÉØ</button>\
                            <button class="btn-small" onclick="moverParaBaixo(${i})">‚¨ÉßÔ∏ÉØ</button>\
                            <button class="btn-small btn-danger" onclick="removerMusica(${i})">‚ÉΩÉ¨</button>\
                        </div>\
                    </li>`;\
            });\
        }\
\
        function enviarPedidoPublico() {\
            const input = document.getElementById('linkMusicaOuvinte');\
            if (input.value.trim() !== '') {\
                socket.emit('novoPedido', input.value.trim());\
                alert('Pedido enviado!'); input.value = '';\
            }\
        }\
\
        socket.on('receberPedido', (url) => { listaEspera.push(url); atualizarListaEspera(); });\
\
        function atualizarListaEspera() {\
            const ul = document.getElementById('listaEspera'); ul.innerHTML = '';\
            listaEspera.forEach((url, i) => {\
                ul.innerHTML += `\
                    <li>\
                        <span class="song-title">${url}</span>\
                        <div>\
                            <button class="btn-small btn-success" onclick="aprovarPedido(${i})">‚ÉºÉ• Aprovar</button>\
                            <button class="btn-small btn-danger" onclick="recusarPedido(${i})">‚ÉΩÉ¨ Recusar</button>\
                        </div>\
                    </li>`;\
            });\
        }\
\
        function aprovarPedido(i) {\
            filaMusicas.push({ nome: "Pedido do P√∫blico", url: listaEspera[i] });\
            listaEspera.splice(i, 1); atualizarListaEspera(); atualizarFila();\
        }\
\
        function recusarPedido(i) { listaEspera.splice(i, 1); atualizarListaEspera(); }\
\
        function mudarEstiloVisualizer(val) { visualizerMode = val; }\
\
        function atualizarEqualizador() {\
            if (!audioCtx) return;\
            bassNode.gain.value = parseFloat(document.getElementById('bassRange').value);\
            midNode.gain.value = parseFloat(document.getElementById('midRange').value);\
            trebleNode.gain.value = parseFloat(document.getElementById('trebleRange').value);\
        }\
\
        function toggleGraveExtreme() {\
            if (!audioCtx) return;\
            graveExtremeAtivo = !graveExtremeAtivo;\
            const btn = document.getElementById('btnGraveExtreme');\
            if (graveExtremeAtivo) {\
                extremeBassNode.gain.value = 25;\
                btn.classList.add('active'); btn.innerText = "ÉøÉ≤• GRAVE EXTREME ATIVADO";\
            } else {\
                extremeBassNode.gain.value = 0;\
                btn.classList.remove('active'); btn.innerText = "ÉøÉ¥É™ LIGAR GRAVE EXTREME";\
            }\
        }\
\
        function mudarCor(variable, value) { document.documentElement.style.setProperty(variable, value); }\
\
        function toggleConjugadorCores() {\
            conjugadorAtivo = !conjugadorAtivo;\
            const btn = document.getElementById('btnConjugador');\
            if(conjugadorAtivo) {\
                btn.innerText = "ÉøÉ¨É® DESLIGAR CONJUGADOR RGB";\
                let hue = 0;\
                conjugadorTimer = setInterval(() => {\
                    hue = (hue + 10) % 360;\
                    let c1 = `hsl(${hue}, 100%, 50%)`;\
                    let c2 = `hsl(${(hue+120)%360}, 100%, 50%)`;\
                    let c3 = `hsl(${(hue+240)%360}, 100%, 50%)`;\
                    mudarCor('--speaker-sub-color', c1);\
                    mudarCor('--speaker-horn-color', c2);\
                    mudarCor('--speaker-tweet-color', c3);\
                }, 150);\
            } else {\
                btn.innerText = "ÉøÉ¨É® LIGAR CONJUGADOR RGB AUTOM√ÅTICO";\
                clearInterval(conjugadorTimer);\
            }\
        }\
\
        function toggleStroboritmo() {\
            stroboRitmoAtivo = !stroboRitmoAtivo;\
            const btn = document.getElementById('btnStroboritmo');\
            btn.innerText = stroboRitmoAtivo ? "ÉøÉÆÉ¶ Desligar Strobo Grave" : "ÉøÉÆÉ¶ Strobo no Ritmo do Grave";\
        }\
\
        function toggleFlashManual() {\
            flashManualAtivo = !flashManualAtivo;\
            const btn = document.getElementById('btnFlashManual');\
            if(flashManualAtivo) {\
                btn.innerText = "ÉøÉ≤ÉÅ Desligar Flash Manual";\
                let speed = parseInt(document.getElementById('flashSpeed').value);\
                let flag = false;\
                flashInterval = setInterval(() => {\
                    document.body.style.backgroundColor = flag ? getComputedStyle(document.documentElement).getPropertyValue('--flash-color').trim() : getComputedStyle(document.documentElement).getPropertyValue('--bg-color').trim();\
                    flag = !flag;\
                }, speed);\
            } else {\
                btn.innerText = "ÉøÉ≤ÉÅ Flash Manual Cont√≠nuo";\
                clearInterval(flashInterval);\
                document.body.style.backgroundColor = getComputedStyle(document.documentElement).getPropertyValue('--bg-color').trim();\
            }\
        }\
\
        function alterarTipoFundo(val) {\
            document.body.className = '';\
            document.body.style.backgroundImage = 'none';\
            document.getElementById('groupCorFundo').style.display = 'none';\
            document.getElementById('groupFotoFundo').style.display = 'none';\
\
            if (val === 'solido') {\
                document.getElementById('groupCorFundo').style.display = 'flex';\
            } else if (val === 'foto') {\
                document.getElementById('groupFotoFundo').style.display = 'block';\
            } else {\
                document.body.classList.add(val);\
            }\
        }\
\
        function aplicarFotoFundo() {\
            const url = document.getElementById('urlFotoFundo').value;\
            if (url) {\
                document.body.className = '';\
                document.body.style.backgroundImage = `url('${url}')`;\
            }\
        }\
    </script>\
</body>\
</html>\
EOF\

