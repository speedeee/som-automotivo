<!DOCTYPE html>\
<html lang="pt-BR">\
<head>\
    <meta charset="UTF-8">\
    <meta name="viewport" content="width=device-width, initial-scale=1.0">\
    <title id="pageTitle">‚É∫ÉÅ SPEED R√ÅDIO</title>\
    <script src="/socket.io/socket.io.js"></script>\
    <script src="https://www.youtube.com/iframe_api"></script>\
    <style>\
        :root { --bg-color: #121212; --card-color: #1e1e1e; --primary-color: #1db954; --text-color: #ffffff; }\
        body { background: var(--bg-color); color: var(--text-color); font-family: sans-serif; text-align: center; padding: 20px; margin: 0; }\
        .card { background: var(--card-color); padding: 20px; border-radius: 10px; max-width: 500px; margin: 0 auto 20px auto; border-top: 4px solid #00e5ff; }\
        .brand-header h1 { margin: 5px 0; font-size: 28px; color: #00e5ff; letter-spacing: 1.5px; }\
        .box-link { background: rgba(255,255,255,0.05); border: 2px dashed #00e5ff; border-radius: 8px; padding: 15px; margin: 15px 0; }\
        .box-link input { width: 90%; text-align: center; font-size: 12px; background: #000; color: #fff; border: 1px solid #444; padding: 8px; border-radius: 5px; }\
        input[type="text"], input[type="email"], input[type="password"] { width: 85%; padding: 10px; border-radius: 5px; border: 1px solid #444; background: #222; color: #fff; margin-bottom: 10px; box-sizing: border-box; }\
        button { padding: 10px 15px; border-radius: 5px; border: none; background: #00e5ff; color: #000; font-weight: bold; cursor: pointer; margin: 3px; }\
        .btn-danger { background: #e74c3c; color: #fff; }\
        .btn-warning { background: #ff9800; color: #fff; }\
        .btn-mic { background: #ff9800; font-size: 16px; padding: 12px 20px; color: #fff; width: 80%; }\
        ul { text-align: left; background: rgba(255,255,255,0.05); padding: 15px 25px; border-radius: 5px; list-style: none; min-height: 40px; }\
        li { margin-bottom: 8px; font-size: 13px; word-break: break-all; }\
        .tab-btn { background: #333; color: #fff; margin-bottom: 15px; border: 1px solid #444; }\
        .active-tab { background: #00e5ff; color: #000; }\
        #ytPlayerContainer { position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; border-radius: 8px; margin-top: 15px; background: #000; }\
        #ytPlayerContainer iframe { position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 0; }\
    </style>\
</head>\
<body>\
\
    <div>\
        <button class="tab-btn active-tab" id="btnTabOuvinte" onclick="verAba('ouvinte')">ÉøÉ≥ª Player Ouvinte</button>\
        <button class="tab-btn" id="btnTabAdm" onclick="verAba('adm')">ÉøÉÆÉªÔ∏ÉØ Painel DJ / ADM</button>\
    </div>\
\
    <!-- OUVINTE -->\
    <div id="abaOuvinte" class="card">\
        <div class="brand-header">\
            <h1>‚É∫ÉÅ SPEED R√ÅDIO</h1>\
            <p>A r√ÉÅdio ao vivo com √ÉÅudio sincronizado!</p>\
        </div>\
\
        <div class="box-link">\
            <p>ÉøÉ≥ÉÇ LINK OFICIAL DA R√ÅDIO</p>\
            <input type="text" id="urlRadio" readonly>\
            <br><br>\
            <button onclick="copiarLink()">ÉøÉ≥É´ Copiar Link da R√ÉÅdio</button>\
        </div>\
\
        <p id="status">Status: Conectando...</p>\
\
        <div id="ytPlayerContainer">\
            <div id="player"></div>\
        </div>\
\
        <div style="margin-top: 20px;">\
            <h3>ÉøÉÆµ Pedir M√∫sica na R√ÉÅdio</h3>\
            <input type="text" id="linkMusicaOuvinte" placeholder="Cole o link do YouTube aqui...">\
            <br>\
            <button onclick="adicionarOuvinte()">‚ÉæÉµ Enviar para Fila</button>\
        </div>\
\
        <h3>ÉøÉ≥Éº Pr√≥ximas M√∫sicas na Fila</h3>\
        <ul id="filaOuvinte"></ul>\
    </div>\
\
    <!-- PAINEL DJ -->\
    <div id="abaAdm" class="card" style="display: none;">\
        <h2>ÉøÉÆÉπÔ∏ÉØ Painel de Controle SPEED R√ÅDIO</h2>\
\
        <div id="areaLogin">\
            <input type="email" id="loginEmail" placeholder="Digite seu e-mail">\
            <input type="password" id="loginPass" placeholder="Digite sua senha">\
            <br>\
            <button onclick="fazerLogin()">Entrar no Painel</button>\
        </div>\
\
        <div id="areaDj" style="display: none;">\
            <div style="background: rgba(255,255,255,0.05); padding: 15px; border-radius: 8px; margin-bottom: 15px;">\
                <h3>ÉøÉÆÉπÔ∏ÉØ Transmiss√£o ao Vivo (Microfone)</h3>\
                <button id="btnMicrofone" class="btn-mic" onclick="toggleMicrofone()">ÉøÉÆÉπÔ∏ÉØ Ligar Microfone</button>\
                <p id="statusMic" style="font-size: 12px; color: #aaa; margin-top: 5px;">Microfone Desligado</p>\
            </div>\
\
            <div style="background: rgba(255,255,255,0.05); padding: 15px; border-radius: 8px;">\
                <h3>ÉøÉÆÉªÔ∏ÉØ Gerenciador de Mixagem</h3>\
                <input type="text" id="linkMusicaAdm" placeholder="Cole o link (YouTube, MP3, SoundCloud...)">\
                <br>\
                <button onclick="adicionarAdm()" style="background: #2ecc71; color: #fff;">‚ÉæÉµ Adicionar</button>\
                <button onclick="comandoDJ('skip')" class="btn-warning">‚ÉØ≠Ô∏ÉØ Pular Atual</button>\
                <button onclick="limparFila()" class="btn-danger">ÉøÉ∑É±Ô∏ÉØ Limpar Fila</button>\
\
                <h4>ÉøÉ≥Éº M√∫sicas na Fila:</h4>\
                <ul id="filaAdm"></ul>\
            </div>\
            <br>\
            <button onclick="logout()" style="background: #555; color: #fff;">Sair do Painel</button>\
        </div>\
    </div>\
\
    <script>\
        const socket = io();\
        let ytPlayer;\
\
        document.getElementById('urlRadio').value = window.location.href;\
\
        function onYouTubeIframeAPIReady() {\
            ytPlayer = new YT.Player('player', {\
                height: '100%',\
                width: '100%',\
                playerVars: { 'autoplay': 1, 'controls': 1, 'origin': window.location.origin },\
                events: {\
                    'onStateChange': (e) => {\
                        if (e.data === YT.PlayerState.ENDED) socket.emit('proximaMusicaAuto');\
                    }\
                }\
            });\
        }\
\
        socket.on('novaMusica', (data) => {\
            const status = document.getElementById('status');\
            if (data && data.musica) {\
                status.innerText = 'Tocando agora na r√ÉÅdio!';\
                let id = data.musica.split('v=')[1]?.substring(0,11) || data.musica;\
                if (ytPlayer && ytPlayer.loadVideoById) ytPlayer.loadVideoById(id);\
            } else {\
                status.innerText = 'Status: Nenhuma m√∫sica na fila';\
            }\
        });\
\
        socket.on('atualizarFila', (lista) => {\
            const filaOuvinte = document.getElementById('filaOuvinte');\
            const filaAdm = document.getElementById('filaAdm');\
            filaOuvinte.innerHTML = lista.map((m, i) => `<li>${i + 1}. ${m}</li>`).join('');\
            filaAdm.innerHTML = lista.map((m, i) => `<li>${i + 1}. ${m}</li>`).join('');\
        });\
\
        function verAba(aba) {\
            document.getElementById('abaOuvinte').style.display = aba === 'ouvinte' ? 'block' : 'none';\
            document.getElementById('abaAdm').style.display = aba === 'adm' ? 'block' : 'none';\
            document.getElementById('btnTabOuvinte').classList.toggle('active-tab', aba === 'ouvinte');\
            document.getElementById('btnTabAdm').classList.toggle('active-tab', aba === 'adm');\
        }\
\
        function copiarLink() {\
            const input = document.getElementById('urlRadio');\
            input.select();\
            navigator.clipboard.writeText(input.value);\
            alert('Link copiado!');\
        }\
\
        function adicionarOuvinte() {\
            const input = document.getElementById('linkMusicaOuvinte');\
            if (input.value) { socket.emit('adicionarMusica', input.value); input.value = ''; }\
        }\
\
        function adicionarAdm() {\
            const input = document.getElementById('linkMusicaAdm');\
            if (input.value) { socket.emit('adicionarMusica', input.value); input.value = ''; }\
        }\
\
        function comandoDJ(cmd) { socket.emit('comandoDJ', cmd); }\
        function limparFila() { socket.emit('limparFila'); }\
\
        function fazerLogin() {\
            const email = document.getElementById('loginEmail').value;\
            const pass = document.getElementById('loginPass').value;\
            fetch('/api/login', {\
                method: 'POST',\
                headers: { 'Content-Type': 'application/json' },\
                body: JSON.stringify({ email, pass })\
            }).then(r => r.json()).then(d => {\
                if(d.success) {\
                    document.getElementById('areaLogin').style.display = 'none';\
                    document.getElementById('areaDj').style.display = 'block';\
                } else alert('E-mail ou senha incorretos!');\
            });\
        }\
\
        function logout() {\
            document.getElementById('areaLogin').style.display = 'block';\
            document.getElementById('areaDj').style.display = 'none';\
        }\
    </script>\
</body>\
</html>\
EOF\

